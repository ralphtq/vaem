                              a ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "swa.restoreLogMessageBoxStatus();" ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          sp:varName "allowLogMessage" ;
                        ] ;
                    ] ;
                  ui:childIndex 7 ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a swa:ResourceActionsButton ;
                      arg:editable [
