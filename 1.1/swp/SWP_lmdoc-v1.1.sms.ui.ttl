                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:gt ;
                  sp:arg1 [
                      a spr:rowCount ;
                      sp:arg1 [
                          sp:varName "instances" ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:getInstancesOfType ;
          ui:varName "instances" ;
          vaem:namespacePrefix [
              a ui:contextValue ;
              sp:arg1 "namespacePrefix" ;
            ] ;
