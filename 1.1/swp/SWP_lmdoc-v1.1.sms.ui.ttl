                                [
                                  sp:object [
                                      sp:varName "o" ;
                                    ] ;
                                  sp:predicate [
                                      sp:varName "p" ;
                                    ] ;
                                  sp:subject [
                                      sp:varName "s" ;
                                    ] ;
                                ]
                              ) ;
                            sp:graphNameNode ui:tempGraph ;
                          ]
                        ) ;
                    ] ;
                ] ;
              ui:child [
                  a ui:update ;
                  ui:childIndex 1 ;
                  ui:updateQuery [
                      a sp:Modify ;
                      sp:insertPattern (
                          [
                            a sp:NamedGraph ;
                            sp:elements (
                                [
                                  sp:object [
                                      sp:varName "o" ;
                                    ] ;
                                  sp:predicate [
                                      sp:varName "p" ;
                                    ] ;
                                  sp:subject [
                                      sp:varName "resource" ;
                                    ] ;
                                ]
                              ) ;
                            sp:graphNameNode ui:tempGraph ;
                          ]
                        ) ;
                      sp:where (
                          [
                            sp:object [
                                sp:varName "o" ;
                              ] ;
                            sp:predicate [
                                sp:varName "p" ;
                              ] ;
                            sp:subject [
                                sp:varName "resource" ;
                              ] ;
                          ]
                        ) ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Action to view as Turtle" ;
  rdfs:label "View as Turtle" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:ViewAsXML
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display." ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a html:A ;
          html:class "lm-simulated-link" ;
          html:onclick "javascript: lm.popup('lm-export-xml','Export XML',600,800)" ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "XML" ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          a html:Div ;
          html:id "lm-export-xml" ;
          ui:child [
              a html:P ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "The conversion to XML requires an XML Schema to be agreed. This is work-in-progress." ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Action to view as XML" ;
  rdfs:label "View as XML" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:ViewElements
  a ui:NodeClass ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:Viewers
  a ui:NodeClass ;
  rdfs:label "Viewers" ;
  rdfs:subClassOf lmdoc:ResourceViews ;
.
lmdoc:WhereUsedLabeledSubjects
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to only allow at most one subject for this component." ;
    ] ;
  ui:private true ;
  ui:prototype [
      a ui:if ;
      ui:child [
          a html:Tr ;
          html:class "lm-row" ;
          ui:child [
              a html:Td ;
              html:class "lm-table-column align-top" ;
              ui:child [
                  a lmdoc:URIResourceViewer ;
                  arg:object [
                      sp:varName "predicate" ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a html:Td ;
              html:class "lm-table-column" ;
              html:id [
                  a ui:concat ;
                  sp:arg1 [
                      sp:varName "pid" ;
                    ] ;
                  sp:arg2 "-body" ;
                ] ;
              ui:child [
                  a lmdoc:WhereUsedSubjectsBody ;
                  ui:args "*" ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:condition [
          a sp:or ;
          sp:arg1 [
              a sp:or ;
              sp:arg1 [
                  a sp:or ;
                  sp:arg1 [
                      a sp:not ;
                      sp:arg1 [
                          a sp:bound ;
                          sp:arg1 [
                              sp:varName "hideIfEmpty" ;
                            ] ;
                        ] ;
                    ] ;
                  sp:arg2 [
                      a sp:ne ;
                      sp:arg1 [
                          sp:varName "hideIfEmpty" ;
                        ] ;
                      sp:arg2 true ;
                    ] ;
                ] ;
              sp:arg2 [
                  a sp:ne ;
                  sp:arg1 [
                      a swa:mode ;
                    ] ;
                  sp:arg2 swa:ViewMode ;
                ] ;
            ] ;
          sp:arg2 [
              a sp:and ;
              sp:arg1 [
                  a sp:bound ;
                  sp:arg1 [
                      sp:varName "object" ;
                    ] ;
                ] ;
              sp:arg2 [
                  a sp:exists ;
                  sp:elements (
                      [
                        sp:object [
                            sp:varName "object" ;
                          ] ;
                        sp:predicate [
                            sp:varName "predicate" ;
                          ] ;
                        sp:subject [
                            sp:varName "anySubject" ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "Where used labelled subjects" ;
  rdfs:label "Labeled subjects" ;
  rdfs:subClassOf lmdoc:Subjects ;
.
lmdoc:WhereUsedSubjects
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:object ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:predicates ;
      spl:valueType sp:Select ;
    ] ;
  ui:prototype [
      a ui:group ;
      letrs:rs [
          a sp:Select ;
          sp:resultVariables (
              [
                sp:varName "predicate" ;
              ]
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "predicates" ;
                  ] ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?0" ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "?1" ;
                  ] ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?0" ;
                  ] ;
              ]
              [
                sp:object 0 ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?1" ;
                  ] ;
              ]
              [
                sp:object () ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?1" ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "predicate" ;
                  ] ;
                sp:predicate spr:colCells ;
                sp:subject [
                    sp:varName "?0" ;
                  ] ;
              ]
              [
                a sp:Filter ;
                sp:expression [
                    a sp:or ;
                    sp:arg1 [
                        a sp:not ;
                        sp:arg1 [
                            a sp:bound ;
                            sp:arg1 [
                                sp:varName "filterFunction" ;
                              ] ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        a spif:invoke ;
                        sp:arg1 [
                            sp:varName "filterFunction" ;
                          ] ;
                        sp:arg2 [
                            sp:varName "predicate" ;
                          ] ;
                        sp:arg3 [
                            sp:varName "subject" ;
                          ] ;
                      ] ;
                  ] ;
              ]
              [
                a sp:Filter ;
                sp:expression [
                    a sp:not ;
                    sp:arg1 [
                        a swa:isHiddenProperty ;
                        arg:property [
                            sp:varName "predicate" ;
                          ] ;
                      ] ;
                  ] ;
              ]
            ) ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:Table ;
              html:class "lm-table" ;
              let:pid [
                  a ui:uniqueId ;
                ] ;
              ui:child [
                  a html:Tbody ;
                  html:class "lm-table-body" ;
                  ui:child [
                      a ui:forEach ;
                      ui:child [
                          a lmdoc:WhereUsedLabeledSubjects ;
                          arg:property [
                              sp:varName "predicate" ;
                            ] ;
                          arg:single false ;
                          ui:args "*" ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:resultSet [
                          sp:varName "rs" ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a html:Thead ;
                  html:class "lm-table-header" ;
                  ui:child [
                      a html:Th ;
                      html:class "lm-column-label" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Referencing Property" ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a html:Th ;
                      html:class "lm-column-label" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Subject" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:gt ;
              sp:arg1 [
                  a spr:rowCount ;
                  sp:arg1 [
                      sp:varName "rs" ;
                    ] ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "Inserts a widget for a given predicate/object combination, showing the subjects as values. This is typically known as \"Incoming References\"." ;
  rdfs:label "Subjects" ;
  rdfs:subClassOf lmdoc:Subjects ;
.
lmdoc:WhereUsedSubjectsBody
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to allow at most one value." ;
    ] ;
  ui:private true ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a ui:else ;
          ui:child [
              a html:Div ;
              html:class "swa-object-row" ;
              ui:child [
                  a swa:SubjectWidgetRow ;
                  arg:predicate [
                      sp:varName "predicate" ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:Div ;
              html:class "swa-add-button-div" ;
              html:style [
                  a sp:if ;
                  sp:arg1 [
                      sp:varName "single" ;
                    ] ;
                  sp:arg2 "display: none" ;
                  sp:arg3 [
                      sp:varName "none" ;
                    ] ;
                ] ;
              let:pid [
                  a ui:uniqueId ;
                ] ;
              ui:child [
                  a html:A ;
                  html:class "swa-add-row-button" ;
                  html:href "javascript:void(0)" ;
                  html:onclick [
                      a fn:concat ;
                      sp:arg1 "swa.addRow('" ;
                      sp:arg2 [
                          sp:varName "pid" ;
                        ] ;
                      sp:arg3 "', " ;
                      sp:arg4 [
                          a sp:coalesce ;
                          sp:arg1 [
                              sp:varName "single" ;
                            ] ;
                          sp:arg2 false ;
                        ] ;
                      sp:arg5 ")" ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  a html:Div ;
                  html:id [
                      sp:varName "pid" ;
                    ] ;
                  html:style "display: none" ;
                  ui:child [
                      a html:Div ;
                      html:class "ies-object-row" ;
                      ui:child [
                          a ui:setContext ;
                          ui:child [
                              a swa:SubjectWidgetRow ;
                              arg:object [
                                  sp:varName "object" ;
                                ] ;
                              arg:predicate [
                                  sp:varName "predicate" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:varName "createLinkFunction" ;
                          ui:varValue lmdoc:createLinkForMainForm ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 2 ;
          ui:condition [
              a swa:isEditMode ;
            ] ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a ui:call ;
              arg:object [
                  sp:varName "object" ;
                ] ;
              arg:predicate [
                  sp:varName "predicate" ;
                ] ;
              ui:child [
                  a ui:forEach ;
                  ui:child [
                      a html:Div ;
                      html:class "swa_widget_value_slot" ;
                      ui:child [
                          a swa:SubjectWidgetRow ;
                          arg:object [
                              sp:varName "object" ;
                            ] ;
                          arg:predicate [
                              sp:varName "predicate" ;
                            ] ;
                          arg:subject [
                              sp:varName "subject" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "rs" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a html:Div ;
                      html:class "swa-object-row" ;
                      ui:child [
                          a swa:SubjectWidgetRow ;
                          arg:object [
                              sp:varName "object" ;
                            ] ;
                          arg:predicate [
                              sp:varName "predicate" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      a sp:eq ;
                      sp:arg1 [
                          a spr:rowCount ;
                          sp:arg1 [
                              sp:varName "rs" ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template swa:SortedSubjects ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:bound ;
              sp:arg1 [
                  sp:varName "object" ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "Where used subjects body" ;
  rdfs:label "Subjects body" ;
  rdfs:subClassOf lmdoc:SubjectElements ;
.
lmdoc:WhereUsedSubjectsGroup
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:filterFunction ;
      spl:valueType spin:Function ;
      rdfs:comment "An optional filter function that takes a predicate, subject and subjectType as arguments and returns true for all predicates that should be displayed." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
      rdfs:comment "The title label." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:object ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The resource to display." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:predicates ;
      spl:valueType sp:Select ;
      rdfs:comment "A result set (e.g., SPARQL SELECT query) that delivers the predicates in this group." ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:Div ;
              html:class "swa-objects-group" ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a html:Div ;
                      html:class "swa-sub-title" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "label" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      a sp:bound ;
                      sp:arg1 [
                          sp:varName "label" ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  a lmdoc:WhereUsedSubjects ;
                  arg:object [
                      sp:varName "object" ;
                    ] ;
                  arg:predicates [
                      sp:varName "predicates" ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:gt ;
              sp:arg1 [
                  a spr:rowCount ;
                  sp:arg1 [
                      sp:varName "predicates" ;
                    ] ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A group of subject widgets." ;
  rdfs:label "Where used subjects group" ;
  rdfs:subClassOf lmdoc:Subjects ;
.
lmdoc:buildDocFilePath
  a sml:BindBySelect ;
  sm:next lmdoc:SaveSWPdoc ;
  sml:selectQuery [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "docFilePath" ;
          ]
        ) ;
      sp:where (
          [
            a sp:Bind ;
            sp:expression [
                a fn:concat ;
                sp:arg1 "/" ;
                sp:arg2 [
                    a spif:regex ;
                    sp:arg1 [
                        a xsd:string ;
                        sp:arg1 [
                            sp:varName "resource" ;
                          ] ;
                      ] ;
                    sp:arg2 ".*//(.*)" ;
                    sp:arg3 "$1" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "docFilePath" ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:label "build doc file path" ;
.
lmdoc:buildDocURL
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "url" ;
          ]
        ) ;
      sp:where (
          [
            a sp:Bind ;
            sp:expression [
                a fn:substring ;
                sp:arg1 [
                    a sp:str ;
                    sp:arg1 [
                        a afn:now ;
                      ] ;
                  ] ;
                sp:arg2 1 ;
                sp:arg3 7 ;
              ] ;
            sp:variable [
                sp:varName "year" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "owner" ;
              ] ;
            sp:predicate vaem:owner ;
            sp:subject [
                sp:varName "metadata" ;
              ] ;
          ]
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "graphType" ;
              ] ;
            sp:path [
                a sp:SeqPath ;
                sp:path1 vaem:hasGraphRole ;
                sp:path2 vaem:filePrefix ;
              ] ;
            sp:subject [
                sp:varName "metadata" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "subject" ;
              ] ;
            sp:predicate dct:subject ;
            sp:subject [
                sp:varName "metadata" ;
              ] ;
          ]
          [
            a sp:Optional ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "version" ;
                    ] ;
                  sp:predicate vaem:revision ;
                  sp:subject [
                      sp:varName "metadata" ;
                    ] ;
                ]
              ) ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spif:regex ;
                sp:arg1 [
                    a spif:upperCase ;
                    sp:arg1 [
                        sp:varName "subject" ;
                      ] ;
                  ] ;
                sp:arg2 " " ;
                sp:arg3 "-" ;
              ] ;
            sp:variable [
                sp:varName "subjectPart" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a sp:concat ;
                sp:arg1 "http://www." ;
                sp:arg2 [
                    sp:varName "owner" ;
                  ] ;
                sp:arg3 "/doc/" ;
                sp:arg4 [
                    sp:varName "year" ;
                  ] ;
                sp:arg5 "/DOC_" ;
                sp:arg6 [
                    sp:varName "graphType" ;
                  ] ;
                sp:arg7 "-" ;
                sp:arg8 [
                    sp:varName "subjectPart" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "versionlessURL" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a sp:if ;
                sp:arg1 [
                    a sp:bound ;
                    sp:arg1 [
                        sp:varName "version" ;
                      ] ;
                  ] ;
                sp:arg2 [
                    a sp:concat ;
                    sp:arg1 [
                        sp:varName "versionlessURL" ;
                      ] ;
                    sp:arg2 "-v" ;
                    sp:arg3 [
                        sp:varName "version" ;
                      ] ;
                    sp:arg4 ".html" ;
                  ] ;
                sp:arg3 [
                    a sp:concat ;
                    sp:arg1 [
                        sp:varName "versionlessURL" ;
                      ] ;
                    sp:arg2 ".html" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "url" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:metadata ;
      spl:valueType vaem:GraphMetaData ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
  rdfs:label "build doc URL" ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:buildGraphMetadataIdentifiers
  a spin:Template ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "gmdU" ;
          ]
          [
            sp:varName "gmdL" ;
          ]
          [
            sp:varName "name" ;
          ]
          [
            sp:varName "graphRole" ;
          ]
          [
            sp:varName "subject" ;
          ]
          [
            sp:varName "ownerName" ;
          ]
          [
            sp:varName "domainName" ;
          ]
        ) ;
      sp:where (
          [
            a sp:Bind ;
            sp:expression [
                a spif:regex ;
                sp:arg1 [
                    a sp:str ;
                    sp:arg1 [
                        sp:varName "graph" ;
                      ] ;
                  ] ;
                sp:arg2 "^http(s)?://(www\\.)?[A-Z-a-z0-9]+\\.([A-Z-a-z0-9]+)(/([0-9]+\\.[0-9]+))?/([A-Z0-9-a-z]+).*$" ;
                sp:arg3 "$6" ;
                sp:arg4 "none" ;
              ] ;
            sp:variable [
                sp:varName "graphRole" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spif:regex ;
                sp:arg1 [
                    a sp:str ;
                    sp:arg1 [
                        sp:varName "graph" ;
                      ] ;
                  ] ;
                sp:arg2 ".*/([A-Za-z0-9-]+)$" ;
                sp:arg3 "$1" ;
              ] ;
            sp:variable [
                sp:varName "name" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spif:regex ;
                sp:arg1 [
                    a sp:str ;
                    sp:arg1 [
                        sp:varName "graph" ;
                      ] ;
                  ] ;
                sp:arg2 ".*/([A-Za-z0-9-]+)/([A-Za-z0-9-]+)$" ;
                sp:arg3 "$1" ;
              ] ;
            sp:variable [
                sp:varName "subject" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spif:regex ;
                sp:arg1 [
                    a sp:str ;
                    sp:arg1 [
                        sp:varName "graph" ;
                      ] ;
                  ] ;
                sp:arg2 "^http(s)?://(www\\.)?([A-Z-a-z0-9]+\\.[A-Z0-9-a-z]+)/.*$" ;
                sp:arg3 "$3" ;
                sp:arg4 "none" ;
              ] ;
            sp:variable [
                sp:varName "domainName" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spif:regex ;
                sp:arg1 [
                    a sp:str ;
                    sp:arg1 [
                        sp:varName "graph" ;
                      ] ;
                  ] ;
                sp:arg2 "^http(s)?://(www\\.)?([A-Z-a-z0-9]+)\\.([A-Z0-9-a-z]+)/.*$" ;
                sp:arg3 "$3" ;
                sp:arg4 "none" ;
              ] ;
            sp:variable [
                sp:varName "ownerName" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a fn:concat ;
                sp:arg1 [
                    sp:varName "graphRole" ;
                  ] ;
                sp:arg2 "-" ;
                sp:arg3 [
                    sp:varName "subject" ;
                  ] ;
                sp:arg4 "-" ;
                sp:arg5 [
                    sp:varName "name" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "compoundName" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a sp:concat ;
                sp:arg1 "Graph MetaData for '" ;
                sp:arg2 [
                    sp:varName "domainName" ;
                  ] ;
                sp:arg3 " " ;
                sp:arg4 [
                    sp:varName "name" ;
                  ] ;
                sp:arg5 " " ;
                sp:arg6 [
                    sp:varName "graphRole" ;
                  ] ;
                sp:arg7 " " ;
                sp:arg8 [
                    sp:varName "subject" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "gmdL" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a sp:iri ;
                sp:arg1 [
                    a sp:concat ;
                    sp:arg1 "http://www.linkedmodel.org/schema/vaem#GMD_" ;
                    sp:arg2 [
                        a fn:upper-case ;
                        sp:arg1 [
                            sp:varName "ownerName" ;
                          ] ;
                      ] ;
                    sp:arg3 "-" ;
                    sp:arg4 [
                        a fn:upper-case ;
                        sp:arg1 [
                            sp:varName "compoundName" ;
                          ] ;
                      ] ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "gmdU" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The base uri of the graph that is being looked for in the catalog" ;
    ] ;
  rdfs:label "build graph metadata identifiers" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:buildResourceDocLink
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "link" ;
          ]
        ) ;
      sp:where (
          [
            a sp:NamedGraph ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "definingGraph" ;
                    ] ;
                  sp:predicate rdfs:isDefinedBy ;
                  sp:subject [
                      sp:varName "resource" ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a lmdoc:getCatalogDocURL ;
                arg:catalogGraph [
                    sp:varName "catalogGraph" ;
                  ] ;
                lmdoc:graph [
                    sp:varName "definingGraph" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "docURI" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a lmdoc:makeAnchorFromResource ;
                arg:resource [
                    sp:varName "resource" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "anchor" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a fn:concat ;
                sp:arg1 [
                    sp:varName "docURI" ;
                  ] ;
                sp:arg2 "#" ;
                sp:arg3 [
                    sp:varName "anchor" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "link" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:catalogGraph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate lmdoc:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "build resource doc link" ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:citation
  a owl:DatatypeProperty ;
  rdfs:comment "A string that can include html tags." ;
  rdfs:domain rdfs:Resource ;
  rdfs:label "citation" ;
.
lmdoc:countOfInstanceOfType
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:expression [
                a sp:Count ;
                sp:expression [
                    sp:varName "instance" ;
                  ] ;
              ] ;
            sp:varName "count" ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph" ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "instance" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type" ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "instance" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:type ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:integer ;
  rdfs:comment "Returns a count of  instancesof a given type defined in a given graph." ;
  rdfs:label "All instances" ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:createHTMLdocumentForResource
  a sm:Function ;
  spin:constraint [
      a spl:Argument ;
      spl:defaultValue " " ;
      spl:optional true ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
      sm:next lmdoc:CreateHTMLforResource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
      sm:next lmdoc:CreateHTMLforResource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      sm:next lmdoc:CreateHTMLforResource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      sm:next lmdoc:CreateHTMLforResource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:swpElement ;
      spl:valueType ui:NodeClass ;
      sm:next lmdoc:CreateHTMLforResource ;
    ] ;
  sm:returnModule lmdoc:returnFromCreateHTMLforResource ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/sparqlmotion?id=createHTMLdocumentForResource&swpElement=http%3A%2F%2Fwww.linkedmodel.org%2Foui%2Flmdoc%23Instance&graph=http://www.linkedmodel.org/2.0/schema/vaem&resource=http%3A%2F%2Fwww.linkedmodel.org%2Fschema%2Fvaem%23ScriptGraph""" ;
  rdfs:label "create HTML document for resource" ;
  rdfs:subClassOf sm:Functions ;
.
lmdoc:createLinkForMainForm
  a ui:NodeClass ;
  rdfs:subClassOf lmdoc:CreateLinkFunctions ;
.
lmdoc:defaultTitleFunction
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "title" ;
          ]
        ) ;
      sp:where (
          [
            a sp:Bind ;
            sp:expression [
                a sp:coalesce ;
                sp:arg1 [
                    a spl:object ;
                    sp:arg1 [
                        sp:varName "resource" ;
                      ] ;
                    sp:arg2 dct:description ;
                  ] ;
                sp:arg2 [
                    a spl:object ;
                    sp:arg1 [
                        sp:varName "resource" ;
                      ] ;
                    sp:arg2 rdfs:comment ;
                  ] ;
                sp:arg3 [
                    a xsd:string ;
                    sp:arg1 [
                        sp:varName "resource" ;
                      ] ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "title" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:getCatalogDocURL
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "url" ;
          ]
        ) ;
      sp:where (
          [
            a sp:Filter ;
            sp:expression [
                a sp:bound ;
                sp:arg1 [
                    sp:varName "catalogGraph" ;
                  ] ;
              ] ;
          ]
          [
            a sp:NamedGraph ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "graph" ;
                    ] ;
                  sp:predicate lmdoc:catalogedGraph ;
                  sp:subject [
                      sp:varName "rec" ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "url" ;
                    ] ;
                  sp:predicate vaem:latestPublishedVersion ;
                  sp:subject [
                      sp:varName "rec" ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "catalogGraph" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:catalogGraph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The graph resource that holds the catalog" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate lmdoc:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The base uri of the graph that is being looked for in the catalog" ;
    ] ;
  rdfs:label "get catalog doc url" ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:getCatalogRecords
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:orderBy (
          [
            a ui:label ;
            sp:arg1 [
                sp:varName "rec" ;
              ] ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "rec" ;
          ]
          [
            sp:varName "role" ;
          ]
          [
            sp:varName "graphStatus" ;
          ]
          [
            sp:varName "latestPublishedVersion" ;
          ]
          [
            sp:varName "catalogedGraph" ;
          ]
          [
            sp:varName "overlayGraph" ;
          ]
          [
            sp:varName "turtleFile" ;
          ]
        ) ;
      sp:where (
          (
            [
              sp:object [
                  sp:varName "rec" ;
                ] ;
              sp:predicate <http://www.w3.org/ns/dcat#record> ;
              sp:subject [
                  sp:varName "catalog" ;
                ] ;
            ]
            [
              a sp:Bind ;
              sp:expression [
                  a spl:object ;
                  sp:arg1 [
                      sp:varName "catalog" ;
                    ] ;
                  sp:arg2 lmcat:documentationOverlayGraph ;
                ] ;
              sp:variable [
                  sp:varName "overlayGraph" ;
                ] ;
            ]
            [
              a sp:Bind ;
              sp:expression [
                  a spl:object ;
                  sp:arg1 [
                      sp:varName "rec" ;
                    ] ;
                  sp:arg2 vaem:hasGraphRole ;
                ] ;
              sp:variable [
                  sp:varName "role" ;
                ] ;
            ]
            [
              a sp:Filter ;
              sp:expression [
                  a sp:eq ;
                  sp:arg1 [
                      sp:varName "role" ;
                    ] ;
                  sp:arg2 [
                      sp:varName "graphRole" ;
                    ] ;
                ] ;
            ]
          )
          [
            sp:object [
                sp:varName "catalogedGraph" ;
              ] ;
            sp:predicate lmcat:catalogedGraph ;
            sp:subject [
                sp:varName "rec" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a sp:iri ;
                sp:arg1 [
                    sp:varName "catalogedGraph" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "catalogedGraphURI" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spl:objectInGraph ;
                sp:arg1 [
                    sp:varName "catalogedGraphURI" ;
                  ] ;
                sp:arg2 vaem:hasGraphMetadata ;
                sp:arg3 [
                    sp:varName "catalogedGraphURI" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "GMD" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spl:object ;
                sp:arg1 [
                    sp:varName "rec" ;
                  ] ;
                sp:arg2 vaem:turtleFileURL ;
              ] ;
            sp:variable [
                sp:varName "maybeTurtleFile" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a sp:coalesce ;
                sp:arg1 [
                    sp:varName "maybeTurtleFile" ;
                  ] ;
                sp:arg2 [
                    a spl:objectInGraph ;
                    sp:arg1 [
                        sp:varName "GMD" ;
                      ] ;
                    sp:arg2 vaem:turtleFileURL ;
                    sp:arg3 [
                        sp:varName "catalogedGraphURI" ;
                      ] ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "turtleFile" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spl:object ;
                sp:arg1 [
                    sp:varName "rec" ;
                  ] ;
                sp:arg2 vaem:latestPublishedVersion ;
              ] ;
            sp:variable [
                sp:varName "maybeLatestPublishedVersion" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a sp:coalesce ;
                sp:arg1 [
                    sp:varName "maybeLatestPublishedVersion" ;
                  ] ;
                sp:arg2 [
                    a spl:objectInGraph ;
                    sp:arg1 [
                        sp:varName "GMD" ;
                      ] ;
                    sp:arg2 vaem:latestPublishedVersion ;
                    sp:arg3 [
                        sp:varName "catalogedGraphURI" ;
                      ] ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "latestPublishedVersion" ;
              ] ;
          ]
          [
            a sp:Optional ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "graphStatus" ;
                    ] ;
                  sp:predicate lmcat:graphStatus ;
                  sp:subject [
                      sp:varName "rec" ;
                    ] ;
                ]
              ) ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graphRole ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "get catalog records" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:getCitations
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "citation" ;
          ]
        ) ;
      sp:where (
          [
            a sp:TriplePath ;
            sp:object lmdoc:citation ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject [
                sp:varName "property" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "citation" ;
              ] ;
            sp:predicate [
                sp:varName "property" ;
              ] ;
            sp:subject [
                sp:varName "resource" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  rdfs:comment "Gets all citations on a given instance." ;
  rdfs:label "get citations" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:getCurrentYear
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "year" ;
          ]
        ) ;
      sp:where (
          [
            a sp:Bind ;
            sp:expression [
                a fn:substring ;
                sp:arg1 [
                    a sp:str ;
                    sp:arg1 [
                        a afn:now ;
                      ] ;
                  ] ;
                sp:arg2 1 ;
                sp:arg3 4 ;
              ] ;
            sp:variable [
                sp:varName "year" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
  rdfs:label "get current year" ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:getDefiningGraph
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "graph" ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "resource" ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1" ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0" ;
              ] ;
          ]
          [
            sp:object rdfs:isDefinedBy ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?2" ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "graph" ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2" ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "graph" ;
              ] ;
            sp:predicate tops:statementDefinedIn ;
            sp:subject [
                sp:varName "?0" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "get defining graph" ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:getDefinition
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          _:b95165
        ) ;
      sp:where (
          [
            sp:object _:b95165 ;
            sp:predicate vaem:description ;
            sp:subject [
                sp:varName "resource" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:label "get definition" ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:getInstances
  a ui:Service ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraph [
          a sp:iri ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
        ] ;
      ui:child [
          a ui:setContext ;
          ui:child [
              a ui:call ;
              arg:graph [
                  sp:varName "myGraph" ;
                ] ;
              ui:child [
                  a ui:else ;
                  ui:child [
                      a swon:Value ;
                      arg:name "nothing" ;
                      arg:value [
                          a ui:concat ;
                          sp:arg1 "No instances in graph " ;
                          sp:arg2 [
                              sp:varName "myGraph" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a swon:Object ;
                      ui:child [
                          a ui:forEach ;
                          ui:child [
                              a swon:Value ;
                              arg:name "instance" ;
                              arg:value [
                                  sp:varName "instance" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "instances" ;
                            ] ;
                          ui:separator ", " ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      a sp:gt ;
                      sp:arg1 [
                          a spr:rowCount ;
                          sp:arg1 [
                              sp:varName "instances" ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template lmdoc:getInstancesOfType ;
              ui:varName "instances" ;
              vaem:namespacePrefix [
                  a ui:contextValue ;
                  sp:arg1 "namespacePrefix" ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:queryGraph [
              a ui:unionOfGraphs ;
              sp:arg1 [
                  sp:varName "myGraph" ;
                ] ;
              sp:arg2 [
                  a ui:graphWithImports ;
                  sp:arg1 <http://qudt.org/swa/doc> ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:JSON ;
  rdfs:label "Instances section" ;
  rdfs:subClassOf lmdoc:Services ;
.
lmdoc:getInstancesOfType
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:orderBy (
          [
            sp:varName "qName" ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "resource" ;
          ]
          [
            sp:varName "qName" ;
          ]
          [
            sp:varName "uri" ;
          ]
        ) ;
      sp:where (
          (
            [
              sp:object [
                  sp:varName "graph" ;
                ] ;
              sp:predicate rdfs:isDefinedBy ;
              sp:subject [
                  sp:varName "resource" ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "myType" ;
                ] ;
              sp:predicate rdf:type ;
              sp:subject [
                  sp:varName "resource" ;
                ] ;
            ]
            [
              a sp:TriplePath ;
              sp:object owl:Thing ;
              sp:path [
                  a sp:ModPath ;
                  sp:modMax -2 ;
                  sp:modMin 1 ;
                  sp:subPath rdfs:subClassOf ;
                ] ;
              sp:subject [
                  sp:varName "myType" ;
                ] ;
            ]
            [
              a sp:Filter ;
              sp:expression [
                  a sp:notExists ;
                  sp:elements (
                      [
                        sp:object true ;
                        sp:predicate vaem:exclude ;
                        sp:subject [
                            sp:varName "myType" ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ]
          )
          [
            a sp:Bind ;
            sp:expression [
                a xsd:string ;
                sp:arg1 [
                    sp:varName "resource" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a smf:qname ;
                sp:arg1 [
                    sp:varName "resource" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "qName" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  rdfs:comment "Gets all instances defined in a given graph, filtered by matching the namespace of their type with a given type, and orders them by label. Note this may (obviously) not scale if a class has too many instances." ;
  rdfs:label "get instances of type" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:getRestrictedDatatypes
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:orderBy (
          [
            sp:varName "qName" ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "resource" ;
          ]
          [
            sp:varName "qName" ;
          ]
          [
            sp:varName "uri" ;
          ]
        ) ;
      sp:where (
          (
            [
              sp:object [
                  sp:varName "graph" ;
                ] ;
              sp:predicate rdfs:isDefinedBy ;
              sp:subject [
                  sp:varName "resource" ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "myType" ;
                ] ;
              sp:predicate rdf:type ;
              sp:subject [
                  sp:varName "resource" ;
                ] ;
            ]
            [
              a sp:TriplePath ;
              sp:object rdfs:Datatype ;
              sp:path [
                  a sp:ModPath ;
                  sp:modMax -2 ;
                  sp:modMin 0 ;
                  sp:subPath rdfs:subClassOf ;
                ] ;
              sp:subject [
                  sp:varName "myType" ;
                ] ;
            ]
            [
              a sp:Filter ;
              sp:expression [
                  a sp:notExists ;
                  sp:elements (
                      [
                        sp:object true ;
                        sp:predicate vaem:exclude ;
                        sp:subject [
                            sp:varName "myType" ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ]
          )
          [
            a sp:Bind ;
            sp:expression [
                a xsd:string ;
                sp:arg1 [
                    sp:varName "resource" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a smf:qname ;
                sp:arg1 [
                    sp:varName "resource" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "qName" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  rdfs:comment "FILTER (fn:upper-case(?ns) = fn:upper-case(?namespacePrefix)) ." ;
  rdfs:comment "Gets instances of rdfs:Datatype" ;
  rdfs:label "get restricted datatypes" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:getRestrictions
  a spin:MagicProperty ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "p" ;
          ]
          [
            sp:varName "v" ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "r" ;
              ] ;
            sp:predicate owl:withRestrictions ;
            sp:subject spin:_arg1 ;
          ]
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "n" ;
              ] ;
            sp:path [
                a sp:SeqPath ;
                sp:path1 [
                    a sp:ModPath ;
                    sp:modMax -2 ;
                    sp:modMin 0 ;
                    sp:subPath rdf:rest ;
                  ] ;
                sp:path2 rdf:first ;
              ] ;
            sp:subject [
                sp:varName "r" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "v" ;
              ] ;
            sp:predicate [
                sp:varName "p" ;
              ] ;
            sp:subject [
                sp:varName "n" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "get restrictions" ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:getTitle
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          _:b55599
        ) ;
      sp:where (
          [
            sp:object _:b55599 ;
            sp:predicate <http://purl.org/dc/elements/1.1/title> ;
            sp:subject [
                sp:varName "resource" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:label "get title" ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:graph
  a rdf:Property ;
  rdfs:label "graph" ;
.
lmdoc:hasValueForProperty
  a spin:Function ;
  spin:body [
      a sp:Ask ;
      sp:where (
          [
            a sp:TriplePath ;
            sp:object spin:_arg2 ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject [
                sp:varName "property" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "value" ;
              ] ;
            sp:predicate [
                sp:varName "property" ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "the subject that is expected to have the value" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdf:Property ;
      rdfs:comment "the expected property" ;
    ] ;
  spin:returnType xsd:boolean ;
  rdfs:comment "Checks whether a given subject (?arg1) has at least one value for a given property (?arg2), or a sub-property of the given property." ;
  rdfs:label "hasValueOfType" ;
  rdfs:subClassOf spl:BooleanFunctions ;
.
lmdoc:htmlString
  a owl:DatatypeProperty ;
  rdfs:comment "A string that can include html tags." ;
  rdfs:domain rdfs:Resource ;
  rdfs:label "html string" ;
  rdfs:range xsd:string ;
.
lmdoc:inheritanceDepth
  a spin:MagicProperty ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "d" ;
          ]
        ) ;
      sp:where (
          [
            a sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "x" ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject spin:_arg1 ;
                  ]
                  [
                    a sp:Filter ;
                    sp:expression [
                        a sp:ne ;
                        sp:arg1 [
                            sp:varName "x" ;
                          ] ;
                        sp:arg2 spin:_arg2 ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "x" ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?0" ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?1" ;
                      ] ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?0" ;
                      ] ;
                  ]
                  [
                    sp:object spin:_arg2 ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?1" ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?1" ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "inc" ;
                      ] ;
                    sp:predicate lmdoc:inheritanceDepth ;
                    sp:subject [
                        sp:varName "?0" ;
                      ] ;
                  ]
                  [
                    a sp:Bind ;
                    sp:expression [
                        a sp:add ;
                        sp:arg1 [
                            sp:varName "inc" ;
                          ] ;
                        sp:arg2 1 ;
                      ] ;
                    sp:variable [
                        sp:varName "d" ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object spin:_arg2 ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject spin:_arg1 ;
                  ]
                  [
                    a sp:Bind ;
                    sp:expression 1 ;
                    sp:variable [
                        sp:varName "d" ;
                      ] ;
                  ]
                )
                (
                  [
                    a sp:Filter ;
                    sp:expression [
                        a sp:eq ;
                        sp:arg1 spin:_arg1 ;
                        sp:arg2 spin:_arg2 ;
                      ] ;
                  ]
                  [
                    a sp:Bind ;
                    sp:expression 0 ;
                    sp:variable [
                        sp:varName "d" ;
                      ] ;
                  ]
                )
              ) ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "Current subclass" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "Current superclass" ;
    ] ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:labelText
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:resultVariables (
          _:b90604
        ) ;
      sp:where (
          [
            a sp:Union ;
            sp:elements (
                (
                  [
                    sp:object _:b54653 ;
                    sp:predicate rdfs:label ;
                    sp:subject _:b4674 ;
                  ]
                )
                (
                  [
                    sp:object _:b54653 ;
                    sp:predicate skos:prefLabel ;
                    sp:subject _:b4674 ;
                  ]
                )
              ) ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a fn:concat ;
                sp:arg1 " -- " ;
                sp:arg2 _:b54653 ;
              ] ;
            sp:variable _:b90604 ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate tui:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "label text" ;
  rdfs:subClassOf lmdoc:Functions ;
.
