                      ui:child [
                          a html:Input ;
                          html:id "logMessageBox" ;
                          html:onclick "swa.rememberLogMessageBoxStatus()" ;
                          html:style "width: 13px; height: 13px; padding: 0; margin:0; vertical-align: middle; position: relative; top: -1px; *overflow: hidden;" ;
                          html:type "checkbox" ;
