                              ui:childIndex 0 ;
                              ui:text "Properties" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          a ui:else ;
                          ui:child [
                              a html:P ;
                              html:class "lm-para" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "No Properties defined in this graph" ;
