                      html:style [
                          a sp:if ;
                          sp:arg1 [
                              sp:varName "ei" ;
                            ] ;
                          sp:arg2 "visibility: hidden" ;
                          sp:arg3 [
                              sp:varName "none" ;
                            ] ;
                        ] ;
                      ui:child [
                          a html:Input ;
                          html:id [
                              a ui:concat ;
                              sp:arg1 [
                                  sp:varName "fid" ;
                                ] ;
                              sp:arg2 "-provenanceModeBox" ;
                            ] ;
                          html:onclick [
                              a ui:concat ;
                              sp:arg1 "swa.switchToViewForm('" ;
                              sp:arg2 [
                                  sp:varName "fid" ;
                                ] ;
                              sp:arg3 "')" ;
                            ] ;
                          html:style "width: 13px; height: 13px; padding: 0; margin:0; vertical-align: bottom; position: relative; top: -2px; *overflow: hidden;" ;
                          html:type "checkbox" ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text " Show Data Sources" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 10 ;
                  ui:condition [
