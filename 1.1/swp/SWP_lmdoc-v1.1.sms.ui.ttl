lmdoc:Header
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:title ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      a html:Div ;
      html:class "left pad-10" ;
      ui:child [
          a html:Div ;
          html:class "clear-both" ;
          ui:childIndex 3 ;
        ] ;
      ui:child [
          a html:Div ;
          html:class "lm-poweredby-logo" ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          a html:Div ;
          html:class "size-24 lm-indigo lm-bold" ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "title" ;
                ] ;
            ] ;
          ui:childIndex 4 ;
        ] ;
      ui:child [
          a ui:insertionPoint ;
          ui:childIndex 1 ;
          ui:pointId "lmhdr1" ;
        ] ;
      ui:child [
          a ui:insertionPoint ;
          ui:childIndex 2 ;
          ui:pointId "lmhdr2" ;
        ] ;
    ] ;
  rdfs:subClassOf lmdoc:Parts ;
