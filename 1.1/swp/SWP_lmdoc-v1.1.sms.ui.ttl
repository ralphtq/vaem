                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 1 ;
                                  ui:text [
                                      a ui:currentQueryGraph ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                          ui:condition [
                              a fn:contains ;
                              sp:arg1 [
                                  sp:varName "flags" ;
                                ] ;
                              sp:arg2 "Sqg" ;
                            ] ;
                        ] ;
                      ui:child [
                          a lmdoc:GraphHeader ;
                          arg:metadata [
                              sp:varName "myGraphMetadata" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:queryGraph [
                          a ui:unionOfGraphs ;
                          sp:arg1 [
                              sp:varName "myGraph" ;
                            ] ;
                          sp:arg2 [
                              a ui:graphWithImports ;
                              sp:arg1 <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
                            ] ;
                          sp:arg3 [
                              a ui:graphWithImports ;
                              sp:arg1 [
                                  sp:varName "myOverlay" ;
                                ] ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "flags" ;
                  ui:varValue [
                      sp:varName "flags" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Instances List" ;
  rdfs:subClassOf lmdoc:Pages ;
.
