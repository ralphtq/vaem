lmdoc:AllRules
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:orderBy (
          [
            sp:varName "ruleProperty" ;
          ]
          [
            sp:varName "stepText" ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "ruleProperty" ;
          ]
          [
            sp:varName "ruleBody" ;
          ]
          [
            sp:varName "ruleAsText" ;
          ]
          [
            sp:varName "stepText" ;
          ]
          [
            sp:varName "ruleComment" ;
          ]
        ) ;
      sp:where (
          [
            a sp:TriplePath ;
            sp:object spin:rule ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject [
                sp:varName "ruleProperty" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "ruleBody" ;
              ] ;
            sp:predicate [
                sp:varName "ruleProperty" ;
              ] ;
            sp:subject [
                sp:varName "class" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spif:convertSPINRDFToString ;
                sp:arg1 [
                    sp:varName "ruleBody" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "ruleAsText" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a lmdoc:ExtractStepTextFromRule ;
                arg:rule [
                    sp:varName "ruleBody" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "stepText" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a lmdoc:ExtractCommentTextFromRule ;
                arg:rule [
                    sp:varName "ruleBody" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "ruleComment" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  rdfs:comment "Gets all rules defined in a given graph and orders them by step." ;
  rdfs:label "All rules" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AnyURILiteralViewer
  a swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      a swa:WeightedExpression ;
      swa:expression [
          a sp:eq ;
          sp:arg1 [
              sp:varName "type" ;
            ] ;
          sp:arg2 xsd:anyURI ;
        ] ;
      swa:weight 2 ;
    ] ;
  ui:overrides swa:AnyURILiteralViewer ;
  ui:private false ;
  ui:prototype [
      a html:Div ;
      ui:child [
          a ui:else ;
          ui:child [
              a html:A ;
              html:href [
                  a xsd:string ;
                  sp:arg1 [
                      sp:varName "object" ;
                    ] ;
                ] ;
              html:title [
                  sp:varName "title" ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      a xsd:string ;
                      sp:arg1 [
                          sp:varName "object" ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:A ;
              html:href [
                  a xsd:string ;
                  sp:arg1 [
                      sp:varName "object" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "object" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a fn:starts-with ;
              sp:arg1 [
                  sp:varName "object" ;
                ] ;
              sp:arg2 "http" ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The LM Doc viewer for xsd:anyURI values: shows a hyperlink to the URI." ;
  rdfs:label "AnyURI literal viewer" ;
  rdfs:seeAlso swa:AnyURILiteralViewer ;
  rdfs:subClassOf lmdoc:ObjectViewer ;
.
lmdoc:AskTemplates
  a spin:AskTemplate ;
  rdfs:label "Ask templates" ;
  rdfs:subClassOf spin:AskTemplates ;
.
lmdoc:BNodeViewer
  a swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      a swa:WeightedExpression ;
      swa:expression [
          a sp:eq ;
          sp:arg1 [
              sp:varName "kind" ;
            ] ;
          sp:arg2 "blank" ;
        ] ;
    ] ;
  ui:overrides swa:BNodeViewer ;
  ui:private true ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a ui:else ;
          ui:child [
              a html:Div ;
              html:class "swa-shifted-label" ;
              ui:child [
                  a ui:resourceView ;
                  ui:childIndex 0 ;
                  ui:matchIds "label" ;
                  ui:resource [
                      sp:varName "object" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          a ui:elseif ;
          ui:child [
              a html:Div ;
              html:class "swa-shifted-label" ;
              ui:child [
                  a html:Pre ;
                  html:class "swa-source-code-viewer" ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "object" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
          ui:condition [
              a sp:eq ;
              sp:arg1 [
                  sp:varName "predicate" ;
                ] ;
              sp:arg2 ui:instanceView ;
            ] ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a swa:NestedObjectViewer ;
              arg:object [
                  sp:varName "object" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:not ;
              sp:arg1 [
                  a smf:hasLabelsPlugin ;
                  sp:arg1 [
                      sp:varName "object" ;
                    ] ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The default object viewer for blank nodes." ;
  rdfs:label "Blank node viewer (lmdoc)" ;
  rdfs:subClassOf lmdoc:ObjectViewer ;
.
lmdoc:BuildMetadataRecord
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a ui:call ;
          arg:graph [
              sp:varName "graph" ;
            ] ;
          ui:child [
              a ui:group ;
              let:gmdDomainName [
                  a spr:cell ;
                  sp:arg1 [
                      sp:varName "gmdIdentifiers" ;
                    ] ;
                  sp:arg2 0 ;
                  sp:arg3 6 ;
                ] ;
              let:gmdGraphRole [
                  a spr:cell ;
                  sp:arg1 [
                      sp:varName "gmdIdentifiers" ;
                    ] ;
                  sp:arg2 0 ;
                  sp:arg3 3 ;
                ] ;
              let:gmdLabel [
                  a spr:cell ;
                  sp:arg1 [
                      sp:varName "gmdIdentifiers" ;
                    ] ;
                  sp:arg2 0 ;
                  sp:arg3 1 ;
                ] ;
              let:gmdName [
                  a spr:cell ;
                  sp:arg1 [
                      sp:varName "gmdIdentifiers" ;
                    ] ;
                  sp:arg2 0 ;
                  sp:arg3 2 ;
                ] ;
              let:gmdOwnerName [
                  a spr:cell ;
                  sp:arg1 [
                      sp:varName "gmdIdentifiers" ;
                    ] ;
                  sp:arg2 0 ;
                  sp:arg3 5 ;
                ] ;
              let:gmdSubject [
                  a spr:cell ;
                  sp:arg1 [
                      sp:varName "gmdIdentifiers" ;
                    ] ;
                  sp:arg2 0 ;
                  sp:arg3 4 ;
                ] ;
              let:gmdU [
                  a spr:cell ;
                  sp:arg1 [
                      sp:varName "gmdIdentifiers" ;
                    ] ;
                  sp:arg2 0 ;
                  sp:arg3 0 ;
                ] ;
              ui:child [
                  a html:P ;
                  html:class "lm-para" ;
                  ui:child [
                      a html:Span ;
                      html:class "boxed" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "gmdDomainName" ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Domain Name is " ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  a html:P ;
                  html:class "lm-para" ;
                  ui:child [
                      a html:Span ;
                      html:class "boxed" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "gmdGraphRole" ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Graph role is " ;
                    ] ;
                  ui:childIndex 5 ;
                ] ;
              ui:child [
                  a html:P ;
                  html:class "lm-para" ;
                  ui:child [
                      a html:Span ;
                      html:class "boxed" ;
