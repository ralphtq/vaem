                          a ui:else ;
                          ui:child [
                              a html:A ;
                              html:href [
                                  a sp:str ;
                                  sp:arg1 [
                                      sp:varName "resource" ;
                                    ] ;
                                ] ;
                              html:target "lm-reference-link-page" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      a smf:qname ;
                                      sp:arg1 [
                                          sp:varName "resource" ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          a ui:if ;
                          ui:child [
                              a ui:else ;
                              ui:child [
                                  a html:Div ;
                                  html:class "float-left pl10px" ;
                                  ui:child [
                                      a ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          sp:varName "label" ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  a html:Div ;
                                  html:class "float-left" ;
                                  ui:child [
                                      a html:A ;
                                      html:class "lm-simulated-link" ;
                                      html:onclick [
                                          a ui:concat ;
                                          sp:arg1 "lm.popupResourceSummary('div-" ;
                                          sp:arg2 [
                                              a lmdoc:makeAnchorFromResource ;
                                              arg:resource [
                                                  sp:varName "resource" ;
                                                ] ;
                                            ] ;
                                          sp:arg3 "',800,500)" ;
                                        ] ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              a smf:qname ;
                                              sp:arg1 [
                                                  sp:varName "resource" ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              a ui:if ;
                              ui:child [
                                  a html:Div ;
                                  html:class "float-left pl10px" ;
                                  ui:child [
                                      a ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          sp:varName "label" ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  a html:Div ;
                                  html:class "float-left" ;
                                  ui:child [
                                      a html:A ;
                                      html:href [
                                          a ui:concat ;
                                          sp:arg1 "#" ;
                                          sp:arg2 [
                                              a lmdoc:makeAnchorFromResource ;
                                              arg:resource [
                                                  sp:varName "resource" ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      html:title [
                                          sp:varName "title" ;
                                        ] ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              a smf:qname ;
                                              sp:arg1 [
                                                  sp:varName "resource" ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:condition [
                                  sp:varName "singlePage" ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:condition [
                              a lmdoc:IsDefinedInGraph ;
                              arg:graph [
                                  sp:varName "myGraph" ;
                                ] ;
                              arg:resource [
                                  sp:varName "resource" ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a ui:if ;
                      ui:child [
                          a html:A ;
                          html:href [
                              a sp:str ;
                              sp:arg1 [
                                  sp:varName "resource" ;
                                ] ;
                            ] ;
                          html:target "lm-reference-link-page" ;
                          ui:child [
                              a ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  a sp:str ;
                                  sp:arg1 [
                                      sp:varName "resource" ;
                                    ] ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          a sp:not ;
                          sp:arg1 [
                              a sp:bound ;
