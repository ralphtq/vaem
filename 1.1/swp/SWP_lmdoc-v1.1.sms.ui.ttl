              ui:child [
                  a ui:call ;
                  arg:class [
                      sp:varName "class" ;
                    ] ;
                  ui:child [
                      a ui:if ;
                      ui:child [
                          a html:Div ;
                          html:class "swa-sub-title" ;
                          ui:child [
                              a ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Rules" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          a ui:forEach ;
                          ui:child [
                              a html:P ;
                              html:class "lm-para" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      sp:varName "commentText" ;
                                    ] ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              a html:P ;
                              html:class "lm-para, dashedbox" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      a ui:encodeNode ;
                                      sp:arg1 [
                                          sp:varName "ruleProperty" ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 1 ;
                                  ui:text " - " ;
                                ] ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 2 ;
                                  ui:text [
                                      sp:varName "stepText" ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              a html:Pre ;
                              html:class "spinrule" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      a lmdoc:numberLines ;
                                      sp:arg1 [
                                          sp:varName "ruleAsText" ;
                                        ] ;
                                      sp:arg2 0 ;
                                      sp:arg3 999 ;
                                      sp:arg4 0 ;
                                      sp:arg5 80 ;
                                      sp:arg6 false ;
                                    ] ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:childIndex 1 ;
                          ui:resultSet [
                              sp:varName "rules" ;
                            ] ;
                        ] ;
                      ui:child [
                          a lmdoc:VSpace ;
                          arg:margin "20px;" ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          a sp:gt ;
                          sp:arg1 [
                              a spr:rowCount ;
                              sp:arg1 [
                                  sp:varName "rules" ;
                                ] ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:template lmdoc:AllRules ;
                  ui:varName "rules" ;
                ] ;
              ui:childIndex 7 ;
              ui:condition [
                  sp:varName "showRules" ;
                ] ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a lmdoc:ClassInstances ;
                  arg:class [
                      sp:varName "class" ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a lmdoc:VSpace ;
                  arg:margin "40px;" ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 11 ;
              ui:condition [
                  sp:varName "showInstances" ;
                ] ;
            ] ;
          ui:child [
              a lmdoc:MaybeDescription ;
              arg:resource [
                  sp:varName "class" ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              a lmdoc:ResourceFooter ;
              arg:options "JSON-LD,TURTLE" ;
              arg:resource [
                  sp:varName "class" ;
                ] ;
              ui:childIndex 13 ;
            ] ;
          ui:child [
              a lmdoc:VSpace ;
              arg:margin "30px;" ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a lmdoc:VSpace ;
              arg:margin "30px;" ;
              ui:childIndex 4 ;
            ] ;
          ui:child [
              a lmdoc:VSpace ;
              arg:margin "40px;" ;
              ui:childIndex 12 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:varName "createLinkFunction" ;
      ui:varValue lmdoc:createLinkForMainForm ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment """<div class=\"lm-resource-box\">
        <ui:if ui:condition=\"{= ?showTitle }\">
            <div class=\"lm-header-box\">
                <lmdoc:ResourceDocAnchor arg:node=\"{= ?class }\" arg:typeLabel=\"Class \"/>
            </div>""" ;
  rdfs:label "Detailed Class View" ;
  rdfs:subClassOf lmdoc:Parts ;
  rdfs:subClassOf lmdoc:Viewers ;
.
lmdoc:DetailedInstanceView
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:setContext ;
      ui:child [
          a html:Div ;
          html:class "tuiView" ;
          let:top "lmdoc-top-detailed-instance-view" ;
          ui:child [
              a html:A ;
              html:id [
                  sp:varName "top" ;
                ] ;
              ui:child [
                  a html:H2 ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          a ui:label ;
                          sp:arg1 [
                              sp:varName "resource" ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              a html:Div ;
              html:class "ies_resource_summary" ;
              ui:child [
                  a html:P ;
                  html:class "size-12" ;
                  ui:child [
                      a html:Span ;
                      html:class "boxed" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              a sp:str ;
                              sp:arg1 [
                                  sp:varName "resource" ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "URI is " ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  a html:P ;
                  html:class "size-12" ;
                  ui:child [
                      a html:Span ;
                      html:class "boxed" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              a smf:qname ;
                              sp:arg1 [
                                  sp:varName "resource" ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "QName is " ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a ui:CommentNode ;
                  ui:childIndex 6 ;
                  rdfs:comment """ui:call arg:object=\"{= ?resource }\"
ui:template=\"{= swa:modeProperty(swa:formSubjectPredicateSelectionTemplate) }\">
<swa:SubjectsGroup arg:label=\"Incoming References\" arg:object=\"{= ?resource }\" arg:predicates=\"{= ?rs }\"/>
</ui:call""" ;
                ] ;
              ui:child [
                  a ui:call ;
                  arg:subject [
                      sp:varName "resource" ;
                    ] ;
                  ui:child [
                      a ui:debug ;
                      ui:child [
                          a ui:dumpResultSet ;
                          ui:childIndex 0 ;
                          ui:message "lmdoc:DetailedInstanceView" ;
                          ui:resultSet [
                              sp:varName "rs" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      a lmdoc:ObjectsGroup ;
                      arg:filterFunction swa:isAnnotationProperty ;
                      arg:label "Annotations" ;
                      arg:predicates [
                          sp:varName "rs" ;
                        ] ;
                      arg:subject [
                          sp:varName "resource" ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a lmdoc:ObjectsGroup ;
                      arg:filterFunction swa:isDatatypeAxiomProperty ;
                      arg:label "Restricted Datatypes" ;
                      arg:predicates [
                          sp:varName "rs" ;
                        ] ;
                      arg:subject [
                          sp:varName "resource" ;
                        ] ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      a lmdoc:ObjectsGroup ;
                      arg:filterFunction swa:isNonAnnotationProperty ;
                      arg:label "Properties" ;
                      arg:predicates [
                          sp:varName "rs" ;
                        ] ;
                      arg:subject [
                          sp:varName "resource" ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:childIndex 3 ;
                  ui:template [
                      a swa:modeProperty ;
                      arg:predicate swa:formObjectPredicateSelectionTemplate ;
                    ] ;
                ] ;
              ui:child [
                  a lmdoc:MaybeDescription ;
                  arg:resource [
                      sp:varName "resource" ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  a lmdoc:ResourceFooter ;
                  arg:options "JSON, JSON-LD,RDF/XML,TURTLE" ;
                  arg:resource [
                      sp:varName "resource" ;
                    ] ;
                  arg:topElement [
                      sp:varName "top" ;
                    ] ;
                  ui:childIndex 5 ;
                ] ;
              ui:child [
                  a lmdoc:VSpace ;
                  arg:margin "40px;" ;
                  ui:childIndex 4 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          a lmdoc:Footer ;
          ui:childIndex 1 ;
        ] ;
      ui:varName "createLinkFunction" ;
      ui:varValue lmdoc:createLinkForMainForm ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Detailed Instance View" ;
  rdfs:subClassOf lmdoc:Parts ;
  rdfs:subClassOf lmdoc:Viewers ;
.
lmdoc:DocumentReferences
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:Div ;
              html:class "swa-sub-title" ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "References" ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a html:Div ;
              ui:child [
                  a ui:call ;
                  arg:resource [
                      sp:varName "resource" ;
                    ] ;
                  ui:child [
                      a ui:forEach ;
                      ui:child [
                          a lmdoc:LiteralViewerWithLabel ;
                          arg:label [
                              a ui:concat ;
                              sp:arg1 [
                                  a sp:str ;
                                  sp:arg1 [
                                      a sp:add ;
                                      sp:arg1 [
                                          sp:varName "index" ;
                                        ] ;
                                      sp:arg2 1 ;
                                    ] ;
                                ] ;
                              sp:arg2 ": " ;
                            ] ;
                          arg:object [
                              sp:varName "citation" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:indexVar "index" ;
                      ui:resultSet [
                          sp:varName "citations" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:template lmdoc:getCitations ;
                  ui:varName "citations" ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              a html:Div ;
              ui:child [
                  a lmdoc:Object ;
                  arg:hideProperty true ;
                  arg:predicate prov:wasInfluencedBy ;
                  arg:subject [
                      sp:varName "resource" ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              a lmdoc:VSpace ;
              arg:margin "20px;" ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:or ;
              sp:arg1 [
                  a lmdoc:hasValueForProperty ;
                  sp:arg1 [
                      sp:varName "resource" ;
                    ] ;
                  sp:arg2 prov:wasInfluencedBy ;
                ] ;
              sp:arg2 [
                  a lmdoc:hasValueForProperty ;
                  sp:arg1 [
                      sp:varName "resource" ;
                    ] ;
                  sp:arg2 lmdoc:citation ;
                ] ;
            ] ;
        ] ;
      ui:child [
          a lmdoc:VSpace ;
          arg:margin "100px;" ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Document References" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:Elements
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:abstract true ;
  ui:responseType ui:HTML ;
  rdfs:label "Elements" ;
  rdfs:subClassOf ui:ViewElements ;
.
lmdoc:ExtractCommentTextFromRule
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "commentText" ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "comment" ;
              ] ;
            sp:predicate rdfs:comment ;
            sp:subject [
                sp:varName "rule" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spif:regex ;
                sp:arg1 [
                    sp:varName "comment" ;
                  ] ;
                sp:arg2 "^(STEP [A-Z]+-[A-Z]+-[0-9]+).*\\n(.*)" ;
                sp:arg3 "$2" ;
              ] ;
            sp:variable [
                sp:varName "commentText" ;
              ] ;
          ]
          [
            a sp:Filter ;
            sp:expression [
                a sp:not ;
                sp:arg1 [
                    a fn:starts-with ;
                    sp:arg1 [
                        sp:varName "commentText" ;
                      ] ;
                    sp:arg2 "STEP" ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:rule ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:label "Extract comment text from rule" ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:ExtractStepTextFromRule
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "stepText" ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "comment" ;
              ] ;
            sp:predicate rdfs:comment ;
            sp:subject [
                sp:varName "rule" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spif:regex ;
                sp:arg1 [
                    sp:varName "comment" ;
                  ] ;
                sp:arg2 "^(.*)$" ;
                sp:arg3 "$1" ;
              ] ;
            sp:variable [
                sp:varName "stepText" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:rule ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:label "Extract Step text from rule" ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:Factories
  a ui:NodeClass ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:Footer
  a ui:NodeClass ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a html:Div ;
          html:class "size-10" ;
          ui:child [
              a html:A ;
              html:href "http://www.topquadrant.com/technology/sparql-web-pages-swp/" ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "TopBraid SPARQL Web Pages (SWP)" ;
                ] ;
              ui:childIndex 7 ;
            ] ;
          ui:child [
              a html:Em ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "lmdoc" ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "Page generated " ;
            ] ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 1 ;
              ui:text [
                  a afn:now ;
                ] ;
            ] ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 2 ;
              ui:text " by" ;
            ] ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 4 ;
              ui:text "version " ;
            ] ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 5 ;
              ui:text [
                  a spl:object ;
                  sp:arg1 lmdoc:GMD_LMDOC ;
                  sp:arg2 vaem:revision ;
                ] ;
            ] ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 6 ;
              ui:text " with " ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a html:Hr ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Footer" ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:Form
  a swa:FormClass ;
  ui:abstract true ;
  rdfs:comment "Base class for the various types of forms, depending on the mode." ;
  rdfs:label "Form (lmdoc)" ;
  rdfs:subClassOf lmdoc:FormElements ;
.
lmdoc:FormElements
  a ui:NodeClass ;
  ui:abstract true ;
  ui:private true ;
  rdfs:comment "Abstract superclass to group together form related LMDOC elements." ;
  rdfs:label "Form elements (lmdoc)" ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:Functions
  a spin:Function ;
  rdfs:label "Functions" ;
  rdfs:subClassOf spin:Functions ;
.
lmdoc:GMD_LMDOC
  a vaem:GraphMetaData ;
  dct:modified "2015-12-22"^^xsd:date ;
  vaem:hasOwner vaem:TopQuadrant ;
  vaem:name "LMDOC" ;
  vaem:namespacePrefix "lmdoc" ;
  vaem:revision "1.1" ;
.
lmdoc:Graph
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:defaultValue true ;
      spl:optional false ;
      spl:predicate arg:singlePage ;
      spl:valueType xsd:boolean ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate vaem:latestPublishedVersion ;
      spl:valueType xsd:anyURI ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate vaem:turtleFileURL ;
      spl:valueType xsd:anyURI ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:errorPrototype [
      a ui:group ;
      ui:child [
          a ui:else ;
          ui:child [
              a ui:group ;
              let:inputGraph [
                  a sp:iri ;
                  sp:arg1 [
                      sp:varName "graph" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:group ;
                  let:myGraph [
                      a sp:Select ;
                      sp:resultVariables (
                          [
                            sp:varName "g" ;
                          ]
                        ) ;
                      sp:where (
                          [
                            a sp:Bind ;
                            sp:expression [
                                a spl:objectInGraph ;
                                sp:arg1 [
                                    sp:varName "gmd" ;
                                  ] ;
                                sp:arg2 vaem:isMetadataFor ;
                                sp:arg3 [
                                    sp:varName "inputGraph" ;
                                  ] ;
                              ] ;
                            sp:variable [
                                sp:varName "g" ;
                              ] ;
                          ]
                        ) ;
                    ] ;
                  ui:child [
                      a ui:if ;
                      ui:child [
                          a html:P ;
                          html:class "lm-para" ;
                          ui:child [
                              a ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "No Graph Metadata record provided in " ;
                            ] ;
                          ui:child [
                              a ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text [
                                  sp:varName "inputGraph" ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          a sp:not ;
                          sp:arg1 [
                              a sp:bound ;
                              sp:arg1 [
                                  sp:varName "myGraph" ;
                                ] ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:P ;
              html:class "lm-para" ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "No Graph URI provided" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:not ;
              sp:arg1 [
                  a sp:bound ;
                  sp:arg1 [
                      sp:varName "graph" ;
                    ] ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraph [
          a sp:iri ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
        ] ;
      ui:child [
          a ui:catch ;
          ui:child [
              a html:P ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Exception in lmdoc:Graph:" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              a html:P ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "exception" ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          a ui:dumpScope ;
          ui:childIndex 0 ;
          ui:message "DEBUG1: lmdoc:Graph" ;
        ] ;
      ui:child [
          a ui:try ;
          ui:child [
              a html:Div ;
              html:id "content_container" ;
              ui:child [
                  a ui:group ;
                  ui:child [
                      a ui:group ;
                      let:myGraphMetadata [
                          a spl:objectInGraph ;
                          sp:arg1 [
                              sp:varName "myGraph" ;
                            ] ;
                          sp:arg2 vaem:hasGraphMetadata ;
                          sp:arg3 [
                              sp:varName "myGraph" ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:dumpScope ;
                          ui:childIndex 1 ;
                          ui:message [
                              a ui:concat ;
                              sp:arg1 "DEBUG2: lmdoc:Graph - input graph " ;
                              sp:arg2 [
                                  sp:varName "myGraph" ;
                                ] ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:if ;
                          ui:child [
                              a ui:throw ;
                              ui:childIndex 0 ;
                              ui:message [
                                  a ui:concat ;
                                  sp:arg1 "No graph metadata instance for " ;
                                  sp:arg2 [
                                      sp:varName "myGraph" ;
                                    ] ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:condition [
                              a sp:not ;
                              sp:arg1 [
                                  a sp:bound ;
                                  sp:arg1 [
                                      sp:varName "myGraphMetadata" ;
                                    ] ;
                                ] ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:setContext ;
                          ui:child [
                              a ui:setContext ;
                              ui:child [
                                  a ui:setContext ;
                                  ui:child [
                                      a ui:group ;
                                      let:myOverlay [
                                          a sp:iri ;
                                          sp:arg1 [
                                              a sp:coalesce ;
                                              sp:arg1 [
                                                  sp:varName "overlay" ;
                                                ] ;
                                              sp:arg2 ui:tempGraph ;
                                            ] ;
                                        ] ;
                                      ui:child [
                                          a ui:setContext ;
                                          ui:child [
                                              a ui:group ;
