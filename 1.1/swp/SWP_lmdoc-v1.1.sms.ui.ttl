                              [
                                a sp:Bind ;
                                sp:expression "http://www.linkedmodel.org/lib/lm/images/logos/qudt_logo-300x110.png" ;
                                sp:variable [
                                    sp:varName "logo" ;
                                  ] ;
                              ]
                              [
                                a sp:Bind ;
                                sp:expression "The QUDT Ontologies are issued under a Creative Commons Attribution Share Alike 3.0 United States License. Attribution should be made to NASA Ames Research Center, TopQuadrant, Inc. and QUDT.org." ;
                                sp:variable [
                                    sp:varName "rights" ;
                                  ] ;
                              ]
                              [
                                a sp:Bind ;
                                sp:expression [
                                    a sp:concat ;
                                    sp:arg1 "http://" ;
                                    sp:arg2 [
                                        sp:varName "gmdDomainName" ;
                                      ] ;
                                    sp:arg3 "/" ;
                                  ] ;
                                sp:variable [
                                    sp:varName "authorityPart" ;
                                  ] ;
                              ]
                              [
                                a sp:Bind ;
                                sp:expression [
                                    a sp:concat ;
                                    sp:arg1 [
                                        sp:varName "authorityPart" ;
                                      ] ;
                                    sp:arg2 [
                                        sp:varName "gmdGraphRole" ;
                                      ] ;
                                    sp:arg3 "/" ;
                                    sp:arg4 [
                                        sp:varName "gmdSubject" ;
                                      ] ;
                                    sp:arg5 "/" ;
                                  ] ;
                                sp:variable [
                                    sp:varName "nameSpacePrefix" ;
                                  ] ;
                              ]
                              [
                                a sp:Bind ;
                                sp:expression [
                                    a sp:concat ;
                                    sp:arg1 [
                                        a fn:upper-case ;
                                        sp:arg1 [
                                            sp:varName "gmdOwnerName" ;
                                          ] ;
                                      ] ;
                                    sp:arg2 "-" ;
                                    sp:arg3 [
                                        a fn:upper-case ;
                                        sp:arg1 [
                                            sp:varName "gmdSubject" ;
                                          ] ;
                                      ] ;
                                    sp:arg4 "-" ;
                                    sp:arg5 [
                                        a fn:upper-case ;
                                        sp:arg1 [
                                            sp:varName "gmdName" ;
                                          ] ;
                                      ] ;
                                  ] ;
                                sp:variable [
                                    sp:varName "descriptor" ;
                                  ] ;
                              ]
                              [
                                a sp:Bind ;
                                sp:expression [
                                    a sp:concat ;
                                    sp:arg1 [
                                        sp:varName "authorityPart" ;
                                      ] ;
                                    sp:arg2 "doc/2017/DOC_" ;
                                    sp:arg3 [
                                        a fn:upper-case ;
                                        sp:arg1 [
                                            sp:varName "gmdGraphRole" ;
                                          ] ;
                                      ] ;
                                    sp:arg4 "-" ;
                                    sp:arg5 [
                                        sp:varName "descriptor" ;
                                      ] ;
                                    sp:arg6 ".html" ;
                                  ] ;
                                sp:variable [
                                    sp:varName "docFile" ;
                                  ] ;
                              ]
                              [
                                a sp:Bind ;
                                sp:expression [
                                    a sp:concat ;
                                    sp:arg1 [
                                        sp:varName "authorityPart" ;
                                      ] ;
                                    sp:arg2 "2.0/" ;
                                    sp:arg3 [
                                        sp:varName "gmdGraphRole" ;
                                      ] ;
                                    sp:arg4 "/" ;
                                    sp:arg5 [
                                        sp:varName "descriptor" ;
                                      ] ;
                                    sp:arg6 "-v2.0.ttl" ;
                                  ] ;
                                sp:variable [
                                    sp:varName "turtleFile" ;
                                  ] ;
                              ]
                            ) ;
                        ] ;
                    ] ;
                  ui:childIndex 7 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:buildGraphMetadataIdentifiers ;
          ui:varName "gmdIdentifiers" ;
        ] ;
    ] ;
  rdfs:subClassOf lmdoc:Factories ;
.
lmdoc:CatalogManager
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  ui:errorPrototype [
      a ui:group ;
      let:myGraph [
          a sp:iri ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "No graph given" ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:not ;
              sp:arg1 [
                  a sp:bound ;
                  sp:arg1 [
                      sp:varName "myGraph" ;
                    ] ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:catalogGraph [
          a sp:iri ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
        ] ;
      ui:child [
          a ui:setContext ;
          ui:child [
              a html:Div ;
              html:id "content_container" ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a ui:group ;
              let:myCatalog [
                  a spl:subject ;
                  sp:arg1 rdf:type ;
                  sp:arg2 lmcat:Catalog ;
                ] ;
              ui:child [
                  a ui:setContext ;
                  ui:child [
                      a html:Div ;
                      html:class "lm-container" ;
                      ui:child [
                          a html:A ;
                          html:id "schemas" ;
                          ui:child [
                              a html:H3 ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Schemas" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          a html:A ;
                          html:id "vocabs" ;
                          ui:child [
                              a html:H3 ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Vocabulary Graphs" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 4 ;
                        ] ;
                      ui:child [
                          a html:Div ;
                          html:style "clear: both;" ;
                          ui:child [
                              a html:Ol ;
                              ui:child [
                                  a html:Li ;
                                  ui:child [
                                      a html:A ;
                                      html:href "#schemas" ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "Schemas" ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:child [
                                  a html:Li ;
                                  ui:child [
                                      a html:A ;
                                      html:href "#vocabs" ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "Vocabularies (instance graphs)" ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              a html:P ;
                              html:class "lm-para" ;
                              ui:child [
                                  a html:Em ;
                                  ui:child [
                                      a ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Linked Model Catalog Maintainer" ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "The " ;
                                ] ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 2 ;
                                  ui:text " is a quality assurance and publishing tool for ontology graphs" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              a html:P ;
                              html:class "lm-para" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Catalog content is organized in the following sections:" ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          a html:H2 ;
                          html:class "size-12" ;
                          ui:child [
                              a ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Catalog URI= " ;
                            ] ;
                          ui:child [
                              a ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text [
                                  sp:varName "myCatalog" ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          a ui:call ;
                          arg:graphRole vaem:SchemaGraph ;
                          ui:child [
                              a lmdoc:CatalogTable ;
                              arg:catalogGraph [
                                  sp:varName "catalogGraph" ;
                                ] ;
                              arg:overlay [
                                  sp:varName "overlay" ;
                                ] ;
                              arg:resultSet [
                                  sp:varName "records" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 3 ;
                          ui:template lmdoc:getCatalogRecords ;
                          ui:varName "records" ;
                        ] ;
                      ui:child [
                          a ui:call ;
                          arg:graphRole vaem:VocabularyGraph ;
                          ui:child [
                              a lmdoc:CatalogTable ;
                              arg:catalogGraph [
                                  sp:varName "catalogGraph" ;
                                ] ;
                              arg:overlay [
                                  sp:varName "overlay" ;
                                ] ;
                              arg:resultSet [
                                  sp:varName "records" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 5 ;
                          ui:template lmdoc:getCatalogRecords ;
                          ui:varName "records" ;
                        ] ;
                      ui:child [
                          a lmdoc:Footer ;
                          ui:childIndex 6 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "catalog" ;
                  ui:varValue [
                      sp:varName "myCatalog" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
          ui:queryGraph [
              a ui:graphWithImports ;
              sp:arg1 [
                  sp:varName "catalogGraph" ;
                ] ;
            ] ;
        ] ;
      ui:child [
          a lmdoc:Header ;
          arg:title "LinkedModel Catalog Maintainer" ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=lmdoc:CatalogManager&graph=http://www.qudt.org/2.0/catalog""" ;
  rdfs:label "Catalog Manager" ;
  rdfs:subClassOf lmdoc:Pages ;
.
lmdoc:CatalogTable
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:catalogGraph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resultSet ;
      spl:valueType sp:Select ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a ui:try ;
          ui:child [
              a ui:if ;
              ui:child [
                  a html:Table ;
                  html:class "table table-responsive" ;
                  ui:child [
                      a html:Tbody ;
                      ui:child [
                          a ui:forEach ;
                          ui:child [
                              a html:Tr ;
                              html:class "lm-row" ;
                              ui:child [
                                  a html:Td ;
                                  ui:child [
                                      a swa:Space ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:child [
                                      a html:Button ;
                                      html:class "lm-button size-4" ;
                                      html:onclick "alert('Constraint Checking...')" ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "Run" ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      a html:Button ;
                                      html:class "lm-button size-4" ;
                                      html:onclick "alert('Showing results ...')" ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "Results" ;
                                        ] ;
                                      ui:childIndex 2 ;
                                    ] ;
                                  ui:childIndex 5 ;
                                ] ;
                              ui:child [
                                  a html:Td ;
                                  ui:child [
                                      a ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          a sp:add ;
                                          sp:arg1 [
                                              sp:varName "index" ;
                                            ] ;
                                          sp:arg2 1 ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:child [
                                  a html:Td ;
                                  ui:child [
                                      a ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          a ui:label ;
                                          sp:arg1 [
                                              a spl:object ;
                                              sp:arg1 [
                                                  sp:varName "rec" ;
                                                ] ;
                                              sp:arg2 lmcat:graphStatus ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 4 ;
                                ] ;
                              ui:child [
                                  a html:Td ;
                                  ui:child [
                                      a ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          a ui:label ;
                                          sp:arg1 [
                                              sp:varName "rec" ;
                                            ] ;
                                        ] ;
