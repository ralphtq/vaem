            ] ;
          ui:child [
              a html:P ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "exception" ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:try ;
          ui:child [
              a ui:bind ;
              ui:child [
                  a ui:group ;
                  let:docFilePath [
                      a fn:concat ;
                      sp:arg1 "/" ;
                      sp:arg2 [
                          a spif:regex ;
                          sp:arg1 [
                              a xsd:string ;
                              sp:arg1 [
                                  sp:varName "resource" ;
                                ] ;
                            ] ;
                          sp:arg2 ".*//(.*)" ;
                          sp:arg3 "$1" ;
                        ] ;
                    ] ;
                  ui:child [
                      a sml:ExportToTextFile ;
                      sml:replace true ;
                      sml:targetFilePath [
                          sp:varName "docFilePath" ;
                        ] ;
                      sml:text [
                          sp:varName "html" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a ui:stringify ;
                  ui:child [
                      a ui:else ;
                      ui:child [
                          a ui:throw ;
                          ui:childIndex 0 ;
                          ui:message [
                              a ui:concat ;
                              sp:arg1 "Unsupported type - can't process swp element " ;
                              sp:arg2 [
                                  sp:varName "swpElement" ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      a ui:elseif ;
                      ui:child [
                          a lmdoc:Class ;
                          arg:flags [
                              sp:varName "flags" ;
                            ] ;
                          arg:graph [
                              sp:varName "graph" ;
                            ] ;
                          arg:overlay [
                              sp:varName "overlay" ;
                            ] ;
                          arg:resource [
                              sp:varName "resource" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                      ui:condition [
                          a fn:contains ;
                          sp:arg1 [
                              a fn:lower-case ;
                              sp:arg1 [
                                  a sp:str ;
                                  sp:arg1 [
                                      sp:varName "swpElement" ;
                                    ] ;
                                ] ;
                            ] ;
                          sp:arg2 "class" ;
                        ] ;
                    ] ;
                  ui:child [
                      a ui:if ;
                      ui:child [
                          a lmdoc:Instance ;
                          arg:flags [
                              sp:varName "flags" ;
                            ] ;
                          arg:graph [
                              sp:varName "graph" ;
                            ] ;
                          arg:overlay [
                              sp:varName "overlay" ;
                            ] ;
                          arg:resource [
                              sp:varName "resource" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          a fn:contains ;
                          sp:arg1 [
                              a fn:lower-case ;
                              sp:arg1 [
                                  a sp:str ;
                                  sp:arg1 [
                                      sp:varName "swpElement" ;
                                    ] ;
                                ] ;
                            ] ;
                          sp:arg2 "instance" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:full true ;
                  ui:varName "html" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:TEXT ;
