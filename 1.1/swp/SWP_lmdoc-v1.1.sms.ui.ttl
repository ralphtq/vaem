                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "The index section looks over the graph in focus for resources that carry an \"rdfs:isDefinedBy' statement for the smae graph. For instances a further check is made to only include those instances whose type resides in the namespace defined by the \"vaem:name\" property in the grpah's metadata record." ;
  rdfs:label "Index section" ;
  rdfs:subClassOf lmdoc:Sections ;
.
