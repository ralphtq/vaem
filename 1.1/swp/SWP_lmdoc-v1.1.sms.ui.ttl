                              arg:resultSet [
                                  sp:varName "instances" ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 1 ;
                          ui:condition [
                              a sp:gt ;
                              sp:arg1 [
                                  sp:varName "count" ;
                                ] ;
                              sp:arg2 0 ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 7 ;
                  ui:template lmdoc:getInstancesOfType ;
                  ui:varName "instances" ;
                ] ;
              ui:child [
                  a ui:call ;
                  arg:graph [
                      sp:varName "graph" ;
                    ] ;
                  ui:child [
                      a ui:group ;
                      let:count [
                          a spr:rowCount ;
                          sp:arg1 [
                              sp:varName "instances" ;
                            ] ;
                        ] ;
                      ui:child [
                          a html:H3 ;
                          html:id "RestrictedDatatypes" ;
                          ui:child [
                              a ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Restricted Datatypes" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          a ui:else ;
                          ui:child [
                              a html:P ;
                              html:class "lm-para" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "No restricted datatypes defined in this graph" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          a ui:if ;
                          ui:child [
                              a html:P ;
                              html:class "lm-para" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "The graph defines, or extends, " ;
                                ] ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 1 ;
                                  ui:text [
                                      sp:varName "count" ;
                                    ] ;
                                ] ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 2 ;
                                  ui:text " restricted datatypes, as indexed below:" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              a lmdoc:MultiColumnList ;
                              arg:columns 4 ;
                              arg:includeWebLink true ;
                              arg:resultSet [
                                  sp:varName "instances" ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 1 ;
                          ui:condition [
                              a sp:gt ;
                              sp:arg1 [
                                  sp:varName "count" ;
                                ] ;
