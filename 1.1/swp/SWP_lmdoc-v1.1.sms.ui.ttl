                                  ) ;
                                sp:graphNameNode [
                                    sp:varName "graph" ;
                                  ] ;
                              ]
                            ) ;
                          sp:where (
                              [
                                a sp:Bind ;
                                sp:expression [
                                    a afn:now ;
