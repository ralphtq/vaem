                                      sp:predicate vaem:owner ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object [
                                          sp:varName "logo" ;
                                        ] ;
                                      sp:predicate vaem:logo ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
