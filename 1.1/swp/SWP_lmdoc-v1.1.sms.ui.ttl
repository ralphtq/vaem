                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 2 ;
                      ui:condition [
                          sp:varName "includeWebLink" ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a ui:debug ;
                  ui:child [
                      a ui:dumpScope ;
                      ui:childIndex 0 ;
