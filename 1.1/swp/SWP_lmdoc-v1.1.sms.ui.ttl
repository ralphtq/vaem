  ui:responseType ui:HTML ;
  rdfs:label "Instances table section" ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:IsDefinedInGraph
  a spin:Function ;
  spin:body [
      a sp:Ask ;
      sp:where (
          [
            a sp:Filter ;
            sp:expression [
                a sp:bound ;
                sp:arg1 [
                    sp:varName "graph" ;
                  ] ;
              ] ;
          ]
          [
            a sp:NamedGraph ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "graph" ;
                    ] ;
                  sp:predicate rdfs:isDefinedBy ;
                  sp:subject [
                      sp:varName "resource" ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "Is defined in graph" ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:Label
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The RDF node to display." ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a ui:if ;
          ui:child [
              a ui:else ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      a ui:label ;
                      sp:arg1 [
                          sp:varName "resource" ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a html:A ;
                  html:href [
                      sp:varName "resource" ;
                    ] ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "resource" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:eq ;
                  sp:arg1 xsd:anyURI ;
                  sp:arg2 [
                      a sp:datatype ;
                      sp:arg1 [
                          sp:varName "resource" ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:isLiteral ;
              sp:arg1 [
                  sp:varName "resource" ;
                ] ;
            ] ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a ui:resourceView ;
              ui:childIndex 0 ;
              ui:matchIds "label" ;
              ui:resource [
                  sp:varName "resource" ;
                ] ;
            ] ;
          ui:childIndex 2 ;
          ui:condition [
              a sp:isBlank ;
              sp:arg1 [
                  sp:varName "resource" ;
                ] ;
            ] ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a lmdoc:URIResourceViewer ;
              arg:object [
                  sp:varName "resource" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
          ui:condition [
              a sp:isIRI ;
              sp:arg1 [
                  sp:varName "resource" ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Displays an arbitrary RDF node. If the node is a resource, then this will use the configured resource display with id=\"label\" (e.g., the tui:Link). Literals of type xsd:anyURI are turned into hyperlinks. All other literals will be rendered as a simple text node with CSS class tuiLabel, with the text derived using ui:label()." ;
  rdfs:label "Label" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:LabelList
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resultSet ;
      spl:valueType sp:Select ;
      rdfs:comment "The SELECT query delivering the nodes to display in its first column." ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a html:Ol ;
          ui:child [
              a ui:forEach ;
              ui:child [
                  a html:Li ;
                  ui:child [
                      a lmdoc:Label ;
                      arg:resource [
                          sp:varName "node" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:resultSet [
                  a sp:Select ;
                  sp:resultVariables (
                      [
                        sp:varName "node" ;
                      ]
                    ) ;
                  sp:where (
                      [
                        sp:object [
                            sp:varName "resultSet" ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?0" ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?1" ;
                          ] ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?0" ;
                          ] ;
                      ]
                      [
                        sp:object 0 ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?1" ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?1" ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "node" ;
                          ] ;
                        sp:predicate spr:colCells ;
                        sp:subject [
                            sp:varName "?0" ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A list of values from a given result set. The individual values will be rendered into lmdoc:Labels." ;
  rdfs:label "Label list" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:LabeledObjects
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:hideProperty ;
      spl:valueType xsd:boolean ;
    ] ;
  ui:private false ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a html:Div ;
          html:class "lm-row" ;
          ui:child [
              a ui:if ;
              ui:child [
                  a lmdoc:URIResourceViewer ;
                  arg:label [
                      a sp:if ;
                      sp:arg1 [
                          a sp:bound ;
                          sp:arg1 [
                              sp:varName "label" ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          sp:varName "label" ;
                        ] ;
                      sp:arg3 [
                          a ui:label ;
                          sp:arg1 [
                              sp:varName "predicate" ;
                            ] ;
                        ] ;
                    ] ;
                  arg:object [
                      sp:varName "predicate" ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:or ;
                  sp:arg1 [
                      a sp:not ;
                      sp:arg1 [
                          a sp:bound ;
                          sp:arg1 [
                              sp:varName "hideProperty" ;
                            ] ;
                        ] ;
                    ] ;
                  sp:arg2 [
                      a sp:eq ;
                      sp:arg1 [
                          sp:varName "hideProperty" ;
                        ] ;
                      sp:arg2 false ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              a ui:setContext ;
              ui:child [
                  a lmdoc:ObjectsBody ;
                  ui:args "*" ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
              ui:varName "viewWidget" ;
              ui:varValue [
                  sp:varName "viewWidget" ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Labeled objects" ;
  rdfs:subClassOf lmdoc:Objects ;
.
lmdoc:LangDisplay
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:lang ;
      spl:valueType xsd:string ;
      rdfs:comment "The language tag." ;
    ] ;
  ui:prototype [
      a ui:if ;
      ui:child [
          a ui:else ;
          ui:child [
              a html:Span ;
              html:class "swa-lang" ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "(" ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text [
                      sp:varName "lang" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text ")" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:Img ;
              html:alt "Language Display" ;
              html:class "swa-lang-img" ;
              html:src [
                  a swa:langImage ;
                  arg:lang [
                      sp:varName "lang" ;
                    ] ;
                ] ;
              html:title [
                  a ui:concat ;
                  sp:arg1 "Language code: " ;
                  sp:arg2 [
                      sp:varName "lang" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a ui:contextValue ;
              sp:arg1 "langFlags" ;
            ] ;
        ] ;
      ui:condition [
          a sp:and ;
          sp:arg1 [
              a sp:bound ;
              sp:arg1 [
                  sp:varName "lang" ;
                ] ;
            ] ;
          sp:arg2 [
              a sp:ne ;
              sp:arg1 [
                  sp:varName "lang" ;
                ] ;
              sp:arg2 "" ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "Displays a given language. Does nothing if the language is unbound." ;
  rdfs:label "Lang display (lmdoc)" ;
  rdfs:subClassOf lmdoc:ViewElements ;
.
lmdoc:Link
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate lmdoc:optionalLinkArgs ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      a html:Span ;
      html:class "tuiLink" ;
      ui:child [
          a ui:createLink ;
          ui:child [
              a html:A ;
              html:href [
                  a fn:concat ;
                  sp:arg1 [
                      sp:varName "link" ;
                    ] ;
                  sp:arg2 "&" ;
                  sp:arg3 [
                      sp:varName "optionalLinkArgs" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      a ui:label ;
                      sp:arg1 [
                          sp:varName "node" ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:resource [
              sp:varName "node" ;
            ] ;
          ui:sendQueryGraph true ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A hyperlink to a resource, using the display label of the resource as text. Additional arguments may be passed in 'lmdoc:optionalArgs' for the rest call." ;
  rdfs:label "Link" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:LiteralViewer
  a swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      a swa:WeightedExpression ;
      swa:expression [
          a sp:eq ;
          sp:arg1 [
              sp:varName "kind" ;
            ] ;
          sp:arg2 "literal" ;
        ] ;
      swa:weight 4 ;
    ] ;
  ui:overrides swa:LiteralViewer ;
  ui:private true ;
  ui:prototype [
      a html:Div ;
      ui:child [
          a ui:else ;
          ui:child [
              a html:Div ;
              ui:child [
                  a ui:parse ;
                  ui:childIndex 0 ;
                  ui:str [
                      a swa:redirectHRefs ;
                      sp:arg1 [
                          sp:varName "object" ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  a lmdoc:LangDisplay ;
                  arg:lang [
                      a sp:lang ;
                      sp:arg1 [
                          sp:varName "object" ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          a ui:elseif ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "object" ;
                ] ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a lmdoc:LangDisplay ;
                  arg:lang [
                      a sp:lang ;
                      sp:arg1 [
                          sp:varName "object" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
              ui:condition [
                  a sp:ne ;
                  sp:arg1 [
                      a sp:lang ;
                      sp:arg1 [
                          sp:varName "object" ;
                        ] ;
                    ] ;
                  sp:arg2 "" ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:A ;
              html:href [
                  a sp:str ;
                  sp:arg1 [
                      sp:varName "object" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      a sp:str ;
                      sp:arg1 [
                          sp:varName "object" ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a fn:starts-with ;
              sp:arg1 [
                  a sp:str ;
                  sp:arg1 [
                      sp:varName "object" ;
                    ] ;
                ] ;
              sp:arg2 "http" ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A node viewer for literal values, displaying the literal's text. If a language tag is present, then this will be displayed behind the text." ;
  rdfs:label "Literal viewer" ;
  rdfs:seeAlso swa:LiteralViewer ;
  rdfs:subClassOf lmdoc:LiteralViewer ;
.
lmdoc:LiteralViewerWithLabel
  a swa:ObjectViewerClass ;
  spin:constraint [
      a spl:Argument ;
