lmdoc:Instance
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:errorPrototype [
      a ui:group ;
      ui:child [
          a ui:else ;
          ui:child [
              a ui:group ;
              let:myGraphMetadata [
                  a spl:objectInGraph ;
                  sp:arg1 [
                      sp:varName "myGraph" ;
                    ] ;
                  sp:arg2 vaem:hasGraphMetadata ;
                  sp:arg3 [
                      a sp:iri ;
                      sp:arg1 [
                          sp:varName "graph" ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a html:P ;
                      html:class "lm-para" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "No graph metadata for graph " ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text [
                              sp:varName "graph" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition "(!bound(?myGraphMetadata))" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:P ;
              html:class "lm-para" ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Missing graph value" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition "(!bound(?graph))" ;
        ] ;
    ] ;
  ui:headIncludes [
      a ui:group ;
      ui:child [
          a html:Meta ;
          html:content "lmdoc:Instance" ;
          html:name "manifest-end" ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a html:Meta ;
          html:content "lmdoc:Instance" ;
          html:name "manifest-start" ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraph [
          a sp:iri ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
        ] ;
      ui:child [
          a ui:catch ;
          ui:child [
              a html:P ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Exception in lmdoc:Instance" ;
