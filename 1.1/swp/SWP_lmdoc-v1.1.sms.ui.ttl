              a html:Div ;
              html:style "clear:both;" ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              a html:Div ;
              html:style "float:left; text-align:middle; padding:10px;" ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text """View as: 
""" ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a lmdoc:ViewAsCSV ;
                      arg:resource [
                          sp:varName "resource" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:condition [
