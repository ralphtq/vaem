      ui:child [
          a html:Div ;
          html:class "float-left" ;
          ui:child [
              a ui:else ;
              ui:child [
                  a ui:parse ;
                  ui:childIndex 0 ;
                  ui:str [
                      a swa:redirectHRefs ;
                      sp:arg1 [
                          sp:varName "object" ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  a lmdoc:LangDisplay ;
                  arg:lang [
                      a sp:lang ;
                      sp:arg1 [
                          sp:varName "object" ;
