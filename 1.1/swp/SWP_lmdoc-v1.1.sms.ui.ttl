                          sp:varName "options" ;
                        ] ;
                      sp:arg2 "CSV" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a lmdoc:ViewAsJSON ;
                      arg:resource [
                          sp:varName "resource" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 4 ;
                  ui:condition [
                      a fn:contains ;
                      sp:arg1 [
                          sp:varName "options" ;
                        ] ;
                      sp:arg2 "JSON" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a lmdoc:ViewAsJSON-LD ;
                      arg:resource [
                          sp:varName "resource" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 5 ;
                  ui:condition [
                      a fn:contains ;
                      sp:arg1 [
                          sp:varName "options" ;
                        ] ;
                      sp:arg2 "JSON-LD" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a lmdoc:ViewAsRDFXML ;
                      arg:resource [
                          sp:varName "resource" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 2 ;
                  ui:condition [
                      a fn:contains ;
                      sp:arg1 [
                          sp:varName "options" ;
                        ] ;
                      sp:arg2 "RDF" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a lmdoc:ViewAsTurtle ;
                      arg:resource [
                          sp:varName "resource" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 3 ;
                  ui:condition [
                      a fn:contains ;
                      sp:arg1 [
                          sp:varName "options" ;
                        ] ;
                      sp:arg2 "TURTLE" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a lmdoc:ViewAsXML ;
                      arg:resource [
                          sp:varName "resource" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 6 ;
                  ui:condition [
                      a fn:contains ;
                      sp:arg1 [
                          sp:varName "options" ;
                        ] ;
                      sp:arg2 "XML" ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a ui:CommentNode ;
              ui:childIndex 0 ;
              rdfs:comment """div style=\"float:left;\">
<a href=\"#{= ?topElement }\">
<img src=\"http://linkedmodel.org/lib/lm/images/icons/doc-back-arrow.png\" width=\"24px;\"/>
</a>
</div""" ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Resource footer" ;
  rdfs:label "Resource Footer" ;
  rdfs:subClassOf lmdoc:Parts ;
.
