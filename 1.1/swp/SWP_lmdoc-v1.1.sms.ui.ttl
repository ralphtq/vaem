@prefix arg: <http://spinrdf.org/arg#> .
@prefix catalog: <http://www.linkedmodel.org/schema/catalog#> .
@prefix css: <http://uispin.org/css#> .
@prefix dct: <http://purl.org/dc/terms/> .
