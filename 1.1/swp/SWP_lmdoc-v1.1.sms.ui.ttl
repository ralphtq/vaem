                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              a html:Td ;
                              html:class "lm-column" ;
                              ui:child [
                                  a ui:else ;
                                  ui:child [
                                      a html:I ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "self" ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  a ui:if ;
                                  ui:child [
                                      a html:B ;
                                      ui:child [
                                          a swa:Link ;
                                          arg:resource [
                                              sp:varName "parent" ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      a ui:TextNode ;
                                      ui:childIndex 1 ;
                                      ui:text "[" ;
                                    ] ;
                                  ui:child [
                                      a ui:TextNode ;
                                      ui:childIndex 2 ;
                                      ui:text [
                                          a ui:encodeNode ;
                                          sp:arg1 [
                                              sp:varName "parent" ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      a ui:TextNode ;
                                      ui:childIndex 3 ;
                                      ui:text "]" ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:condition [
                                      a sp:ne ;
                                      sp:arg1 [
                                          sp:varName "parent" ;
                                        ] ;
                                      sp:arg2 [
                                          sp:varName "class" ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "myRestrictions" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          a sp:gt ;
                          sp:arg1 [
                              a spr:rowCount ;
                              sp:arg1 [
                                  sp:varName "myRestrictions" ;
                                ] ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:resultSet [
                  sp:varName "myParents" ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Property details table" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:RDFListViewer
  a swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      a swa:WeightedExpression ;
      swa:expression [
          a sp:eq ;
          sp:arg1 [
              sp:varName "kind" ;
            ] ;
          sp:arg2 "list" ;
        ] ;
      swa:weight 50 ;
    ] ;
  ui:overrides swa:RDFListViewer ;
  ui:prototype [
      a html:Div ;
      html:class "swa-rdf-list-viewer" ;
      ui:child [
          a html:Ol ;
          html:class "swa-rdf-list-viewer-ol" ;
          ui:child [
              a ui:forEach ;
              ui:child [
                  a html:Li ;
                  html:class "swa-rdf-list-viewer-li" ;
                  ui:child [
                      a lmdoc:ObjectViewer ;
                      arg:object [
                          sp:varName "member" ;
                        ] ;
                      arg:predicate rdf:first ;
                      arg:subject [
                          sp:varName "item" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:resultSet [
                  a sp:Select ;
                  sp:resultVariables (
                      [
                        sp:varName "member" ;
                      ]
                      [
                        sp:varName "item" ;
                      ]
                    ) ;
                  sp:where (
                      [
                        a sp:TriplePath ;
                        sp:object [
                            sp:varName "item" ;
                          ] ;
                        sp:path [
                            a sp:ModPath ;
                            sp:modMax -2 ;
                            sp:modMin 0 ;
                            sp:subPath rdf:rest ;
                          ] ;
                        sp:subject [
                            sp:varName "object" ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "member" ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "item" ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "A viewer for rdf:Lists, arranging values vertically in a scrollable container." ;
  rdfs:label "RDF list viewer" ;
  rdfs:seeAlso swa:RDFListViewer ;
  rdfs:subClassOf lmdoc:ObjectViewer ;
.
lmdoc:ReferencesToResourceInGivenGraph
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:orderBy (
          [
            a ui:label ;
            sp:arg1 [
                sp:varName "property" ;
              ] ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "property" ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph" ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "resource" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "resource" ;
              ] ;
            sp:predicate [
                sp:varName "property" ;
              ] ;
            sp:subject [
                sp:varName "subject" ;
              ] ;
          ]
          [
            a sp:Filter ;
            sp:expression [
                a sp:ne ;
                sp:arg1 [
                    sp:varName "property" ;
                  ] ;
                sp:arg2 rdfs:isDefinedBy ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:comment "Gets all properties for subjects that reference a resource as object in given class." ;
  rdfs:label "All instances" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
