                            sp:subject [
                                sp:varName "?0" ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "parent" ;
                              ] ;
                            sp:predicate rdf:first ;
                            sp:subject [
                                sp:varName "?1" ;
                              ] ;
                          ]
                          [
                            sp:object () ;
                            sp:predicate rdf:rest ;
                            sp:subject [
                                sp:varName "?1" ;
                              ] ;
                          ]
                        ) ;
