                      sp:resultVariables (
                          [
                            sp:varName "property" ;
                          ]
                          [
                            sp:varName "parent" ;
                          ]
                        ) ;
                      sp:where (
                          [
                            sp:object [
                                sp:varName "?0" ;
                              ] ;
                            sp:predicate lmdoc:relevantPropertiesAtClassWithParent ;
                            sp:subject [
                                sp:varName "property" ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "class" ;
