lmdoc:Class
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:errorPrototype [
      a ui:group ;
      ui:child [
          a ui:else ;
          ui:child [
              a ui:group ;
              let:myGraphMetadata [
                  a spl:object ;
                  sp:arg1 [
                      sp:varName "myGraph" ;
                    ] ;
                  sp:arg2 vaem:hasGraphMetadata ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a html:P ;
                      html:class "lm-para" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "No graph metadata for graph " ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text [
                              sp:varName "graph" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition "(!bound(?myGraphMetadata))" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:P ;
              html:class "lm-para" ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Missiing graph value" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition "(!bound(?graph))" ;
        ] ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraph [
          a sp:iri ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
        ] ;
      ui:child [
          a html:Div ;
          html:id "content_container" ;
          ui:child [
              a ui:group ;
              let:myOverlay [
                  a sp:iri ;
                  sp:arg1 [
                      a sp:coalesce ;
                      sp:arg1 [
                          sp:varName "overlay" ;
                        ] ;
                      sp:arg2 ui:tempGraph ;
                    ] ;
                ] ;
              ui:child [
                  a ui:setContext ;
                  ui:child [
                      a ui:setContext ;
                      ui:child [
                          a ui:setContext ;
                          ui:child [
                              a ui:group ;
                              let:myGraphMetadata [
                                  a spl:object ;
                                  sp:arg1 [
                                      sp:varName "myGraph" ;
                                    ] ;
                                  sp:arg2 vaem:hasGraphMetadata ;
                                ] ;
                              ui:child [
                                  a lmdoc:DetailedClassView ;
                                  arg:class [
                                      sp:varName "resource" ;
                                    ] ;
                                  arg:showDiagram true ;
                                  arg:showInstances false ;
                                  arg:showTitle false ;
                                  ui:childIndex 2 ;
                                ] ;
                              ui:child [
                                  a lmdoc:Footer ;
                                  ui:childIndex 3 ;
                                ] ;
                              ui:child [
                                  a lmdoc:PartHeader ;
                                  arg:metadata [
                                      sp:varName "myGraphMetadata" ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:child [
                                  a lmdoc:ResourceHeader ;
                                  arg:resource [
                                      sp:varName "resource" ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:queryGraph [
                              a ui:unionOfGraphs ;
                              sp:arg1 [
                                  a ui:graphWithImports ;
                                  sp:arg1 [
                                      sp:varName "myGraph" ;
                                    ] ;
                                ] ;
                              sp:arg2 [
                                  a ui:graphWithImports ;
                                  sp:arg1 [
                                      sp:varName "myOverlay" ;
                                    ] ;
                                ] ;
                              sp:arg3 [
                                  a ui:graphWithImports ;
                                  sp:arg1 <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:varName "graph" ;
                      ui:varValue [
                          sp:varName "myGraph" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "flags" ;
                  ui:varValue [
                      sp:varName "flags" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  vaem:todo "remove dependency on swa.css" ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=lmdoc:Class&graph=http://www.linkedmodel.org/2.0/schema/vaem&resource=http%3A%2F%2Fwww.linkedmodel.org%2Fschema%2Fvaem%23GraphRole""" ;
  rdfs:label "Class Documentation" ;
  rdfs:subClassOf lmdoc:Pages ;
.
lmdoc:ClassDiagramShowingInheritanceOnly
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:focusClass ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The focus class of interest." ;
    ] ;
  ui:prototype [
      a ui:group ;
      letrs:classes [
          a sp:Select ;
          sp:resultVariables (
              [
                sp:varName "class" ;
              ]
            ) ;
          sp:where (
              [
                a sp:TriplePath ;
                sp:object [
                    sp:varName "class" ;
                  ] ;
                sp:path [
                    a sp:ModPath ;
                    sp:modMax -2 ;
                    sp:modMin 0 ;
                    sp:subPath rdfs:subClassOf ;
                  ] ;
                sp:subject [
                    sp:varName "focusClass" ;
                  ] ;
              ]
              [
                a sp:Filter ;
                sp:expression [
                    a sp:and ;
                    sp:arg1 [
                        a sp:isIRI ;
                        sp:arg1 [
                            sp:varName "class" ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        a sp:or ;
                        sp:arg1 [
                            a sp:not ;
                            sp:arg1 [
                                a swauml:isRootClass ;
                                sp:arg1 [
                                    sp:varName "class" ;
                                  ] ;
                              ] ;
                          ] ;
                        sp:arg2 [
                            a sp:eq ;
                            sp:arg1 [
                                sp:varName "focusClass" ;
                              ] ;
                            sp:arg2 [
                                sp:varName "class" ;
                              ] ;
                          ] ;
                      ] ;
                  ] ;
              ]
            ) ;
        ] ;
      ui:child [
          a ui:setContext ;
          let:id [
              a ui:uniqueId ;
            ] ;
          letrs:superClassEdges [
              a sp:Select ;
              sp:resultVariables (
                  [
                    sp:varName "class" ;
                  ]
                  [
                    sp:varName "superClass" ;
                  ]
                ) ;
              sp:where (
                  (
                    [
                      sp:object [
                          sp:varName "rowIndex" ;
                        ] ;
                      sp:predicate spr:rowIndices ;
                      sp:subject [
                          sp:varName "classes" ;
                        ] ;
                    ]
                    [
                      a sp:Bind ;
                      sp:expression [
                          a spr:cell ;
                          sp:arg1 [
                              sp:varName "classes" ;
                            ] ;
                          sp:arg2 [
                              sp:varName "rowIndex" ;
                            ] ;
                          sp:arg3 0 ;
                        ] ;
                      sp:variable [
                          sp:varName "class" ;
                        ] ;
                    ]
                  )
                  [
                    sp:object [
                        sp:varName "superClass" ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "class" ;
                      ] ;
                  ]
                  [
                    a sp:Filter ;
                    sp:expression [
                        a swauml:contains ;
                        sp:arg1 [
                            sp:varName "classes" ;
                          ] ;
                        sp:arg2 [
                            sp:varName "superClass" ;
                          ] ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              a html:Div ;
              html:class "swauml-diagram" ;
              html:id [
                  sp:varName "id" ;
                ] ;
              ui:child [
                  a html:Svg ;
                  html:height "100%" ;
                  html:width "100%" ;
                  ui:child [
                      a html:Defs ;
                      ui:child [
                          a html:Marker ;
                          html:id "associationMarker" ;
                          html:markerHeight "10" ;
                          html:markerWidth "10" ;
                          html:orient "auto" ;
                          html:refX "10" ;
                          html:refY "5" ;
                          ui:child [
                              a html:Path ;
                              html:class "swauml-association-edge-marker" ;
                              html:d "M10,5 L0,10 L0,0 Z" ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          a html:Marker ;
                          html:id "subClassMarker" ;
                          html:markerHeight "20" ;
                          html:markerWidth "20" ;
                          html:orient "auto" ;
                          html:refX "0" ;
                          html:refY "10" ;
                          ui:child [
                              a html:Polygon ;
                              html:class "swauml-subclass-edge-marker" ;
                              html:points "0,10 10,6 10,14" ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      a ui:forEach ;
                      ui:child [
                          a swauml:SubClassEdge ;
                          arg:subClass [
                              sp:varName "class" ;
                            ] ;
                          arg:superClass [
                              sp:varName "superClass" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                      ui:resultSet [
                          sp:varName "superClassEdges" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  a ui:forEach ;
                  ui:child [
                      a swauml:ClassNode ;
                      arg:attributesFilterFunction [
                          sp:varName "attributesFilterFunction" ;
                        ] ;
                      arg:class [
                          sp:varName "class" ;
                        ] ;
                      arg:focused [
                          a sp:eq ;
                          sp:arg1 [
                              sp:varName "class" ;
                            ] ;
                          sp:arg2 [
                              sp:varName "focusClass" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "classes" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              a html:Script ;
              ui:child [
                  a swon:Array ;
                  ui:child [
                      a ui:forEach ;
                      ui:child [
                          a swon:Object ;
                          ui:child [
                              a swon:Value ;
                              arg:name "subClass" ;
                              arg:value [
                                  sp:varName "class" ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              a swon:Value ;
                              arg:name "superClass" ;
                              arg:value [
                                  sp:varName "superClass" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:resultSet [
                          sp:varName "superClassEdges" ;
                        ] ;
                      ui:separator "," ;
                    ] ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  a swon:Array ;
                  ui:childIndex 5 ;
                ] ;
              ui:child [
                  a swon:Comma ;
                  ui:childIndex 4 ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "swa.initClassDiagram(\"" ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text [
                      sp:varName "id" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text "\"," ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 6 ;
                  ui:text """
   )""" ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 0 ;
          ui:varName "swaSystemLabels" ;
          ui:varValue [
              sp:varName "systemLabels" ;
            ] ;
        ] ;
    ] ;
  rdfs:label "Class diagram showing inheritance only" ;
  rdfs:subClassOf lmdoc:AbstractClassDiagram ;
.
lmdoc:ClassInstances
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:setContext ;
      ui:child [
          a ui:group ;
          letrs:instances [
              a sp:Select ;
              sp:orderBy (
                  [
                    a ui:label ;
                    sp:arg1 [
                        sp:varName "instance" ;
                      ] ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "instance" ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "class" ;
                      ] ;
                    sp:predicate rdf:type ;
