@prefix swauml: <http://topbraid.org/swauml#> .
@prefix swon: <http://uispin.org/swon#> .
@prefix tops: <http://www.topbraid.org/tops#> .
@prefix tui: <http://uispin.org/tui#> .
@prefix ui: <http://uispin.org/ui#> .
@prefix uix: <http://topbraidlive.org/uix#> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix voag: <http://voag.linkedmodel.org/voag/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dct:description
  a rdf:Property ;
  rdfs:range xsd:string ;
.
arg:catalog
  a rdf:Property ;
  rdfs:label "catalog" ;
  rdfs:range rdfs:Resource ;
.
arg:catalogEntry
  a owl:ObjectProperty ;
  rdfs:label "catalog entry" ;
  rdfs:range rdfs:Resource ;
.
arg:catalogGraph
  a owl:ObjectProperty ;
  rdfs:label "catalog graph" ;
  rdfs:range rdfs:Resource ;
.
arg:columns
  a rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:flags
  a owl:DatatypeProperty ;
  rdfs:range xsd:string ;
.
arg:graphRole
  a rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:heading
  a rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:hideProperty
  a rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:includeWebLink
  a rdf:Property ;
  rdfs:label "Instance Web Link" ;
  rdfs:range xsd:boolean ;
  rdfs:subPropertyOf sp:arg ;
.
arg:instancesTemplate
  a rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:logo
  a rdf:Property ;
.
arg:margin
  a rdf:Property ;
  rdfs:label "margin" ;
.
arg:options
  a rdf:Property ;
  rdfs:range xsd:string ;
.
arg:overlay
  a owl:DatatypeProperty ;
  dct:description "An overlay is an optional graph and its imports that add additional constructs to SWP/SWA processing"^^rdf:HTML ;
  rdfs:range xsd:string ;
.
arg:parentLevel
  a owl:DatatypeProperty ;
  rdfs:label "parent level" ;
  rdfs:range xsd:string ;
.
arg:propertySet
  a rdf:Property ;
.
arg:resourceSet
  a rdf:Property ;
.
arg:sectionHeading
  a rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:showConstructors
  a rdf:Property ;
  rdfs:range xsd:boolean ;
  rdfs:subPropertyOf sp:arg ;
.
arg:showDiagram
  a rdf:Property ;
  rdfs:range xsd:boolean ;
  rdfs:subPropertyOf sp:arg ;
.
arg:showInstances
  a rdf:Property ;
  rdfs:range xsd:boolean ;
  rdfs:subPropertyOf sp:arg ;
.
arg:showRules
  a rdf:Property ;
  rdfs:range xsd:boolean ;
  rdfs:subPropertyOf sp:arg ;
.
arg:showTitle
  a rdf:Property ;
  rdfs:range xsd:boolean ;
  rdfs:subPropertyOf sp:arg ;
.
arg:singlePage
  a rdf:Property ;
  rdfs:range xsd:boolean ;
  rdfs:subPropertyOf sp:arg ;
.
arg:summaryView
  a rdf:Property ;
  rdfs:label "summary view" ;
  rdfs:subPropertyOf sp:arg ;
.
arg:swpElement
  a rdf:Property ;
  rdfs:label "swp element" ;
  rdfs:subPropertyOf sp:arg ;
.
arg:titleFunction
  a rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:topElement
  a rdf:Property ;
  rdfs:label "top element" ;
  rdfs:range xsd:string ;
  rdfs:subPropertyOf sp:arg ;
.
spin:RuleProperty
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty lmdoc:htmlString ;
    ] ;
.
spl:subjectInGraph
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "subject" ;
          ]
        ) ;
      sp:where (
          [
            a sp:NamedGraph ;
            sp:elements (
                [
                  sp:object spin:_arg2 ;
                  sp:predicate spin:_arg1 ;
                  sp:subject [
                      sp:varName "subject" ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode spin:_arg3 ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdf:Property ;
      rdfs:comment "The predicate." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg2 ;
      rdfs:comment "The object." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg3 ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:comment "Gets the \"first\" subject of a given predicate (?arg1)/object (?arg2) combination. Note that if multiple values are present then the result might be unpredictably random." ;
  rdfs:label "subject in graph" ;
  rdfs:subClassOf spl:OntologyFunctions ;
.
<http://topbraid.org/email#TestAddress>
  a owl:Class ;
  rdfs:label "Test address" ;
  rdfs:subClassOf <http://topbraid.org/email#Address> ;
  rdfs:subClassOf [
      a owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty vaem:id ;
    ] ;
.
smf:convertRDFToText
  rdfs:subClassOf sml:Elements ;
.
swa:DatatypeAxiomProperty
  a rdfs:Class ;
  rdfs:comment "A marker type to distinguish datatype axiom properties from others." ;
  rdfs:label "Datatype axiom property" ;
  rdfs:subClassOf rdf:Property ;
.
swa:isDatatypeAxiomProperty
  a spin:Function ;
  spin:body [
      a sp:Ask ;
      sp:where (
          [
            a sp:Filter ;
            sp:expression [
                a sp:exists ;
                sp:elements (
                    [
                      a sp:NamedGraph ;
                      sp:elements (
                          [
                            sp:object swa:DatatypeAxiomProperty ;
                            sp:predicate rdf:type ;
                            sp:subject [
                                sp:varName "predicate" ;
                              ] ;
                          ]
                        ) ;
                      sp:graphNameNode ui:graph ;
                    ]
                  ) ;
              ] ;
          ]
        ) ;
    ] ;
  spin:private true ;
  rdfs:comment "Checks whether a given property has been marked as swa:DatatypeAxiomProperty." ;
  rdfs:label "is datatype axiom property" ;
  rdfs:subClassOf swa:PropertyWidgetGroupFilterFunctions ;
.
<http://topbraid.org/xhtml#Area>
  a rdfs:Resource ;
.
voag:Graph
  a owl:Class ;
  ui:instanceView [
      a html:Div ;
      tui:resource spin:_this ;
      ui:child [
          a html:P ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  a spl:object ;
                  sp:arg1 spin:_this ;
                  sp:arg2 vaem:namespacePrefix ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:id "graphLabel" ;
      ui:priority 2 ;
    ] ;
.
<http://www.linkedmodel.org/1.1/swp/lmdoc>
  a owl:Ontology ;
  vaem:hasGraphMetadata <http://www.linkedmodel.org/1.1/swp/lmdoc/GMD_LMDOC> ;
  vaem:hasGraphRole vaem:ViewGraph ;
  owl:imports <http://debug.topbraidlive.org/1.0/swa> ;
  owl:imports <http://epub.linkedmodel.org/1.0/schema/catalog> ;
  owl:imports <http://spinrdf.org/spin.ui> ;
  owl:imports <http://spinrdf.org/spinx> ;
  owl:imports <http://topbraid.org/swa> ;
  owl:imports <http://uispin.org/ui> ;
  owl:imports <http://uispin.org/ui.ui> ;
  owl:imports <http://www.linkedmodel.org/schema/vaem> ;
  owl:imports <http://www.w3.org/2004/02/skos/core> ;
  owl:imports <http://www.w3.org/ns/dcat> ;
  owl:versionInfo "Created with TopBraid Composer" ;
.
<http://www.linkedmodel.org/1.1/swp/lmdoc/GMD_LMDOC>
  a <vaem:DocumentationGraph> ;
  dct:created "2014-08-06"^^xsd:date ;
  vaem:hasOwner vaem:TopQuadrant ;
  vaem:hasSteward vaem:TopQuadrant ;
  vaem:name "lmdoc" ;
  vaem:namespace "http://www.linkedmodel.org/oui/lmdoc#"^^xsd:anyURI ;
  vaem:namespacePrefix "lmdoc" ;
  vaem:owner "TopQuadrant" ;
  vaem:revision "1.1" ;
.
lmdoc:AboutNamespaces
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:metadata ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      letrs:namespaces [
          a sp:Select ;
          sp:orderBy (
              [
                sp:varName "nsPrefix" ;
              ]
            ) ;
          sp:resultVariables (
              [
                sp:varName "ns" ;
              ]
              [
                sp:varName "nsPrefix" ;
              ]
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "ns" ;
                  ] ;
                sp:predicate vaem:namespace ;
                sp:subject [
                    sp:varName "metadata" ;
                  ] ;
              ]
              [
                a sp:Bind ;
                sp:expression [
                    a smf:prefix ;
                    sp:arg1 [
                        a sp:iri ;
                        sp:arg1 [
                            a sp:str ;
                            sp:arg1 [
                                sp:varName "ns" ;
                              ] ;
                          ] ;
                      ] ;
                  ] ;
                sp:variable [
                    sp:varName "nsPrefix" ;
                  ] ;
              ]
            ) ;
        ] ;
      ui:child [
          a ui:group ;
          let:nsCount [
              a spr:rowCount ;
              sp:arg1 [
                  sp:varName "namespaces" ;
                ] ;
            ] ;
          ui:child [
              a ui:else ;
              ui:child [
                  a html:P ;
                  html:class "lm-para" ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "No namespace documentation." ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a ui:else ;
                  ui:child [
                      a html:P ;
                      html:class "lm-para" ;
                      ui:child [
                          a html:Code ;
                          html:class "boxed" ;
                          ui:child [
                              a ui:forEach ;
                              ui:child [
                                  a html:A ;
                                  html:href [
                                      sp:varName "ns" ;
                                    ] ;
                                  ui:child [
                                      a ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          sp:varName "nsPrefix" ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:resultSet [
                                  sp:varName "namespaces" ;
                                ] ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "The namespace prefix for resources in this ontology is: " ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a html:Dd ;
                      html:class "boxed size-14" ;
                      ui:child [
                          a ui:forEach ;
                          ui:child [
                              a html:A ;
                              html:href [
                                  sp:varName "ns" ;
                                ] ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      sp:varName "nsPrefix" ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "namespaces" ;
                            ] ;
                          ui:separator ", " ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a html:P ;
                      html:class "lm-para" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "The namespace prefixes for the resources in this ontology are:" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      a sp:gt ;
                      sp:arg1 [
                          sp:varName "nsCount" ;
                        ] ;
                      sp:arg2 1 ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:gt ;
                  sp:arg1 [
                      sp:varName "nsCount" ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "About Namespaces" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:AboutPublishedGraphs
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:metadata ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:rdfFile [
          a spl:object ;
          sp:arg1 [
              sp:varName "metadata" ;
            ] ;
          sp:arg2 vaem:rdfxmlFileURL ;
        ] ;
      let:ttlFile [
          a spl:object ;
          sp:arg1 [
              sp:varName "metadata" ;
            ] ;
          sp:arg2 vaem:turtleFileURL ;
        ] ;
      ui:child [
          a ui:else ;
          ui:child [
              a html:P ;
              html:class "lm-para" ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "The graphs have not yet been published as Turtle files." ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:P ;
              html:class "lm-para" ;
              let:graphType [
                  a fn:lower-case ;
                  sp:arg1 [
                      a ui:label ;
                      sp:arg1 [
                          a spl:object ;
                          sp:arg1 [
                              sp:varName "metadata" ;
                            ] ;
                          sp:arg2 vaem:hasGraphRole ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  a html:Code ;
                  html:class "boxed" ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "graphType" ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text """
The """ ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text """ is available as: 
   
""" ;
                ] ;
              ui:child [
                  a ui:else ;
                  ui:child [
                      a ui:if ;
                      ui:child [
                          a html:A ;
                          html:href [
                              sp:varName "ttlFile" ;
                            ] ;
                          ui:child [
                              a ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Turtle" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          a sp:ne ;
                          sp:arg1 [
                              a sp:str ;
                              sp:arg1 [
                                  sp:varName "ttlFile" ;
                                ] ;
                            ] ;
                          sp:arg2 "" ;
                        ] ;
                    ] ;
                  ui:childIndex 4 ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a html:A ;
                      html:href [
                          sp:varName "rdfFile" ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "RDF/XML" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      a ui:if ;
                      ui:child [
                          a html:A ;
                          html:href [
                              sp:varName "ttlFile" ;
                            ] ;
                          ui:child [
                              a ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Turtle" ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text """,  
       """ ;
                        ] ;
                      ui:childIndex 1 ;
                      ui:condition [
                          a sp:ne ;
                          sp:arg1 [
                              a sp:str ;
                              sp:arg1 [
                                  sp:varName "ttlFile" ;
                                ] ;
                            ] ;
                          sp:arg2 "" ;
                        ] ;
                    ] ;
                  ui:childIndex 3 ;
                  ui:condition [
                      a sp:ne ;
                      sp:arg1 [
                          a sp:str ;
                          sp:arg1 [
                              sp:varName "rdfFile" ;
                            ] ;
                        ] ;
                      sp:arg2 "" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:or ;
              sp:arg1 [
                  a sp:ne ;
                  sp:arg1 [
                      a sp:str ;
                      sp:arg1 [
                          sp:varName "rdfFile" ;
                        ] ;
                    ] ;
                  sp:arg2 "" ;
                ] ;
              sp:arg2 [
                  a sp:ne ;
                  sp:arg1 [
                      a sp:str ;
                      sp:arg1 [
                          sp:varName "ttlFile" ;
                        ] ;
                    ] ;
                  sp:arg2 "" ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "About prublished graphs" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:AbstractClassDiagram
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:associationsFilterFunction ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "An optional filter function that can be used to suppress showing certain relationships. The functions should be subclass of swa:AssociationsFilterFunctions." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:attributesFilterFunction ;
      spl:valueType spin:Function ;
      rdfs:comment "An optional function(?predicate, ?sourceClass) returning true to include a given property at a given class node. Function should be subclass of swa:AttributesFilterFunctions." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:systemLabels ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to use system labels (qnames and IRIs)." ;
    ] ;
  ui:abstract true ;
  rdfs:label "Abstract class diagram (lmdoc)" ;
  rdfs:subClassOf lmdoc:GraphElements ;
.
lmdoc:AbstractObject
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:defaultValue "160px" ;
      spl:optional true ;
      spl:predicate arg:labelWidth ;
      spl:valueType xsd:string ;
      rdfs:comment "The label width, defaults to 160px. Set to \"inline\" to have the preferred width, i.e. it will occupy exactly the needed space." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:editWidget ;
      spl:valueType swa:ObjectEditorClass ;
      rdfs:comment "The preferred widget if in edit mode." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:hideIfEmpty ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to suppress this if the given subject has no value for the given predicate. Has no effect if we are not in view mode." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:hideInModes ;
      spl:valueType xsd:string ;
      rdfs:comment "An optional comma-separated list of mode names (e.g. \"edit\", \"search\", \"view\") enumerating those views in which this widget shall be hidden." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
      rdfs:comment "A label, overriding the default label." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:linear ;
      spl:valueType xsd:boolean ;
      rdfs:comment "By default (false), the label and the widget will be laid out in a tabular style, with all widgets nicely aligned underneath one another. If set to true, then no such alignment will happen. (In previous versions of SWA this was represented using arg:tabular)." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:searchWidget ;
      spl:valueType swa:ObjectFacetClass ;
      rdfs:comment "The preferred facet widget." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:viewWidget ;
      spl:valueType swa:ObjectViewerClass ;
      rdfs:comment "The preferred widget if in view mode." ;
    ] ;
  ui:abstract true ;
  rdfs:comment "Base class of lmdoc:Object and lmdoc:Objects, to declare the arguments that the subclasses have in common." ;
  rdfs:label "Abstract object" ;
  rdfs:subClassOf lmdoc:ObjectElements ;
.
lmdoc:AbstractSection
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:metadata ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a html:Div ;
          html:class "lm-abstract" ;
          ui:child [
              a ui:CommentNode ;
              ui:childIndex 1 ;
              rdfs:comment "p class=\"lm-para\">{= spl:object(?metadata, vaem:intent) }</p" ;
            ] ;
          ui:child [
              a lmdoc:AboutNamespaces ;
              arg:metadata [
                  sp:varName "metadata" ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              a lmdoc:AboutPublishedGraphs ;
              arg:metadata [
                  sp:varName "metadata" ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              a lmdoc:MaybeDescription ;
              arg:resource [
                  sp:varName "metadata" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          a html:H2 ;
          html:id [
              a fn:lower-case ;
              sp:arg1 [
                  sp:varName "sectionHeading" ;
                ] ;
            ] ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "sectionHeading" ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:debug ;
          ui:child [
              a ui:CommentNode ;
              ui:childIndex 0 ;
              rdfs:comment "ui:dumpScope ui:message=\"DEBUG1: lmdoc:AbstractSection - {= ?metadata }\"/" ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  vaem:todo "The namespaces for all referenced vocabularies are giving in the section on <a href=\"#ns\">Namespaces</a>. " ;
  rdfs:label "Abstract section" ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:AbstractSubject
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:defaultValue "160px" ;
      spl:optional true ;
      spl:predicate arg:labelWidth ;
      spl:valueType xsd:string ;
      rdfs:comment "The label width, defaults to 160px. Set to \"inline\" to have the preferred width, i.e. it will occupy exactly the needed space." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:hideIfEmpty ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to suppress this if the given subject has no value for the given predicate. Has no effect if we are not in view mode." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
      rdfs:comment "A label, overriding the default label." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:linear ;
      spl:valueType xsd:boolean ;
      rdfs:comment "By default (false), the label and the widget will be laid out in a tabular style, with all widgets nicely aligned underneath one another. If set to true, then no such alignment will happen. (In previous versions of SWA this was represented using arg:tabular)." ;
    ] ;
  ui:abstract true ;
  rdfs:comment "Similar to swa:AbstractObject but for the other direction." ;
  rdfs:label "Abstract subject" ;
  rdfs:subClassOf lmdoc:SubjectElements ;
.
lmdoc:AllClasses
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:orderBy (
          [
            sp:varName "qName" ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "resource" ;
          ]
          [
            sp:varName "qName" ;
          ]
          [
            sp:varName "uri" ;
          ]
        ) ;
      sp:where (
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "graph" ;
              ] ;
            sp:path [
                a sp:AltPath ;
                sp:path1 rdfs:isDefinedBy ;
                sp:path2 vaem:isElaboratedIn ;
              ] ;
            sp:subject [
                sp:varName "resource" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type" ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "resource" ;
              ] ;
          ]
          [
            a sp:TriplePath ;
            sp:object owl:Class ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "type" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a xsd:string ;
                sp:arg1 [
                    sp:varName "resource" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a smf:qname ;
                sp:arg1 [
                    sp:varName "resource" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "qName" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  rdfs:comment "Gets all classes defined in a given graph and orders them by label. Note this may (obviously) not scale if a class has too many instances." ;
  rdfs:label "All classes" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllConstructors
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:orderBy (
          [
            sp:varName "property" ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "property" ;
          ]
          [
            sp:varName "ruleBody" ;
          ]
          [
            sp:varName "ruleAsText" ;
          ]
        ) ;
      sp:where (
          [
            a sp:TriplePath ;
            sp:object spin:constructor ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject [
                sp:varName "property" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "ruleBody" ;
              ] ;
            sp:predicate [
                sp:varName "property" ;
              ] ;
            sp:subject [
                sp:varName "class" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spif:convertSPINRDFToString ;
                sp:arg1 [
                    sp:varName "ruleBody" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "ruleAsText" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  rdfs:comment "Gets all constructors defined in a given graph and orders them by step." ;
  rdfs:label "All constructors" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllDocumentParts
  a spin:MagicProperty ;
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:orderBy (
          [
            sp:varName "i" ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "ct" ;
          ]
          [
            sp:varName "i" ;
          ]
        ) ;
      sp:where (
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "c" ;
              ] ;
            sp:path [
                a sp:SeqPath ;
                sp:path1 [
                    a sp:SeqPath ;
                    sp:path1 ui:prototype ;
                    sp:path2 ui:child ;
                  ] ;
                sp:path2 ui:child ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            sp:object [
                sp:varName "i" ;
              ] ;
            sp:predicate ui:childIndex ;
            sp:subject [
                sp:varName "c" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "ct" ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "c" ;
              ] ;
          ]
          [
            a sp:TriplePath ;
            sp:object spin:_arg1 ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "ct" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  rdfs:comment "Gets all classes defined in a given graph and orders them by label. Note this may (obviously) not scale if a class has too many instances." ;
  rdfs:label "All document parts" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllInstanceOfType
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:orderBy (
          [
            a ui:label ;
            sp:arg1 [
                sp:varName "instance" ;
              ] ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "instance" ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph" ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "instance" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type" ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "instance" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:type ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:comment "Gets all instancesof a given type defined in a given graph and orders them by label. " ;
  rdfs:label "All instances" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllInstanceTypes
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:orderBy (
          [
            a ui:label ;
            sp:arg1 [
                sp:varName "class" ;
              ] ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "class" ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph" ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "instance" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "class" ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "instance" ;
              ] ;
          ]
          [
            a sp:TriplePath ;
            sp:object owl:Thing ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "class" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  rdfs:comment "Gets all the types of instances defined in a given graph and orders them by label. " ;
  rdfs:label "All instances" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllOwners
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:orderBy (
          [
            sp:varName "owner" ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "owner" ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "owner" ;
              ] ;
            sp:predicate vaem:owner ;
            sp:subject [
                sp:varName "resource" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  rdfs:comment "Gets all owners of a given graph." ;
  rdfs:label "All owners" ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllProperties
  a spin:SelectTemplate ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:orderBy (
          [
            sp:varName "qName" ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "resource" ;
          ]
          [
            sp:varName "qName" ;
          ]
          [
            sp:varName "uri" ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph" ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "resource" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type" ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "resource" ;
              ] ;
          ]
          [
            a sp:TriplePath ;
            sp:object rdf:Property ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "type" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a xsd:string ;
                sp:arg1 [
                    sp:varName "resource" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a smf:qname ;
                sp:arg1 [
                    sp:varName "resource" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "qName" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have." ;
    ] ;
  rdfs:comment "Gets all properties defined in a given graph and orders them by label. Note this may (obviously) not scale if a class has too many instances." ;
  rdfs:label "All properties" ;
