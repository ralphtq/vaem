                                    [
                                      sp:object "" ;
                                      sp:predicate dct:title ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object "" ;
                                      sp:predicate dct:subject ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object "TBD" ;
                                      sp:predicate vaem:intent ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
