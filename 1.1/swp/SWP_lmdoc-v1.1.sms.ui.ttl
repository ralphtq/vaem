rdfs:Class
  ui:instanceView [
      a ui:group ;
      ui:child [
          a ui:group ;
          let:resource [
              a sp:iri ;
              sp:arg1 [
                  a spif:decodeURL ;
                  sp:arg1 [
                      a sp:str ;
                      sp:arg1 spin:_this ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              a ui:setContext ;
              ui:child [
                  a ui:group ;
                  let:myGraph [
                      a sp:iri ;
                      sp:arg1 [
                          a lmdoc:getDefiningGraph ;
                          arg:resource [
                              sp:varName "resource" ;
                            ] ;
                        ] ;
                    ] ;
                  ui:child [
                      a ui:setContext ;
                      ui:child [
                          a ui:debug ;
                          ui:child [
                              a html:P ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Current query graph is " ;
                                ] ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 1 ;
                                  ui:text [
                                      a ui:currentQueryGraph ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              a html:P ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Graph is " ;
                                ] ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 1 ;
                                  ui:text [
                                      sp:varName "myGraph" ;
                                    ] ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          a lmdoc:ClassPopupSummary ;
                          arg:resource spin:_this ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:varName "graph" ;
                      ui:varValue [
                          sp:varName "myGraph" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:queryGraph [
                  a sp:iri ;
                  sp:arg1 [
                      a spif:decodeURL ;
                      sp:arg1 [
                          a sp:str ;
                          sp:arg1 [
                              sp:varName "graph" ;
                            ] ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:id "lmdoc-popup" ;
      ui:priority -20 ;
    ] ;
  ui:instanceView [
      a ui:group ;
      ui:child [
          a lmdoc:DetailedClassView ;
          arg:class spin:_this ;
          arg:showConstructors false ;
          arg:showInstances false ;
          arg:showRules false ;
          ui:childIndex 0 ;
        ] ;
      ui:id "lmdoc" ;
      ui:priority -20 ;
    ] ;
.
rdfs:Resource
  ui:instanceView [
      a ui:group ;
      let:resource [
          a sp:iri ;
          sp:arg1 [
              a spl:object ;
              sp:arg1 spin:_this ;
              sp:arg2 lmcat:resourceForOverview ;
            ] ;
        ] ;
      ui:child [
          a ui:CommentNode ;
          ui:childIndex 0 ;
          rdfs:comment "swa:ResourceFormBody arg:resource=\"{= spl:object(?this, lmcat:resourceForOverview) }\"/" ;
        ] ;
      ui:child [
          a ui:resourceView ;
          ui:childIndex 1 ;
          ui:matchIds "overview" ;
          ui:resource [
              a spl:object ;
              sp:arg1 spin:_this ;
              sp:arg2 lmcat:resourceForOverview ;
            ] ;
        ] ;
      ui:id "specificContent" ;
      ui:priority 2 ;
    ] ;
  ui:instanceView [
      a ui:group ;
      ui:child [
          a html:P ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "Should not be here with " ;
            ] ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 1 ;
              ui:text spin:_this ;
            ] ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 2 ;
              ui:text "?" ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:id "overview" ;
      ui:priority -2 ;
    ] ;
  ui:instanceView [
