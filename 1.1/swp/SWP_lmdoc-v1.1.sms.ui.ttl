                      ui:child [
                          a ui:forEach ;
                          ui:child [
                              a html:P ;
                              html:class "lm-para, dashedbox" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      a ui:encodeNode ;
                                      sp:arg1 [
                                          sp:varName "property" ;
                                        ] ;
                                    ] ;
