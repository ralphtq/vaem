  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:swpElement ;
      spl:valueType ui:NodeClass ;
      sm:next lmdoc:CreateHTMLforResource ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a ui:catch ;
