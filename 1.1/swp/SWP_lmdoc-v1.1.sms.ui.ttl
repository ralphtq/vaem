                      a ui:call ;
                      arg:subject [
                          sp:varName "resource" ;
                        ] ;
                      ui:child [
                          a html:Div ;
                          html:class "lm-header-box" ;
                          ui:child [
                              a lmdoc:ResourceDocAnchor ;
                              arg:resource [
                                  sp:varName "resource" ;
                                ] ;
