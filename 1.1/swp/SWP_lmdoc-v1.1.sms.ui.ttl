                                          sp:varName "docFile" ;
                                        ] ;
                                      sp:predicate vaem:latestPublishedVersion ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object dct:created ;
                                      sp:predicate vaem:usesNonImportedResource ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
