                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object dct:rights ;
                                      sp:predicate vaem:usesNonImportedResource ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object dct:subject ;
                                      sp:predicate vaem:usesNonImportedResource ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object dct:title ;
                                      sp:predicate vaem:usesNonImportedResource ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object dct:description ;
                                      sp:predicate vaem:usesNonImportedResource ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object dct:contributor ;
                                      sp:predicate vaem:usesNonImportedResource ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object dct:creator ;
                                      sp:predicate vaem:usesNonImportedResource ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object dct:author ;
                                      sp:predicate vaem:usesNonImportedResource ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object voag:CC-SHAREALIKE_3PT0-US ;
                                      sp:predicate vaem:usesNonImportedResource ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object voag:QUDT-Attribution ;
                                      sp:predicate vaem:usesNonImportedResource ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object skos:closeMatch ;
                                      sp:predicate vaem:usesNonImportedResource ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object skos:exactMatch ;
                                      sp:predicate vaem:usesNonImportedResource ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object voag:QUDT-Attribution ;
                                      sp:predicate vaem:withAttributionTo ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object voag:CC-SHAREALIKE_3PT0-US ;
                                      sp:predicate vaem:hasLicenseType ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object "2.0" ;
                                      sp:predicate vaem:revision ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
