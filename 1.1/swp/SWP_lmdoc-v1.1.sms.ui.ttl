              ui:child [
                  a swa:Space ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  a swa:Space ;
                  ui:childIndex 4 ;
                ] ;
              ui:child [
                  a swa:Space ;
                  ui:childIndex 6 ;
                ] ;
              ui:child [
                  a html:Div ;
                  html:style "float: right" ;
                  ui:child [
                      a ui:insertionPoint ;
                      ui:childIndex 0 ;
                      ui:pointId "bottomBar" ;
                    ] ;
                  ui:childIndex 8 ;
                ] ;
              ui:child [
                  a html:Span ;
                  html:id [
                      a ui:concat ;
                      sp:arg1 [
                          sp:varName "fid" ;
                        ] ;
                      sp:arg2 "-editModeButtonBar" ;
                    ] ;
                  html:style [
                      a sp:if ;
                      sp:arg1 [
                          sp:varName "ei" ;
                        ] ;
                      sp:arg2 [
                          sp:varName "none" ;
                        ] ;
                      sp:arg3 "display: none" ;
                    ] ;
                  ui:child [
                      a swa:Button ;
                      arg:class "test-save-button" ;
                      arg:iconClass "ui-icon ui-icon-check" ;
                      arg:id [
                          a ui:concat ;
                          sp:arg1 [
                              sp:varName "fid" ;
                            ] ;
                          sp:arg2 "-saveButton" ;
                        ] ;
                      arg:label "Save Changes" ;
                      arg:onClick [
                          a ui:concat ;
                          sp:arg1 "swa.submitForm('" ;
                          sp:arg2 [
                              sp:varName "fid" ;
                            ] ;
                          sp:arg3 "', null, swa.checkPostConfigChangeWarning())" ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a swa:Button ;
                      arg:iconClass "ui-icon ui-icon-cancel" ;
                      arg:id [
                          a ui:concat ;
                          sp:arg1 [
                              sp:varName "fid" ;
                            ] ;
                          sp:arg2 "-cancelButton" ;
                        ] ;
                      arg:label "Cancel" ;
                      arg:onClick [
                          a ui:concat ;
                          sp:arg1 "swa.switchToViewForm('" ;
                          sp:arg2 [
                              sp:varName "fid" ;
                            ] ;
                          sp:arg3 "')" ;
                        ] ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      a swa:Space ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      a ui:if ;
                      ui:child [
                          a swa:Space ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          a swa:Space ;
                          ui:childIndex 4 ;
                        ] ;
                      ui:child [
                          a swa:Space ;
                          ui:childIndex 5 ;
