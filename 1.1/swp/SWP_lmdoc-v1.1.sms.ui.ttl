lmdoc:InstanceSummaryView
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraph [
          a sp:iri ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
        ] ;
      let:myOverlay [
          a sp:iri ;
          sp:arg1 [
              sp:varName "overlay" ;
            ] ;
        ] ;
      let:myResource [
          a sp:iri ;
          sp:arg1 [
              sp:varName "resource" ;
            ] ;
        ] ;
      ui:child [
          a ui:setContext ;
          ui:child [
              a html:Div ;
              html:id "summary_page" ;
              ui:child [
                  a html:Div ;
                  html:class "pt10px pl20px" ;
                  ui:child [
                      a lmdoc:Object ;
                      arg:predicate rdf:type ;
                      arg:subject [
                          sp:varName "myResource" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 5 ;
                ] ;
              ui:child [
                  a html:Div ;
                  html:class "swa-sub-title" ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Description" ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  a html:P ;
                  html:class "size-24" ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          a smf:qname ;
                          sp:arg1 [
                              sp:varName "myResource" ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a html:Div ;
                      html:class "pt10px pl20px" ;
                      ui:child [
                          a lmdoc:Object ;
                          arg:predicate prov:wasInfluencedBy ;
                          arg:subject [
                              sp:varName "myResource" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      a html:Div ;
                      html:class "swa-sub-title" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "References" ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a lmdoc:VSpace ;
                      arg:margin "10px;" ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 6 ;
                  ui:condition [
                      a lmdoc:hasValueForProperty ;
                      sp:arg1 [
                          sp:varName "myResource" ;
                        ] ;
                      sp:arg2 prov:wasInfluencedBy ;
                    ] ;
                ] ;
              ui:child [
                  a lmdoc:MaybeDescription ;
                  arg:resource [
                      sp:varName "myResource" ;
                    ] ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  a lmdoc:VSpace ;
                  arg:margin "10px;" ;
                  ui:childIndex 4 ;
                ] ;
              ui:child [
                  a lmdoc:VSpace ;
                  arg:margin "30px;" ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a lmdoc:VSpace ;
                  arg:margin "30px;" ;
                  ui:childIndex 7 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a ui:CommentNode ;
              ui:childIndex 0 ;
              rdfs:comment "ui:dumpScope ui:message=\"DEBUG1: lmdoc:InstanceSummaryView - {= ?myResource }\"/" ;
            ] ;
          ui:child [
              a lmdoc:Footer ;
              ui:childIndex 2 ;
            ] ;
          ui:childIndex 0 ;
          ui:queryGraph [
              a ui:unionOfGraphs ;
              sp:arg1 [
                  a ui:graphWithImports ;
                  sp:arg1 [
                      sp:varName "myGraph" ;
                    ] ;
                ] ;
              sp:arg2 ui:view ;
              sp:arg3 [
                  a ui:graphWithImports ;
                  sp:arg1 [
                      sp:varName "myOverlay" ;
                    ] ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Instance Summary View" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:InstancesGeneratorSection
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraphMetadata [
          a spl:object ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      let:tableId "lm_resources" ;
      ui:child [
          a html:Div ;
          html:style "margin: 40px 0 25px 0;" ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          a ui:call ;
          arg:graph [
              sp:varName "graph" ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a html:Div ;
                  html:style "padding:20px;" ;
                  ui:child [
                      a html:Button ;
                      html:class "lm-button" ;
                      html:onclick [
                          a ui:concat ;
                          sp:arg1 "lm.acceptSelection('" ;
                          sp:arg2 [
                              sp:varName "tableId" ;
                            ] ;
                          sp:arg3 "', '" ;
                          sp:arg4 [
                              a xsd:string ;
                              sp:arg1 [
                                  sp:varName "graph" ;
                                ] ;
                            ] ;
                          sp:arg5 "', '" ;
                          sp:arg6 [
                              sp:varName "overlay" ;
                            ] ;
                          sp:arg7 "')" ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Accept Selections" ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      a html:Button ;
                      html:class "lm-button" ;
                      html:onclick [
                          a ui:concat ;
                          sp:arg1 "lmdoc.clearSelection('" ;
                          sp:arg2 [
                              sp:varName "tableId" ;
                            ] ;
                          sp:arg3 "')" ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Clear Selections" ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a html:Button ;
                      html:class "lm-button" ;
                      html:onclick [
                          a ui:concat ;
                          sp:arg1 "lmdoc.selectAll('" ;
                          sp:arg2 [
                              sp:varName "tableId" ;
                            ] ;
                          sp:arg3 "')" ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Select All" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a html:H2 ;
                  html:id [
                      a lmdoc:makeAnchorFromString ;
                      arg:label [
                          sp:varName "sectionHeading" ;
                        ] ;
                    ] ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  a html:Table ;
                  html:class "lm-table" ;
                  html:id [
                      sp:varName "tableId" ;
                    ] ;
                  ui:child [
                      a html:Tbody ;
                      ui:child [
                          a ui:forEach ;
                          ui:child [
                              a html:Div ;
                              let:id [
                                  a ui:uniqueId ;
                                ] ;
                              ui:child [
                                  a html:Tr ;
                                  html:class "lm-row" ;
                                  ui:child [
                                      a html:Td ;
                                      html:class "lm-column" ;
                                      html:id [
                                          a fn:concat ;
                                          sp:arg1 "td-resource_" ;
                                          sp:arg2 [
                                              sp:varName "id" ;
                                            ] ;
                                        ] ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              a xsd:string ;
                                              sp:arg1 [
                                                  sp:varName "instance" ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:child [
                                      a html:Td ;
                                      html:class "lm-column" ;
                                      ui:child [
                                          a html:Button ;
                                          html:class "lm-button" ;
                                          html:onclick [
                                              a ui:concat ;
                                              sp:arg1 "lm.generate('" ;
                                              sp:arg2 [
                                                  a xsd:string ;
                                                  sp:arg1 [
                                                      sp:varName "instance" ;
                                                    ] ;
                                                ] ;
                                              sp:arg3 "','" ;
                                              sp:arg4 [
                                                  a xsd:string ;
                                                  sp:arg1 [
                                                      sp:varName "graph" ;
                                                    ] ;
                                                ] ;
                                              sp:arg5 "','" ;
                                              sp:arg6 [
                                                  sp:varName "overlay" ;
                                                ] ;
                                              sp:arg7 "')" ;
                                            ] ;
                                          ui:child [
                                              a ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text "View" ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 2 ;
                                    ] ;
                                  ui:child [
                                      a html:Td ;
                                      html:class "lm-column" ;
                                      ui:child [
                                          a html:Input ;
                                          html:name [
                                              a ui:concat ;
                                              sp:arg1 [
                                                  a fn:concat ;
                                                  sp:arg1 "CB_" ;
                                                  sp:arg2 [
                                                      sp:varName "id" ;
                                                    ] ;
                                                ] ;
                                              sp:arg2 " " ;
                                            ] ;
                                          html:type "checkbox" ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 3 ;
                                    ] ;
                                  ui:child [
                                      a html:Td ;
                                      html:class "lm-column" ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              sp:varName "qName" ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "instances" ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a html:Thead ;
                      html:class "lm-table-header" ;
                      ui:child [
                          a html:Tr ;
                          html:class "lm-row" ;
                          ui:child [
                              a html:Th ;
                              html:class "lm-column-label" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Generate" ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              a html:Th ;
                              html:class "lm-column-label" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Instance" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              a html:Th ;
                              html:class "lm-column-label" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Quick Look" ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              a html:Th ;
                              html:class "lm-column-label" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "URI" ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:gt ;
                  sp:arg1 [
                      a spr:rowCount ;
                      sp:arg1 [
                          sp:varName "instances" ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:getInstancesOfType ;
          ui:varName "instances" ;
          vaem:namespacePrefix [
              a ui:contextValue ;
              sp:arg1 "namespacePrefix" ;
            ] ;
        ] ;
      ui:child [
          a lmdoc:VSpace ;
          arg:margin "40px;" ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Instances generator section" ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:InstancesList
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraph [
          a sp:iri ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
        ] ;
      ui:child [
          a ui:group ;
          let:myGraphMetadata [
              a spl:objectInGraph ;
              sp:arg1 [
                  sp:varName "myGraph" ;
                ] ;
              sp:arg2 vaem:hasGraphMetadata ;
              sp:arg3 [
                  sp:varName "myGraph" ;
                ] ;
            ] ;
          ui:child [
              a ui:group ;
              let:myOverlay [
                  a sp:iri ;
                  sp:arg1 [
                      a sp:coalesce ;
                      sp:arg1 [
                          sp:varName "overlay" ;
                        ] ;
                      sp:arg2 ui:tempGraph ;
                    ] ;
                ] ;
              ui:child [
                  a ui:setContext ;
                  ui:child [
                      a ui:setContext ;
                      ui:child [
                          a html:Section ;
                          html:class "details" ;
                          html:id "details" ;
                          html:property "dct:abstract" ;
                          html:rel "bibo:Chapter" ;
                          html:resource "#ref" ;
                          html:typeof "bibo:Chapter" ;
                          ui:child [
                              a html:Section ;
                              html:class "informative" ;
                              html:id "instances" ;
                              ui:child [
                                  a lmdoc:InstancesTable ;
                                  arg:graph [
                                      sp:varName "myGraph" ;
                                    ] ;
                                  arg:overlay [
                                      sp:varName "overlay" ;
                                    ] ;
                                  arg:sectionHeading "Instances" ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 4 ;
                        ] ;
                      ui:child [
                          a html:Section ;
                          html:class "introductory" ;
                          html:id "abstract" ;
                          html:property "dct:abstract" ;
                          html:rel "bibo:Chapter" ;
                          html:resource "#ref" ;
                          html:typeof "bibo:Chapter" ;
                          ui:child [
                              a lmdoc:AbstractSection ;
                              arg:metadata [
                                  sp:varName "myGraphMetadata" ;
                                ] ;
                              arg:sectionHeading "Abstract" ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 3 ;
                        ] ;
                      ui:child [
                          a ui:if ;
                          ui:child [
                              a debug-swa:DumpTriplesForResourceAsSubject ;
                              arg:resource [
                                  a ui:concat ;
                                  sp:arg1 [
                                      sp:varName "myGraphMetadata" ;
                                    ] ;
                                  sp:arg2 " " ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 2 ;
                          ui:condition [
                              a fn:contains ;
                              sp:arg1 [
                                  sp:varName "flags" ;
                                ] ;
                              sp:arg2 "Sgmd" ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:if ;
                          ui:child [
                              a html:P ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Current query graph is " ;
