                          ui:text [
                              sp:varName "graph" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition "(!bound(?myGraphMetadata))" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:P ;
              html:class "lm-para" ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Missiing graph value" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition "(!bound(?graph))" ;
        ] ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraph [
          a sp:iri ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
        ] ;
      ui:child [
          a ui:group ;
          let:myOverlay [
              a sp:iri ;
              sp:arg1 [
                  a sp:coalesce ;
                  sp:arg1 [
                      sp:varName "overlay" ;
                    ] ;
                  sp:arg2 ui:tempGraph ;
                ] ;
            ] ;
          ui:child [
              a ui:setContext ;
              ui:child [
                  a ui:setContext ;
                  ui:child [
                      a ui:setContext ;
                      ui:child [
                          a ui:group ;
                          let:myGraphMetadata [
                              a spl:object ;
                              sp:arg1 [
                                  sp:varName "myGraph" ;
                                ] ;
                              sp:arg2 vaem:hasGraphMetadata ;
                            ] ;
                          ui:child [
                              a ui:dumpScope ;
                              ui:childIndex 0 ;
                              ui:message [
                                  a ui:concat ;
                                  sp:arg1 "DEBUG1: lmdoc:ClassSummary - " ;
                                  sp:arg2 [
                                      sp:varName "resource" ;
                                    ] ;
                                ] ;
                            ] ;
                          ui:child [
                              a lmdoc:DetailedClassView ;
                              arg:class [
                                  sp:varName "resource" ;
                                ] ;
                              arg:showDiagram false ;
                              arg:showInstances false ;
                              arg:showTitle false ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              a lmdoc:Footer ;
                              ui:childIndex 4 ;
                            ] ;
                          ui:child [
                              a lmdoc:PartHeader ;
                              arg:metadata [
                                  sp:varName "myGraphMetadata" ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              a lmdoc:ResourceHeader ;
                              arg:resource [
                                  sp:varName "resource" ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:queryGraph [
                          a ui:unionOfGraphs ;
                          sp:arg1 [
                              a ui:graphWithImports ;
                              sp:arg1 [
                                  sp:varName "myGraph" ;
                                ] ;
                            ] ;
                          sp:arg2 [
                              a ui:graphWithImports ;
                              sp:arg1 [
                                  sp:varName "myOverlay" ;
                                ] ;
                            ] ;
                          sp:arg3 [
                              a ui:graphWithImports ;
                              sp:arg1 <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "graph" ;
                  ui:varValue [
                      sp:varName "myGraph" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:varName "flags" ;
              ui:varValue [
                  sp:varName "flags" ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=lmdoc:ClassSummary&graph=http://www.linkedmodel.org/2.0/schema/vaem&resource=http%3A%2F%2Fwww.linkedmodel.org%2Fschema%2Fvaem%23GraphRole""" ;
  rdfs:label "Class Summary" ;
  rdfs:subClassOf lmdoc:Parts ;
