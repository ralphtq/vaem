              ui:childIndex 2 ;
            ] ;
          ui:child [
              a ui:elseif ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "object" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a lmdoc:LangDisplay ;
                      arg:lang [
                          a sp:lang ;
                          sp:arg1 [
                              sp:varName "object" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:condition [
                      a sp:ne ;
                      sp:arg1 [
                          a sp:lang ;
                          sp:arg1 [
                              sp:varName "object" ;
                            ] ;
                        ] ;
                      sp:arg2 "" ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a html:A ;
                  html:href [
                      a sp:str ;
                      sp:arg1 [
                          sp:varName "object" ;
                        ] ;
                    ] ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          a sp:str ;
                          sp:arg1 [
                              sp:varName "object" ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a fn:starts-with ;
                  sp:arg1 [
                      a sp:str ;
                      sp:arg1 [
                          sp:varName "object" ;
                        ] ;
                    ] ;
                  sp:arg2 "http" ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a html:Div ;
          html:class "pl40px pr10px float-left" ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "label" ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A node viewer for literal values, displaying the literal's text. If a language tag is present, then this will be displayed behind the text." ;
  rdfs:label "Literal viewer with label" ;
  rdfs:subClassOf lmdoc:LiteralViewer ;
.
lmdoc:MagicProperties
  a spin:MagicProperty ;
  rdfs:label "Magic properties" ;
  rdfs:subClassOf spin:MagicProperties ;
.
lmdoc:MaybeDescription
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate." ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a lmdoc:MaybeDescriptionUsingProperty ;
          arg:property dct:description ;
          arg:resource [
              sp:varName "resource" ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          a lmdoc:MaybeDescriptionUsingProperty ;
          arg:property vaem:description ;
          arg:resource [
              sp:varName "resource" ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a lmdoc:MaybeDescriptionUsingProperty ;
          arg:property rdfs:comment ;
          arg:resource [
              sp:varName "resource" ;
            ] ;
          ui:childIndex 3 ;
        ] ;
      ui:child [
          a lmdoc:MaybeDescriptionUsingProperty ;
          arg:property skos:definition ;
          arg:resource [
              sp:varName "resource" ;
            ] ;
          ui:childIndex 2 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Maybe Description" ;
  rdfs:label "Maybe Description" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:MaybeDescriptionUsingProperty
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate." ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:desc [
          a sp:coalesce ;
          sp:arg1 [
              a spl:object ;
              sp:arg1 [
                  sp:varName "resource" ;
                ] ;
              sp:arg2 [
                  sp:varName "property" ;
                ] ;
            ] ;
          sp:arg2 "Nothing" ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a ui:else ;
              ui:child [
                  a html:P ;
                  html:class "lm-para" ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "desc" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a html:P ;
                  html:class "lm-para" ;
                  ui:child [
                      a ui:parse ;
                      ui:childIndex 0 ;
                      ui:str [
                          a sp:str ;
                          sp:arg1 [
                              sp:varName "desc" ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:eq ;
                  sp:arg1 [
                      a sp:str ;
                      sp:arg1 [
                          a sp:datatype ;
                          sp:arg1 [
                              sp:varName "desc" ;
                            ] ;
                        ] ;
                    ] ;
                  sp:arg2 "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML" ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:ne ;
              sp:arg1 [
                  a sp:str ;
                  sp:arg1 [
                      sp:varName "desc" ;
                    ] ;
                ] ;
              sp:arg2 "Nothing" ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Maybe Description using property" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:MaybeHTMLstring
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate." ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:desc [
          a sp:coalesce ;
          sp:arg1 [
              a spl:object ;
              sp:arg1 [
                  sp:varName "resource" ;
                ] ;
              sp:arg2 lmdoc:htmlString ;
            ] ;
          sp:arg2 "Nothing" ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:P ;
              html:class "lm-para" ;
              ui:child [
                  a ui:parse ;
                  ui:childIndex 0 ;
                  ui:str [
                      sp:varName "desc" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:ne ;
              sp:arg1 [
                  sp:varName "desc" ;
                ] ;
              sp:arg2 "Nothing" ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Maybe an HTML string" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:MultiColumnList
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:titleFunction ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:columns ;
      spl:valueType xsd:integer ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:includeWebLink ;
      spl:valueType xsd:boolean ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resultSet ;
      spl:valueType sp:Select ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:count [
          a spr:rowCount ;
          sp:arg1 [
              sp:varName "resultSet" ;
            ] ;
        ] ;
      let:myTitleFunction [
          a sp:coalesce ;
          sp:arg1 [
              sp:varName "titleFunction" ;
            ] ;
          sp:arg2 [
              a ui:contextValue ;
              sp:arg1 "title-function" ;
            ] ;
          sp:arg3 lmdoc:defaultTitleFunction ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:Div ;
              html:class "lm-index-table" ;
              let:max [
                  a sp:floor ;
                  sp:arg1 [
                      a sp:divide ;
                      sp:arg1 [
                          a xsd:integer ;
                          sp:arg1 [
                              sp:varName "count" ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          a xsd:integer ;
                          sp:arg1 [
                              sp:varName "columns" ;
                            ] ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  a html:Div ;
                  html:class "container-fluid" ;
                  ui:child [
                      a ui:forEach ;
                      ui:child [
                          a html:Div ;
                          html:class "col-xs-12 col-sm-6 col-md-4 col-lg-3" ;
                          ui:child [
                              a lmdoc:ResourceLink ;
                              arg:includeWebLink [
                                  sp:varName "includeWebLink" ;
                                ] ;
                              arg:resource [
                                  sp:varName "resource" ;
                                ] ;
                              arg:title [
                                  a smf:invoke ;
                                  sp:arg1 [
                                      sp:varName "myTitleFunction" ;
                                    ] ;
                                  sp:arg2 [
                                      sp:varName "resource" ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:resultSet [
                          sp:varName "resultSet" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:gt ;
              sp:arg1 [
                  sp:varName "count" ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
    ] ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:MyBNodeViewer
  a swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      a swa:WeightedExpression ;
      swa:expression [
          a sp:eq ;
          sp:arg1 [
              sp:varName "kind" ;
            ] ;
          sp:arg2 "blank" ;
        ] ;
      swa:weight 50 ;
    ] ;
  ui:private true ;
  ui:prototype [
      a html:Div ;
      html:class "swa-shifted-label" ;
      ui:child [
          a html:Pre ;
          html:class "query" ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  a ui:label ;
                  sp:arg1 [
                      sp:varName "object" ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          a ui:CommentNode ;
          ui:childIndex 1 ;
          rdfs:comment "ui:resourceView ui:matchIds=\"showbnode\" ui:resource=\"{= ?object }\"/" ;
        ] ;
    ] ;
  rdfs:comment "My object viewer for blank nodes." ;
  rdfs:label "BNode viewer" ;
  rdfs:subClassOf lmdoc:BNodeViewer ;
.
lmdoc:NoAssociations
  a spin:Function ;
  spin:body [
      a sp:Ask ;
      sp:where (
          [
            a sp:Filter ;
            sp:expression false ;
          ]
        ) ;
    ] ;
  rdfs:label "No associations" ;
  rdfs:subClassOf swa:AssociationsFilterFunctions ;
.
lmdoc:NonImportedResources
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:metadata ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:ns [
          a spl:object ;
          sp:arg1 [
              sp:varName "metadata" ;
            ] ;
          sp:arg2 vaem:namespace ;
        ] ;
      ui:child [
          a ui:group ;
          letrs:nonImportedResources [
              a sp:Select ;
              sp:orderBy (
                  [
                    sp:varName "qname" ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "resource" ;
                  ]
                  [
                    sp:varName "qname" ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "resource" ;
                      ] ;
                    sp:predicate vaem:usesNonImportedResource ;
                    sp:subject [
                        sp:varName "metadata" ;
                      ] ;
                  ]
                  [
                    a sp:Bind ;
                    sp:expression [
                        a smf:qname ;
                        sp:arg1 [
                            sp:varName "usedResource" ;
                          ] ;
                      ] ;
                    sp:variable [
                        sp:varName "qname" ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              a ui:group ;
              let:count [
                  a spr:rowCount ;
                  sp:arg1 [
                      sp:varName "nonImportedResources" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a html:H2 ;
                      html:id [
                          a lmdoc:makeAnchorFromString ;
                          arg:label [
                              sp:varName "sectionHeading" ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "sectionHeading" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      a html:P ;
                      html:class "lm-para" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "The graph uses " ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text [
                              sp:varName "count" ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 2 ;
                          ui:text " resources from other graphs that are not imported, as listed below:" ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a lmdoc:MultiColumnList ;
                      arg:columns 5 ;
                      arg:includeWebLink true ;
                      arg:resultSet [
                          sp:varName "nonImportedResources" ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      a sp:gt ;
                      sp:arg1 [
                          sp:varName "count" ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "non-imported resources" ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:Object
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:hideProperty ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      a lmdoc:LabeledObjects ;
      arg:single "true" ;
      ui:args "*" ;
    ] ;
  rdfs:comment "Inserts a widget for a single value of a given predicate at the given subject. This element should only be used if the property doesn't have a max cardinality of 1 anyway, to overload the default behavior." ;
  rdfs:label "Object" ;
  rdfs:subClassOf lmdoc:AbstractObject ;
.
lmdoc:ObjectElements
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:elementId ;
      spl:valueType xsd:string ;
      rdfs:comment "An optional HTML ID for the element containing this object." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The subject resource of the form or widget. May be left empty in which case the subjectType will be used." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:predicate ;
      spl:valueType rdf:Property ;
      rdfs:comment "The predicate." ;
    ] ;
  rdfs:seeAlso swa:ObjectElements ;
  rdfs:subClassOf lmdoc:FormElements ;
.
lmdoc:ObjectViewer
  a swa:ObjectViewerClass ;
  ui:overrides swa:ObjectViewer ;
  ui:private true ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a html:Div ;
          html:class "lmdoc-object-widget" ;
          let:class [
              a sp:coalesce ;
              sp:arg1 [
                  a ui:contextValue ;
                  sp:arg1 "viewWidget" ;
                ] ;
              sp:arg2 [
                  a swa:bestObjectViewerClass ;
                  arg:object [
                      sp:varName "object" ;
                    ] ;
                  arg:predicate [
                      sp:varName "predicate" ;
                    ] ;
                  arg:subject [
                      sp:varName "subject" ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              a html:Div ;
              html:class "pb20px" ;
              html:style "padding-left:120px;" ;
              html:title [
                  a sp:str ;
                  sp:arg1 [
                      sp:varName "object" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:else ;
                  ui:child [
                      a ui:if ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "[Error: no ObjectViewer found for " ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text [
                              a ui:label ;
                              sp:arg1 [
                                  sp:varName "subject" ;
                                ] ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 2 ;
                          ui:text ", " ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 3 ;
                          ui:text [
                              a ui:label ;
                              sp:arg1 [
                                  sp:varName "predicate" ;
                                ] ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 4 ;
                          ui:text ", " ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 5 ;
                          ui:text [
                              a ui:label ;
                              sp:arg1 [
                                  sp:varName "object" ;
                                ] ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 6 ;
                          ui:text "]" ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          a sp:bound ;
                          sp:arg1 [
                              sp:varName "object" ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a ui:dynamicView ;
                      arg:object [
                          sp:varName "object" ;
                        ] ;
                      arg:predicate [
                          sp:varName "predicate" ;
                        ] ;
                      arg:subject [
                          sp:varName "subject" ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:class [
                          sp:varName "class" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      a sp:bound ;
                      sp:arg1 [
                          sp:varName "class" ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a ui:dumpScope ;
              ui:childIndex 0 ;
              ui:message [
                  a ui:concat ;
                  sp:arg1 "DEBUG1: lmdoc:ObjectViewer " ;
                  sp:arg2 [
                      sp:varName "class" ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment """A read-only widget displaying a single object. In order to be selected on forms, subclasses of this class must specify a weight > 0 and an expression that returns true for the given input variable bindings:
- ?type: the datatype or rdf:type of the object being displayed
- ?kind: \"literal\", \"blank\", \"uri\" or \"image\"
- ?predicate: the property being displayed""" ;
  rdfs:label "Object viewer" ;
  rdfs:seeAlso swa:ObjectViewer ;
  rdfs:subClassOf lmdoc:ObjectWidget ;
.
lmdoc:ObjectViewerRow
  a swa:ObjectWidgetRowClass ;
  ui:private true ;
  ui:prototype [
      a ui:group ;
      let:datatype [
          a sp:if ;
          sp:arg1 [
              a sp:isLiteral ;
              sp:arg1 [
                  sp:varName "object" ;
                ] ;
            ] ;
          sp:arg2 [
              a sp:datatype ;
              sp:arg1 [
                  sp:varName "object" ;
                ] ;
            ] ;
          sp:arg3 [
              sp:varName "no" ;
            ] ;
        ] ;
      let:uid [
          a ui:uniqueId ;
        ] ;
      ui:child [
          a html:Div ;
          html:about [
              a sp:if ;
              sp:arg1 [
                  a sp:isIRI ;
                  sp:arg1 [
                      sp:varName "subject" ;
                    ] ;
                ] ;
              sp:arg2 [
                  sp:varName "subject" ;
                ] ;
              sp:arg3 [
                  sp:varName "noBNodes" ;
                ] ;
            ] ;
          html:class "swa-widget-row" ;
          html:content [
              a sp:if ;
              sp:arg1 [
                  a sp:isLiteral ;
                  sp:arg1 [
                      sp:varName "object" ;
                    ] ;
                ] ;
              sp:arg2 [
                  sp:varName "object" ;
                ] ;
              sp:arg3 [
                  sp:varName "no" ;
                ] ;
            ] ;
          html:datatype [
              sp:varName "datatype" ;
            ] ;
          html:href [
              a sp:if ;
              sp:arg1 [
                  a sp:isIRI ;
                  sp:arg1 [
                      sp:varName "object" ;
                    ] ;
                ] ;
              sp:arg2 [
                  sp:varName "object" ;
                ] ;
              sp:arg3 [
                  sp:varName "no" ;
                ] ;
            ] ;
          html:id [
              sp:varName "uid" ;
            ] ;
          html:property [
              a sp:if ;
              sp:arg1 [
                  a sp:isLiteral ;
                  sp:arg1 [
                      sp:varName "object" ;
                    ] ;
                ] ;
              sp:arg2 [
                  a ui:encodeNode ;
                  sp:arg1 [
                      sp:varName "predicate" ;
                    ] ;
                ] ;
              sp:arg3 [
                  sp:varName "no" ;
                ] ;
            ] ;
          html:rel [
              a sp:if ;
              sp:arg1 [
                  a sp:isIRI ;
                  sp:arg1 [
                      sp:varName "object" ;
                    ] ;
                ] ;
              sp:arg2 [
                  a ui:encodeNode ;
                  sp:arg1 [
                      sp:varName "predicate" ;
                    ] ;
                ] ;
              sp:arg3 [
                  sp:varName "no" ;
                ] ;
            ] ;
          ui:addNamespace [
              a sp:if ;
              sp:arg1 [
                  a swa:hasPrefix ;
                  arg:resource [
                      sp:varName "predicate" ;
                    ] ;
                ] ;
              sp:arg2 [
                  sp:varName "predicate" ;
                ] ;
              sp:arg3 [
                  sp:varName "none" ;
                ] ;
            ] ;
          ui:child [
              a lmdoc:ObjectViewer ;
              arg:uid [
                  sp:varName "uid" ;
                ] ;
              ui:args "*" ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "A row in an ObjectViewer." ;
  rdfs:label "Object viewer row (lmdoc)" ;
  rdfs:subClassOf lmdoc:ObjectWidgetRow ;
.
lmdoc:ObjectWidget
  a swa:ObjectWidgetClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:object ;
      rdfs:comment "The object to display or edit." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:uid ;
      spl:valueType xsd:string ;
      rdfs:comment "The uid used to identify the triple." ;
    ] ;
  ui:private true ;
  ui:prototype [
      a ui:dynamicView ;
      arg:object [
          sp:varName "object" ;
        ] ;
      arg:predicate [
          sp:varName "predicate" ;
        ] ;
      arg:subject [
          sp:varName "subject" ;
        ] ;
      ui:class [
          a swa:modeProperty ;
          arg:predicate swa:objectWidgetClass ;
        ] ;
    ] ;
  rdfs:comment "A component representing a single RDF node. Depending on the mode, this may for example be an ObjectViewer or ObjectEditor." ;
  rdfs:label "Object widget" ;
  rdfs:subClassOf lmdoc:ObjectElements ;
.
lmdoc:ObjectWidgetRow
  a swa:ObjectWidgetRowClass ;
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:object ;
      rdfs:comment "The object node." ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a html:Div ;
          ui:child [
              a ui:dynamicView ;
              arg:object [
                  sp:varName "object" ;
                ] ;
              arg:predicate [
                  sp:varName "predicate" ;
                ] ;
              arg:subject [
                  sp:varName "subject" ;
                ] ;
              ui:childIndex 0 ;
              ui:class lmdoc:ObjectViewer ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "Superclass for the widget row types." ;
  rdfs:label "Object widget row" ;
  rdfs:seeAlso swa:ObjectWidgetRow ;
  rdfs:subClassOf lmdoc:ObjectElements ;
.
lmdoc:Objects
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:tabular ;
      spl:valueType xsd:boolean ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:function [
          a swa:modeProperty ;
          arg:predicate swa:isSingleFunction ;
        ] ;
      ui:child [
          a lmdoc:LabeledObjects ;
          arg:single [
              a sp:if ;
              sp:arg1 [
                  a sp:bound ;
                  sp:arg1 [
                      sp:varName "function" ;
                    ] ;
                ] ;
              sp:arg2 [
                  a spif:invoke ;
                  sp:arg1 [
                      sp:varName "function" ;
                    ] ;
                  sp:arg2 [
                      sp:varName "predicate" ;
                    ] ;
                  sp:arg3 [
                      sp:varName "subject" ;
                    ] ;
                ] ;
              sp:arg3 [
                  a swa:modeProperty ;
                  arg:predicate swa:isSingleConstant ;
                ] ;
            ] ;
          ui:args "*" ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "A two-columned structure with a label on the left and zero or more objects on the right." ;
  rdfs:label "Objects" ;
  rdfs:subClassOf lmdoc:AbstractObject ;
.
lmdoc:ObjectsBody
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:elementId ;
      spl:valueType xsd:string ;
      rdfs:comment "An optional HTML ID for the element containing this object." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:offset ;
      spl:valueType xsd:integer ;
      rdfs:comment "The offset for the \"next 50\" recursive calls." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to allow at most one value." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The subject resource of the form or widget. May be left empty in which case the subjectType will be used." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:predicate ;
      spl:valueType rdf:Property ;
      rdfs:comment "The predicate." ;
    ] ;
  ui:private true ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a ui:else ;
          ui:child [
              a html:Div ;
              html:class "lmdoc-object-row" ;
              ui:child [
                  a lmdoc:ObjectWidgetRow ;
                  arg:predicate [
                      sp:varName "predicate" ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a ui:call ;
              arg:predicate [
                  sp:varName "predicate" ;
                ] ;
              arg:subject [
                  sp:varName "subject" ;
                ] ;
              let:special [
                  a swa:specialAddButtonFunction ;
                  arg:predicate [
                      sp:varName "predicate" ;
                    ] ;
                  arg:subject [
                      sp:varName "subject" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:else ;
                  ui:child [
                      a ui:group ;
                      let:limit 50 ;
                      let:offset [
                          a sp:coalesce ;
                          sp:arg1 [
                              sp:varName "offset" ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                      ui:child [
                          a ui:forEach ;
                          ui:child [
                              a html:Div ;
                              html:class "lmdoc-object-row" ;
                              ui:child [
                                  a html:Div ;
                                  html:class "clear-both" ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  a lmdoc:ObjectWidgetRow ;
                                  arg:object [
                                      sp:varName "object" ;
                                    ] ;
                                  arg:predicate [
                                      sp:varName "predicate" ;
                                    ] ;
                                  arg:subject [
                                      sp:varName "subject" ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:limit [
                              sp:varName "limit" ;
                            ] ;
                          ui:offset [
                              sp:varName "offset" ;
                            ] ;
                          ui:resultSet [
                              sp:varName "rs" ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:group ;
                          let:id [
                              a ui:uniqueId ;
                            ] ;
                          let:rowCount [
                              a spr:rowCount ;
                              sp:arg1 [
                                  sp:varName "rs" ;
                                ] ;
                            ] ;
                          ui:child [
                              a ui:loadable ;
                              ui:child [
                                  a ui:if ;
                                  ui:child [
                                      a ui:else ;
                                      ui:child [
                                          a html:Div ;
                                          html:class "lmdoc-objects-show-more" ;
                                          ui:child [
                                              a html:A ;
                                              html:href "javascript:void(0)" ;
                                              html:onclick [
                                                  a ui:concat ;
                                                  sp:arg1 "swa.load('" ;
                                                  sp:arg2 [
                                                      sp:varName "id" ;
                                                    ] ;
                                                  sp:arg3 "', { newOffset: " ;
                                                  sp:arg4 [
                                                      a sp:add ;
                                                      sp:arg1 [
                                                          sp:varName "offset" ;
                                                        ] ;
                                                      sp:arg2 [
                                                          sp:varName "limit" ;
                                                        ] ;
                                                    ] ;
                                                  sp:arg5 " })" ;
                                                ] ;
                                              ui:child [
                                                  a ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text "Show entries " ;
                                                ] ;
                                              ui:child [
                                                  a ui:TextNode ;
                                                  ui:childIndex 1 ;
                                                  ui:text [
                                                      a sp:add ;
                                                      sp:arg1 [
                                                          a sp:add ;
                                                          sp:arg1 [
                                                              sp:varName "offset" ;
                                                            ] ;
                                                          sp:arg2 [
                                                              sp:varName "limit" ;
                                                            ] ;
                                                        ] ;
                                                      sp:arg2 1 ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  a ui:TextNode ;
                                                  ui:childIndex 2 ;
                                                  ui:text " to " ;
                                                ] ;
                                              ui:child [
                                                  a ui:TextNode ;
                                                  ui:childIndex 3 ;
                                                  ui:text [
                                                      a spl:min ;
                                                      sp:arg1 [
                                                          sp:varName "rowCount" ;
                                                        ] ;
                                                      sp:arg2 [
                                                          a sp:add ;
                                                          sp:arg1 [
                                                              a sp:add ;
                                                              sp:arg1 [
                                                                  sp:varName "offset" ;
                                                                ] ;
                                                              sp:arg2 [
                                                                  sp:varName "limit" ;
                                                                ] ;
                                                            ] ;
                                                          sp:arg2 [
                                                              sp:varName "limit" ;
                                                            ] ;
                                                        ] ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  a ui:TextNode ;
                                                  ui:childIndex 4 ;
                                                  ui:text " of " ;
                                                ] ;
                                              ui:child [
                                                  a ui:TextNode ;
                                                  ui:childIndex 5 ;
                                                  ui:text [
                                                      sp:varName "rowCount" ;
                                                    ] ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:child [
                                      a ui:if ;
                                      ui:child [
                                          a lmdoc:ObjectsBody ;
                                          arg:offset [
                                              sp:varName "newOffset" ;
                                            ] ;
                                          ui:args "*" ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                      ui:condition [
                                          a sp:bound ;
                                          sp:arg1 [
                                              sp:varName "newOffset" ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:condition [
                                      a sp:gt ;
                                      sp:arg1 [
                                          sp:varName "rowCount" ;
                                        ] ;
                                      sp:arg2 [
                                          a sp:add ;
                                          sp:arg1 [
                                              sp:varName "offset" ;
                                            ] ;
                                          sp:arg2 [
                                              sp:varName "limit" ;
                                            ] ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:loadId [
                                  sp:varName "id" ;
                                ] ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a html:Div ;
                      html:class "lmdoc-object-row" ;
                      ui:child [
                          a lmdoc:ObjectWidgetRow ;
                          arg:predicate [
                              sp:varName "predicate" ;
                            ] ;
                          arg:subject [
                              sp:varName "subject" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      a sp:and ;
                      sp:arg1 [
                          a sp:and ;
                          sp:arg1 [
                              a sp:and ;
                              sp:arg1 [
                                  a spr:isEmpty ;
                                  sp:arg1 [
                                      sp:varName "rs" ;
                                    ] ;
                                ] ;
                              sp:arg2 [
                                  a sp:not ;
                                  sp:arg1 [
                                      a swa:isViewMode ;
                                    ] ;
                                ] ;
                            ] ;
                          sp:arg2 [
                              a sp:not ;
                              sp:arg1 [
                                  a sp:bound ;
                                  sp:arg1 [
                                      sp:varName "special" ;
                                    ] ;
                                ] ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          a sp:not ;
                          sp:arg1 [
                              a swa:isBlankNodeProperty ;
                              arg:property [
                                  sp:varName "predicate" ;
                                ] ;
                            ] ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template swa:SortedObjects ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              a sp:bound ;
              sp:arg1 [
                  sp:varName "subject" ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The body of an Object(s) widget, typically containing one row for each value. This can be \"overloaded\" via a mode property." ;
  rdfs:label "Objects body" ;
  rdfs:subClassOf lmdoc:ObjectElements ;
.
lmdoc:ObjectsGroup
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:filterFunction ;
      spl:valueType spin:Function ;
      rdfs:comment "An optional filter function that takes a predicate and a subject as arguments and returns true for all predicates that should be displayed." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:predicates ;
      spl:valueType spr:Table ;
      rdfs:comment "A result set (e.g., SPARQL SELECT query) that delivers the predicates in this group." ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The resource to display." ;
    ] ;
  ui:prototype [
      a ui:group ;
      letrs:properties [
          a sp:Select ;
          sp:resultVariables (
              [
                sp:varName "predicate" ;
              ]
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "predicates" ;
                  ] ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?0" ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "?1" ;
                  ] ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?0" ;
                  ] ;
              ]
              [
                sp:object 0 ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?1" ;
                  ] ;
              ]
              [
                sp:object () ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?1" ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "predicate" ;
                  ] ;
                sp:predicate spr:colCells ;
                sp:subject [
                    sp:varName "?0" ;
                  ] ;
              ]
              [
                a sp:Filter ;
                sp:expression [
                    a sp:or ;
                    sp:arg1 [
                        a sp:not ;
                        sp:arg1 [
                            a sp:bound ;
                            sp:arg1 [
                                sp:varName "filterFunction" ;
                              ] ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        a spif:invoke ;
                        sp:arg1 [
                            sp:varName "filterFunction" ;
                          ] ;
                        sp:arg2 [
                            sp:varName "predicate" ;
                          ] ;
                        sp:arg3 [
                            sp:varName "subject" ;
                          ] ;
                      ] ;
                  ] ;
              ]
              [
                a sp:Filter ;
                sp:expression [
                    a sp:not ;
                    sp:arg1 [
                        a swa:isHiddenPropertyAtSubject ;
                        arg:property [
                            sp:varName "predicate" ;
                          ] ;
                        arg:subject [
                            sp:varName "subject" ;
                          ] ;
                      ] ;
                  ] ;
              ]
            ) ;
        ] ;
      ui:child [
          a ui:debug ;
          ui:child [
              a ui:dumpResultSet ;
              ui:childIndex 0 ;
              ui:message "DEBUG: lmdoc:ObjectsGroup" ;
              ui:resultSet [
                  sp:varName "properties" ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          a ui:if ;
          ui:child [
              a html:Div ;
              ui:child [
                  a ui:CommentNode ;
                  ui:childIndex 2 ;
                  rdfs:comment """table class=\"lm-table\" let:pid=\"{= ui:uniqueId() }\">
                <thead class=\"lm-table-header\">
                    <th class=\"lm-column-label\">{= ?label }</th>
                    <th class=\"lm-column-label\">Values</th>
                </thead>
                <tbody class=\"lm-table-body\">
                    <ui:forEach ui:resultSet=\"{= ?properties }\">
                        <lmdoc:Objects arg:predicate=\"{= ?predicate }\" arg:subject=\"{= ?subject }\" arg:tabular=\"true\"/>
                    </ui:forEach>
                </tbody>
            </table""" ;
                ] ;
              ui:child [
                  a ui:forEach ;
                  ui:child [
                      a lmdoc:Objects ;
                      arg:predicate [
                          sp:varName "predicate" ;
                        ] ;
                      arg:subject [
                          sp:varName "subject" ;
                        ] ;
                      arg:tabular true ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "properties" ;
                    ] ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a html:Div ;
                      html:class "swa-sub-title" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "label" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      a sp:bound ;
                      sp:arg1 [
                          sp:varName "label" ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
          ui:condition [
              a sp:not ;
              sp:arg1 [
                  a spr:isEmpty ;
                  sp:arg1 [
                      sp:varName "properties" ;
                    ] ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A group of lmdoc:Objects elements where the predicates are computed by taking a result set (e.g. of all relevant properties) and applying a filter on top of it, e.g. to only show the annotation properties among those that are relevant." ;
  rdfs:label "Objects group" ;
  rdfs:subClassOf lmdoc:ViewElements ;
