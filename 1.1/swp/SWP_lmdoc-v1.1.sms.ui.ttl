                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Description" ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              a html:Div ;
                              html:class "swa-sub-title" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Type" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              a lmdoc:MaybeDescription ;
                              arg:resource [
                                  sp:varName "resource" ;
                                ] ;
                              ui:childIndex 4 ;
                            ] ;
                          ui:child [
                              a lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isAnnotationProperty ;
                              arg:label "Annotations" ;
                              arg:predicates [
                                  sp:varName "rs" ;
                                ] ;
                              arg:subject [
                                  sp:varName "resource" ;
                                ] ;
                              ui:childIndex 8 ;
                            ] ;
                          ui:child [
                              a lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isNonAnnotationProperty ;
                              arg:label "Properties" ;
                              arg:predicates [
                                  sp:varName "rs" ;
                                ] ;
                              arg:subject [
                                  sp:varName "resource" ;
                                ] ;
                              ui:childIndex 6 ;
                            ] ;
                          ui:child [
                              a lmdoc:ResourceFooter ;
                              arg:options "CSV,JSON-LD,TURTLE" ;
                              arg:resource [
                                  sp:varName "resource" ;
                                ] ;
                              ui:childIndex 10 ;
                            ] ;
                          ui:child [
                              a lmdoc:VSpace ;
                              arg:margin "30px;" ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              a lmdoc:VSpace ;
                              arg:margin "30px;" ;
                              ui:childIndex 5 ;
                            ] ;
                          ui:child [
                              a lmdoc:VSpace ;
                              arg:margin "30px;" ;
                              ui:childIndex 7 ;
                            ] ;
                          ui:child [
                              a lmdoc:VSpace ;
                              arg:margin "40px;" ;
                              ui:childIndex 9 ;
                            ] ;
                          ui:childIndex 3 ;
                        ] ;
                      ui:child [
                          a ui:CommentNode ;
                          ui:childIndex 0 ;
                          rdfs:comment "ui:dumpScope ui:message=\"DEBUG1: lmdoc:InstancesSection instance {= ?resource }\"/" ;
                        ] ;
                      ui:child [
                          a lmdoc:VSpace ;
                          arg:margin "20px;" ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:template [
                          a swa:modeProperty ;
                          arg:predicate swa:formObjectPredicateSelectionTemplate ;
                        ] ;
                    ] ;
                  ui:child [
                      a lmdoc:VSpace ;
                      arg:margin "40px;" ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "instances" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:gt ;
                  sp:arg1 [
                      a spr:rowCount ;
                      sp:arg1 [
                          sp:varName "instances" ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:getInstancesOfType ;
          ui:varName "instances" ;
          vaem:namespacePrefix [
              a ui:contextValue ;
              sp:arg1 "namespacePrefix" ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Instances section" ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:InstancesSummarySection
  a ui:NodeClass ;
