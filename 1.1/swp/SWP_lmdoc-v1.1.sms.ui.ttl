lmdoc:Preview
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:catalogEntry ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:catalogGraph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraph [
          a sp:iri ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
        ] ;
      ui:child [
          a ui:catch ;
          ui:child [
              a html:H1 ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Exception" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              a html:P ;
              ui:child [
                  a html:Em ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "lmdoc:Preview" ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text " has an exception:" ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a html:P ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Graph is " ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text [
                      sp:varName "myGraph" ;
                    ] ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              a html:P ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "exception" ;
                    ] ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:try ;
          ui:child [
              a ui:if ;
              ui:child [
                  a ui:throw ;
                  ui:childIndex 0 ;
                  ui:message [
                      a ui:concat ;
                      sp:arg1 "Graph is not a resource - " ;
                      sp:arg2 [
                          sp:varName "graph" ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:not ;
                  sp:arg1 [
                      a sp:bound ;
                      sp:arg1 [
                          sp:varName "myGraph" ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              a ui:setContext ;
              ui:child [
                  a html:Div ;
                  html:id "content_container" ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a ui:group ;
                  let:myOverlay [
                      a sp:coalesce ;
                      sp:arg1 [
                          sp:varName "overlay" ;
                        ] ;
                      sp:arg2 ui:tempGraph ;
                    ] ;
                  ui:child [
                      a ui:setContext ;
                      ui:child [
                          a ui:group ;
                          let:myGraphMetadata [
                              a spl:subjectInGraph ;
                              sp:arg1 vaem:isMetadataFor ;
                              sp:arg1 [
                                  sp:varName "myGraph" ;
                                ] ;
                              sp:arg2 [
                                  sp:varName "myGraph" ;
                                ] ;
                            ] ;
                          ui:child [
                              a ui:if ;
                              ui:child [
                                  a ui:throw ;
                                  ui:childIndex 0 ;
                                  ui:message [
                                      a ui:concat ;
                                      sp:arg1 "Graph metadata record is not an resource - " ;
                                      sp:arg2 [
                                          sp:varName "myGraphMetadata" ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:condition [
                                  a sp:not ;
                                  sp:arg1 [
                                      a sp:isIRI ;
                                      sp:arg1 [
                                          sp:varName "myGraphMetadata" ;
                                        ] ;
                                    ] ;
                                ] ;
                            ] ;
                          ui:child [
                              a ui:setContext ;
                              ui:child [
                                  a ui:group ;
                                  let:namespacePrefix [
                                      a spl:objectInGraph ;
                                      sp:arg1 [
                                          sp:varName "myGraphMetadata" ;
                                        ] ;
                                      sp:arg2 vaem:namespacePrefix ;
                                      sp:arg3 [
                                          sp:varName "myGraph" ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      a ui:if ;
                                      ui:child [
                                          a ui:throw ;
                                          ui:childIndex 0 ;
                                          ui:message "Namespace prefix empty" ;
                                        ] ;
                                      ui:childIndex 0 ;
                                      ui:condition [
                                          a sp:not ;
                                          sp:arg1 [
                                              a sp:bound ;
                                              sp:arg1 [
                                                  sp:varName "namespacePrefix" ;
                                                ] ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      a ui:setContext ;
                                      ui:child [
                                          a html:Hr ;
                                          ui:childIndex 4 ;
                                        ] ;
                                      ui:child [
                                          a html:Section ;
                                          html:class "informative" ;
                                          html:id "overview-of-ontology" ;
                                          ui:child [
                                              a ui:resourceView ;
                                              ui:childIndex 0 ;
                                              ui:matchIds "specificContent" ;
                                              ui:resource [
                                                  a spl:object ;
                                                  sp:arg1 [
                                                      sp:varName "catalogEntry" ;
                                                    ] ;
                                                  sp:arg2 lmcat:resourceForOverview ;
                                                ] ;
                                            ] ;
                                          ui:child [
                                              a lmdoc:IndexSection ;
                                              arg:graph [
                                                  sp:varName "myGraph" ;
                                                ] ;
                                              arg:sectionHeading "Resource Index" ;
                                              ui:childIndex 1 ;
                                              vaem:namespacePrefix [
                                                  sp:varName "namespacePrefix" ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 7 ;
                                        ] ;
                                      ui:child [
                                          a html:Section ;
                                          html:class "introductory" ;
                                          html:id "abstract" ;
                                          ui:child [
                                              a lmdoc:AbstractSection ;
                                              arg:metadata [
                                                  sp:varName "myGraphMetadata" ;
                                                ] ;
                                              arg:sectionHeading "Abstract" ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 2 ;
                                        ] ;
                                      ui:child [
                                          a html:Section ;
                                          html:id "namespaces-1" ;
                                          ui:child [
                                              a lmdoc:ImportedNamespaces ;
                                              arg:graph [
                                                  sp:varName "myGraph" ;
                                                ] ;
                                              arg:sectionHeading "Imported Graphs" ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 5 ;
                                        ] ;
                                      ui:child [
                                          a html:Section ;
                                          html:id "non-imported-myGraphMetadatas" ;
                                          ui:child [
                                              a lmdoc:NonImportedResources ;
                                              arg:metadata [
                                                  sp:varName "myGraphMetadata" ;
                                                ] ;
                                              arg:sectionHeading "Non-imported Resources" ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 6 ;
                                        ] ;
                                      ui:child [
                                          a ui:CommentNode ;
                                          ui:childIndex 0 ;
                                          rdfs:comment "ui:dumpScope ui:message=\"DEBUG1: lmdoc:Preview for graph {= ?graph }\"/" ;
                                        ] ;
                                      ui:child [
                                          a ui:CommentNode ;
                                          ui:childIndex 3 ;
                                          rdfs:comment """section id=\"toc\">
<lmdoc:TableOfContents arg:sectionHeading=\"Table of Contents\"/>
</section""" ;
                                        ] ;
                                      ui:child [
                                          a lmdoc:Footer ;
                                          ui:childIndex 8 ;
                                        ] ;
                                      ui:child [
                                          a lmdoc:GraphHeader ;
                                          arg:metadata [
                                              sp:varName "myGraphMetadata" ;
                                            ] ;
                                          ui:childIndex 1 ;
                                        ] ;
                                      ui:childIndex 1 ;
                                      ui:varName "namespacePrefix" ;
                                      ui:varValue [
                                          sp:varName "namespacePrefix" ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 1 ;
                              ui:varName "graphMetadata" ;
                              ui:varValue [
                                  sp:varName "myGraphMetadata" ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:queryGraph [
                          a ui:unionOfGraphs ;
                          sp:arg1 [
                              a ui:graphWithImports ;
                              sp:arg1 [
                                  sp:varName "myGraph" ;
                                ] ;
                            ] ;
                          sp:arg2 ui:view ;
                          sp:arg3 [
                              a ui:graphWithImports ;
                              sp:arg1 [
                                  sp:varName "myOverlay" ;
                                ] ;
                            ] ;
                          sp:arg4 [
                              a ui:graphWithImports ;
                              sp:arg1 [
                                  sp:varName "catalogGraph" ;
                                ] ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
              ui:varName "graph" ;
              ui:varValue [
                  sp:varName "myGraph" ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=lmdoc:Preview&graph=http://www.linkedmodel.org/2.0/schema/vaem""" ;
  rdfs:label "Preview Graph Documentation" ;
  rdfs:subClassOf lmdoc:Pages ;
.
lmdoc:PropertiesMaintainer
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
