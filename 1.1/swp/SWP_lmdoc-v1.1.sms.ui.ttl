  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:errorPrototype [
      a ui:group ;
      ui:child [
          a ui:else ;
          ui:child [
              a ui:group ;
              let:myGraphMetadata [
                  a spl:object ;
                  sp:arg1 [
                      sp:varName "myGraph" ;
