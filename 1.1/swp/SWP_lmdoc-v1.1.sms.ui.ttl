lmdoc:PropertiesSection
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraphMetadata [
          a spl:object ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      ui:child [
          a html:Div ;
          html:style "margin: 40px 0 25px 0;" ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:call ;
          arg:graph [
              sp:varName "graph" ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a html:H2 ;
                  html:id [
                      a lmdoc:makeAnchorFromString ;
                      arg:label [
                          sp:varName "sectionHeading" ;
                        ] ;
                    ] ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  a ui:forEach ;
                  ui:child [
                      a ui:call ;
                      arg:subject [
                          sp:varName "resource" ;
                        ] ;
                      ui:child [
                          a html:Div ;
                          html:class "lm-header-box" ;
                          ui:child [
                              a lmdoc:ResourceDocAnchor ;
                              arg:resource [
                                  sp:varName "resource" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          a html:Div ;
                          html:class "lm-resource-box" ;
                          ui:child [
                              a html:Div ;
                              html:class "swa-sub-title" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Description" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              a lmdoc:MaybeDescription ;
                              arg:resource [
                                  sp:varName "resource" ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              a lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isAnnotationProperty ;
                              arg:label "Annotations" ;
                              arg:predicates [
                                  sp:varName "rs" ;
                                ] ;
                              arg:subject [
                                  sp:varName "resource" ;
                                ] ;
                              ui:childIndex 5 ;
                            ] ;
                          ui:child [
                              a lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isNonAnnotationProperty ;
                              arg:label "Properties" ;
                              arg:predicates [
                                  sp:varName "rs" ;
