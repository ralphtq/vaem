lmdoc:maybeConvertToURI
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "uri" ;
          ]
        ) ;
      sp:where (
          [
            a sp:Bind ;
            sp:expression [
                a sp:if ;
                sp:arg1 [
                    a sp:isIRI ;
                    sp:arg1 spin:_arg1 ;
                  ] ;
                sp:arg2 spin:_arg1 ;
                sp:arg3 [
                    a sp:iri ;
                    sp:arg1 [
                        a smf:buildURI ;
                        sp:arg1 spin:_arg1 ;
                      ] ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:comment "Checks if an argument is a URI. If not converts it to a URI." ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:mySuperClass
  a spin:MagicProperty ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "super" ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "class" ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject spin:_arg1 ;
          ]
          [
            a sp:TriplePath ;
            sp:object owl:Class ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "class" ;
              ] ;
          ]
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "super" ;
              ] ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            sp:object [
                sp:varName "superType" ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "super" ;
              ] ;
          ]
          [
            a sp:Filter ;
            sp:expression [
                a sp:ne ;
                sp:arg1 [
                    sp:varName "superType" ;
                  ] ;
                sp:arg2 owl:Restriction ;
              ] ;
          ]
          [
            a sp:Filter ;
            sp:expression [
                a sp:and ;
                sp:arg1 [
                    a sp:ne ;
                    sp:arg1 [
                        sp:varName "super" ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
                sp:arg2 [
                    a sp:ne ;
                    sp:arg1 [
                        sp:varName "super" ;
                      ] ;
                    sp:arg2 spin:_arg1 ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
    ] ;
  rdfs:label "my super class" ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:numberLines
  a spin:Function ;
  spin:constraint [
      a spl:Argument ;
      spl:defaultValue 60 ;
      spl:predicate sp:arg5 ;
      spl:valueType xsd:integer ;
      rdfs:comment "width of code block" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:defaultValue 999 ;
      spl:predicate sp:arg3 ;
      spl:valueType xsd:integer ;
      rdfs:comment "number of lines to generate" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:defaultValue false ;
      spl:predicate sp:arg4 ;
      spl:valueType xsd:integer ;
      rdfs:comment "indent" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType xsd:integer ;
      rdfs:comment "first index" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg6 ;
      spl:valueType xsd:boolean ;
      rdfs:comment "debug" ;
    ] ;
  spin:returnType xsd:string ;
  spinx:javaScriptCode """// ----------
// numberLines
// ----------
//
// numberLines(text, firstLine, lineCount, depth, maxWidth, debug)
//
// @text:             what to number
// @firstLine:      where to start in the array of split strings
// @lineCount:    max number of lines to generate
// @depth:         width of margin
// @width:          width of code block
// @debug:         trace rules in the output
//


var debug2 = false,
     lineNo = 0 ,
     offset= 0 ;

function formatNumber(n) {
   var str=n.toString() ;
   if (n<10) str+= '  '
   else  if (n<100) str += ' ';
  return str + ' '
  };


function createShiftArr(step) {

	var space = '     ';
	
	if ( isNaN(parseInt(step)) ) {  // argument is string
		space = step;
	} else { // argument is integer
		switch(step) {
			case 1: space = ' '; break;
			case 2: space = '  '; break;
			case 3: space = '   '; break;
			case 4: space = '    '; break;
			case 5: space = '     '; break;
			case 6: space = '      '; break;
			case 7: space = '       '; break;
			case 8: space = '        '; break;
			case 9: space = '         '; break;
			case 10: space = '          '; break;
			case 11: space = '           '; break;
			case 12: space = '            '; break;
		}
	};

	var shift = ['\\n!NN!']; // array of shifts
	for(ix=0;ix<100;ix++){
		shift.push(shift[ix]+space); 
	}
	return shift;
   };

function createSpacesArray() {
	var ar = [''];
	for(ix=0;ix<100;ix++){
		ar.push(ar[ix] + ' '); 
	}
	return ar;
};                                                                   

function formatLine(str,width) {       
  var ix,
      adjWidth = width + 4,
    
    linesSplitOnComma = function (str, margin, width) {
      if ( str.search(/, /) > -1)  {
       var jx,
           fla = str.replace(/, /,\",~==~  \" + margin)
                  .split(\"~==~\") ,
           splits = fla.length ,                         
           fla2= [] ;
      
       for (jx=0; jx < splits ; jx++) {
          var splitLine= fla[jx] ;     
          if ((splitLine.length > adjWidth )  && ( splitLine.indexOf(\",\") > -1 )) {
              fla2 = fla2.concat(linesSplitOnComma(splitLine, margin, adjWidth)) 
            } else {
            len = fla2.push(splitLine) 
            }
        } ;
      return fla2
      } else return [str]
    } ;

  function trySplitOnBracedExpression(width) {
    var splitIndex = str.search(/{/) ,
        safeIndex = (splitIndex > 3)? splitIndex - 3: 0 ;
        margin = spacesArray[safeIndex] ,
        newLine = \"\" ;
    if ( str.search(/(\"{.*}\")/) > -1)  {
      var fla = str.replace(/(\"{[=#]\\s[a-zA-Z0-9_&,;\\(\\)\\s':\\?]+}\")(&gt;|\\s)/g,\"~==~$1$2\") 
                    .split(\"~==~\") ,
          splits = fla.length ,
          ar2 = [] ;
      
      newLine += fla[0] ;

      for (ix=1; ix < splits ; ix++) {
        var splitLine= margin + fla[ix] ;     
        if (splitLine.length > adjWidth ) {
              ar2 = ar2.concat(linesSplitOnComma(splitLine, margin, adjWidth)) 
            } else {
           len = ar2.push(splitLine) 
          }
        } 
    } else {
       var ar2 =  linesSplitOnComma(str, margin, adjWidth) ;
       for(ix=0;ix < ar2.length; ix++) {
          var splitLine= margin + ar2[ix] ;
          newLine +=    splitLine ;
         } 
       } ; 
     return newLine
  } ;
  
  function trySplitOnIF(width) {
    var splitIndex = str.search(/ \\(IF/) ,
        safeIndex = (splitIndex > 2)? splitIndex - 2: 0 ;
        margin = spacesArray[safeIndex] ,
        newLine = \"\" ;
    if ( str.search(/,\\sIF/) > -1)  {
      var fla =str.replace(/,(\\sIF)/g,\",~==~$1\") 
                    .split(\"~==~\") ,
          splits = fla.length ,
          ar2 = [] ;
      
      newLine += fla[0] ;

      for (ix=1; ix < splits ; ix++) {
        var splitLine= margin + fla[ix] ;     
        if (splitLine.length > adjWidth ) {
              ar2 = ar2.concat(linesSplitOnComma(splitLine, margin, adjWidth)) 
            } else {
           len = ar2.push(splitLine) 
          }
        } ;

      for(ix=0;ix < ar2.length; ix++) {
        var splitLine= margin + ar2[ix] ;
        lineNo +=  1;
        newLine += \"\\n\" + formatNumber(lineNo - offset) +  splitLine ;
       } ; 
     return newLine
      } else { newLine = trySplitOnBracedExpression(width) } ;
     return newLine   
    } ;
  
  function makeSplits(width) {  
    newLine = trySplitOnIF(width);
    return newLine
  }
  
   return makeSplits(width)
} ;

   function numberedTextLines(text, firstLine, lineCount, depth, maxWidth, debug) {

       var ar = text.split('\\n'),
             len =  ar.length ,
             lastLine = (firstLine > 0)? lineCount + firstLine - 1 : lineCount ,
             shift = step ? createShiftArr(step) : shift;
        
       function numberedIndentation(text) {
            var offset = (firstLine > 0)? firstLine -1 : 0 ,
                myStr = String(text).replace(\"!NN!\", formatNumber(lineNo - offset))  ;
            return myStr
            };

        function numberText() {
            var text = '';
            for (i=firstLine;i< lastLine && i < len ; i++) {
                var aLine = ar[i] + '' ;
                lineNo++;
                text += numberedIndentation(shift[1]) + formatLine(aLine,maxWidth) ;
             } ;
          return text
         } ;

         return numberText()

    } ;

   var step = 2 ,                          // 2 spaces
      shift = createShiftArr(step),
      spacesArray = createSpacesArray(),
      result = numberedTextLines(arg1,arg2, arg3, arg4, arg5, arg6) ;
      return result ;
""" ;
  rdfs:subClassOf spin:Functions ;
.
lmdoc:optionalLinkArgs
  a owl:DatatypeProperty ;
  rdfs:label "optional link args" ;
  rdfs:range xsd:string ;
.
lmdoc:parentsOfPropertiesAtClass
  a spin:MagicProperty ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:resultVariables (
          [
            sp:varName "parent" ;
          ]
        ) ;
      sp:where (
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "property" ;
              ] ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg2 ;
          ]
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "superClass" ;
              ] ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            a sp:Filter ;
            sp:expression [
                a sp:and ;
                sp:arg1 [
                    a sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass" ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    a sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass" ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            a sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "superClass" ;
                      ] ;
                    sp:predicate rdfs:domain ;
                    sp:subject [
                        sp:varName "property" ;
                      ] ;
                  ]
                  [
                    a sp:Bind ;
                    sp:expression [
                        sp:varName "superClass" ;
                      ] ;
                    sp:variable [
                        sp:varName "parent" ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "property" ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass" ;
                      ] ;
                  ]
                  [
                    a sp:NotExists ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "value" ;
                            ] ;
                          sp:predicate owl:hasValue ;
                          sp:subject [
                              sp:varName "superClass" ;
                            ] ;
                        ]
                      ) ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass" ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent" ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "property" ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass" ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "value" ;
                      ] ;
                    sp:predicate owl:hasValue ;
                    sp:subject [
                        sp:varName "superClass" ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass" ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent" ;
                      ] ;
                  ]
                )
              ) ;
          ]
          [
            a sp:Filter ;
            sp:expression [
                a sp:isIRI ;
                sp:arg1 [
                    sp:varName "parent" ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "a property on the left" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdf:Property ;
      rdfs:comment "property" ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}" ;
  spin:returnType rdfs:Class ;
  rdfs:label "parents of properties at class" ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:rangeOfPropertyAtClass
  a spin:MagicProperty ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:resultVariables (
          [
            sp:varName "range" ;
          ]
          [
            sp:varName "valueRestriction" ;
          ]
        ) ;
      sp:where (
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "superClass" ;
              ] ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            a sp:Filter ;
            sp:expression [
                a sp:and ;
                sp:arg1 [
                    a sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass" ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    a sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass" ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "aProperty" ;
              ] ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg2 ;
          ]
          [
            a sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "range" ;
                      ] ;
                    sp:predicate rdfs:range ;
                    sp:subject [
                        sp:varName "aProperty" ;
                      ] ;
                  ]
                  [
                    a sp:Bind ;
                    sp:expression false ;
                    sp:variable [
                        sp:varName "valueRestriction" ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "aProperty" ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass" ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "range" ;
                      ] ;
                    sp:predicate owl:allValuesFrom ;
                    sp:subject [
                        sp:varName "superClass" ;
                      ] ;
                  ]
                  [
                    a sp:Bind ;
                    sp:expression false ;
                    sp:variable [
                        sp:varName "valueRestriction" ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "aProperty" ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass" ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "range" ;
                      ] ;
                    sp:predicate owl:hasValue ;
                    sp:subject [
                        sp:varName "superClass" ;
                      ] ;
                  ]
                  [
                    a sp:Bind ;
                    sp:expression true ;
                    sp:variable [
                        sp:varName "valueRestriction" ;
                      ] ;
                  ]
                )
              ) ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional false ;
      spl:predicate sp:arg2 ;
      spl:valueType rdf:Property ;
      rdfs:comment "property" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of" ;
    ] ;
  spin:labelTemplate "Range(s) for {?arg2} at class {?arg1}" ;
  rdfs:comment "Gets a list of ranges for a given class and property based on all superclasses." ;
  rdfs:label "Range of property at class" ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:relevantPropertiesAtClass
  a spin:MagicProperty ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:resultVariables (
          [
            sp:varName "property" ;
          ]
          [
            sp:varName "parent" ;
          ]
        ) ;
      sp:where (
          [
            sp:object spin:_arg1 ;
            sp:predicate spl:relevantPropertyAtClass ;
            sp:subject [
                sp:varName "property" ;
              ] ;
          ]
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "superClass" ;
              ] ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            a sp:Filter ;
            sp:expression [
                a sp:and ;
                sp:arg1 [
                    a sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass" ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    a sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass" ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "aProperty" ;
              ] ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject [
                sp:varName "property" ;
              ] ;
          ]
          [
            a sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "superClass" ;
                      ] ;
                    sp:predicate rdfs:domain ;
                    sp:subject [
                        sp:varName "aProperty" ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "aProperty" ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass" ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass" ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent" ;
                      ] ;
                  ]
                )
              ) ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of" ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}" ;
  rdfs:comment "Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels." ;
  rdfs:label "Relevant properties at class" ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:relevantPropertiesAtClassWithParent
  a spin:MagicProperty ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:resultVariables (
          [
            sp:varName "class" ;
          ]
          [
            sp:varName "parent" ;
          ]
        ) ;
      sp:where (
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "superClass" ;
              ] ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "class" ;
              ] ;
          ]
          [
            a sp:Filter ;
            sp:expression [
                a sp:and ;
                sp:arg1 [
                    a sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass" ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    a sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass" ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            a sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "superClass" ;
                      ] ;
                    sp:predicate rdfs:domain ;
                    sp:subject [
                        sp:varName "property" ;
                      ] ;
                  ]
                  [
                    a sp:Bind ;
                    sp:expression [
                        sp:varName "superClass" ;
                      ] ;
                    sp:variable [
                        sp:varName "parent" ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "property" ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass" ;
                      ] ;
                  ]
                  [
                    a sp:NotExists ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "value" ;
                            ] ;
                          sp:predicate owl:hasValue ;
                          sp:subject [
                              sp:varName "superClass" ;
                            ] ;
                        ]
                      ) ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass" ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent" ;
                      ] ;
                  ]
                )
              ) ;
          ]
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "property" ;
              ] ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            a sp:Filter ;
            sp:expression [
                a sp:isIRI ;
                sp:arg1 [
                    sp:varName "class" ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "a property on the left" ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}" ;
  spin:returnType rdfs:Class ;
  rdfs:comment """Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels. 

A magic property that establishes a relationship between properties (left) and classes (right) to determine which properties are \"relevant\" for the class. Relevant means that they have the class in their domain and/or restrictions, including superclasses and sub-properties.

Note that the performance of the body of this magic property has been optimized for the case in which the class is given, so ideally use this for queries such as  ?property iess:relevantPropertyAtClass skos:Concept .""" ;
  rdfs:label "Relevant properties at class with parent" ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:relevantPropertyDetailsAtClass
  a spin:MagicProperty ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:resultVariables (
          [
            sp:varName "property" ;
          ]
          [
            sp:varName "parent" ;
          ]
          [
            sp:varName "range" ;
          ]
          [
            sp:varName "valueRestriction" ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "?0" ;
              ] ;
            sp:predicate lmdoc:relevantPropertiesAtClass ;
            sp:subject spin:_arg1 ;
          ]
          [
            sp:object [
                sp:varName "property" ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1" ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "parent" ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1" ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1" ;
              ] ;
          ]
          [
            sp:object spin:_arg1 ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?3" ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "property" ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?3" ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?3" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?4" ;
              ] ;
            sp:predicate lmdoc:rangeOfPropertyAtClass ;
            sp:subject [
                sp:varName "?2" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "range" ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?4" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?5" ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?4" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "valueRestriction" ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?5" ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?5" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of" ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}" ;
  rdfs:comment "Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels." ;
  rdfs:label "Relevant property details at class" ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:returnFromCreateHTMLforResource
  a sml:ReturnText ;
  sml:serialization sm:XML ;
  rdfs:label "return from create HTML for resource" ;
.
lmdoc:ruleSet
  a owl:ObjectProperty ;
  rdfs:label "rule set" ;
.
lmdoc:valueRestrictionsForPropertyAtClass
  a spin:MagicProperty ;
  spin:body [
      a sp:Select ;
      sp:distinct true ;
      sp:resultVariables (
          [
            sp:varName "range" ;
          ]
          [
            sp:varName "superClass" ;
          ]
        ) ;
      sp:where (
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "superClass" ;
              ] ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            a sp:NotExists ;
            sp:elements (
                [
                  sp:object owl:Restriction ;
                  sp:predicate rdf:type ;
                  sp:subject [
                      sp:varName "superClass" ;
                    ] ;
                ]
              ) ;
          ]
          [
            a sp:Filter ;
            sp:expression [
                a sp:and ;
                sp:arg1 [
                    a sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass" ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    a sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass" ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            a sp:TriplePath ;
            sp:object [
                sp:varName "aProperty" ;
              ] ;
            sp:path [
                a sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg2 ;
          ]
          [
            sp:object [
                sp:varName "res" ;
              ] ;
            sp:predicate rdfs:subClassOf ;
            sp:subject [
                sp:varName "superClass" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "aProperty" ;
              ] ;
            sp:predicate owl:onProperty ;
            sp:subject [
                sp:varName "res" ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "range" ;
              ] ;
            sp:predicate owl:hasValue ;
            sp:subject [
                sp:varName "res" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional false ;
      spl:predicate sp:arg2 ;
      spl:valueType rdf:Property ;
      rdfs:comment "property" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of" ;
    ] ;
  spin:labelTemplate "Value restriction(s) for property {?arg2} at class {?arg1}" ;
  rdfs:comment "Gets restricted values for a given class and property based on all superclasses." ;
  rdfs:label "Value restrictions for property at class." ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
catalog:hasTypeLogo
  a owl:ObjectProperty ;
.
vaem:GraphMetadata
  ui:instanceView [
