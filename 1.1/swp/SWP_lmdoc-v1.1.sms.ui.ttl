                  sp:varName "resource" ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a html:Span ;
                      html:class "swa-form-header-uri" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "resource" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      sp:varName "showURI" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
          ui:condition [
              a sp:or ;
              sp:arg1 [
                  a sp:not ;
                  sp:arg1 [
                      a sp:bound ;
                      sp:arg1 [
                          sp:varName "suppressHeader" ;
                        ] ;
                    ] ;
                ] ;
              sp:arg2 [
                  a sp:not ;
                  sp:arg1 [
                      sp:varName "suppressHeader" ;
                    ] ;
                ] ;
            ] ;
        ] ;
      ui:child [
          a ui:loadable ;
          html:class "ui-layout-content" ;
          ui:child [
              a ui:else ;
              ui:child [
                  a ui:setContext ;
                  ui:child [
                      a html:Form ;
                      html:class "swa-form view-mode swa-form-view" ;
                      html:id [
                          sp:varName "fid" ;
                        ] ;
                      html:resource [
                          sp:varName "resource" ;
                        ] ;
                      ui:child [
                          a html:Div ;
                          html:class "swa-form-body" ;
                          ui:child [
                              a ui:setContext ;
                              ui:child [
                                  a swa:DataViewsSection ;
                                  arg:resource [
                                      sp:varName "resource" ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  a ui:resourceView ;
                                  ui:childIndex 0 ;
                                  ui:matchIds [
                                      a ui:concat ;
                                      sp:arg1 [
                                          sp:varName "extraMatchIds" ;
                                        ] ;
                                      sp:arg2 "view,form" ;
                                    ] ;
                                  ui:resource [
                                      sp:varName "resource" ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:varName [
                                  a sp:if ;
                                  sp:arg1 [
                                      sp:varName "editable" ;
                                    ] ;
                                  sp:arg2 [
                                      sp:varName "none" ;
                                    ] ;
                                  sp:arg3 "swa-no-edit-button" ;
                                ] ;
                              ui:varValue true ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "mode" ;
                  ui:varValue [
                      a sp:coalesce ;
                      sp:arg1 [
                          sp:varName "viewModeName" ;
                        ] ;
                      sp:arg2 "view" ;
                    ] ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a html:Div ;
                  html:class "swa-uri" ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "resource" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:and ;
                  sp:arg1 [
                      sp:varName "showURI" ;
                    ] ;
                  sp:arg2 [
                      a sp:isIRI ;
                      sp:arg1 [
                          sp:varName "resource" ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a ui:setContext ;
                  ui:child [
                      a html:Form ;
                      html:autocomplete "off" ;
                      html:class "swa-form switchable-mode swa-form-edit" ;
                      html:id [
                          sp:varName "fid" ;
                        ] ;
                      html:resource [
                          a swa:resourceURIOrBNodeId ;
                          arg:resource [
                              sp:varName "resource" ;
                            ] ;
                        ] ;
                      ui:child [
                          a html:Div ;
                          html:class "swa-form-body" ;
                          ui:child [
                              a ui:else ;
                              ui:child [
                                  a ui:classView ;
                                  ui:childIndex 0 ;
                                  ui:class [
                                      a swa:resourceType ;
                                    ] ;
                                  ui:matchIds [
                                      a ui:concat ;
                                      sp:arg1 [
                                          sp:varName "extraMatchIds" ;
                                        ] ;
                                      sp:arg2 "edit,form" ;
                                    ] ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              a ui:if ;
                              ui:child [
                                  a ui:resourceView ;
                                  ui:childIndex 0 ;
                                  ui:matchIds [
                                      a ui:concat ;
                                      sp:arg1 [
                                          sp:varName "extraMatchIds" ;
                                        ] ;
                                      sp:arg2 "edit,form" ;
                                    ] ;
                                  ui:resource [
                                      sp:varName "resource" ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:condition [
                                  a sp:bound ;
                                  sp:arg1 [
                                      sp:varName "resource" ;
                                    ] ;
                                ] ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          a ui:if ;
                          ui:child [
                              a html:Input ;
                              html:name "_base" ;
                              html:type "hidden" ;
                              html:value [
                                  a ui:currentQueryGraph ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:condition [
                              sp:varName "editable" ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:if ;
                          ui:child [
                              a html:Input ;
                              html:name "resourceType" ;
                              html:type "hidden" ;
                              html:value [
                                  a swa:resourceType ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                          ui:condition [
                              a sp:not ;
                              sp:arg1 [
                                  a sp:bound ;
                                  sp:arg1 [
                                      sp:varName "resource" ;
                                    ] ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "mode" ;
                  ui:varValue "edit" ;
                ] ;
              ui:childIndex 1 ;
              ui:condition [
                  sp:varName "editing" ;
                ] ;
            ] ;
          ui:childIndex 2 ;
          ui:loadId [
              a ui:concat ;
              sp:arg1 [
                  sp:varName "fid" ;
                ] ;
              sp:arg2 "-loadable" ;
            ] ;
        ] ;
      ui:varName [
          a sp:if ;
          sp:arg1 [
              sp:varName "suppressInlineEditing" ;
            ] ;
          sp:arg2 "swa-no-edit-button" ;
          sp:arg3 [
              sp:varName "none" ;
            ] ;
        ] ;
      ui:varValue true ;
    ] ;
  rdfs:comment "A form displaying details of a given resource. The form displays a header on top, with label and type of the resource. If arg:editable is set to true, the form will have a button at the bottom to switch it to edit mode." ;
  rdfs:label "View form" ;
  rdfs:subClassOf lmdoc:Form ;
.
lmdoc:TOCEntry
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:count ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:heading ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myCountString [
          a sp:if ;
          sp:arg1 [
              a sp:bound ;
              sp:arg1 [
                  sp:varName "count" ;
                ] ;
            ] ;
          sp:arg2 [
              a fn:concat ;
              sp:arg1 " [" ;
              sp:arg2 [
                  sp:varName "count" ;
                ] ;
              sp:arg3 "]" ;
            ] ;
          sp:arg3 "" ;
        ] ;
      ui:child [
          a html:A ;
          html:href [
              a fn:concat ;
              sp:arg1 "#" ;
              sp:arg2 [
                  a lmdoc:makeAnchorFromString ;
                  arg:label [
                      sp:varName "heading" ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "heading" ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          a ui:TextNode ;
          ui:childIndex 1 ;
          ui:text [
              sp:varName "myCountString" ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Creates a TOC Entry" ;
  rdfs:label "Label" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:TableOfContents
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a html:A ;
          html:id "lmdoc_top" ;
          ui:child [
              a html:H2 ;
              html:id [
                  a lmdoc:makeAnchorFromString ;
                  arg:label [
                      sp:varName "sectionHeading" ;
                    ] ;
