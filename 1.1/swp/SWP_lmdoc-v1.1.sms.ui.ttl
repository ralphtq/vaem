lmdoc:ImageResourceViewer
  a swa:ObjectViewerClass ;
  ui:overrides swa:ImageResourceViewer ;
  ui:private true ;
  ui:prototype [
      a ui:group ;
      let:myImage [
          sp:varName "object" ;
        ] ;
      ui:child [
          a html:A ;
          html:href [
              sp:varName "myImage" ;
            ] ;
          ui:child [
              a html:Img ;
              html:src [
                  sp:varName "myImage" ;
                ] ;
              html:width "100px;" ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "The LM Doc viewer for URI resources that appear to be images, judged by their file extension." ;
  rdfs:label "Image resource viewer" ;
  rdfs:seeAlso swa:ImageResourceViewer ;
  rdfs:subClassOf lmdoc:ObjectViewer ;
.
lmdoc:ImportedNamespaces
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      letrs:imports [
          a sp:Select ;
          sp:orderBy (
              [
                sp:varName "importedGraph" ;
              ]
            ) ;
          sp:resultVariables (
              [
                sp:varName "importedGraph" ;
              ]
              [
                sp:varName "intent" ;
              ]
            ) ;
          sp:where (
              [
                a sp:NamedGraph ;
                sp:elements (
                    [
                      sp:object [
                          sp:varName "importedGraph" ;
                        ] ;
                      sp:predicate owl:imports ;
                      sp:subject [
                          sp:varName "graph" ;
                        ] ;
                    ]
                    [
                      a sp:NamedGraph ;
                      sp:elements (
                          [
                            a sp:Optional ;
                            sp:elements (
                                [
                                  sp:object [
                                      sp:varName "gmd" ;
