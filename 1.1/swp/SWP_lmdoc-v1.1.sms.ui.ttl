      spl:valueType xsd:string ;
    ] ;
  swa:objectWidgetWeight [
      a swa:WeightedExpression ;
      swa:expression [
          a sp:eq ;
          sp:arg1 [
              sp:varName "kind" ;
            ] ;
          sp:arg2 "literal" ;
        ] ;
      swa:weight 4 ;
    ] ;
  ui:private true ;
  ui:prototype [
      a ui:group ;
