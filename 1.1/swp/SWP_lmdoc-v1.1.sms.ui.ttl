  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:summaryView ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The summary view class to use" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:template ;
      spl:valueType spin:SelectTemplate ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:view ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The view class to use" ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraphMetadata [
          a spl:object ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      let:tableId "lm_resources" ;
      ui:child [
          a html:Div ;
          html:style "margin: 40px 0 25px 0;" ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          a ui:call ;
          arg:graph [
              sp:varName "graph" ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a html:Div ;
                  html:style "padding:20px;" ;
                  ui:child [
                      a html:Button ;
                      html:class "lm-button" ;
                      html:onclick [
                          a ui:concat ;
                          sp:arg1 "lm.acceptSelection('" ;
                          sp:arg2 [
                              sp:varName "tableId" ;
                            ] ;
                          sp:arg3 "', '" ;
                          sp:arg4 [
                              a xsd:string ;
                              sp:arg1 [
                                  sp:varName "graph" ;
                                ] ;
                            ] ;
                          sp:arg5 "', '" ;
                          sp:arg6 [
                              sp:varName "overlay" ;
                            ] ;
                          sp:arg7 "')" ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Accept Selections" ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      a html:Button ;
                      html:class "lm-button" ;
                      html:onclick [
                          a ui:concat ;
                          sp:arg1 "lm.clearSelection('" ;
                          sp:arg2 [
                              sp:varName "tableId" ;
                            ] ;
                          sp:arg3 "')" ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Clear Selections" ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a html:Button ;
                      html:class "lm-button" ;
                      html:onclick [
                          a ui:concat ;
                          sp:arg1 "lm.selectAll('" ;
                          sp:arg2 [
                              sp:varName "tableId" ;
                            ] ;
                          sp:arg3 "')" ;
                        ] ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Select All" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  a html:Table ;
                  html:class "lm-table" ;
                  html:id [
                      sp:varName "tableId" ;
                    ] ;
                  ui:child [
                      a html:Tbody ;
                      ui:child [
                          a ui:forEach ;
                          ui:child [
                              a html:Div ;
                              let:id [
                                  a ui:uniqueId ;
                                ] ;
                              ui:child [
                                  a html:Tr ;
                                  html:class "lm-row" ;
                                  ui:child [
                                      a html:Td ;
                                      html:class "lm-column" ;
                                      html:id [
                                          a fn:concat ;
                                          sp:arg1 "td-resource_" ;
                                          sp:arg2 [
                                              sp:varName "id" ;
                                            ] ;
                                        ] ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              a xsd:string ;
                                              sp:arg1 [
                                                  sp:varName "resource" ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 2 ;
                                    ] ;
                                  ui:child [
                                      a html:Td ;
                                      html:class "lm-column" ;
                                      ui:child [
                                          a html:Div ;
                                          html:class "lm-buttons-dock" ;
                                          let:resourceDiv [
                                              a sp:concat ;
                                              sp:arg1 "lm-export-" ;
                                              sp:arg2 [
                                                  sp:varName "id" ;
                                                ] ;
                                            ] ;
                                          ui:child [
                                              a html:Button ;
                                              html:class "lm-button lm-simulated-link" ;
                                              html:onclick [
                                                  a ui:concat ;
                                                  sp:arg1 "javascript: lm.showResourceInPopup('" ;
                                                  sp:arg2 [
                                                      a ui:encodeURL ;
                                                      sp:arg1 [
                                                          a sp:str ;
                                                          sp:arg1 [
                                                              sp:varName "resource" ;
                                                            ] ;
                                                        ] ;
                                                    ] ;
                                                  sp:arg3 "','" ;
                                                  sp:arg4 [
                                                      a ui:label ;
                                                      sp:arg1 [
                                                          sp:varName "resource" ;
                                                        ] ;
                                                    ] ;
                                                  sp:arg5 "','" ;
                                                  sp:arg6 [
                                                      a ui:encodeURL ;
                                                      sp:arg1 [
                                                          a sp:str ;
                                                          sp:arg1 [
                                                              a ui:currentQueryGraph ;
                                                            ] ;
                                                        ] ;
                                                    ] ;
                                                  sp:arg7 "',600,600)" ;
                                                ] ;
                                              ui:child [
                                                  a ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text "Popup View" ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:child [
                                              a html:Button ;
                                              html:class "lm-button" ;
                                              html:onclick [
                                                  a ui:concat ;
                                                  sp:arg1 "lm.generate('" ;
                                                  sp:arg2 [
                                                      a xsd:string ;
                                                      sp:arg1 [
                                                          sp:varName "resource" ;
                                                        ] ;
                                                    ] ;
                                                  sp:arg3 "','" ;
                                                  sp:arg4 [
                                                      a xsd:string ;
                                                      sp:arg1 [
                                                          sp:varName "graph" ;
                                                        ] ;
                                                    ] ;
                                                  sp:arg5 "','" ;
                                                  sp:arg6 [
                                                      a ui:encodeURL ;
                                                      sp:arg1 [
                                                          sp:varName "view" ;
                                                        ] ;
                                                    ] ;
                                                  sp:arg7 "','" ;
                                                  sp:arg8 [
                                                      sp:varName "overlay" ;
                                                    ] ;
                                                  sp:arg9 "')" ;
                                                ] ;
                                              ui:child [
                                                  a ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text "Page View" ;
                                                ] ;
                                              ui:childIndex 2 ;
                                            ] ;
                                          ui:child [
                                              a html:Div ;
                                              html:id [
                                                  sp:varName "resourceDiv" ;
                                                ] ;
                                              ui:child [
                                                  a html:Div ;
                                                  html:id "content_container" ;
                                                  ui:child [
                                                      a ui:CommentNode ;
                                                      ui:childIndex 0 ;
                                                      rdfs:comment """ui:setContext ui:queryGraph=\"{= ui:unionOfGraphs(ui:graphWithImports(?graph), ui:graphWithImports(IRI(?overlay))) }\">
                                                <ui:resourceView ui:matchIds=\"lmdoc-popup\"
                                                                 ui:resource=\"{= IRI(?resource) }\"/>
                                            </ui:setContext""" ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:childIndex 1 ;
                                            ] ;
                                          ui:child [
                                              a html:Div ;
                                              ui:child [
                                                  a html:Div ;
                                                  html:class "clear-both" ;
                                                  ui:childIndex 2 ;
                                                ] ;
                                              ui:child [
                                                  a html:Div ;
                                                  html:class "left pt24px pr8px pl8px" ;
                                                  ui:child [
                                                      a html:Span ;
                                                      html:class "size-14" ;
                                                      ui:child [
                                                          a ui:TextNode ;
                                                          ui:childIndex 0 ;
                                                          ui:text "Generate" ;
                                                        ] ;
                                                      ui:childIndex 0 ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:child [
                                                  a html:Div ;
                                                  html:class "sliderCheckbox left" ;
                                                  ui:child [
                                                      a html:Input ;
                                                      html:id [
                                                          a fn:concat ;
                                                          sp:arg1 "CB_" ;
                                                          sp:arg2 [
                                                              sp:varName "id" ;
                                                            ] ;
                                                        ] ;
                                                      html:name [
                                                          a fn:concat ;
                                                          sp:arg1 "CB_" ;
                                                          sp:arg2 [
                                                              sp:varName "id" ;
                                                            ] ;
                                                        ] ;
                                                      html:type "checkbox" ;
                                                      html:value "None" ;
                                                      ui:childIndex 0 ;
                                                    ] ;
                                                  ui:child [
                                                      a html:Label ;
                                                      html:for [
                                                          a fn:concat ;
                                                          sp:arg1 "CB_" ;
                                                          sp:arg2 [
                                                              sp:varName "id" ;
                                                            ] ;
                                                        ] ;
                                                      ui:childIndex 1 ;
                                                    ] ;
                                                  ui:childIndex 1 ;
                                                ] ;
                                              ui:childIndex 3 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 3 ;
                                    ] ;
                                  ui:child [
                                      a html:Td ;
                                      html:class "lm-column" ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              a sp:add ;
                                              sp:arg1 [
                                                  sp:varName "index" ;
                                                ] ;
                                              sp:arg2 1 ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      a html:Td ;
                                      html:class "lm-column" ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              sp:varName "qName" ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:indexVar "index" ;
                          ui:resultSet [
                              sp:varName "resources" ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a html:Thead ;
                      html:class "lm-table-header" ;
                      ui:child [
                          a html:Tr ;
                          html:class "lm-row" ;
                          ui:child [
                              a html:Th ;
                              html:class "lm-column-label" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "#" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              a html:Th ;
                              html:class "lm-column-label" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Actions" ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              a html:Th ;
                              html:class "lm-column-label" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Resource" ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              a html:Th ;
                              html:class "lm-column-label" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "URI" ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:gt ;
                  sp:arg1 [
                      a spr:rowCount ;
                      sp:arg1 [
                          sp:varName "resources" ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template [
              sp:varName "template" ;
            ] ;
          ui:varName "resources" ;
        ] ;
      ui:child [
          a lmdoc:VSpace ;
          arg:margin "40px;" ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment """<button class=\"lm-button lm-simulated-link\" onclick=\"javascript: lm.popup('{= ?resourceDiv }','{= ui:label(?resource) }',600,600)\">Popup View</button>

     <button class=\"lm-button lm-simulated-link\" onclick=\"javascript: lm.showResourceInPopup('{= ui:encodeURL(str(?resource)) }','{= ui:label(?resource) }','{= ui:encodeURL(str(ui:currentQueryGraph())) }',600,600)\">Popup View</button>
                                 """ ;
  rdfs:label "Resources generator" ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:ResourcesMaintainer
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:heading ;
      spl:valueType xsd:string ;
      rdfs:comment "Section heading" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:summaryView ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The summary view class to use" ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:template ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:view ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The view class to use" ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraph [
          a sp:iri ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
        ] ;
      ui:child [
          a ui:catch ;
          ui:child [
              a html:P ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Exception: " ;
                ] ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text [
                      sp:varName "exception" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:try ;
          ui:child [
              a ui:if ;
              ui:child [
                  a ui:throw ;
                  ui:childIndex 0 ;
                  ui:message [
                      a ui:concat ;
                      sp:arg1 "Bad Graph: " ;
                      sp:arg2 [
                          sp:varName "graph" ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:not ;
                  sp:arg1 [
                      a sp:bound ;
                      sp:arg1 [
                          sp:varName "myGraph" ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              a ui:setContext ;
              ui:child [
                  a ui:group ;
                  let:myGraphMetadata [
                      a spl:objectInGraph ;
                      sp:arg1 [
                          sp:varName "myGraph" ;
                        ] ;
                      sp:arg2 vaem:hasGraphMetadata ;
                      sp:arg3 [
                          sp:varName "myGraph" ;
                        ] ;
                    ] ;
                  ui:child [
                      a ui:setContext ;
                      ui:child [
                          a ui:group ;
                          let:myOverlay [
                              a sp:iri ;
                              sp:arg1 [
                                  a sp:coalesce ;
                                  sp:arg1 [
                                      sp:varName "overlay" ;
                                    ] ;
                                  sp:arg2 ui:tempGraph ;
                                ] ;
                            ] ;
                          ui:child [
                              a ui:setContext ;
                              ui:child [
                                  a ui:setContext ;
                                  ui:child [
                                      a html:H1 ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              sp:varName "heading" ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 3 ;
                                    ] ;
                                  ui:child [
                                      a html:Section ;
                                      html:class "details" ;
                                      html:id "details" ;
                                      ui:child [
                                          a html:Section ;
                                          html:class "informative" ;
                                          html:id [
                                              sp:varName "heading" ;
                                            ] ;
                                          ui:child [
                                              a lmdoc:ResourcesGenerator ;
                                              arg:graph [
                                                  sp:varName "myGraph" ;
                                                ] ;
                                              arg:overlay [
                                                  sp:varName "overlay" ;
                                                ] ;
                                              arg:sectionHeading [
                                                  sp:varName "heading" ;
                                                ] ;
                                              arg:summaryView [
                                                  sp:varName "summaryView" ;
                                                ] ;
                                              arg:template [
                                                  sp:varName "template" ;
                                                ] ;
                                              arg:view [
                                                  sp:varName "view" ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:child [
                                          a lmdoc:Footer ;
                                          ui:childIndex 1 ;
                                        ] ;
                                      ui:childIndex 5 ;
                                    ] ;
                                  ui:child [
                                      a html:Section ;
                                      html:class "introductory" ;
                                      html:id "abstract" ;
                                      ui:child [
                                          a lmdoc:AbstractSection ;
                                          arg:metadata [
                                              sp:varName "myGraphMetadata" ;
                                            ] ;
                                          arg:sectionHeading "Abstract" ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 4 ;
                                    ] ;
                                  ui:child [
                                      a ui:if ;
                                      ui:child [
                                          a html:P ;
                                          ui:child [
                                              a ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text "Current query graph is " ;
                                            ] ;
                                          ui:child [
                                              a ui:TextNode ;
                                              ui:childIndex 1 ;
                                              ui:text [
                                                  a ui:currentQueryGraph ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 1 ;
                                      ui:condition [
                                          a fn:contains ;
                                          sp:arg1 [
                                              sp:varName "flags" ;
                                            ] ;
                                          sp:arg2 "Sqg" ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      a ui:if ;
                                      ui:child [
                                          a ui:CommentNode ;
                                          ui:childIndex 0 ;
                                          rdfs:comment "debug-swa:DumpTriplesForResourceAsSubject arg:resource=\"{= ?myGraphMetadata } \"/" ;
                                        ] ;
                                      ui:childIndex 2 ;
                                      ui:condition [
                                          a fn:contains ;
                                          sp:arg1 [
                                              sp:varName "flags" ;
                                            ] ;
                                          sp:arg2 "Sgmd" ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      a lmdoc:GraphHeader ;
                                      arg:metadata [
                                          sp:varName "myGraphMetadata" ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:queryGraph [
                                      a ui:unionOfGraphs ;
                                      sp:arg1 [
                                          a ui:graphWithImports ;
                                          sp:arg1 [
                                              sp:varName "myGraph" ;
                                            ] ;
                                        ] ;
                                      sp:arg2 [
                                          a ui:graphWithImports ;
                                          sp:arg1 <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
                                        ] ;
                                      sp:arg3 [
                                          a ui:graphWithImports ;
                                          sp:arg1 [
                                              sp:varName "myOverlay" ;
                                            ] ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:varName "flags" ;
                              ui:varValue [
                                  sp:varName "flags" ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:varName "namespacePrefix" ;
                      ui:varValue [
                          a spl:objectInGraph ;
                          sp:arg1 [
                              sp:varName "myGraphMetadata" ;
                            ] ;
                          sp:arg2 vaem:name ;
                          sp:arg3 [
                              sp:varName "myGraph" ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
              ui:varName "graph" ;
              ui:varValue [
                  sp:varName "graph" ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Resources Maintainer" ;
  rdfs:subClassOf lmdoc:Parts ;
.
lmdoc:RestrictedDatatypesSection
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a ui:call ;
          arg:graph [
              sp:varName "graph" ;
            ] ;
          ui:child [
              a ui:forEach ;
              ui:child [
                  a html:Div ;
                  html:id [
                      a ui:concat ;
                      sp:arg1 "div-" ;
                      sp:arg2 [
                          a lmdoc:makeAnchorFromResource ;
                          arg:resource [
                              sp:varName "resource" ;
                            ] ;
                        ] ;
                    ] ;
                  ui:child [
                      a html:Div ;
                      html:class "pt41px pl20px" ;
                      ui:child [
                          a lmdoc:Object ;
                          arg:predicate rdf:type ;
                          arg:subject [
                              sp:varName "resource" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 6 ;
                    ] ;
                  ui:child [
                      a html:Div ;
                      html:class "pt41px pl20px" ;
                      ui:child [
                          a lmdoc:Object ;
                          arg:predicate owl:onDatatype ;
                          arg:subject [
                              sp:varName "resource" ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 8 ;
                    ] ;
                  ui:child [
                      a html:Div ;
                      html:class "swa-sub-title" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Description" ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      a html:Div ;
                      html:class "swa-sub-title" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Restricted Datatype" ;
                        ] ;
                      ui:childIndex 7 ;
                    ] ;
                  ui:child [
                      a html:Div ;
                      html:class "swa-sub-title" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Restrictions" ;
                        ] ;
                      ui:childIndex 9 ;
                    ] ;
                  ui:child [
                      a html:Div ;
                      html:class "swa-sub-title" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Type" ;
                        ] ;
                      ui:childIndex 5 ;
                    ] ;
                  ui:child [
                      a html:P ;
                      html:class "size-24" ;
                      ui:child [
                          a ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              a smf:qname ;
                              sp:arg1 [
                                  sp:varName "resource" ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      a ui:CommentNode ;
                      ui:childIndex 10 ;
                      rdfs:comment """div class=\"pt41px pl20px\">
                    <lmdoc:Object arg:predicate=\"owl:withRestrictions\" arg:subject=\"{= ?resource }\"/>
                </div""" ;
                    ] ;
                  ui:child [
                      a ui:if ;
                      ui:child [
                          a html:Div ;
                          html:class "pt40px pl40px" ;
                          ui:child [
                              a lmdoc:Object ;
                              arg:predicate prov:wasInfluencedBy ;
                              arg:subject [
                                  sp:varName "resource" ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          a html:Div ;
                          html:class "swa-sub-title" ;
                          ui:child [
                              a ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "References" ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          a lmdoc:VSpace ;
                          arg:margin "20px;" ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 11 ;
                      ui:condition [
                          a lmdoc:hasValueForProperty ;
                          sp:arg1 [
                              sp:varName "resource" ;
                            ] ;
                          sp:arg2 prov:wasInfluencedBy ;
                        ] ;
                    ] ;
                  ui:child [
                      a lmdoc:MaybeDescription ;
                      arg:resource [
                          sp:varName "resource" ;
                        ] ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      a lmdoc:VSpace ;
                      arg:margin "10px;" ;
                      ui:childIndex 4 ;
                    ] ;
                  ui:child [
                      a lmdoc:VSpace ;
                      arg:margin "30px;" ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a lmdoc:VSpace ;
                      arg:margin "30px;" ;
                      ui:childIndex 12 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:resultSet [
                  sp:varName "instances" ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:getRestrictedDatatypes ;
          ui:varName "instances" ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "restricted datatypes section" ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:RichTextViewer
  a swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      a swa:WeightedExpression ;
      swa:expression [
          a sp:and ;
          sp:arg1 [
              a sp:eq ;
              sp:arg1 [
                  sp:varName "kind" ;
                ] ;
              sp:arg2 "literal" ;
            ] ;
          sp:arg2 [
              a sp:or ;
              sp:arg1 [
                  a spl:subPropertyOf ;
                  sp:arg1 [
                      sp:varName "predicate" ;
                    ] ;
                  sp:arg2 skos:note ;
                ] ;
              sp:arg2 [
                  a sp:eq ;
                  sp:arg1 [
                      sp:varName "type" ;
                    ] ;
                  sp:arg2 rdf:HTML ;
                ] ;
            ] ;
        ] ;
      swa:weight 10 ;
    ] ;
  ui:overrides swa:RichTextViewer ;
  ui:prototype [
      a html:Div ;
      html:class "swa-shifted-label" ;
      ui:child [
          a ui:parse ;
          ui:childIndex 0 ;
          ui:str [
              a swa:redirectHRefs ;
              sp:arg1 [
                  sp:varName "object" ;
                ] ;
            ] ;
        ] ;
      ui:child [
          a lmdoc:LangDisplay ;
          arg:lang [
              a sp:lang ;
              sp:arg1 [
                  sp:varName "object" ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  rdfs:comment "A viewer for HTML-based values. Parses the literal into HTML and inserts that into the document. Links will be redirected using the currently registered createLinkFunction." ;
  rdfs:label "Rich text viewer (lmdoc)" ;
  rdfs:subClassOf lmdoc:ObjectViewer ;
.
lmdoc:SaveSWPdoc
  a sml:ExportToTextFile ;
  sm:next lmdoc:returnFromCreateHTMLforResource ;
  sml:encoding "ISO-8859-1" ;
  sml:replace true ;
  sml:targetFilePath "{?docFilePath}" ;
  sml:text "{?resourceDoc}" ;
