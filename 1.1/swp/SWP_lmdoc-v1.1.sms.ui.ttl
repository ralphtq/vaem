              ui:childIndex 0 ;
            ] ;
          ui:child [
              a html:P ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "exception" ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:try ;
          ui:child [
              a html:Div ;
              html:id "content_container" ;
              ui:child [
                  a ui:group ;
                  let:myGraphMetadata [
                      a spl:object ;
                      sp:arg1 [
                          sp:varName "myGraph" ;
                        ] ;
                      sp:arg2 vaem:hasGraphMetadata ;
                    ] ;
                  ui:child [
                      a ui:group ;
                      let:myOverlay [
                          a sp:iri ;
                          sp:arg1 [
                              a sp:coalesce ;
                              sp:arg1 [
                                  sp:varName "overlay" ;
                                ] ;
                              sp:arg2 ui:tempGraph ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:setContext ;
                          ui:child [
                              a ui:setContext ;
                              ui:child [
                                  a ui:setContext ;
                                  ui:child [
                                      a ui:setContext ;
                                      ui:child [
                                          a ui:group ;
                                          let:myGraphMetadata [
                                              a spl:object ;
                                              sp:arg1 [
                                                  sp:varName "myGraph" ;
                                                ] ;
                                              sp:arg2 vaem:hasGraphMetadata ;
                                            ] ;
                                          ui:child [
                                              a ui:CommentNode ;
                                              ui:childIndex 0 ;
                                              rdfs:comment "ui:dumpScope ui:message=\"DEBUG1: lmdoc:Instance - {= ?resource }\"/" ;
                                            ] ;
                                          ui:child [
                                              a ui:call ;
                                              arg:subject [
                                                  sp:varName "resource" ;
                                                ] ;
                                              ui:child [
                                                  a html:Dd ;
                                                  html:class "size-14" ;
                                                  ui:child [
                                                      a lmdoc:ObjectsBody ;
                                                      arg:predicate rdf:type ;
                                                      arg:subject [
                                                          sp:varName "resource" ;
                                                        ] ;
                                                      ui:args "*" ;
                                                      ui:childIndex 0 ;
                                                    ] ;
                                                  ui:childIndex 3 ;
                                                ] ;
                                              ui:child [
                                                  a html:Div ;
                                                  html:class "swa-sub-title" ;
                                                  ui:child [
                                                      a ui:TextNode ;
                                                      ui:childIndex 0 ;
                                                      ui:text "Description" ;
                                                    ] ;
                                                  ui:childIndex 5 ;
                                                ] ;
                                              ui:child [
                                                  a html:Div ;
                                                  html:class "swa-sub-title" ;
                                                  ui:child [
                                                      a ui:TextNode ;
                                                      ui:childIndex 0 ;
                                                      ui:text "Type" ;
                                                    ] ;
                                                  ui:childIndex 2 ;
                                                ] ;
                                              ui:child [
                                                  a ui:resourceView ;
                                                  ui:childIndex 6 ;
                                                  ui:matchIds "description" ;
                                                  ui:resource [
                                                      sp:varName "resource" ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  a lmdoc:ObjectsGroup ;
                                                  arg:filterFunction swa:isAnnotationProperty ;
                                                  arg:label "Annotations" ;
                                                  arg:predicates [
                                                      sp:varName "rs" ;
                                                    ] ;
                                                  arg:subject [
                                                      sp:varName "resource" ;
                                                    ] ;
                                                  ui:childIndex 10 ;
                                                ] ;
                                              ui:child [
                                                  a lmdoc:ObjectsGroup ;
                                                  arg:filterFunction swa:isNonAnnotationProperty ;
                                                  arg:label "Properties" ;
                                                  arg:predicates [
                                                      sp:varName "rs" ;
                                                    ] ;
                                                  arg:subject [
                                                      sp:varName "resource" ;
                                                    ] ;
                                                  ui:childIndex 8 ;
                                                ] ;
                                              ui:child [
                                                  a lmdoc:ResourceFooter ;
                                                  arg:options "CSV,JSON-LD,RDF,TURTLE" ;
                                                  arg:resource [
                                                      sp:varName "resource" ;
                                                    ] ;
                                                  ui:childIndex 12 ;
                                                ] ;
                                              ui:child [
                                                  a lmdoc:ResourceHeader ;
                                                  arg:resource [
                                                      sp:varName "resource" ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:child [
                                                  a lmdoc:VSpace ;
                                                  arg:margin "20px;" ;
                                                  ui:childIndex 1 ;
                                                ] ;
                                              ui:child [
                                                  a lmdoc:VSpace ;
                                                  arg:margin "30px;" ;
                                                  ui:childIndex 4 ;
                                                ] ;
                                              ui:child [
                                                  a lmdoc:VSpace ;
                                                  arg:margin "30px;" ;
                                                  ui:childIndex 7 ;
                                                ] ;
                                              ui:child [
                                                  a lmdoc:VSpace ;
                                                  arg:margin "30px;" ;
                                                  ui:childIndex 9 ;
                                                ] ;
                                              ui:child [
                                                  a lmdoc:VSpace ;
                                                  arg:margin "40px;" ;
                                                  ui:childIndex 11 ;
                                                ] ;
                                              ui:childIndex 2 ;
                                              ui:template [
                                                  a swa:modeProperty ;
                                                  arg:predicate swa:formObjectPredicateSelectionTemplate ;
                                                ] ;
                                            ] ;
                                          ui:child [
                                              a lmdoc:Footer ;
                                              ui:childIndex 3 ;
                                            ] ;
                                          ui:child [
                                              a lmdoc:PartHeader ;
                                              arg:metadata [
                                                  sp:varName "myGraphMetadata" ;
                                                ] ;
                                              ui:childIndex 1 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                      ui:queryGraph [
                                          a ui:unionOfGraphs ;
                                          sp:arg1 [
                                              a ui:graphWithImports ;
                                              sp:arg1 [
                                                  sp:varName "myGraph" ;
                                                ] ;
                                            ] ;
                                          sp:arg2 [
                                              a ui:graphWithImports ;
                                              sp:arg1 [
                                                  sp:varName "myOverlay" ;
                                                ] ;
                                            ] ;
                                          sp:arg3 [
                                              a ui:graphWithImports ;
                                              sp:arg1 <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:varName "graph" ;
                                  ui:varValue [
                                      sp:varName "myGraph" ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:varName "catalogGraph" ;
                              ui:varValue [
                                  sp:varName "catalogGraph" ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:varName "flags" ;
                          ui:varValue [
                              sp:varName "flags" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a ui:throw ;
                      ui:childIndex 0 ;
                      ui:message [
                          a ui:concat ;
                          sp:arg1 "Graph is not a URI resource: " ;
                          sp:arg2 [
                              sp:varName "myGraph" ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      a sp:not ;
                      sp:arg1 [
                          a sp:isIRI ;
                          sp:arg1 [
                              sp:varName "myGraph" ;
                            ] ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  vaem:todo "remove dependency on swa.css" ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=lmdoc:Instance&graph=http://www.linkedmodel.org/2.0/schema/vaem&resource=http%3A%2F%2Fwww.linkedmodel.org%2Fschema%2Fvaem%23ScriptGraph""" ;
  rdfs:label "Instance Documentation" ;
  rdfs:subClassOf lmdoc:Pages ;
