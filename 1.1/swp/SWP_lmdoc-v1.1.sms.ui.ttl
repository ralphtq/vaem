lmdoc:makeAnchorFromResource
  a spin:Function ;
  spin:body [
      a sp:Select ;
      sp:resultVariables (
          [
            sp:varName "anchor" ;
          ]
        ) ;
      sp:where (
          [
            a sp:Bind ;
            sp:expression [
                a smf:qname ;
                sp:arg1 [
                    sp:varName "resource" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "a1" ;
              ] ;
          ]
          [
            a sp:Bind ;
            sp:expression [
                a spif:regex ;
                sp:arg1 [
                    sp:varName "a1" ;
                  ] ;
