                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:getInstancesOfType ;
          ui:varName "instances" ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Instances summary section" ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:InstancesTable
  a ui:NodeClass ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      a ui:group ;
      let:myGraphMetadata [
          a spl:object ;
          sp:arg1 [
              sp:varName "graph" ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      let:tableId "lm_resources" ;
      ui:child [
          a html:Div ;
          html:style "margin: 40px 0 25px 0;" ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          a ui:call ;
          arg:graph [
              sp:varName "graph" ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a html:H2 ;
                  html:id [
                      a lmdoc:makeAnchorFromString ;
                      arg:label [
                          sp:varName "sectionHeading" ;
                        ] ;
                    ] ;
                  ui:child [
                      a ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  a html:Table ;
                  html:class "lm-table" ;
                  html:id [
                      sp:varName "tableId" ;
                    ] ;
                  ui:child [
                      a html:Tbody ;
                      ui:child [
                          a ui:forEach ;
                          ui:child [
                              a html:Div ;
                              let:id [
                                  a ui:uniqueId ;
                                ] ;
                              ui:child [
                                  a html:Tr ;
                                  html:class "lm-row" ;
                                  ui:child [
                                      a html:Td ;
                                      html:class "lm-column" ;
                                      html:id [
                                          a fn:concat ;
                                          sp:arg1 "td-resource_" ;
                                          sp:arg2 [
                                              sp:varName "id" ;
                                            ] ;
                                        ] ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              a xsd:string ;
                                              sp:arg1 [
                                                  sp:varName "instance" ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:child [
                                      a html:Td ;
                                      html:class "lm-column" ;
                                      ui:child [
                                          a ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              sp:varName "qName" ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      a html:Td ;
                                      html:class "lm-column" ;
                                      ui:child [
                                          a lmdoc:MaybeDescriptionUsingProperty ;
                                          arg:property vaem:description ;
                                          arg:resource [
                                              sp:varName "instance" ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 2 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "instances" ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a html:Thead ;
                      html:class "lm-table-header" ;
                      ui:child [
                          a html:Tr ;
                          html:class "lm-row" ;
                          ui:child [
                              a html:Th ;
                              html:class "lm-column-label" ;
                              ui:child [
                                  a ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Description" ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              a html:Th ;
                              html:class "lm-column-label" ;
                              ui:child [
