                          ui:child [
                              a html:Dd ;
                              html:class "size-14" ;
                              ui:child [
                                  a lmdoc:ObjectsBody ;
                                  arg:predicate rdf:type ;
                                  arg:subject [
                                      sp:varName "resource" ;
                                    ] ;
                                  ui:args "*" ;
                                  ui:childIndex 0 ;
