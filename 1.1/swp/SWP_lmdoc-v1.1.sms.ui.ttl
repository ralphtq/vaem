              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "sectionHeading" ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          a html:Ol ;
          html:class "lm-toc-numeric" ;
          ui:child [
              a html:Li ;
              html:class "lm-toce" ;
              ui:child [
                  a html:Ol ;
                  html:class "lm-toc" ;
                  ui:child [
                      a html:Li ;
                      html:class "lm-toce" ;
                      ui:child [
                          a lmdoc:TOCEntry ;
                          arg:heading "Classes" ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      a html:Li ;
                      html:class "lm-toce" ;
                      ui:child [
                          a lmdoc:TOCEntry ;
                          arg:heading "Instances" ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      a html:Li ;
                      html:class "lm-toce" ;
                      ui:child [
                          a lmdoc:TOCEntry ;
                          arg:heading "Properties" ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a lmdoc:TOCEntry ;
                  arg:heading "Resource Details" ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a html:Li ;
              html:class "lm-toce" ;
              ui:child [
                  a html:Ol ;
                  html:class "lm-toc" ;
                  ui:child [
                      a html:Li ;
                      html:class "lm-toce" ;
                      ui:child [
                          a lmdoc:TOCEntry ;
                          arg:heading "Imported Graphs" ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      a html:Li ;
                      html:class "lm-toce" ;
                      ui:child [
                          a lmdoc:TOCEntry ;
                          arg:heading "Non-imported Resources" ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a lmdoc:TOCEntry ;
                  arg:heading "Resource Index" ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Table of contents" ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:URIResourceSubjectViewer
  a swa:SubjectViewerClass ;
  swa:subjectWidgetWeight [
      a swa:WeightedExpression ;
      swa:expression [
          a sp:isIRI ;
          sp:arg1 [
              sp:varName "subject" ;
            ] ;
        ] ;
    ] ;
  ui:overrides swa:URIResourceSubjectViewer ;
  ui:private false ;
  ui:prototype [
      a ui:group ;
      let:myGraph [
          a ui:contextValue ;
          sp:arg1 "graph" ;
        ] ;
      ui:child [
          a html:Div ;
          html:class "swa-shifted-label" ;
          html:title [
              sp:varName "subject" ;
            ] ;
          ui:child [
              a ui:else ;
              ui:child [
                  a lmdoc:ResourceLink ;
                  arg:resource [
                      sp:varName "subject" ;
                    ] ;
                  arg:title [
                      a xsd:string ;
                      sp:arg1 [
                          sp:varName "subject" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a ui:else ;
                  ui:child [
                      a lmdoc:ResourceLink ;
                      arg:resource [
                          sp:varName "subject" ;
                        ] ;
                      arg:title [
                          a xsd:string ;
                          sp:arg1 [
                              sp:varName "subject" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a ui:resourceView ;
                      ui:childIndex 1 ;
                      ui:matchIds "lmdoc-summary" ;
                      ui:resource [
                          sp:varName "subject" ;
                        ] ;
                    ] ;
                  ui:child [
                      a lmdoc:ResourceDocLink ;
                      arg:label [
                          sp:varName "myLabel" ;
                        ] ;
                      arg:resource [
                          sp:varName "subject" ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      a lmdoc:IsDefinedInGraph ;
                      arg:graph [
                          sp:varName "myGraph" ;
                        ] ;
                      arg:resource [
                          sp:varName "subject" ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:bound ;
                  sp:arg1 [
                      sp:varName "myGraph" ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "A viewer for URI resources, displaying a hyperlink to that resource." ;
  rdfs:label "URI resource subject viewer" ;
  rdfs:subClassOf lmdoc:SubjectViewer ;
.
lmdoc:URIResourceViewer
  a swa:ObjectViewerClass ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  swa:objectWidgetWeight [
      a swa:WeightedExpression ;
      swa:expression [
          a sp:eq ;
          sp:arg1 [
              sp:varName "kind" ;
            ] ;
          sp:arg2 "uri" ;
        ] ;
      swa:weight 50 ;
    ] ;
  ui:overrides swa:URIResourceViewer ;
  ui:private true ;
  ui:prototype [
      a ui:group ;
      let:myGraph [
          a ui:contextValue ;
          sp:arg1 "graph" ;
        ] ;
      ui:child [
          a ui:group ;
          let:myLabel [
              sp:varName "label" ;
            ] ;
          ui:child [
              a ui:else ;
              ui:child [
                  a lmdoc:ResourceLink ;
                  arg:label [
                      sp:varName "myLabel" ;
                    ] ;
                  arg:resource [
                      sp:varName "object" ;
                    ] ;
                  arg:title [
                      a sp:str ;
                      sp:arg1 [
                          sp:varName "object" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a ui:else ;
                  ui:child [
                      a lmdoc:ResourceLink ;
                      arg:label [
                          sp:varName "myLabel" ;
                        ] ;
                      arg:resource [
                          sp:varName "object" ;
                        ] ;
                      arg:title [
                          a xsd:string ;
                          sp:arg1 [
                              sp:varName "object" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  a ui:if ;
                  ui:child [
                      a html:Div ;
                      html:class "pt10px" ;
                      ui:child [
                          a ui:resourceView ;
                          ui:childIndex 0 ;
                          ui:matchIds "lmdoc-summary" ;
                          ui:resource [
                              sp:varName "object" ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      a lmdoc:ResourceLink ;
                      arg:label [
                          sp:varName "myLabel" ;
                        ] ;
                      arg:resource [
                          sp:varName "object" ;
                        ] ;
                      arg:title [
                          a sp:str ;
                          sp:arg1 [
                              sp:varName "object" ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      a lmdoc:IsDefinedInGraph ;
                      arg:graph [
                          sp:varName "myGraph" ;
                        ] ;
                      arg:resource [
                          sp:varName "object" ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:bound ;
                  sp:arg1 [
                      sp:varName "myGraph" ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "URI resource viewer" ;
  rdfs:seeAlso swa:URIResourceViewer ;
  rdfs:subClassOf lmdoc:ObjectViewer ;
.
lmdoc:UpdateGraphMetadata
  a ui:Service ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate vaem:latestPublishedVersion ;
      spl:valueType xsd:anyURI ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:optional true ;
      spl:predicate vaem:turtleFileURL ;
      spl:valueType xsd:anyURI ;
    ] ;
  spin:constraint [
      a spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      a ui:group ;
      ui:child [
          a ui:catch ;
          ui:child [
              a html:P ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Exception in lmdoc:UpdateGraphMetadata:" ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              a html:P ;
              ui:child [
                  a ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "exception" ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          a ui:try ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 2 ;
              ui:text [
                  a sp:str ;
                  sp:arg1 [
                      sp:varName "graph" ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              a ui:TextNode ;
              ui:childIndex 3 ;
              ui:text " updated" ;
            ] ;
          ui:child [
              a ui:if ;
              ui:child [
                  a ui:throw ;
                  ui:childIndex 0 ;
                  ui:message [
                      a ui:concat ;
                      sp:arg1 "Graph is not a URI resource: " ;
                      sp:arg2 [
                          sp:varName "graph" ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  a sp:not ;
                  sp:arg1 [
                      a sp:isIRI ;
                      sp:arg1 [
                          sp:varName "graph" ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              a ui:setContext ;
              ui:child [
                  a ui:group ;
                  let:myGraphMetadata [
                      a spl:objectInGraph ;
                      sp:arg1 [
                          sp:varName "graph" ;
                        ] ;
                      sp:arg2 vaem:hasGraphMetadata ;
                      sp:arg3 [
                          sp:varName "graph" ;
                        ] ;
                    ] ;
                  ui:child [
                      a ui:if ;
                      ui:child [
                          a ui:throw ;
                          ui:childIndex 0 ;
                          ui:message [
                              a ui:concat ;
                              sp:arg1 "No graph metadata instance for " ;
                              sp:arg2 [
                                  a sp:str ;
                                  sp:arg1 [
                                      sp:varName "graph" ;
                                    ] ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          a sp:not ;
                          sp:arg1 [
                              a sp:bound ;
                              sp:arg1 [
                                  sp:varName "myGraphMetadata" ;
                                ] ;
                            ] ;
                        ] ;
                    ] ;
                  ui:child [
                      a ui:transaction ;
                      ui:child [
                          a ui:update ;
                          ui:childIndex 0 ;
                          ui:updateQuery [
                              a sp:Modify ;
                              sp:deletePattern (
                                  [
                                    sp:object [
                                        sp:varName "previousPublishedVersion" ;
                                      ] ;
                                    sp:predicate vaem:latestPublishedVersion ;
                                    sp:subject [
                                        sp:varName "gmdU" ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "oldDate" ;
                                      ] ;
                                    sp:predicate dct:modified ;
                                    sp:subject [
                                        sp:varName "gmdU" ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "oldTurtleFileURL" ;
                                      ] ;
                                    sp:predicate vaem:turtleFileURL ;
                                    sp:subject [
                                        sp:varName "gmdU" ;
                                      ] ;
                                  ]
                                ) ;
                              sp:where (
                                  [
                                    sp:object [
                                        sp:varName "gmdU" ;
                                      ] ;
                                    sp:predicate vaem:hasGraphMetadata ;
                                    sp:subject [
                                        sp:varName "graph" ;
                                      ] ;
                                  ]
                                  [
                                    a sp:Optional ;
                                    sp:elements (
                                        [
                                          sp:object [
                                              sp:varName "oldDate" ;
                                            ] ;
                                          sp:predicate dct:modified ;
                                          sp:subject [
                                              sp:varName "gmdU" ;
                                            ] ;
                                        ]
                                      ) ;
                                  ]
                                  [
                                    a sp:Optional ;
                                    sp:elements (
                                        [
                                          sp:object [
                                              sp:varName "oldTurtleFileURL" ;
                                            ] ;
                                          sp:predicate vaem:turtleFileURL ;
                                          sp:subject [
                                              sp:varName "gmdU" ;
                                            ] ;
                                        ]
                                      ) ;
                                  ]
                                  [
                                    a sp:Optional ;
                                    sp:elements (
                                        [
                                          sp:object [
                                              sp:varName "previousPublishedVersion" ;
                                            ] ;
                                          sp:predicate vaem:latestPublishedVersion ;
                                          sp:subject [
                                              sp:varName "gmdU" ;
                                            ] ;
                                        ]
                                      ) ;
                                  ]
                                ) ;
                            ] ;
                        ] ;
                      ui:child [
                          a ui:update ;
                          ui:childIndex 1 ;
                          ui:updateQuery [
                              a sp:Modify ;
                              sp:insertPattern (
                                  [
                                    a sp:NamedGraph ;
                                    sp:elements (
                                        [
                                          sp:object [
                                              sp:varName "date" ;
                                            ] ;
                                          sp:predicate dct:modified ;
                                          sp:subject [
                                              sp:varName "gmdU" ;
                                            ] ;
                                        ]
                                        [
                                          sp:object [
                                              sp:varName "turtleFileURL" ;
                                            ] ;
                                          sp:predicate vaem:turtleFileURL ;
                                          sp:subject [
                                              sp:varName "gmdU" ;
                                            ] ;
                                        ]
                                        [
                                          sp:object [
                                              sp:varName "latestPublishedVersion" ;
                                            ] ;
                                          sp:predicate vaem:latestPublishedVersion ;
                                          sp:subject [
                                              sp:varName "gmdU" ;
                                            ] ;
                                        ]
                                        [
                                          sp:object [
                                              sp:varName "previousPublishedVersion" ;
                                            ] ;
                                          sp:predicate vaem:previousPublishedVersion ;
                                          sp:subject [
                                              sp:varName "gmdU" ;
