  ui:prototype [
      a ui:group ;
      ui:child [
          a lmdoc:ResourcesMaintainer ;
          arg:flags [
              sp:varName "flags" ;
            ] ;
          arg:graph [
              sp:varName "graph" ;
            ] ;
          arg:heading "Properties Maintainer" ;
          arg:overlay [
              sp:varName "overlay" ;
            ] ;
          arg:summaryView lmdoc:PropertiesSummaryView ;
          arg:template lmdoc:AllProperties ;
