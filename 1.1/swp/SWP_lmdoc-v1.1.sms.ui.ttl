                                      sp:predicate vaem:namespacePrefix ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object "qudt" ;
                                      sp:predicate vaem:namespace ;
                                      sp:subject [
                                          sp:varName "gmdU" ;
                                        ] ;
                                    ]
                                    [
                                      sp:object [
                                          sp:varName "gmdSubject" ;
