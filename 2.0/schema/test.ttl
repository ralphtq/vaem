# baseURI: http://vaem.linkedmodel.org/2.0/schema/test

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix test: <http://vaem.linkedmodel.org/2.0/schema/test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://vaem.linkedmodel.org/2.0/schema/test>
  rdf:type owl:Ontology ;
  owl:versionIRI <http://vaem.linkedmodel.org/2.0/schema/test> ;
  owl:versionInfo "Created with TopBraid Composer"^^xsd:string ;
.
test:Thing
  rdf:type owl:Class ;
  rdfs:isDefinedBy <http://vaem.linkedmodel.org/2.0/schema/test> ;
  rdfs:label "Thing"^^xsd:string ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty test:hasObjectProperty ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty test:name ;
    ] ;
.
test:hasObjectProperty
  rdf:type owl:ObjectProperty ;
  rdfs:isDefinedBy <http://vaem.linkedmodel.org/2.0/schema/test> ;
  rdfs:label "has object property"^^xsd:string ;
.
test:name
  rdf:type owl:DatatypeProperty ;
  rdfs:isDefinedBy <http://vaem.linkedmodel.org/2.0/schema/test> ;
  rdfs:label "name"^^xsd:string ;
  rdfs:range xsd:string ;
.
