@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix voag: <http://voag.linkedmodel.org/voag/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

vaem:Aspect a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Aspect Dimension" ;
    dcterms:description "Aspect is used to distinguish among sets of features of a domain or subject area. The term is borrowed from \"aspect-oriented\" programming, where it is used to separate concerns. An ontology may be characterized by this dimension so as to parition features that are orthogonal. For example,  in a systems ontology there may be aspects for \"structure\", \"function\", \"behavior\" and \"interface\" or \"interoperability\". A viewpoint can be distinguished by \"aspects\". For example the \"information viewpoint\" of an application can be partitioned into separate graphs for the \"security\", \"operational\" and\"data retention\" aspects."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    rdfs:subClassOf vaem:Dimension .

vaem:Dimension a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Domain" ;
    dcterms:description "A dimension identifies a separation of concens that serves as a way to categorize an ontology graph. In VAEM,  the notion of \"Dimension\" is partitioned into \"Aspect\", \"Discipline\", \"Domain\" and \"Viewpoint\". "^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:Discipline a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Discipline Dimension" ;
    dcterms:description "A discipline is a specific area of work or study. Examples of disciplines in the engineering domain are electrical engineering, mechanical engineering and, in the financial domain, risk assessment, investment analysis.  In VAEM, discipline is used as a dimension for characterizing an ontology graph"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    rdfs:subClassOf vaem:Dimension .

vaem:Domain a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Domain Dimension" ;
    dcterms:description "A domain is a subject area of interest. Examples of domains are \"enterprise\", \"process\", \"organization\" and \"system\". In VAEM, \"Domain\" is used as a dimension for characterizing an ontology graph"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    rdfs:subClassOf vaem:Dimension .

vaem:GraphMetaData a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Graph Metadata" ;
    dcterms:description "\"vaem:GraphMetaData\" defines basic metadata for the registration and publishing of a graph.  For specificaiton of governance the vocabulary \"VOAG\" may be used."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    rdfs:seeAlso <http://voag.linkedmodel.org/vocab/voag> ;
    sh:property vaem:GraphMetaData-applicableDiscipline,
        vaem:GraphMetaData-applicableDomain,
        vaem:GraphMetaData-description,
        vaem:GraphMetaData-graphName,
        vaem:GraphMetaData-graphTitle,
        vaem:GraphMetaData-hasAspect,
        vaem:GraphMetaData-hasGraphRole,
        vaem:GraphMetaData-hasIdentifier,
        vaem:GraphMetaData-hasLicenseType,
        vaem:GraphMetaData-hasOwner,
        vaem:GraphMetaData-hasSteward,
        vaem:GraphMetaData-hasViewpoint,
        vaem:GraphMetaData-intent,
        vaem:GraphMetaData-latestPublishedVersion,
        vaem:GraphMetaData-namespace,
        vaem:GraphMetaData-namespacePrefix,
        vaem:GraphMetaData-owner,
        vaem:GraphMetaData-previousPublishedVersion,
        vaem:GraphMetaData-publishedDate,
        vaem:GraphMetaData-rdfxmlFileURL,
        vaem:GraphMetaData-releaseDate,
        vaem:GraphMetaData-revision,
        vaem:GraphMetaData-specificity,
        vaem:GraphMetaData-turtleFileURL,
        vaem:GraphMetaData-withAttributionTo .

vaem:GraphRole a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Graph role" ;
    dcterms:description "GraphRole is used to characterize how a graph of resources participates in an ontology set.  For example, a graph can be a schema, vocabulary, dataset, script, or ruleset"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    sh:property vaem:GraphRole-description,
        vaem:GraphRole-filePrefix .

vaem:Party a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "Party" ;
    dcterms:description "A \"Party\" is a generalization for an actor that may be realized as a person, organizaiton or named role."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:Viewpoint a rdfs:Class,
        sh:NodeShape ;
    rdfs:label "ViewpointDimension" ;
    dcterms:description "Viewpoint is used to denote how a set of resources, or an individual resource, is relevant to a context of use. The term \"viewpoint\" is adopted from the ISO RM-ODP specifications and its more recent use in enterprise architecture descriptions. The RM-ODP introducesd the concept of viewpoint to describe a system from a particular set of concerns. RM-ODP defines five viewpoints. Together they provide a complete description of a system: enterprise viewpoint, information viewpoint, computational viewpoint, engineering viewpoint, and technology viewpoint.  In VAEM, \"Viewpoint\" is used as a dimension for characterizing an ontology graph.  The viewpoints of an ontology may not always correpsond directly to those of a system but the idea of describing a subject area of interest from distinct viewpoints is still relevant. A viewpoint can be further distinguished by \"aspects\". For example the \"information viewpoint\" of an application can be partitioned into separate graphs for the \"security\", \"operational\" and\"data retention\" aspects."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    rdfs:subClassOf vaem:Dimension .

vaem:CatalogEntry dcterms:description "VAEM Governed Object class is a placeholder for concepts that are fully defined by the voag:GovernedObject concept hierarchy for building a catalog of ontologies and graphs"^^rdf:HTML .

vaem:CodelistGraph a vaem:GraphRole ;
    rdfs:label "Codelist graph" ;
    vaem:description "A graph that holds enumerations that are codelists."^^rdf:HTML ;
    vaem:filePrefix "CODELIST" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:CollectionGraph a vaem:GraphRole ;
    rdfs:label "Collection graph" ;
    vaem:description "A \"vaem:CollectionGraph\" is a graph that aggregates other graphs using \"owl:imports\" statements."^^rdf:HTML ;
    vaem:filePrefix "COLLECTION" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ConfigurationGraph a vaem:GraphRole ;
    rdfs:label "Configuration Graph" ;
    vaem:description "A graph that serves as a registy or provides other parameter settings."^^rdf:HTML ;
    vaem:filePrefix "CONFIG" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ConnectSetGraph a vaem:GraphRole ;
    rdfs:label "Connect set graph" ;
    vaem:description "A graph that specifies mapings between external data sources and a neutral model."^^rdf:HTML ;
    vaem:filePrefix "CONNECTSET" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ConstraintsGraph a vaem:GraphRole ;
    rdfs:label "Constraints graph" ;
    vaem:description "A graph that is for defining constraints using SPIN."^^rdf:HTML ;
    vaem:filePrefix "CONSTRAINTS" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ControllerGraph a vaem:GraphRole ;
    rdfs:label "Controller graph" ;
    vaem:description "A graph that acts as a controller in an MVC-like framework."^^rdf:HTML ;
    vaem:filePrefix "CONTROLLER" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:CurationGraph a vaem:GraphRole ;
    rdfs:label "Curation graph" ;
    vaem:description "A graph to hold metadata that is needed to describe, govern and provision another graph. A curation graph will likely use VOAG and VAEM for this purpose. The property \"vaem:curationGraph\" is used to link to the graph (or graphs) being curated"^^rdf:HTML ;
    vaem:filePrefix "CURATION" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:DataGraph a vaem:GraphRole ;
    rdfs:label "Data graph" ;
    vaem:description "A graph that holds data instances."^^rdf:HTML ;
    vaem:filePrefix "DATA" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:DatatypesGraph a vaem:GraphRole ;
    rdfs:label "Datatypes graph" ;
    vaem:description "A graph that holds datatype specifications."^^rdf:HTML ;
    vaem:filePrefix "DATATYPES" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:DocumentationGraph a vaem:GraphRole ;
    rdfs:label "Documentation graph" ;
    vaem:description "A graph that is soley for the purpose of generating documentation."^^rdf:HTML ;
    vaem:filePrefix "DOC" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:DynamicGraph a vaem:GraphRole ;
    rdfs:label "Dynamic Graph" ;
    vaem:description "A graph which holds session-dependent data."^^rdf:HTML ;
    vaem:filePrefix "DYNAMIC" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:EditorGraph a vaem:GraphRole ;
    rdfs:label "Editor Graph" ;
    vaem:description "A graph which defines an SWA/SWP editor"^^rdf:HTML ;
    vaem:filePrefix "EDITOR" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ExporterGraph a vaem:GraphRole ;
    rdfs:label "Exporter Graph" ;
    vaem:description "A graph which has scripts and or rules for exporting data."^^rdf:HTML ;
    vaem:filePrefix "EXPORTER" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:FunctionsGraph a vaem:GraphRole ;
    rdfs:label "Functions graph" ;
    vaem:description "A graph that defines SPIN functions."^^rdf:HTML ;
    vaem:filePrefix "FUNCTIONS" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ImporterGraph a vaem:GraphRole ;
    rdfs:label "Importer Graph" ;
    vaem:description "A graph which has scripts and or rules for importing data."^^rdf:HTML ;
    vaem:filePrefix "IMPORTER" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:LinkSetGraph a vaem:GraphRole ;
    rdfs:label "Link Set graph" ;
    vaem:description "A graph that holds statements that specify links between resources."^^rdf:HTML ;
    vaem:filePrefix "LINKSET" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:MappingGraph a vaem:GraphRole ;
    rdfs:label "Mapping graph" ;
    vaem:description "A graph that specifies a transformation of a graph into another graph or graphs. Invariably this is a SPINMap graph using SPARQL Rules (SPIN) to express the transforms."^^rdf:HTML ;
    vaem:filePrefix "MAPPINGS" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ModelGraph a vaem:GraphRole ;
    rdfs:label "Model Graph" ;
    vaem:description "A graph which specifies one or more models."^^rdf:HTML ;
    vaem:filePrefix "MODEL" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ProjectGraph a vaem:GraphRole ;
    rdfs:label "Project Type Graph" ;
    vaem:description "A graph which defines a project type."^^rdf:HTML ;
    vaem:filePrefix "PROJECT" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ProxyGraph a vaem:GraphRole ;
    rdfs:label "Proxy graph" ;
    vaem:description "A graph that represents an external data source, or schema, as an ontology model."^^rdf:HTML ;
    vaem:filePrefix "PROXY" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ReferenceDataGraph a vaem:GraphRole ;
    rdfs:label "Reference data graph" ;
    vaem:description "A graph that holds reference data."^^rdf:HTML ;
    vaem:filePrefix "REFDATA" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:RulesGraph a vaem:GraphRole ;
    rdfs:label "Rules Graph" ;
    vaem:description "A graph that holds SPIN rules."^^rdf:HTML ;
    vaem:filePrefix "RULES" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:SPINlibraryGraph a vaem:GraphRole ;
    rdfs:label "SPIN Library Graph" ;
    vaem:description "A graph that holds SPIN library code."^^rdf:HTML ;
    vaem:filePrefix "SPIN" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ScriptGraph a vaem:GraphRole ;
    rdfs:label "Script graph" ;
    vaem:description "A graph that defines SWP templates that are of a general scripting nature."^^rdf:HTML ;
    vaem:filePrefix "SCRIPT" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ServicesGraph a vaem:GraphRole ;
    rdfs:label "Services Graph" ;
    vaem:description "A graph that implements SWP services."^^rdf:HTML ;
    vaem:filePrefix "SERVICES" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ShapesGraph a vaem:GraphRole ;
    rdfs:label "SHAPES Graph" ;
    vaem:description "A graph of SHAPE SHACL constraints."^^rdf:HTML ;
    vaem:filePrefix "SHAPES" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ShapesUIgraph a vaem:GraphRole ;
    rdfs:label "SHAPES UI Graph" ;
    vaem:description "A graph of SHAPE SHACL constraints for UI purposes."^^rdf:HTML ;
    vaem:filePrefix "SHAPES-UI" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:SurrogateGraph a vaem:GraphRole ;
    rdfs:label "Surrogate graph" ;
    vaem:description "A graph that specifies minimal representation of resources from another graph so as to avoid the need to import it."^^rdf:HTML ;
    vaem:filePrefix "CONNECTSET" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:TransformsGraph a vaem:GraphRole ;
    rdfs:label "Transforms graph" ;
    vaem:description "A graph that uses SPIN to define transforms."^^rdf:HTML ;
    vaem:filePrefix "TRANSFORMS" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:UnknownGraphRole a vaem:GraphRole ;
    rdfs:label "Unknown graph role" ;
    vaem:description "A graph whose role is unknown."^^rdf:HTML ;
    vaem:filePrefix "UNKNOWN" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:UnspecifiedGraphRole a vaem:GraphRole ;
    rdfs:label "Unspecified Graph Role" ;
    vaem:description "A graph that is for defining constraints using SPIN."^^rdf:HTML ;
    vaem:filePrefix "CONSTRAINTS" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:UtilityGraph a vaem:GraphRole ;
    rdfs:label "Utility Graph" ;
    vaem:description "An SWP graph that is a utiltity."^^rdf:HTML ;
    vaem:filePrefix "UTILITY" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ViewGraph a vaem:GraphRole ;
    rdfs:label "View graph" ;
    vaem:description "A graph that provides the access to services in an MVC-like framework."^^rdf:HTML ;
    vaem:filePrefix "VIEW" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:ViewerGraph a vaem:GraphRole ;
    rdfs:label "Viewer Graph" ;
    vaem:description "A graph which defines an SWA/SWP viewer"^^rdf:HTML ;
    vaem:filePrefix "VIEWER" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:VocabularyGraph a vaem:GraphRole ;
    rdfs:label "Vocabulary graph" ;
    vaem:description "A graph that is a controlled set of instances that define a terminology. Typically this is based on SKOS."^^rdf:HTML ;
    vaem:filePrefix "VOCAB" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:comment-range a sh:NodeShape ;
    rdfs:label "Values of comment" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    sh:property [ sh:datatype xsd:string ;
            sh:path vaem:comment ] ;
    sh:targetSubjectsOf vaem:comment .

vaem:dateCreated dcterms:description "The property \"vaem:dateCreated\" is intended for general use as the name implies.  The range of the property is set as \"vaem:dateUnion\" so as to allow a value to have a number of forms from a  year only to a full timestamp"^^rdf:HTML .

vaem:hasGraphMetadata-range a sh:NodeShape ;
    rdfs:label "Values of hasGraphMetadata" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    sh:property [ sh:class vaem:GraphMetaData ;
            sh:path vaem:hasGraphMetadata ] ;
    sh:targetSubjectsOf vaem:hasGraphMetadata .

vaem:idString dcterms:description "The property \"vaem:idString\" is intended for general use as a means to specifiy a unique reference to something. This is a data property with a string range and is a sub-property of \"vame:id\""^^rdf:HTML .

vaem:isElaboratedIn-range a sh:NodeShape ;
    rdfs:label "Values of isElaboratedIn" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:path vaem:isElaboratedIn ] ;
    sh:targetSubjectsOf vaem:isElaboratedIn .

vaem:isMetadataFor a rdf:Property ;
    rdfs:label "is metadata for" ;
    dcterms:description "An annotation used to reference the graph that is being described with metadata."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:lastUpdated dcterms:description "The property \"vaem:lastUpdated\" is intended for general use as the name implies.  The range of the property is set as \"vaem:dateUnion\" so as to allow a value to have a number of forms from a  year only to a full timestamp"^^rdf:HTML .

vaem:logo-range a sh:NodeShape ;
    rdfs:label "Values of logo" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:path vaem:logo ] ;
    sh:targetSubjectsOf vaem:logo .

vaem:name-range a sh:NodeShape ;
    rdfs:label "Values of name" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    sh:property [ sh:datatype xsd:string ;
            sh:path vaem:name ] ;
    sh:targetSubjectsOf vaem:name .

vaem:ownedBy dcterms:description "The property \"vaem:ownedBy\" is a general property that in some cases could have scalar values or may refer to some concept of \"Party\".  For this reason, the  type of this property is set as \"rdf:Property\" and the property is rangeless. There are two sub-properties of \"vaem:ownedBy\", namely \"vaem:owner\" for string values and \"vaem:owningParty\" for referencing a party.  Ownership applies to those ontologies that are proprietary"^^rdf:HTML .

vaem:owningParty dcterms:description "The property \"vaem:owningParty\" is used to refer to some concept of \"Party\" and is a sub-property of \"vaem:ownedBy\""^^rdf:HTML .

vaem:rationale-range a sh:NodeShape ;
    rdfs:label "Values of rationale" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    sh:property [ sh:datatype xsd:string ;
            sh:path vaem:rationale ] ;
    sh:targetSubjectsOf vaem:rationale .

vaem:reifiableBy a rdf:Property ;
    rdfs:label "reifiable by" ;
    dcterms:description "To express how statements in a model can be reifiable, this property is used to explicitly associate a property with a user-defined sub-class of \"rdf:Statement\". A recommended way of using this is to declare the properties that share the same reification constructs as sub-properties of a parent property that carries the \"vaem:reifiableBy\" property. The parent property should be of type \"rdf:Property\" so that it can have both datatype and object properties as sub-properties. By this means use and transformations of a model can be understood through a fully specified metamodel. \"vaem:reifiableBy\" is rangeless in order to comply with OWL DL semantics. Its range would have been rdfs:Class in order to refer to \"rdf:Statement\" sub-classes"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:todo-range a sh:NodeShape ;
    rdfs:label "Values of todo" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    sh:property [ sh:datatype xsd:string ;
            sh:path vaem:todo ] ;
    sh:targetSubjectsOf vaem:todo .

vaem:urlForHTML-range a sh:NodeShape ;
    rdfs:label "Values of urlForHTML" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:path vaem:urlForHTML ] ;
    sh:targetSubjectsOf vaem:urlForHTML .

vaem:usesNonImportedResource a rdf:Property ;
    rdfs:label "uses non-imported resource" ;
    dcterms:description "The property \"vaem:usesNonImportedResource\" is used to express dependencies on resources from graphs that are not imported"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:website-range a sh:NodeShape ;
    rdfs:label "Values of website" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:path vaem:website ] ;
    sh:targetSubjectsOf vaem:website .

vaem:GMD_VAEM a vaem:GraphMetaData ;
    rdfs:label "VAEM Schema Version 2.0 Metadata" ;
    dcterms:abstract "VAEM stands for \"Vocabulary for Attaching Essential Metadata\". What VAEM regards as essential metadata is data about dates and times, confidentiality, and other characterisitic qualifiers of the ontology, but also references to where a ontology is documented and where to find ontology registration for governance, attribution and provenance. VAEM makes use of some properties from the DC terms vocabulary using the namespace prefix \"dct\". VAEM is OWL-DL compliant." ;
    dcterms:created "2011-04-20"^^xsd:date ;
    dcterms:modified "2016-12-19"^^xsd:date ;
    dcterms:title "VAEM Version 2.0 Metadata" ;
    vaem:description "VAEM stands for \"Vocabulary for Attaching Essential Metadata\". What VAEM regards as essential metadata is data about dates and times, confidentiality, and other characterisitic qualifiers of the ontology, but also references to where a ontology is documented and where to find ontology registration for governance, attribution and provenance. VAEM makes use of some properties from the DC terms vocabulary using the namespace prefix \"dct\"."^^rdf:HTML ;
    vaem:graphName "VAEM" ;
    vaem:graphTitle "VAEM: Vocabulary for Attaching Essential Metadata (v2.0)" ;
    vaem:hasGraphRole vaem:SchemaGraph ;
    vaem:hasOwner vaem:TopQuadrant ;
    vaem:hasSteward vaem:TopQuadrant ;
    vaem:intent "The purpose of VAEM is to provide, by import, a foundation for commonly needed resources for metadata on an ontology." ;
    vaem:isMetadataFor <http://www.linkedmodel.org/2.0/schema/vaem> ;
    vaem:latestPublishedVersion "http://www.linkedmodel.org/doc/2015/SCHEMA_vaem-v2.0"^^xsd:anyURI ;
    vaem:logo "http://www.linkedmodel.org/lib/lm/images/logos/vaem_logo_300x110.png"^^xsd:anyURI ;
    vaem:namespace "http://www.linkedmodel.org/schema/vaem#"^^xsd:anyURI ;
    vaem:namespacePrefix "vaem" ;
    vaem:owner "TopQuadrant, Inc." ;
    vaem:previousPublishedVersion "http://linkedmodel.org/doc/vaem/1.2/"^^xsd:anyURI ;
    vaem:releaseDate "2016-09-27"^^xsd:date ;
    vaem:revision "2.0" ;
