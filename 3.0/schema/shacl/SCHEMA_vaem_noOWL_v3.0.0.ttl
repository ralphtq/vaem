vaem:SchemaGraph a vaem:GraphRole ;
    rdfs:label "Schema graph" ;
    vaem:description "A graph that defines classes and properties for one or more namespaces."^^rdf:HTML ;
    vaem:filePrefix "SCHEMA" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:applicableDiscipline a rdf:Property ;
    rdfs:label "applicable discipline" ;
    dcterms:description "The property \"vaem:applicableDiscipline\" is used to indicate relevance of a set of resources, or a resource itself, to a specific discipline of work or study. Examples of disciplines in the engineering domain are electrical engineering, mechanical engineering and, in the financial domain, risk assessment, investment analysis.  In VAEM, the property is used as a dimension for characterizing an ontology graph.  The property is an \"rdf:Property\" to allow both scalar and object values"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    rdfs:subPropertyOf vaem:hasDimension .

vaem:applicableDomain a rdf:Property ;
    rdfs:label "apllicable domain" ;
    dcterms:description "The property \"vaem:applicableDomain\" is used to specify how  a set of resources, or an individual resource is grounded in a domain, that is, a subject area of interest. Examples of domains are \"enterprise\", \"process\", \"organization\" and \"system\". In VAEM, the property is used as a dimension for characterizing an ontology graph. The property is an \"rdf:Property\" to allow both scalar and object values"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    rdfs:subPropertyOf vaem:hasDimension .

vaem:filePrefix a rdf:Property ;
    rdfs:label "file prefix" ;
    dcterms:description "The property \"vaem:filePrefix\" is for specifying a preferred file prefix for a graph. For example a schema graph may be given the file prefix \"SCHEMA\" followed by an underscore \"_\"."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:graphName a rdf:Property ;
    rdfs:label "graph name" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:graphTitle a rdf:Property ;
    rdfs:label "graph title" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:hasAspect a rdf:Property ;
    rdfs:label "has aspect " ;
    dcterms:description "The property \"vaem:hasAspect\" is used to distinguish among sets of features of a domain or subject area. The term is borrowed from \"aspect-oriented\" programming, where it is used to separate concerns. An ontology may be characterized by this dimension so as to parition features that are orthogonal. For example,  in a systems ontology we can distinguish aspects for \"structure\", \"function\", \"behavior\" and \"interface\".  The property is an \"rdf:Property\" to allow both scalar and object values"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    rdfs:subPropertyOf vaem:hasDimension .

vaem:hasGraphRole a rdf:Property ;
    rdfs:label "has graph role" ;
    dcterms:description "The property \"lms:hasGraphRole\" is used to characterize how a resource participates in an ontology set.  The property is used to specify the role that a graph plays, for example, an ontology graph can be a schema, vocabulary, dataset, script, or ruleset"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:hasIdentifier a rdf:Property ;
    rdfs:label "has identifier" ;
    dcterms:description "The property \"vaemhasIdentifier\" is intended for general use as a means to specifiy a unique reference to something. This is an object property that is a sub-property of \"vame:id\""^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:hasLicenseType a rdf:Property ;
    rdfs:label "has license type"@en-US ;
    dcterms:description "The property \"vaem:hasLicenseType\" points to an entry in the VOAG ontology for licenses"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:hasOwner a rdf:Property ;
    rdfs:label "has owner" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:hasSteward a rdf:Property ;
    rdfs:label "has steward" ;
    dcterms:description "A property that is used to refer to a \"Steward\", that is, the party or role that is responsible for maintaining an asset, in the case of VAEM, an ontology graph."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:hasViewpoint a rdf:Property ;
    rdfs:label "has viewpoint" ;
    dcterms:description "The property \"vaem:hasViewpoint\" is used to denote how a set of resources, or an individual resource, is relevant to a context of use. The term \"viewpoint\" is adopted from the ISO RM-ODP specifications and its more recent use in enterprise architecture descriptions.  In VAEM, the property is used as a dimension for characterizing an ontology graph.  The property is an \"rdf:Property\" to allow both scalar and object values"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    rdfs:subPropertyOf vaem:hasDimension .

vaem:intent a rdf:Property ;
    rdfs:label "intent" ;
    dcterms:description "The property \"vaem:intent\" is used to outline  a statement of purpose. This typically expresses one or more desired outcomes"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:latestPublishedVersion a rdf:Property ;
    rdfs:label "latest published version" ;
    dcterms:description "The property \"vaem:latestPublishedVersion\"is a URL to documentation for the latest version of a graph."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:namespace a rdf:Property ;
    rdfs:label "namespace" ;
    dcterms:description "The property \"vaem:namespace\" is the onotlogy URI with which a graph is primarily associated. The intent is to allow multiple graphs to define statements for resources in the same Ontology namespace. For example, a foundation level graph with the base URI of \"http://www.somesite.com/1.0/schema/OurOntology\"  may define general  concepts for \"OurOntology\". Another graph with the base URI \"http://www.somesite.com/1.0/schema/level2/OurOntology\"  may add more specific details to the same \"OurOntology\". Each of these two graphs would carry the same value for \"vaem:namespace\", that is, \"http://www.somesite.com/schema/OurOntology\".    In other words, an ontology URI is the URI associated with the resources of a controlled namespace. On the other hand the graph URIs (the base URIs) identify the graphs that hold resources that make up an ontology"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:namespacePrefix a rdf:Property ;
    rdfs:label "namespace prefix" ;
    dcterms:description "The property \"vaem:namespacePrefix\" specifes a short handle or label for the URI of an Ontology.  Multiple graphs can define statements for resources in the same Ontololgy namespace. For example, a foundation level graph with the base URI of \"http://www.somesite.com/1.0/schema/OurOntology\"  may define general  concepts for \"OurOntology\". Another graph with the base URI \"http://www.somesite.com/1.0/schema/level2/OurOntology\"  may add more specific details to the same \"OurOntology\". Each of these two graphs would carry the same value for \"vaem:namespacePrefix\", for this example, perhaps, \"ourOntology\""^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:owner a rdf:Property ;
    rdfs:label "owner" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:previousPublishedVersion a rdf:Property ;
    rdfs:label "previous published version" ;
    dcterms:description "The property \"vaem:previousPublishedVersion\"is a URL to documentation for the previous version of a graph."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:rdfxmlFileURL a rdf:Property ;
    rdfs:label "RDF/XML file URL" ;
    dcterms:description "The property \"vaem:rdfxmlFileURL\" is used to provide a link to the location of the ontology's RDF/XML file"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:revision a rdf:Property ;
    rdfs:label "revision" ;
    dcterms:description "The property \"vaem:revision\" is a property intended for general use as the name implies."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:specificity a rdf:Property ;
    rdfs:label "specificity" ;
    dcterms:description "The property \"vaem:specificity\" is intended to specify the level of detail of an ontology.  The values that can be set for this property are restriced to an integer from 1 to 5. An ontology at level 1 has concepts of more general applicability than one at level 5. By having graphs at different levels of specificity it is possible to support greater modularity for selective imports"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:turtleFileURL a rdf:Property ;
    rdfs:label "turtle file URL" ;
    dcterms:description "The property \"vaem:turtleFileURL\" is used to provide a link to the location of the ontology's turtle file"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:withAttributionTo a rdf:Property ;
    rdfs:label "with attribution to" ;
    dcterms:description "The property \"vaem:withAttributionTo\" is an annotation property that is either used to hold either a string or a reference to an instance of \"voag:Attribution\", from the VOAG ontology"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:TopQuadrant a vaem:Party ;
    rdfs:label "TopQuadrant" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:comment a rdf:Property ;
    rdfs:label "comment" ;
    dcterms:description "An annotation property that can be freely used on any kind of resource. The range of the property is \"xsd:string\""^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:date a rdf:Property ;
    rdfs:label "date" ;
    dcterms:description "The property \"vaem:date\" is intended for general use as the name implies.  The range of the property is set as \"vaem:dateUnion\" so as to allow a value to have a number of forms from a  year only to a full timestamp. The property is also the parent of all dates so that queries can be made for any date on an ontology"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:description a rdf:Property ;
    rdfs:label "description" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:hasGraphMetadata a rdf:Property ;
    rdfs:label "has graph metadata" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:isElaboratedIn a rdf:Property ;
    rdfs:label "is elaborated in" ;
    dcterms:description "An annotation used to reference a graph that elaborates (adds properties and axioms to) a resource"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    rdfs:subPropertyOf rdfs:isDefinedBy .

vaem:logo a rdf:Property ;
    rdfs:label "logo" ;
    dcterms:description "The property \"vaem:logo\" is a reference to an image that is used for publishing the ontology\""^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:name a rdf:Property ;
    rdfs:label "context name" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:publishedDate a rdf:Property ;
    rdfs:label "published date" ;
    dcterms:description "The property \"vaem:publishedDate\" specifies the date and time that the ontology was published. This is distinct from a release date in the sense that \"release\" may not imply being published."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    rdfs:seeAlso vaem:releaseDate ;
    rdfs:subPropertyOf vaem:date .

vaem:rationale a rdf:Property ;
    rdfs:label "rationale" ;
    dcterms:description "A description of a justification for some other assertion or value"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:releaseDate a rdf:Property ;
    rdfs:label "release date" ;
    dcterms:description "The property \"vaem:releaseDate\" specifies the date and time that the ontology was released. This is distinct from a publication date in the sense that \"release\" may not imply being published."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> ;
    rdfs:seeAlso vaem:publishedDate ;
    rdfs:subPropertyOf vaem:date .

vaem:todo a rdf:Property ;
    rdfs:label "todo" ;
    dcterms:description "As it name implies, a way to attach an annotation about a \"todo\" task"^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:urlForHTML a rdf:Property ;
    rdfs:label "URL for HTML" ;
    dcterms:description "Provides a link to the location of the ontology's HTML file" ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:website a rdf:Property ;
    rdfs:label "website" ;
    dcterms:description "Provides a link to a party's website, where a party is typically an organization." ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

vaem:hasDimension a rdf:Property ;
    rdfs:label "has dimension" ;
    dcterms:description "The property \"vaem:hasDimension\" is used categorize an ontology.  In VAEM, the property is used to characterize an ontology graph."^^rdf:HTML ;
    rdfs:isDefinedBy <http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> .

<http://www.linkedmodel.org/3.0.0/schema/shacl/vaem> a owl:Ontology ;
    rdfs:label "SCHEMA VAEM SHACL Version 3.0.0" ;
    vaem:hasGraphMetadata vaem:GMD_VAEM .

