.
vaem:GraphRole
  a rdfs:Class ;
  a sh:NodeShape ;
  dcterms:description """
GraphRole is used to characterize how a graph of resources participates in an ontology set.
For example, a graph can be a schema, vocabulary, dataset, script, or ruleset.
"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Graph Role" ;
  rdfs:subClassOf vaem:ElementalConstruct ;
  sh:property vaem:GraphRole-description ;
  sh:property vaem:GraphRole-filePrefix ;
.
vaem:GraphRole-description
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  sh:path dcterms:description ;
  sh:maxCount 1 ;
.
vaem:GraphRole-filePrefix
  a sh:PropertyShape ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  sh:path vaem:filePrefix ;
  sh:datatype xsd:string ;
  sh:maxCount 1 ;
.
