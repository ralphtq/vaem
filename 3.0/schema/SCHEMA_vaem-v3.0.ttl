# baseURI: http://www.linkedmodel.org/3.0/schema/vaem

@prefix dash: <http://datashapes.org/dash#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix voag: <http://voag.linkedmodel.org/voag/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.linkedmodel.org/3.0/schema/vaem>
  a owl:Ontology ;
  dcterms:description """
<p>
VAEM stands for "<em>Vocabulary About Elemental Metadata</em>". 
Elemental Metadata is specified as foundational constructs for metaclasses, 
properties for dates and times, characterisitic qualifiers of the ontology such as dimensions, 
governance, attribution, along with references to where an ontology is documented and where it is 
registrated.
</p>
<p>
VAEM makes use of some properties from the DC terms vocabulary. 
</p>
"""^^rdf:HTML ;
  rdfs:label "VAEM Schema Version 3.0" ;
  vaem:hasGraphMetadata vaem:GMD_VAEM ;
  owl:versionIRI <http://www.linkedmodel.org/3.0/schema/vaem> ;
.
vaem:Aspect
  a vaem:AspectClass ;
  dcterms:description """
<p><strong>Aspect</strong> superclass is an abstract class that has sub-classes that specify distinct sets of properties. 
These serve as <strong><strong>features</strong></strong> or <strong>traits</strong> for reuse with a defining set of properties. 
They can be considered equivalent to interface classes in Java, traits in Scala and type classes in other languages. 
All aspect classes should be of type <strong>AspectClass</strong> so that they are distinguished as "mix-ins" as opposed to classes 
in a type hierarchy.</p>
"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Aspect" ;
  rdfs:subClassOf vaem:ElementalConstruct ;
.
vaem:AspectClass
  a rdfs:Class ;
  a sh:NodeShape ;
  rdfs:comment """
<p>An <strong>Aspect Class</strong> is the type for all "Aspect" classes. 
These serve as <strong>features</strong> or <strong>traits</strong> for reuse with a defining set of properties. 
They are equivalent to interface classes in Java, traits in Scala and type classes in other languages.</p>
"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Aspect Class" ;
  rdfs:subClassOf rdfs:Class ;
  rdfs:subClassOf sh:NodeShape ;
.
vaem:CatalogEntry
  a rdfs:Class ;
  a sh:NodeShape ;
  dcterms:description """
VAEM Governed Object class is a placeholder for concepts that are fully defined by 
the "voag:GovernedObject" concept hierarchy for building a catalog of ontologies and graphs.
"""^^rdf:HTML ;
  rdfs:label "Catalog Entry" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:subClassOf vaem:ElementalConstruct ;
.
vaem:CodelistGraph
  a vaem:GraphRole ;
  dcterms:description "A graph that holds enumerations that are codelists."^^rdf:HTML ;
  vaem:filePrefix "CLTGRAPH" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Codelist graph" ;
.
vaem:CollectionGraph
  a vaem:GraphRole ;
  dcterms:description """
A "vaem:CollectionGraph" is a graph that aggregates other graphs using "owl:imports" 
statements.
"""^^rdf:HTML ;
  vaem:filePrefix "CLNGRAPH" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Collection graph" ;
.
vaem:ConfigurationGraph
  a vaem:GraphRole ;
  dcterms:description "A graph that serves as a registy or provides other parameter settings."^^rdf:HTML ;
  vaem:filePrefix "CFGGRAPH" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Configuration Graph" ;
.
vaem:Discipline
  a owl:Class ;
  dcterms:description """
A discipline is a specific area of work or study.
Examples of disciplines are "civil engineering" and "nursing".
In VAEM, discipline is used as a dimension for characterizing an ontology graph and
specializing where a domain is being used.
For example a graph might be about material science for civil engineering or chemistry for nursing.
"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Discipline" ;
  rdfs:subClassOf vaem:ElementalConstruct ;
.
vaem:Domain
  a owl:Class ;
  dcterms:description """
A domain is a subject area of interest. 
Examples of domains are "chemistry", "physics", "material science", "mechanics" and "medicine".
"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/2.0/schema/vaem> ;
  rdfs:label "Domain" ;
  rdfs:subClassOf vaem:ElementalConstruct ;
.
vaem:ElementalConstruct
  a rdfs:Class ;
  a sh:NodeShape ;
  dcterms:description """
<em>VAEM Construct</em> class is an abstract root class for all VAEM classes.
"""^^rdf:HTML ;
  rdfs:label "Elemental Construct" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:subClassOf owl:Thing ;
  sh:abstract true ;
.
vaem:HarmonizationGraph
  a vaem:GraphRole ;
  dcterms:description "A graph that specifies mapings between external data sources and a neutral model."^^rdf:HTML ;
  vaem:filePrefix "HRMGRAPH" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Harmonization Graph" ;
.
vaem:ConstraintsGraph
  a vaem:GraphRole ;
  dcterms:description "A graph that is for defining constraints using SPIN."^^rdf:HTML ;
  vaem:filePrefix "CSTGRAPH" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Constraints graph" ;
.
vaem:ControllerGraph
  a vaem:GraphRole ;
  dcterms:description "A graph that acts as a controller in an MVC-like framework."^^rdf:HTML ;
  vaem:filePrefix "CTRGRAPH" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Controller graph" ;
.
vaem:DataGraph
  a vaem:GraphRole ;
  dcterms:description "A graph that holds data instances."^^rdf:HTML ;
  vaem:filePrefix "DATGRAPH" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Data graph" ;
.
vaem:DatatypesGraph
  a vaem:GraphRole ;
  dcterms:description "A graph that holds datatype specifications."^^rdf:HTML ;
  vaem:filePrefix "DTYGRAPH" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Datatypes graph" ;
.
vaem:DocumentationGraph
  a vaem:GraphRole ;
  dcterms:description "A graph for the purpose of generating documentation."^^rdf:HTML ;
  vaem:filePrefix "DOCGRAPH" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Documentation graph" ;
.
vaem:DynamicGraph
  a vaem:GraphRole ;
  dcterms:description "A graph which holds session-dependent data."^^rdf:HTML ;
  vaem:filePrefix "DYNGRAPH" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Dynamic Graph" ;
.
vaem:FunctionsGraph
  a vaem:GraphRole ;
  dcterms:description "A graph that defines functions."^^rdf:HTML ;
  vaem:filePrefix "FUNGRAPH" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Functions Graph" ;
.
vaem:GMD_VAEM
  a vaem:GraphMetaData ;
  dcterms:abstract """
<p>
VAEM stands for "<em>Vocabulary About Elemental Metadata</em>". 
What VAEM regards as empirical metadata is foundational constructs for metaclasses, 
properties for dates and times, characterisitic qualifiers of the ontology such as dimensions, 
governance, attribution, alon with references to where an ontology is documented and where it is 
registrated.
</p>
<p>
VAEM makes use of some properties from the DC terms vocabulary using the namespace prefix "dct". 
"""^^rdf:HTML ;
  dcterms:created "2023-09-21"^^xsd:date ;
  dcterms:modified "2023-09-21"^^xsd:date ;
  dcterms:title "VAEM Version 3.0 Metadata" ;
  dcterms:description """
<p>
VAEM stands for "<em>Vocabulary About Elemental Metadata</em>". 
Elemental Metadata is specified as foundational constructs for metaclasses, 
properties for dates and times, characterisitic qualifiers of the ontology such as dimensions, 
governance, attribution, along with references to where an ontology is documented and where it is 
registrated.
</p>
<p>
VAEM makes use of some properties from the DC terms vocabulary and "voag:Attribution" from the "VOAG" ontology. 
</p>
"""^^rdf:HTML ;
  vaem:graphName "VAEM" ;
  vaem:graphTitle "VAEM: Vocabulary About Elemental Metadata (v3.0)" ;
  vaem:hasGraphRole vaem:SchemaGraph ;
  vaem:intent "The purpose of VAEM is to provide, by import, a foundation for commonly needed resources for metadata on an ontology." ;
  vaem:isMetadataFor <http://www.linkedmodel.org/3.0/schema/vaem> ;
  vaem:latestPublishedVersion "http://www.linkedmodel.org/doc/2015/SCHEMA_vaem-v2.0"^^xsd:anyURI ;
  vaem:logo "http://www.linkedmodel.org/lib/lm/images/logos/vaem_logo_300x110.png"^^xsd:anyURI ;
  vaem:namespace "http://www.linkedmodel.org/schema/vaem#"^^xsd:anyURI ;
  vaem:namespacePrefix "vaem" ;
  vaem:previousPublishedVersion "http://linkedmodel.org/doc/vaem/1.2/"^^xsd:anyURI ;
  vaem:releaseDate "2023-09-25"^^xsd:date ;
  vaem:revision "3.0" ;
  vaem:turtleFileURL "http://www.linkedmodel.org/2.0/schema/SCHEMA_vaem-v3.0.ttl"^^xsd:anyURI ;
  vaem:usesNonImportedResource dash:reifiableBy ;
  vaem:usesNonImportedResource dcterms:abstract ;
  vaem:usesNonImportedResource dcterms:author ;
  vaem:usesNonImportedResource dcterms:created ;
  vaem:usesNonImportedResource dcterms:modified ;
  vaem:usesNonImportedResource dcterms:title ;
  vaem:usesNonImportedResource voag:Attribution ;
  vaem:usesNonImportedResource voag:CC-SHAREALIKE_3PT0-US ;
  vaem:withAttributionTo "VAEM is issued under a Creative Commons Attribution Share Alike 3.0 United States License. Attribution should be made to TopQuadrant, Inc." ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "VAEM Schema Version 3.0 Metadata" ;
.
vaem:GraphDimensionAspect
  a vaem:GraphDimension ;
  dcterms:description """
<p>Aspect is used to distinguish among sets of features of a domain or subject area. 
The term is borrowed from "aspect-oriented programming", where it is used to 
separate concerns. 
An ontology may be characterized by this dimension so as to parition features that 
are orthogonal.
</p>
<p>
For example, in a systems ontology there may be aspects for "structure", "function", 
"behavior" and "interface" or "interoperability".
</p>
<p>
A "ViewpointGraph" is another dimension of ontology modeling that is distinguished from AspectGraph" by being concerned with
concerned with the context of interest.
</p>
"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Aspect Graph Dimension" ;
  rdfs:subClassOf vaem:DimensionGraph ;
.
vaem:GraphMetaData
  a rdfs:Class ;
  a sh:NodeShape ;
  dcterms:description """
<p>For a graph expressed in RDF and SHACL, <em>vaem:GraphMetaData</em> defines basic metadata for the meta-ontology constructs, 
graph metadata constructs, registration and publishing properties.  
</p>
<p>
For specification of graph governance the vocabulary "VOAG" may be used.
</p>
"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "Graph Metadata" ;
  rdfs:seeAlso <http://voag.linkedmodel.org/vocab/voag> ;
  rdfs:subClassOf vaem:ElementalConstruct ;
  sh:property vaem:GraphMetaData-description ;
  sh:property vaem:GraphMetaData-graphName ;
  sh:property vaem:GraphMetaData-graphTitle ;
  sh:property vaem:GraphMetaData-hasDiscipline ;
  sh:property vaem:GraphMetaData-hasDomain ;
  sh:property vaem:GraphMetaData-hasGraphRole ;
  sh:property vaem:GraphMetaData-hasIdentifier ;
  sh:property vaem:GraphMetaData-hasLicenseType ;
  sh:property vaem:GraphMetaData-hasOwner ;
  sh:property vaem:GraphMetaData-hasSteward ;
  sh:property vaem:GraphMetaData-hasViewpoint ;
  sh:property vaem:GraphMetaData-intent ;
  sh:property vaem:GraphMetaData-latestPublishedVersion ;
  sh:property vaem:GraphMetaData-namespace ;
  sh:property vaem:GraphMetaData-namespacePrefix ;
  sh:property vaem:GraphMetaData-owner ;
  sh:property vaem:GraphMetaData-previousPublishedVersion ;
  sh:property vaem:GraphMetaData-publishedDate ;
  sh:property vaem:GraphMetaData-rdfxmlFileURL ;
  sh:property vaem:GraphMetaData-releaseDate ;
  sh:property vaem:GraphMetaData-revision ;
  sh:property vaem:GraphMetaData-specificity ;
  sh:property vaem:GraphMetaData-turtleFileURL ;
  sh:property vaem:GraphMetaData-withAttributionTo ;
.
