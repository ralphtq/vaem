.
vaem:ShapesGraph
  a vaem:GraphRole ;
  dcterms:description "A graph of SHAPE SHACL constraints."^^rdf:HTML ;
  vaem:filePrefix "SHAGRAPH" ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "SHAPES Graph" ;
.
vaem:StringOrLangStringOrHTMLorAttribution
  a rdf:List ;
  rdf:first [
      sh:datatype xsd:string ;
    ] ;
  rdf:rest (
      [
        sh:datatype rdf:langString ;
      ]
      [
        sh:datatype rdf:HTML ;
      ]
      [
        sh:class voag:Attribution ;
      ]
    ) ;
  rdfs:comment """
An <em>rdf:List</em> that can be used in property constraints as value for <em>sh:or</em> to indicate 
that all values of a property must be either <em>xsd:string</em>, <em>rdf:langString</em>  or <em>rdf:HTML</em> 
(in that order of preference).
"""^^rdf:HTML ;
  rdfs:label "string or langString or HTML" ;
.
vaem:StringOrLangString
  a rdf:List ;
  rdf:first [
      sh:datatype xsd:string ;
    ] ;
  rdf:rest (
      [
        sh:datatype rdf:langString ;
      ]
    ) ;
  rdfs:comment """
An <em>rdf:List</em> that can be used in property constraints as value for <em>sh:or</em> to indicate 
that all values of a property must be either <em>xsd:string</em>, or <em>rdf:langString</em> 
(in that order of preference).
"""^^rdf:HTML ;
  rdfs:label "string or langString" ;
.
vaem:StringOrLangStringOrHTML
  a rdf:List ;
  rdf:first [
      sh:datatype xsd:string ;
    ] ;
  rdf:rest (
      [
        sh:datatype rdf:langString ;
      ]
      [
        sh:datatype rdf:HTML ;
      ]
    ) ;
  rdfs:comment """
An <em>rdf:List</em> that can be used in property constraints as value for <em>sh:or</em> to indicate 
that all values of a property must be either <em>xsd:string</em>, <em>rdf:langString</em>  or <em>rdf:HTML</em> 
(in that order of preference).
"""^^rdf:HTML ;
  rdfs:label "string or langString or HTML" ;
.
vaem:StringOrLangStringOrHTMLorParty
  a rdf:List ;
  rdf:first [
      sh:datatype xsd:string ;
    ] ;
  rdf:rest (
      [
        sh:datatype rdf:langString ;
      ]
      [
        sh:datatype rdf:HTML ;
      ]
      [
        sh:class voag:Party ;
      ]
    ) ;
  rdfs:comment """
An <em>rdf:List</em> that can be used in property constraints as value for <em>sh:or</em> to indicate 
that all values of a property must be either <em>xsd:string</em>, <em>rdf:langString</em>  or <em>rdf:HTML</em> 
(in that order of preference).
"""^^rdf:HTML ;
  rdfs:label "string or langString or HTML" ;
.
