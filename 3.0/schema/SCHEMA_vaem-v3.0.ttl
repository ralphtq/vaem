vaem:releaseDate
  a rdf:Property ;
  dcterms:description "The property \"vaem:releaseDate\" specifies the date and time that the ontology was released. This is distinct from a publication date in the sense that \"release\" may not imply being published."^^rdf:HTML ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/3.0/schema/vaem> ;
  rdfs:label "release date" ;
