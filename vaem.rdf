<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:voag="http://voag.linkedmodel.org/voag#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:vaem="http://www.linkedmodel.org/schema/vaem#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xml:base="http://www.linkedmodel.org/schema/vaem">
  <owl:Ontology rdf:about="">
    <vaem:owner rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >TopQuadrant</vaem:owner>
    <dc:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Vocabulary for Attaching Essential Metadata</dc:title>
    <vaem:usesNonImportedResource>
      <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/contributor">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >contributor</rdfs:label>
      </owl:AnnotationProperty>
    </vaem:usesNonImportedResource>
    <vaem:revision rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >2.0</vaem:revision>
    <vaem:lastUpdated rdf:datatype="#dateUnion">2014-06-28</vaem:lastUpdated>
    <vaem:usesNonImportedResource>
      <vaem:LicenseModel rdf:about="http://voag.linkedmodel.org/voag#CC-SHAREALIKE_3PT0-US">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >Creative Commons Attribution-Share Alike 3.0 United States License</rdfs:label>
      </vaem:LicenseModel>
    </vaem:usesNonImportedResource>
    <vaem:dateCreated rdf:datatype="#dateUnion">2011-04-20</vaem:dateCreated>
    <vaem:usesNonImportedResource>
      <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >description</rdfs:label>
      </owl:AnnotationProperty>
    </vaem:usesNonImportedResource>
    <vaem:usesNonImportedResource>
      <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/subject">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >subject</rdfs:label>
      </owl:AnnotationProperty>
    </vaem:usesNonImportedResource>
    <vaem:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >VAEM stands for "Vocabulary for Attaching Essential Metadata". The purpose of VAEM is to provide, by import, a foundation for commonly needed resources when building an ontology. An effort has been made to restrict these resources to a minimal level.   What VAEM regards as essential metadata is data about dates and times, confidentiality, and other characterisitic qualifiers of the ontology, but also references to where a ontology is documented and where to find ontology governance, Attribution and Provenance.</vaem:description>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Vocabulary for Attaching Essential Metadata</rdfs:label>
    <vaem:owningParty rdf:resource="http://www.topquadrant.com"/>
    <vaem:usesNonImportedResource>
      <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >title</rdfs:label>
      </owl:AnnotationProperty>
    </vaem:usesNonImportedResource>
    <vaem:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >VAEM</vaem:name>
    <vaem:usesNonImportedResource>
      <vaem:Attribution rdf:about="http://voag.linkedmodel.org/voag#TopQuadrantAttribution">
        <vaem:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >LinkedModel Ontologies and Vocabularies are issued under a Creative Commons Attribution Share Alike 3.0 United States License. Attribution should be made to TopQuadrant, Inc.</vaem:description>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >TopQuadrant attribution</rdfs:label>
      </vaem:Attribution>
    </vaem:usesNonImportedResource>
    <owl:versionIRI rdf:resource=""/>
    <vaem:namespacePrefix rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >vaem</vaem:namespacePrefix>
    <vaem:namespace rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI"
    >http://www.linkedmodel.org/schema/vaem#</vaem:namespace>
    <vaem:hasLicenseType rdf:resource="http://voag.linkedmodel.org/voag#CC-SHAREALIKE_3PT0-US"/>
    <vaem:withAttributionTo rdf:resource="http://voag.linkedmodel.org/voag#TopQuadrantAttribution"/>
    <dc:author rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Ralph Hodgson</dc:author>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Metadata</dc:subject>
    <vaem:hasGraphRole>
      <vaem:GraphRole rdf:ID="SchemaGraph">
        <rdfs:isDefinedBy rdf:resource=""/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >Schema graph</rdfs:label>
      </vaem:GraphRole>
    </vaem:hasGraphRole>
    <vaem:usesNonImportedResource>
      <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/author">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
        >author</rdfs:label>
      </owl:AnnotationProperty>
    </vaem:usesNonImportedResource>
  </owl:Ontology>
  <rdfs:Datatype rdf:ID="dateUnion">
    <owl:equivalentClass>
      <rdfs:Datatype>
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#dateTime"/>
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
        </owl:unionOf>
      </rdfs:Datatype>
    </owl:equivalentClass>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >A date union is a datatype that allows a value to be expressed either as an xsd:date, xsd:datetime or xsd:gYear</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >date union</rdfs:label>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:ID="integer1to5">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >integer 1 to 5</rdfs:label>
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    <owl:equivalentClass>
      <rdfs:Datatype>
        <owl:withRestrictions rdf:parseType="Collection">
          <rdf:Description>
            <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#positiveInteger"
            >5</xsd:maxInclusive>
          </rdf:Description>
        </owl:withRestrictions>
        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
      </rdfs:Datatype>
    </owl:equivalentClass>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdfs:Datatype>
  <owl:Class rdf:ID="Attribution">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Attribution</rdfs:label>
    <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >A mininal treatment of attribution. This serves as a placeholder class for voag:Attribution.</dc:description>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:ID="description"/>
        </owl:onProperty>
        <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >1</owl:cardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:Class>
  <owl:Class rdf:ID="Domain">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >A domain is a subject area of interest. Examples of domains are "enterprise", "process", "organization" and "system". In VAEM, "Domain" is used as a dimension for characterizing an ontology graph.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Domain</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="Discipline">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >A Discipline is a specific area of work or study. Examples of disciplines in the engineering domain are electrical engineering, mechanical engineering and, in the financial domain, risk assessment, investment analysis.  In VAEM, "Discipline" is used as a dimension for characterizing an ontology graph.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Discipline</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="CatalogEntry">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Governed object</rdfs:label>
    <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >VAEM Governed Object class is a placeholder for concepts that are fully defined by the voag:GovernedObject concept hierarchy for building a catalog of ontologies and graphs.</dc:description>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#description"/>
        </owl:onProperty>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >1</owl:minCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="LicenseModel">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >License model</rdfs:label>
    <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The VAEM Licence Model class is a placeholder for concepts that are fully defined by VOAG.</dc:description>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:about="#description"/>
        </owl:onProperty>
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >1</owl:minCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty>
          <owl:DatatypeProperty rdf:ID="url"/>
        </owl:onProperty>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >1</owl:maxCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:ID="Viewpoint">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Viewpoint is used to denote how a set of resources, or an individual resource, is relevant to a context of use. The term "viewpoint" is adopted from the ISO RM-ODP specifications and its more recent use in enterprise architecture descriptions.  In VAEM, "Viewpoint" is used as a dimension for characterizing an ontology graph.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Viewpoint</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="GraphRole">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >GraphRole is used to characterize how a graph of resources participates in an ontology set.  For example, a graph can be a schema, vocabulary, dataset, script, or ruleset.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Graph role</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="Aspect">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Aspect is used to distinguish among sets of features of a domain or subject area. The term is borrowed from "aspect-oriented" programming, where it is used to separate concerns. An ontology may be characterized by this dimension so as to parition features that are orthogonal. For example,  in a systems ontology we can distinguish aspects for "structure", "function", "behavior" and "interface".</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Aspect</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:ID="withAttributionTo">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >with attribution to</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:ID="hasIdentifier">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaemhasIdentifier" is intended for general use as a means to specifiy a unique reference to something. This is an object property that is a sub-property of "vame:id".</rdfs:comment>
    <rdfs:subPropertyOf>
      <rdf:Property rdf:ID="id"/>
    </rdfs:subPropertyOf>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >has identifier</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:ID="reifiableBy">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >To express how statements in a model can be reifiable, this property is used to explicitly associate a property with a user-defined sub-class of "rdf:Statement". A recommended way of using this is to declare the properties that share the same reification constructs as sub-properties of a parent property that carries the "vaem:reifiableBy" property. The parent property should be of type "rdf:Property" so that it can have both datatype and object properties as sub-properties. By this means use and transformations of a model can be understood through a fully specified metamodel. "vaem:reifiableBy" is rangeless in order to comply with OWL DL semantics. Its range would have been rdfs:Class in order to refer to "rdf:Statement" sub-classes.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >reifiable by</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:ID="hasGraphRole">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "lms:hasGraphRole" is used to characterize how a resource participates in an ontology set.  The property is used to specify the role that a graph plays, for example, an ontology graph can be a schema, vocabulary, dataset, script, or ruleset.</rdfs:comment>
    <rdfs:range rdf:resource="#GraphRole"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >has graph role</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:ID="usesNonImportedResource">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >A property that is used to express dependencies on resources from graphs that are not imported.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >uses non-imported resource</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:ID="hasLicenseType">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label xml:lang="en-US">has license type</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:ID="hasCatalogEntry">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >has catalog entry</rdfs:label>
  </owl:ObjectProperty>
  <rdf:Property rdf:ID="hasAspectScope">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:hasAspectScope" is used to distinguish among sets of features of a domain or subject area. The term is borrowed from "aspect-oriented" programming, where it is used to separate concerns. An ontology may be characterized by this dimension so as to parition features that are orthogonal. For example,  in a systems ontology we can distinguish aspects for "structure", "function", "behavior" and "interface".  The property is an "rdf:Property" to allow both scalar and object values.</rdfs:comment>
    <rdfs:subPropertyOf>
      <rdf:Property rdf:ID="hasScope"/>
    </rdfs:subPropertyOf>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >has aspect scope</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:about="#hasScope">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:hasScope" is used indicate a scope of relevance of an ontology.  In VAEM, the property is used as a dimension for characterizing an ontology graph.  The property is an "rdf:Property" to allow both scalar and object values.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >has scope</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:ID="hasDisciplineScope">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:hasDisciplineScope" is used to indicate relevance of a set of resources, or a resource itself, to a specific discipline of work or study. Examples of disciplines in the engineering domain are electrical engineering, mechanical engineering and, in the financial domain, risk assessment, investment analysis.  In VAEM, the property is used as a dimension for characterizing an ontology graph.  The property is an "rdf:Property" to allow both scalar and object values.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="#hasScope"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >has discipline scope</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:ID="ownedBy">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:ownedBy" is a general property that in some cases could have scalar values or may refer to some concept of "Party".  For this reason, the  type of this property is set as "rdf:Property" and the property is rangeless. There are two sub-properties of "vaem:ownedBy", namely "vaem:owner" for string values and "vaem:owningParty" for referencing a party.  Ownership applies to those ontologies that are proprietary.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >owned by</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:ID="hasContext">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:hasContext" is used indicate a "situation" in which an ontology has relevance.  InVAEM, the property can used as a dimension for characterizing an ontology graph.  The property is an "rdf:Property" to allow both scalar and object values.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >has context</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:ID="hasViewpointScope">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:hasVewpointScope" is used to denote how a set of resources, or an individual resource, is relevant to a context of use. The term "viewpoint" is adopted from the ISO RM-ODP specifications and its more recent use in enterprise architecture descriptions.  In VAEM, the property is used as a dimension for characterizing an ontology graph.  The property is an "rdf:Property" to allow both scalar and object values.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="#hasScope"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >has viewpoint scope</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:ID="isElaboratedIn">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#isDefinedBy"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >An annotation used to reference a graph that elaborates (adds properties and axioms to) a resource.</rdfs:comment>
    <rdfs:label>isDefinedBy</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Property>
  <rdf:Property rdf:ID="hasDomainScope">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:hasDomainScope" is used to specify how  a set of resources, or an individual resource is grounded in a domain, that is, a subject area of interest. Examples of domains are "enterprise", "process", "organization" and "system". In VAEM, the property is used as a dimension for characterizing an ontology graph. The property is an "rdf:Property" to allow both scalar and object values.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="#hasScope"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >has domain scope</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:ID="owningParty">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:owningParty" is used to refer to some concept of "Party" and is a sub-property of "vaem:ownedBy".</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="#ownedBy"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >owning party</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:about="#id">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:id" is intended for general use as a means to specifiy an identifier. The type of this property is intentionally set to "rdf:Property" so that use of the property can allow both object and scaler values.  For this reason, the property is rangeless.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >id</rdfs:label>
  </rdf:Property>
  <owl:DatatypeProperty rdf:ID="dateCreated">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:dateCreated" is intended for general use as the name implies.  The range of the property is set as "vaem:dateUnion" so as to allow a value to have a number of forms from a  year only to a full timestamp.</rdfs:comment>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:ID="date"/>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="#dateUnion"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >date created</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#url">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >url</rdfs:label>
    <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:url" is intended for general use as the name implies.  The range of the property is set as an XSD URI.</dc:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="acronym">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:acronym" provides a common way to define a commonly used abbreviation on a resource.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >acronym</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="owner">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >owner</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="#ownedBy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="namespace">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:namespace" provides a means to specify the onotlogy URI with which a graph is primarily associated. The intent is to allow multiple graphs to define statements for resources in the same Ontology namespace. For example, a foundation level graph with the base URI of "http://www.somesite.com/1.0/schema/OurOntology"  may define general  concepts for "OurOntology". Another graph with the base URI "http://www.somesite.com/1.0/schema/level2/OurOntology"  may add more specific details to the same "OurOntology". Each of these two graphs would carry the same value for "vaem:namespace", that is, "http://www.somesite.com/schema/OurOntology".    In other words, an ontology URI is the URI associated with the resources of a controlled namespace. On the other hand the graph URIs (the base URIs) identify the graphs that hold resources that make up an ontology.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >namespace</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="idString">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:idString" is intended for general use as a means to specifiy a unique reference to something. This is a data property with a string range and is a sub-property of "vame:id".</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="#id"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >identifier</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="revision">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:revision" is a property intended for general use as the name implies. </rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >revision</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#description">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:description" is intended for general use as the name implies.  Unlike "rdfs:comment",  "vaem:description" is an "owl:DatatypeProperty". As such it can play a stronger role in the model, for example, as a predicate in an axiom.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >description</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="title">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >title</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="lastUpdated">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:lastUpdated" is intended for general use as the name implies.  The range of the property is set as "vaem:dateUnion" so as to allow a value to have a number of forms from a  year only to a full timestamp.</rdfs:comment>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="#date"/>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="#dateUnion"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >last updated</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="abbreviation">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:abbreviation" provides a common way to define a commonly used abbreviation on a resource.</rdfs:comment>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >abbreviation</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="releaseDate">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:releaseDate" is intended for general use as the name implies.  The range of the property is set as "vaem:dateUnion" so as to allow a value to have a number of forms from a  year only to a full timestamp.</rdfs:comment>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="#date"/>
    </rdfs:subPropertyOf>
    <rdfs:range rdf:resource="#dateUnion"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >release date</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="specificity">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:specificity" is intended to specify the level of detail of an ontology.  The values that can be set for this property are restriced to an integer from 1 to 5. An ontology at level 1 has concepts of more general applicability than one at level 5. By having graphs at different levels of specificity it is possible to support greater modularity for selective imports.</rdfs:comment>
    <rdfs:range rdf:resource="#integer1to5"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >specificity</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="name">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:name" is intended for general use. In many cases "rdfs:label" could be used give names to resources. In the case where compliance with a specific naming rule is needed,  "vaem:name" allows  a resource to carry a name that is used in more specific contexts. Making "vaem:name" a sub-property of "rdfs:label" allows "vaem:name" to serve in the same way as an "rdfs:label".</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >name</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="rationale">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >A description of a justification for some other assertion or value.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >rationale</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="namespacePrefix">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:namespacePrefix" specifes a short handle or label for the URI of an Ontology.  Multiple graphs can define statements for resources in the same Ontololgy namespace. For example, a foundation level graph with the base URI of "http://www.somesite.com/1.0/schema/OurOntology"  may define general  concepts for "OurOntology". Another graph with the base URI "http://www.somesite.com/1.0/schema/level2/OurOntology"  may add more specific details to the same "OurOntology". Each of these two graphs would carry the same value for "vaem:namespacePrefix", for this example, perhaps, "ourOntology".</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >namespace prefix</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:ID="intent">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:intent" is used to outline  a statement of purpose. This typically expresses one or more desired outcomes.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >intent</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="#date">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >The property "vaem:date" is intended for general use as the name implies.  The range of the property is set as "vaem:dateUnion" so as to allow a value to have a number of forms from a  year only to a full timestamp. The property is also the parent of all dates so that queries can be made for any date on an ontology.</rdfs:comment>
    <rdfs:range rdf:resource="#dateUnion"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >date</rdfs:label>
  </owl:DatatypeProperty>
  <vaem:GraphRole rdf:ID="BridgeGraph">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Bridge graph</rdfs:label>
  </vaem:GraphRole>
  <vaem:GraphRole rdf:ID="MappingGraph">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Mapping graph</rdfs:label>
    <vaem:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >A graph that specifies a transformation of a graph into another graph or graphs. Invariably this is a SPINMap graph using SPARQL Rules (SPIN) to express the transforms.</vaem:description>
  </vaem:GraphRole>
  <vaem:GraphRole rdf:ID="ViewGraph">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >View graph</rdfs:label>
  </vaem:GraphRole>
  <vaem:GraphRole rdf:ID="ControllersGraph">
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Controllers graph</rdfs:label>
    <rdfs:isDefinedBy rdf:resource=""/>
  </vaem:GraphRole>
  <vaem:GraphRole rdf:ID="TransformsGraph">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Transforms graph</rdfs:label>
  </vaem:GraphRole>
  <vaem:GraphRole rdf:ID="DataGraph">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Data graph</rdfs:label>
  </vaem:GraphRole>
  <vaem:GraphRole rdf:ID="FunctionsGraph">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Functions graph</rdfs:label>
  </vaem:GraphRole>
  <vaem:GraphRole rdf:ID="RulesGraph">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Rules Graph</rdfs:label>
  </vaem:GraphRole>
  <owl:AnnotationProperty rdf:ID="comment">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >An annotation property that can be freely used on any kind of resource. The range of the property is "xsd:string".</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >definition</rdfs:label>
  </owl:AnnotationProperty>
  <vaem:GraphRole rdf:ID="ProxyGraph">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Proxy graph</rdfs:label>
  </vaem:GraphRole>
  <owl:AnnotationProperty rdf:ID="todo">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >As it name implies, a way to attach an annotation about a "todo" task</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >todo</rdfs:label>
  </owl:AnnotationProperty>
  <vaem:GraphRole rdf:ID="CollectionGraph">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Collection graph</rdfs:label>
  </vaem:GraphRole>
  <vaem:GraphRole rdf:ID="ScriptGraph">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Script graph</rdfs:label>
  </vaem:GraphRole>
  <vaem:GraphRole rdf:ID="VocabularyGraph">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Vocabulary graph</rdfs:label>
    <vaem:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >An RDF/OWL Graph that is a controlled set of instances.</vaem:description>
  </vaem:GraphRole>
  <vaem:GraphRole rdf:ID="CurationGraph">
    <rdfs:isDefinedBy rdf:resource=""/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >Curation graph</rdfs:label>
    <dc:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string"
    >A curation graph is one whose purpose is to hold metadata that is needed to describe, govern and provision another graph. A curation graph will likely use VOAG and VAEM for this purpose. The property "vaem:curationGraph" is used to link to the graph (or graphs) being curated.</dc:description>
  </vaem:GraphRole>
  <owl:Restriction rdf:nodeID="A0">
    <owl:onProperty rdf:resource="#hasCatalogEntry"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
    >1</owl:maxCardinality>
  </owl:Restriction>
  <owl:Restriction rdf:nodeID="A1">
    <owl:onProperty rdf:resource="#hasViewpointScope"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
