vaem:SurrogateGraph
  a vaem:GraphRole ;
  dcterms:description "A graph that specifies minimal representation of resources from another graph so as to avoid the need to import it."^^rdf:HTML ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/$$VERSION$$/schema/shacl/vaem> ;
  rdfs:label "Surrogate Graph" ;
