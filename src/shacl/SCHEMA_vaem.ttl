  vaem:filePrefix "SERGRAPH" .

vaem:ShapesGraph
  a vaem:GraphRole ;
  dcterms:description "A graph of SHACL shapes that define constraints."^^rdf:HTML ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/$$VERSION$$/schema/shacl/vaem> ;
  rdfs:label "Shapes Graph" ;
  vaem:filePrefix "SHAGRAPH" .

vaem:StringOrLangString
  a rdf:List ;
  rdf:first [
    sh:datatype xsd:string ;
  ] ;
  rdf:rest ( [
    sh:datatype rdf:langString ;
  ] ) ;
  rdfs:comment """
An <em>rdf:List</em> that can be used in property constraints as value for <em>sh:or</em> to indicate
that all values of a property must be either <em>xsd:string</em>, or <em>rdf:langString</em>
(in that order of preference).
"""^^rdf:HTML ;
  rdfs:isDefinedBy <http://www.linkedmodel.org/$$VERSION$$/schema/shacl/vaem> ;
  rdfs:label "string or langString" .

