# baseURI: http://vaem.linkedmodel.org/test_unbound_graph
# imports: http://spinrdf.org/spin
# imports: http://spinrdf.org/spin.ui

@prefix arg: <http://spinrdf.org/arg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sp: <http://spinrdf.org/sp#> .
@prefix spin: <http://spinrdf.org/spin#> .
@prefix spl: <http://spinrdf.org/spl#> .
@prefix test: <http://vaem.linkedmodel.org/test_unbound_graph#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://vaem.linkedmodel.org/test_unbound_graph>
  rdf:type owl:Ontology ;
  owl:imports <http://spinrdf.org/spin> ;
  owl:imports <http://spinrdf.org/spin.ui> ;
  owl:versionInfo "Created with TopBraid Composer"^^xsd:string ;
.
test:IsDefinedInGraph
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Ask ;
      sp:where (
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                  sp:predicate rdfs:isDefinedBy ;
                  sp:subject [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "Is defined in graph"^^xsd:string ;
  rdfs:subClassOf spin:Functions ;
.
