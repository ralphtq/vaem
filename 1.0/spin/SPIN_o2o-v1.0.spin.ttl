            sp:variable [
                sp:varName "i2"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:substring ;
                sp:arg1 spin:_arg2 ;
                sp:arg2 0 ;
                sp:arg3 [
                    rdf:type sp:add ;
                    sp:arg1 [
                        rdf:type sp:add ;
                        sp:arg1 [
                            sp:varName "i1"^^xsd:string ;
                          ] ;
                        sp:arg2 [
                            sp:varName "i2"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:arg2 1 ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "p2_1"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:if ;
                sp:arg1 [
                    rdf:type sp:eq ;
                    sp:arg1 spin:_arg1 ;
                    sp:arg2 "" ;
                  ] ;
                sp:arg2 [
                    sp:varName "p2_1"^^xsd:string ;
