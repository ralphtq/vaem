o2o:DeleteAnons
  rdf:type o2o:Query ;
  spin:update [
      rdf:type sp:Modify ;
      sp:deletePattern (
          [
            sp:object _:b530587 ;
            sp:predicate _:b841569 ;
            sp:subject _:b834846 ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "anon"^^xsd:string ;
              ] ;
            sp:predicate rdfs:subClassOf ;
            sp:subject _:b834846 ;
          ]
          [
            rdf:type sp:NotExists ;
            sp:elements (
                [
                  sp:object _:b834846 ;
                  sp:predicate [
                      sp:varName "p1"^^xsd:string ;
                    ] ;
                  sp:subject [
                      sp:varName "s"^^xsd:string ;
                    ] ;
                ]
              ) ;
          ]
          [
            sp:object _:b530587 ;
            sp:predicate _:b841569 ;
            sp:subject _:b834846 ;
          ]
        ) ;
    ] ;
  spin:update [
      rdf:type sp:Modify ;
      sp:deletePattern (
          [
            sp:object _:b676997 ;
            sp:predicate _:b675477 ;
            sp:subject _:b196853 ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "anon"^^xsd:string ;
              ] ;
            sp:predicate rdfs:subClassOf ;
            sp:subject _:b977574 ;
          ]
          [
            rdf:type sp:NotExists ;
            sp:elements (
                [
                  sp:object _:b977574 ;
                  sp:predicate [
                      sp:varName "p1"^^xsd:string ;
                    ] ;
                  sp:subject [
                      sp:varName "s"^^xsd:string ;
                    ] ;
                ]
              ) ;
          ]
          [
            sp:object _:b196853 ;
            sp:predicate rdfs:subClassOf ;
            sp:subject _:b977574 ;
          ]
          [
            sp:object owl:Restriction ;
            sp:predicate rdf:type ;
            sp:subject _:b196853 ;
          ]
          [
            sp:object _:b676997 ;
            sp:predicate _:b675477 ;
            sp:subject _:b196853 ;
          ]
        ) ;
    ] ;
  rdfs:label "Delete Anons"^^xsd:string ;
.
