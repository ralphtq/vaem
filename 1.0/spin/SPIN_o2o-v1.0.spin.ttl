            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:regex ;
                sp:arg1 [
                    sp:varName "t0b"^^xsd:string ;
                  ] ;
                sp:arg2 "%[0-9A-F][0-9A-F]" ;
                sp:arg3 "" ;
              ] ;
            sp:variable [
                sp:varName "t1"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:regex ;
                sp:arg1 [
                    sp:varName "t1"^^xsd:string ;
