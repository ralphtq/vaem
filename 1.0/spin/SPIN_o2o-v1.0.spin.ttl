o2o:relevantPropertiesAtClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "class"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "superClass"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:domain ;
                    sp:subject [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:NotExists ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "value"^^xsd:string ;
                            ] ;
                          sp:predicate owl:hasValue ;
                          sp:subject [
                              sp:varName "superClass"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                  ]
                )
              ) ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:isIRI ;
                sp:arg1 [
                    sp:varName "class"^^xsd:string ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "a property on the left"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  spin:returnType rdfs:Class ;
  rdfs:comment """Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels. 

A magic property that establishes a relationship between properties (left) and classes (right) to determine which properties are \"relevant\" for the class. Relevant means that they have the class in their domain and/or restrictions, including superclasses and sub-properties.

Note that the performance of the body of this magic property has been optimized for the case in which the class is given, so ideally use this for queries such as  ?property o2o:relevantPropertyAtClass skos:Concept ."""^^xsd:string ;
  rdfs:label "Relevant properties at class"^^xsd:string ;
  rdfs:subClassOf o2o:ClassMagicProperties ;
.
o2o:relevantPropertiesAtClassWithParent
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "class"^^xsd:string ;
          ]
          [
            sp:varName "parent"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "superClass"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:domain ;
                    sp:subject [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:variable [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:NotExists ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "value"^^xsd:string ;
                            ] ;
                          sp:predicate owl:hasValue ;
                          sp:subject [
                              sp:varName "superClass"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:isIRI ;
                sp:arg1 [
                    sp:varName "class"^^xsd:string ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "a property on the left"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  spin:returnType rdfs:Class ;
  rdfs:comment """Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels. 

A magic property that establishes a relationship between properties (left) and classes (right) to determine which properties are \"relevant\" for the class. Relevant means that they have the class in their domain and/or restrictions, including superclasses and sub-properties.

Note that the performance of the body of this magic property has been optimized for the case in which the class is given, so ideally use this for queries such as  ?property o2o:relevantPropertyAtClass skos:Concept ."""^^xsd:string ;
  rdfs:label "Relevant properties at class with parent"^^xsd:string ;
  rdfs:subClassOf o2o:ClassMagicProperties ;
.
o2o:relevantPropertyDetailsAtClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "parent"^^xsd:string ;
          ]
          [
            sp:varName "range"^^xsd:string ;
          ]
          [
            sp:varName "valueRestriction"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "?0"^^xsd:string ;
              ] ;
            sp:predicate o2o:relevantPropertiesAtClass ;
            sp:subject spin:_arg1 ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "parent"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object spin:_arg1 ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?3"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?4"^^xsd:string ;
              ] ;
            sp:predicate o2o:rangeOfPropertyAtClass ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "range"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?4"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?5"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?4"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "valueRestriction"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?5"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?5"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  rdfs:comment "Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels."^^xsd:string ;
  rdfs:label "Relevant property details at class"^^xsd:string ;
  rdfs:subClassOf o2o:ClassMagicProperties ;
.
o2o:relevantPropertyDetailsAtClassWithCardinalities
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            rdf:type fn:lower-case ;
            sp:arg1 [
                rdf:type ui:label ;
                sp:arg1 [
                    sp:varName "property"^^xsd:string ;
                  ] ;
              ] ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "parent"^^xsd:string ;
          ]
          [
            sp:varName "range"^^xsd:string ;
          ]
          [
            sp:varName "valueRestriction"^^xsd:string ;
          ]
          [
            sp:varName "min"^^xsd:string ;
          ]
          [
            sp:varName "max"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "?0"^^xsd:string ;
              ] ;
            sp:predicate o2o:relevantPropertyDetailsAtClass ;
            sp:subject spin:_arg1 ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "parent"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?2"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "range"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?3"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "valueRestriction"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:minCardinality ;
                sp:arg1 spin:_arg1 ;
                sp:arg2 [
                    sp:varName "property"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "min"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:maxCardinality ;
                sp:arg1 spin:_arg1 ;
                sp:arg2 [
                    sp:varName "property"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "max"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  rdfs:comment "Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels."^^xsd:string ;
  rdfs:label "Relevant property details at class with cardinalities"^^xsd:string ;
  rdfs:subClassOf o2o:ClassMagicProperties ;
.
o2o:secondPhraseOfTwo
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          _:b792906
        ) ;
      sp:where (
          [
            rdf:type sp:Let ;
            sp:expression [
                rdf:type smf:regex ;
                sp:arg1 spin:_arg1 ;
                sp:arg2 "([A-z-]+) ([A-z-]+)" ;
                sp:arg3 "$2" ;
              ] ;
            sp:variable _:b792906 ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "qname"^^xsd:string ;
    ] ;
  rdfs:label "second phrase of two"^^xsd:string ;
  rdfs:subClassOf o2o:Functions ;
.
o2o:sourceString
  rdf:type rdf:Property ;
  rdfs:label "source string"^^xsd:string ;
  rdfs:subPropertyOf sp:arg ;
.
o2o:tailPart
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          _:b311742
        ) ;
      sp:where (
          [
            rdf:type sp:Let ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 "([A-z0-9._]+)" ;
                sp:arg2 spin:_arg2 ;
                sp:arg3 "(.*)" ;
              ] ;
            sp:variable _:b86265 ;
          ]
          [
            rdf:type sp:Let ;
            sp:expression [
                rdf:type smf:regex ;
                sp:arg1 spin:_arg1 ;
                sp:arg2 _:b86265 ;
                sp:arg3 "$1" ;
              ] ;
            sp:variable [
                sp:varName "part"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Let ;
            sp:expression [
                rdf:type smf:regex ;
                sp:arg1 spin:_arg1 ;
                sp:arg2 _:b86265 ;
                sp:arg3 "$2" ;
              ] ;
            sp:variable _:b194862 ;
          ]
          [
            rdf:type sp:Let ;
            sp:expression [
                rdf:type smf:if ;
                sp:arg1 [
                    rdf:type fn:contains ;
                    sp:arg1 _:b194862 ;
                    sp:arg2 spin:_arg2 ;
                  ] ;
                sp:arg2 [
                    rdf:type o2o:tailPart ;
                    sp:arg1 _:b194862 ;
                    sp:arg2 spin:_arg2 ;
                  ] ;
                sp:arg3 _:b194862 ;
              ] ;
            sp:variable _:b311742 ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "The namespace, including separator, '#' or '/'"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType xsd:string ;
      rdfs:comment "The name to be converted"^^xsd:string ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:comment """Returns the tail part of a string (arg1) using the separator given in arg2.

For example:

LET (?x := o2o:tailPart(\"Core-Abstractions-MultiplicityExpressions-MultiplicityElement-upper.1-spec\", \"-\"))

returns 'spec'"""^^xsd:string ;
  rdfs:label "tail part"^^xsd:string ;
  rdfs:subClassOf o2o:Functions ;
.
o2o:trimString
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          _:b387129
        ) ;
      sp:where (
          [
            rdf:type sp:Let ;
            sp:expression [
                rdf:type smf:regex ;
                sp:arg1 spin:_arg1 ;
                sp:arg2 "^\\s+([A-Za-z0-9].*)\\s*$" ;
                sp:arg3 "$1" ;
              ] ;
            sp:variable _:b387129 ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "Raw name"^^xsd:string ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:label "normalize string"^^xsd:string ;
  rdfs:subClassOf o2o:Functions ;
.
o2o:tripleToAdd
  rdf:type owl:ObjectProperty ;
  rdfs:label "triple to add"^^xsd:string ;
