o2o:getRandomDate
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "randomDate"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression spin:_arg1 ;
            sp:variable [
                sp:varName "year"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:random ;
              ] ;
            sp:variable [
                sp:varName "day0"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:round ;
                sp:arg1 [
                    rdf:type sp:mul ;
                    sp:arg1 [
                        sp:varName "day0"^^xsd:string ;
                      ] ;
                    sp:arg2 28 ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "day1"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:cast ;
                arg:datatype xsd:integer ;
                sp:arg1 [
                    sp:varName "day1"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "randomDay1"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:if ;
                sp:arg1 [
                    rdf:type sp:lt ;
                    sp:arg1 [
                        sp:varName "randomDay1"^^xsd:string ;
                      ] ;
                    sp:arg2 10 ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:if ;
                    sp:arg1 [
                        rdf:type sp:gt ;
                        sp:arg1 [
                            sp:varName "randomDay1"^^xsd:string ;
                          ] ;
                        sp:arg2 0 ;
                      ] ;
                    sp:arg2 [
                        rdf:type fn:concat ;
                        sp:arg1 "0" ;
                        sp:arg2 [
                            sp:varName "randomDay1"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:arg3 "01" ;
                  ] ;
                sp:arg3 [
                    sp:varName "randomDay1"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "randomDay"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:random ;
              ] ;
            sp:variable [
                sp:varName "month0"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:round ;
                sp:arg1 [
                    rdf:type sp:mul ;
                    sp:arg1 [
                        sp:varName "month0"^^xsd:string ;
                      ] ;
                    sp:arg2 12 ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "month1"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:cast ;
