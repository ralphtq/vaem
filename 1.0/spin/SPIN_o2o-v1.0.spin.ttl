                    sp:arg2 spin:_arg5 ;
                    sp:arg3 [
                        rdf:type o2o:constructIncrementallyPairedList ;
                        sp:arg1 [
                            sp:varName "p1"^^xsd:string ;
                          ] ;
                        sp:arg2 [
                            sp:varName "rest"^^xsd:string ;
                          ] ;
