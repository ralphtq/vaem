                            sp:arg1 [
                                sp:varName "ns"^^xsd:string ;
                              ] ;
                            sp:arg2 "http://www.w3.org/2002/07/owl#" ;
                          ] ;
                        sp:arg2 [
                            rdf:type sp:eq ;
                            sp:arg1 [
                                sp:varName "ns"^^xsd:string ;
                              ] ;
                            sp:arg2 "http://www.w3.org/2000/01/rdf-schema#" ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        rdf:type sp:eq ;
                        sp:arg1 [
                            sp:varName "ns"^^xsd:string ;
                          ] ;
                        sp:arg2 "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ;
