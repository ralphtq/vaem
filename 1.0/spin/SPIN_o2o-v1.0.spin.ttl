                        sp:arg2 [
                            rdf:type smf:resource ;
                            sp:arg1 [
                                rdf:type fn:concat ;
                                sp:arg1 spin:_arg3 ;
                                sp:arg2 [
                                    rdf:type afn:localname ;
                                    sp:arg1 spin:_arg1 ;
                                  ] ;
                              ] ;
                          ] ;
                        sp:arg3 spin:_arg1 ;
                      ] ;
                    sp:arg3 <http://blank-nodes#cannot-be-copied> ;
                  ] ;
              ] ;
            sp:variable _:b157604 ;
