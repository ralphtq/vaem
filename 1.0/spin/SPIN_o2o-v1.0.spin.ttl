o2o:TestClass_A
  rdf:type owl:Class ;
  rdfs:label "KSC LCS Test class A"^^xsd:string ;
  rdfs:subClassOf o2o:TestClass ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:hasValue "TEST A"^^xsd:string ;
      owl:onProperty <http://www.linkedmodel.org/schema/vaem#name> ;
    ] ;
.
o2o:TestClass_AB
  rdf:type owl:Class ;
  dc:description "A test class for the relevant class documentation generation,"^^xsd:string ;
  spin:query [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "class"^^xsd:string ;
          ]
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "parent"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression o2o:TestClass_AB ;
            sp:variable [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate o2o:relevantPropertiesAtClass ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "class"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?2"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "parent"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:query [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "class"^^xsd:string ;
          ]
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "range"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression o2o:TestClass_AB ;
            sp:variable [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression <http://www.linkedmodel.org/schema/dtype#derivedFrom> ;
            sp:variable [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "class"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?2"^^xsd:string ;
              ] ;
            sp:predicate o2o:rangeOfPropertyAtClass ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "range"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:query [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "class"^^xsd:string ;
          ]
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "range"^^xsd:string ;
          ]
          [
            sp:varName "super"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression o2o:TestClass_AB ;
            sp:variable [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate o2o:relevantPropertiesAtClass ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "class"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?2"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "parent"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "class"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?4"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?4"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?4"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?5"^^xsd:string ;
              ] ;
            sp:predicate o2o:valueRestrictionsForPropertyAtClass ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "range"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?5"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?6"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?5"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "super"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?6"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?6"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:query [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "parent"^^xsd:string ;
          ]
          [
            sp:varName "class"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression o2o:TestClass_AB ;
            sp:variable [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression <http://www.linkedmodel.org/schema/dtype#derivedFrom> ;
            sp:variable [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "class"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?2"^^xsd:string ;
              ] ;
            sp:predicate o2o:parentsOfPropertiesAtClass ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "parent"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:label "KSC LCS Test class AB"^^xsd:string ;
  rdfs:subClassOf o2o:TestClass_A ;
  rdfs:subClassOf o2o:TestClass_B ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:hasValue <http://www.linkedmodel.org/schema/vaem#DataGraph> ;
      owl:onProperty <http://www.linkedmodel.org/schema/dtype#derivedFrom> ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:hasValue <http://www.linkedmodel.org/schema/vaem#RulesGraph> ;
      owl:onProperty <http://www.linkedmodel.org/schema/dtype#derivedFrom> ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty <http://www.linkedmodel.org/schema/vaem#title> ;
    ] ;
.
o2o:TestClass_B
  rdf:type owl:Class ;
  rdfs:label "KSC LCS Test class B"^^xsd:string ;
  rdfs:subClassOf o2o:TestClass ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty <http://www.linkedmodel.org/schema/vaem#title> ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty <http://www.linkedmodel.org/schema/vaem#revision> ;
    ] ;
.
o2o:TripleReplacement
  rdf:type owl:Class ;
  rdfs:label "Triple replacement"^^xsd:string ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom rdf:Statement ;
      owl:onProperty o2o:tripleToAdd ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom rdf:Statement ;
      owl:onProperty o2o:tripleToDelete ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty o2o:graphURI ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty o2o:tripleToAdd ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty o2o:tripleToDelete ;
    ] ;
.
o2o:abbreviateCamelCaseName
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "initials"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:replaceAll ;
                sp:arg1 spin:_arg1 ;
                sp:arg2 "[a-z]" ;
                sp:arg3 "" ;
              ] ;
            sp:variable [
                sp:varName "in1"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:replaceAll ;
                sp:arg1 [
                    sp:varName "in1"^^xsd:string ;
                  ] ;
                sp:arg2 " " ;
                sp:arg3 "-" ;
              ] ;
            sp:variable [
                sp:varName "in2"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:replaceAll ;
                sp:arg1 [
                    sp:varName "in2"^^xsd:string ;
                  ] ;
                sp:arg2 "--" ;
                sp:arg3 "-" ;
              ] ;
            sp:variable [
                sp:varName "in3"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:replaceAll ;
                sp:arg1 [
                    sp:varName "in3"^^xsd:string ;
                  ] ;
                sp:arg2 "_" ;
                sp:arg3 "-" ;
              ] ;
            sp:variable [
                sp:varName "initials"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "Input string"^^xsd:string ;
    ] ;
  rdfs:label "avvreviate camelcase name"^^xsd:string ;
  rdfs:subClassOf o2o:Functions ;
.
o2o:allValuesOfPropertyOccurrence
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          _:b931822
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object _:b250361 ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg2 ;
          ]
          [
            sp:object spin:_arg1 ;
            sp:predicate owl:onProperty ;
            sp:subject _:b992177 ;
          ]
          [
            sp:object owl:Restriction ;
            sp:predicate rdf:type ;
            sp:subject _:b992177 ;
          ]
          [
            sp:object _:b992177 ;
            sp:predicate rdfs:subClassOf ;
            sp:subject _:b250361 ;
          ]
          [
            sp:object _:b931822 ;
            sp:predicate owl:allValuesFrom ;
            sp:subject _:b992177 ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdf:Property ;
      rdfs:comment "the relevant property of a class"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "the class of the relevanr property"^^xsd:string ;
    ] ;
  rdfs:comment "Given a relevant property and a class determine the range set for the occurrence on the class"^^xsd:string ;
  rdfs:label "all values of property occurrence"^^xsd:string ;
  rdfs:subClassOf o2o:ClassMagicProperties ;
.
o2o:canBecomeURI
  rdf:type spin:Function ;
  spin:body [
