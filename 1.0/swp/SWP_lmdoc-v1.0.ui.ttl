              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/jquery/js/jquery.hotkeys.js"^^xsd:string ;
            ] ;
          html:type "text/javascript"^^xsd:string ;
          ui:childIndex 12 ;
        ] ;
      ui:child [
          rdf:type html:Script ;
          html:src [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/jquery/js/jquery.jqGrid.min.js"^^xsd:string ;
            ] ;
          html:type "text/javascript"^^xsd:string ;
          ui:childIndex 9 ;
