lmdoc:PropertyDetailsTable
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:parent ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdf:Property ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Td ;
          html:class "docPropertiesTD"^^xsd:string ;
          ui:child [
              rdf:type ui:group ;
              letrs:myParents [
                  rdf:type sp:Select ;
                  sp:resultVariables (
                      [
                        sp:varName "parent"^^xsd:string ;
                      ]
                    ) ;
                  sp:where (
                      [
                        sp:object [
                            sp:varName "class"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "property"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?2"^^xsd:string ;
                          ] ;
                        sp:predicate lmlib:parentsOfPropertiesAtClass ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "parent"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?2"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?2"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "lm_inner_table"^^xsd:string ;
                  ui:child [
                      rdf:type ui:forEach ;
                      ui:child [
                          rdf:type html:Tr ;
                          html:class "lm_inner_row"^^xsd:string ;
                          ui:child [
                              rdf:type html:Td ;
                              html:class "lm_inner_column"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:else ;
                                  ui:child [
                                      rdf:type html:I ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "self"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type html:B ;
                                      ui:child [
                                          rdf:type swa:Link ;
                                          arg:resource [
                                              sp:varName "parent"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 1 ;
                                      ui:text "["^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 2 ;
                                      ui:text [
                                          rdf:type ui:encodeNode ;
                                          sp:arg1 [
                                              sp:varName "parent"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 3 ;
                                      ui:text "]"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:condition [
                                      rdf:type sp:ne ;
                                      sp:arg1 [
                                          sp:varName "parent"^^xsd:string ;
                                        ] ;
                                      sp:arg2 [
                                          sp:varName "class"^^xsd:string ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type html:Td ;
                              html:class "lm_inner_column"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:group ;
                                  let:range [
                                      rdf:type sp:Select ;
                                      sp:resultVariables (
                                          [
                                            sp:varName "range"^^xsd:string ;
                                          ]
                                        ) ;
                                      sp:where (
                                          [
                                            sp:object [
                                                sp:varName "parent"^^xsd:string ;
                                              ] ;
                                            sp:predicate rdf:first ;
                                            sp:subject [
                                                sp:varName "?0"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object [
                                                sp:varName "?1"^^xsd:string ;
                                              ] ;
                                            sp:predicate rdf:rest ;
                                            sp:subject [
                                                sp:varName "?0"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object [
                                                sp:varName "property"^^xsd:string ;
                                              ] ;
                                            sp:predicate rdf:first ;
                                            sp:subject [
                                                sp:varName "?1"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object () ;
                                            sp:predicate rdf:rest ;
                                            sp:subject [
                                                sp:varName "?1"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object [
                                                sp:varName "?2"^^xsd:string ;
                                              ] ;
                                            sp:predicate lmlib:rangeOfPropertyAtClass ;
                                            sp:subject [
                                                sp:varName "?0"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object [
                                                sp:varName "range"^^xsd:string ;
                                              ] ;
                                            sp:predicate rdf:first ;
                                            sp:subject [
                                                sp:varName "?2"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object () ;
                                            sp:predicate rdf:rest ;
                                            sp:subject [
                                                sp:varName "?2"^^xsd:string ;
                                              ] ;
                                          ]
                                        ) ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:else ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              rdf:type ui:label ;
                                              sp:arg1 [
                                                  sp:varName "range"^^xsd:string ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:if ;
                                      ui:child [
                                          rdf:type swa:Link ;
                                          arg:resource [
                                              sp:varName "range"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 1 ;
                                          ui:text "["^^xsd:string ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 2 ;
                                          ui:text [
                                              rdf:type ui:encodeNode ;
                                              sp:arg1 [
                                                  sp:varName "range"^^xsd:string ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 3 ;
                                          ui:text "]"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                      ui:condition [
                                          rdf:type sp:isIRI ;
                                          sp:arg1 [
                                              sp:varName "range"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type ui:group ;
                          letrs:myRestrictions [
                              rdf:type sp:Select ;
                              sp:resultVariables (
                                  [
                                    sp:varName "range"^^xsd:string ;
                                  ]
                                ) ;
                              sp:where (
                                  [
                                    sp:object [
                                        sp:varName "parent"^^xsd:string ;
                                      ] ;
                                    sp:predicate rdf:first ;
                                    sp:subject [
                                        sp:varName "?0"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "?1"^^xsd:string ;
                                      ] ;
                                    sp:predicate rdf:rest ;
                                    sp:subject [
                                        sp:varName "?0"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "property"^^xsd:string ;
                                      ] ;
                                    sp:predicate rdf:first ;
                                    sp:subject [
                                        sp:varName "?1"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object () ;
                                    sp:predicate rdf:rest ;
                                    sp:subject [
                                        sp:varName "?1"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "?2"^^xsd:string ;
                                      ] ;
                                    sp:predicate lmlib:valueRestrictionsForPropertyAtClass ;
                                    sp:subject [
                                        sp:varName "?0"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "range"^^xsd:string ;
                                      ] ;
                                    sp:predicate rdf:first ;
                                    sp:subject [
                                        sp:varName "?2"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "?3"^^xsd:string ;
                                      ] ;
                                    sp:predicate rdf:rest ;
                                    sp:subject [
                                        sp:varName "?2"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "parent"^^xsd:string ;
                                      ] ;
                                    sp:predicate rdf:first ;
                                    sp:subject [
                                        sp:varName "?3"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object () ;
                                    sp:predicate rdf:rest ;
                                    sp:subject [
                                        sp:varName "?3"^^xsd:string ;
                                      ] ;
                                  ]
                                ) ;
                            ] ;
                          ui:child [
                              rdf:type ui:if ;
                              ui:child [
                                  rdf:type ui:forEach ;
                                  ui:child [
                                      rdf:type html:Tr ;
                                      html:class "lm_inner_row"^^xsd:string ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "lm_inner_column"^^xsd:string ;
                                          ui:child [
                                              rdf:type html:B ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text " only "^^xsd:string ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:child [
                                              rdf:type ui:else ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text [
                                                      rdf:type ui:label ;
                                                      sp:arg1 [
                                                          sp:varName "range"^^xsd:string ;
                                                        ] ;
                                                    ] ;
                                                ] ;
                                              ui:childIndex 2 ;
                                            ] ;
                                          ui:child [
                                              rdf:type ui:if ;
                                              ui:child [
                                                  rdf:type swa:Link ;
                                                  arg:resource [
                                                      sp:varName "range"^^xsd:string ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 1 ;
                                                  ui:text "["^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 2 ;
                                                  ui:text [
                                                      rdf:type ui:encodeNode ;
                                                      sp:arg1 [
                                                          sp:varName "range"^^xsd:string ;
                                                        ] ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 3 ;
                                                  ui:text "]"^^xsd:string ;
                                                ] ;
                                              ui:childIndex 1 ;
                                              ui:condition [
                                                  rdf:type sp:isIRI ;
                                                  sp:arg1 [
                                                      sp:varName "range"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "lm_inner_column"^^xsd:string ;
                                          ui:child [
                                              rdf:type ui:else ;
                                              ui:child [
                                                  rdf:type html:I ;
                                                  ui:child [
                                                      rdf:type ui:TextNode ;
                                                      ui:childIndex 0 ;
                                                      ui:text "self"^^xsd:string ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:childIndex 1 ;
                                            ] ;
                                          ui:child [
                                              rdf:type ui:if ;
                                              ui:child [
                                                  rdf:type html:B ;
                                                  ui:child [
                                                      rdf:type swa:Link ;
                                                      arg:resource [
                                                          sp:varName "parent"^^xsd:string ;
                                                        ] ;
                                                      ui:childIndex 0 ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 1 ;
                                                  ui:text "["^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 2 ;
                                                  ui:text [
                                                      rdf:type ui:encodeNode ;
                                                      sp:arg1 [
                                                          sp:varName "parent"^^xsd:string ;
                                                        ] ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 3 ;
                                                  ui:text "]"^^xsd:string ;
                                                ] ;
                                              ui:childIndex 0 ;
                                              ui:condition [
                                                  rdf:type sp:ne ;
                                                  sp:arg1 [
                                                      sp:varName "parent"^^xsd:string ;
                                                    ] ;
                                                  sp:arg2 [
                                                      sp:varName "class"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 1 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:resultSet [
                                      sp:varName "myRestrictions"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:condition [
                                  rdf:type sp:gt ;
                                  sp:arg1 [
                                      rdf:type spr:rowCount ;
                                      sp:arg1 [
                                          sp:varName "myRestrictions"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  sp:arg2 0 ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:resultSet [
                          sp:varName "myParents"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Property details table"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ResourceDocAnchor
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:typeLabel ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Span ;
      ui:child [
          rdf:type html:A ;
          html:id [
              rdf:type lmdoc:makeAnchorFromResource ;
              arg:resource [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type html:Strong ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "typeLabel"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 1 ;
              ui:text [
                  rdf:type smf:qname ;
                  sp:arg1 [
                      sp:varName "node"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "An anchor in the documentaiton entry for a resource."^^xsd:string ;
  rdfs:label "Resource Doc Ancor"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ResourceDocLink
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:title ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Span ;
      ui:child [
          rdf:type html:A ;
          html:href [
              rdf:type fn:concat ;
              sp:arg1 "#" ;
              sp:arg2 [
                  rdf:type lmdoc:makeAnchorFromResource ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          html:title [
              sp:varName "title"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  rdf:type smf:qname ;
                  sp:arg1 [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A hyperlink to the documentaiton entry for a resource."^^xsd:string ;
  rdfs:label "Resource Doc Link"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ResourceFooter
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type html:Div ;
      html:style "padding:4px;   border: 1px dashed #2f6fab;   color: black;   background-color: #f9f9f9;   line-height: 0.9em;"^^xsd:string ;
      ui:child [
          rdf:type html:Div ;
          html:style "clear:both;"^^xsd:string ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:style "float:left; position:relative; margin:10px; 4px; 1px; 4px; "^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text """View as: 
        """^^xsd:string ;
            ] ;
          ui:child [
              rdf:type lmdoc:ViewAsCSV ;
              arg:resource [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type lmdoc:ViewAsJSON ;
              arg:resource [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              ui:childIndex 4 ;
            ] ;
          ui:child [
              rdf:type lmdoc:ViewAsJSON-LD ;
              arg:resource [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              ui:childIndex 5 ;
            ] ;
          ui:child [
              rdf:type lmdoc:ViewAsRDFXML ;
              arg:resource [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type lmdoc:ViewAsTurtle ;
              arg:resource [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              rdf:type lmdoc:ViewAsXML ;
              arg:resource [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              ui:childIndex 6 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:style "float:left; position:relative; width:60px;"^^xsd:string ;
          ui:child [
              rdf:type html:A ;
              html:href "#lmdoc_top"^^xsd:string ;
              ui:child [
                  rdf:type html:Img ;
                  html:src "http://linkedmodel.org/lib/lm/images/icons/doc-back-arrow.png"^^xsd:string ;
                  html:width "24px;"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Resource footer"^^xsd:string ;
  rdfs:label "Resource Footer"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ResourceLink
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:title ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Span ;
      ui:child [
          rdf:type html:A ;
          html:href [
              rdf:type xsd:string ;
              sp:arg1 [
                  sp:varName "resource"^^xsd:string ;
                ] ;
            ] ;
          html:title [
              sp:varName "title"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  rdf:type smf:qname ;
                  sp:arg1 [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A hyperlink to a resource, using the QName of the resource as text. "^^xsd:string ;
  rdfs:label "Resource Link"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:Sections
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:sectionHeading ;
      spl:valueType xsd:string ;
    ] ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:SelectTemplates
  rdf:type spin:SelectTemplate ;
  rdfs:subClassOf spin:SelectTemplates ;
.
lmdoc:SubElements
  rdf:type ui:NodeClass ;
  rdfs:subClassOf lmdoc:Elements ;
