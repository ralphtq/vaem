rdfs:Class
  ui:instanceView [
      rdf:type ui:group ;
      ui:child [
          rdf:type lmdoc:DetailedClassView ;
          arg:class spin:_this ;
          arg:showConstructors "false"^^xsd:boolean ;
          arg:showInstances "false"^^xsd:boolean ;
          arg:showRules "false"^^xsd:boolean ;
          ui:childIndex 0 ;
        ] ;
      ui:id "lmdoc"^^xsd:string ;
      ui:priority -20 ;
    ] ;
.
rdfs:Resource
  ui:instanceView [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:group ;
          let:title [
              rdf:type sp:coalesce ;
              sp:arg1 [
                  rdf:type spl:object ;
                  sp:arg1 spin:_this ;
                  sp:arg2 voag:title ;
                ] ;
              sp:arg2 [
                  rdf:type spl:object ;
                  sp:arg1 spin:_this ;
                  sp:arg2 dct:title ;
                ] ;
              sp:arg3 "" ;
            ] ;
          ui:child [
              rdf:type ui:group ;
              let:summary [
                  rdf:type spl:object ;
                  sp:arg1 spin:_this ;
                  sp:arg2 vaem:description ;
                ] ;
              ui:child [
                  rdf:type html:Dt ;
                  ui:child [
                      rdf:type html:Dd ;
                      html:class "size-10"^^xsd:string ;
                      ui:child [
                          rdf:type ui:parse ;
                          ui:childIndex 0 ;
                          ui:str [
                              sp:varName "summary"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "title"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:id "lmdoc-summary"^^xsd:string ;
      ui:priority -1 ;
    ] ;
.
