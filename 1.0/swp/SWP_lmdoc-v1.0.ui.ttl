# baseURI: http://www.linkedmodel.org/1.1/swp/lmdoc
# imports: http://spinrdf.org/spin.ui
# imports: http://topbraid.org/swa
# imports: http://uispin.org/ui
# imports: http://uispin.org/ui.ui
# imports: http://vaem.linkedmodel.org/1.0/spin/lib
# imports: http://www.linkedmodel.org/2.0/schema/vaem
# imports: http://www.w3.org/2004/02/skos/core

@prefix afn: <http://jena.hpl.hp.com/ARQ/function#> .
@prefix arg: <http://spinrdf.org/arg#> .
@prefix catalog: <http://www.linkedmodel.org/schema/catalog#> .
@prefix css: <http://uispin.org/css#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix fn: <http://www.w3.org/2005/xpath-functions#> .
@prefix html: <http://uispin.org/html#> .
@prefix let: <http://uispin.org/let#> .
@prefix letrs: <http://uispin.org/letrs#> .
@prefix lmdoc: <http://www.linkedmodel.org/oui/lmdoc#> .
@prefix lmlib: <http://vaem.linkedmodel.org/spin/lib/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix smf: <http://topbraid.org/sparqlmotionfunctions#> .
@prefix sp: <http://spinrdf.org/sp#> .
@prefix spif: <http://spinrdf.org/spif#> .
@prefix spin: <http://spinrdf.org/spin#> .
@prefix spin.ui: <http://spinrdf.org/spin.ui#> .
@prefix spl: <http://spinrdf.org/spl#> .
@prefix spr: <http://spinrdf.org/spr#> .
@prefix swa: <http://topbraid.org/swa#> .
@prefix tui: <http://uispin.org/tui#> .
@prefix ui: <http://uispin.org/ui#> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix voag: <http://voag.linkedmodel.org/schema/voag#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dct:description
  rdf:type rdf:Property ;
  rdfs:range xsd:string ;
.
arg:heading
  rdf:type rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:instancesTemplate
  rdf:type rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:logo
  rdf:type rdf:Property ;
.
arg:margin
  rdf:type rdf:Property ;
  rdfs:label "margin"^^xsd:string ;
.
arg:propertySet
  rdf:type rdf:Property ;
.
arg:resourceSet
  rdf:type rdf:Property ;
.
arg:sectionHeading
  rdf:type rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
<http://topbraid.org/xhtml#Area>
  rdf:type rdfs:Resource ;
.
voag:Figure
  rdf:type owl:Class ;
.
voag:Figure_1
  rdf:type owl:Class ;
  rdfs:subClassOf voag:Figure ;
.
voag:Figure_2
  rdf:type owl:Class ;
  rdfs:subClassOf voag:Figure_1 ;
.
voag:Figure_3
  rdf:type owl:Class ;
  rdfs:subClassOf voag:Figure_2 ;
.
voag:Graph
  rdf:type owl:Class ;
  ui:instanceView [
      rdf:type html:Div ;
      tui:resource spin:_this ;
      ui:child [
          rdf:type html:P ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  rdf:type spl:object ;
                  sp:arg1 spin:_this ;
                  sp:arg2 vaem:namespacePrefix ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:id "graphLabel"^^xsd:string ;
      ui:priority 2 ;
    ] ;
.
voag:Logo
  rdf:type owl:Class ;
.
<http://www.linkedmodel.org/1.1/swp/lmdoc>
  rdf:type owl:Ontology ;
  vaem:hasGraphRole vaem:ViewGraph ;
  owl:imports <http://spinrdf.org/spin.ui> ;
  owl:imports <http://topbraid.org/swa> ;
  owl:imports <http://uispin.org/ui> ;
  owl:imports <http://uispin.org/ui.ui> ;
  owl:imports <http://vaem.linkedmodel.org/1.0/spin/lib> ;
  owl:imports <http://www.linkedmodel.org/2.0/schema/vaem> ;
  owl:imports <http://www.w3.org/2004/02/skos/core> ;
  owl:versionInfo "Created with TopBraid Composer"^^xsd:string ;
.
lmdoc:AllClasses
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            sp:varName "qName"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "class"^^xsd:string ;
          ]
          [
            sp:varName "qName"^^xsd:string ;
          ]
          [
            sp:varName "uri"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object rdfs:Class ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "type"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type xsd:string ;
                sp:arg1 [
                    sp:varName "class"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:qname ;
                sp:arg1 [
                    sp:varName "class"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "qName"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all classes defined in a given graph and orders them by label. Note this may (obviously) not scale if a class has too many instances."^^xsd:string ;
  rdfs:label "All classes"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllInstances
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            sp:varName "qName"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "instance"^^xsd:string ;
          ]
          [
            sp:varName "qName"^^xsd:string ;
          ]
          [
            sp:varName "uri"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object owl:Thing ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "type"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type xsd:string ;
                sp:arg1 [
                    sp:varName "instance"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:qname ;
                sp:arg1 [
                    sp:varName "instance"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "qName"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all instances defined in a given graph and orders them by label. Note this may (obviously) not scale if a class has too many instances."^^xsd:string ;
  rdfs:label "All instances"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllOwners
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            sp:varName "owner"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "owner"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "owner"^^xsd:string ;
              ] ;
            sp:predicate vaem:owner ;
            sp:subject [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all owners of a given graph."^^xsd:string ;
  rdfs:label "All owners"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllProperties
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            sp:varName "qName"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "qName"^^xsd:string ;
          ]
          [
            sp:varName "uri"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object rdf:Property ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "type"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type xsd:string ;
                sp:arg1 [
                    sp:varName "property"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:qname ;
                sp:arg1 [
                    sp:varName "property"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "qName"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all properties defined in a given graph and orders them by label. Note this may (obviously) not scale if a class has too many instances."^^xsd:string ;
  rdfs:label "All properties"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AnyURILiteralViewer
  rdf:type swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:eq ;
          sp:arg1 [
              sp:varName "type"^^xsd:string ;
            ] ;
          sp:arg2 xsd:anyURI ;
        ] ;
      swa:weight 2 ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type html:Div ;
      ui:child [
          rdf:type html:A ;
          html:href [
              rdf:type xsd:string ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
            ] ;
          html:title [
              sp:varName "title"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "The LM Doc viewer for xsd:anyURI values: shows a hyperlink to the URI."^^xsd:string ;
  rdfs:label "AnyURI literal viewer"^^xsd:string ;
  rdfs:subClassOf swa:AnyURILiteralViewer ;
.
lmdoc:AskTemplates
  rdf:type spin:AskTemplate ;
  rdfs:label "Ask templates"^^xsd:string ;
  rdfs:subClassOf spin:AskTemplates ;
.
lmdoc:ClassInstances
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type ui:group ;
          let:count [
              rdf:type sp:Select ;
              sp:resultVariables (
                  [
                    sp:expression [
                        rdf:type sp:Count ;
                        sp:expression [
                            sp:varName "instance"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:varName "instanceCount"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "class"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:type ;
                    sp:subject [
                        sp:varName "instance"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:Div ;
                  html:class "ies-subtitle"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Instances"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type lmdoc:SubjectsBody ;
                  arg:object [
                      sp:varName "class"^^xsd:string ;
                    ] ;
                  arg:predicate rdf:type ;
                  arg:tabular "true"^^xsd:string ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      sp:varName "count"^^xsd:string ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue lmdoc:createLinkForMainForm ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Class Instances"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ClassesSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "resource"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:style "margin: 40px 0 25px 0;"^^xsd:string ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type html:H2 ;
          html:id [
              rdf:type lmdoc:makeAnchorFromString ;
              arg:label [
                  sp:varName "sectionHeading"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "sectionHeading"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type ui:call ;
          arg:graph [
              sp:varName "resource"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "resource-box"^^xsd:string ;
                      ui:child [
                          rdf:type ui:call ;
                          arg:subject [
                              sp:varName "class"^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type html:Div ;
                              html:class "header-box"^^xsd:string ;
                              ui:child [
                                  rdf:type lmdoc:ResourceDocAnchor ;
                                  arg:node [
                                      sp:varName "class"^^xsd:string ;
                                    ] ;
                                  arg:typeLabel "Class "^^xsd:string ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type html:P ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      rdf:type lmdoc:getDescription ;
                                      arg:resource [
                                          sp:varName "class"^^xsd:string ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isAnnotationProperty ;
                              arg:graph [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                              arg:label "Annotations"^^xsd:string ;
                              arg:predicates [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "class"^^xsd:string ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isNonAnnotationProperty ;
                              arg:graph [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                              arg:label "Properties"^^xsd:string ;
                              arg:predicates [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "class"^^xsd:string ;
                                ] ;
                              ui:childIndex 5 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ResourceFooter ;
                              arg:resource [
                                  sp:varName "class"^^xsd:string ;
                                ] ;
                              ui:childIndex 7 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "20px;"^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "30px;"^^xsd:string ;
                              ui:childIndex 4 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "40px;"^^xsd:string ;
                              ui:childIndex 6 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:template [
                              rdf:type swa:modeProperty ;
                              arg:predicate swa:formObjectPredicateSelectionTemplate ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:VSpace ;
                      arg:margin "40px;"^^xsd:string ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:resultSet [
                      sp:varName "classes"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "classes"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 1 ;
          ui:template lmdoc:AllClasses ;
          ui:varName "classes"^^xsd:string ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Classes section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:CopyrightSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:call ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:P ;
                  html:class "copyright"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text """Copyright ©2011-2014 
"""^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text """
   , All Rights Reserved.
"""^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:forEach ;
                      ui:child [
                          rdf:type html:Abbr ;
                          html:title [
                              sp:varName "owner"^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "owner"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                      ui:resultSet [
                          sp:varName "rs"^^xsd:string ;
                        ] ;
                      ui:separator ", "^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "rs"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:AllOwners ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Copyright section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:CreateLinkFunctions
  rdf:type spin:Function ;
  rdfs:subClassOf swa:CreateLinkFunctions ;
.
lmdoc:DetailedClassView
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type html:Div ;
          html:class "tuiView"^^xsd:string ;
          ui:child [
              rdf:type html:Div ;
              html:class "ies_resource_summary"^^xsd:string ;
              ui:child [
                  rdf:type html:P ;
                  html:class "ies_qname"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "QName = "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 1 ;
                      ui:text [
                          rdf:type ui:encodeNode ;
                          sp:arg1 [
                              sp:varName "class"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type lmlib:maybeDescription ;
                          sp:arg1 [
                              sp:varName "class"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:H2 ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "class"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              arg:resource [
                  sp:varName "class"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "class"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type lmdoc:ObjectsGroup ;
                  arg:filterFunction swa:isAnnotationProperty ;
                  arg:label "Annotations"^^xsd:string ;
                  arg:predicates [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                  arg:subject [
                      sp:varName "class"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 4 ;
              ui:template [
                  rdf:type swa:modeProperty ;
                  arg:predicate swa:formObjectPredicateSelectionTemplate ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:group ;
              letrs:myPropertySet [
                  rdf:type sp:Select ;
                  sp:distinct "true"^^xsd:boolean ;
                  sp:orderBy (
                      [
                        rdf:type ui:label ;
                        sp:arg1 [
                            sp:varName "property"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:resultVariables (
                      [
                        sp:varName "property"^^xsd:string ;
                      ]
                      [
                        sp:varName "parent"^^xsd:string ;
                      ]
                    ) ;
                  sp:where (
                      [
                        sp:object [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                        sp:predicate lmlib:relevantPropertiesAtClassWithParent ;
                        sp:subject [
                            sp:varName "property"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "class"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "parent"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-subtitle"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Relevant Properties for "^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text [
                              rdf:type ui:label ;
                              sp:arg1 [
                                  sp:varName "class"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:PropertiesTable ;
                      arg:class [
                          sp:varName "class"^^xsd:string ;
                        ] ;
                      arg:propertySet [
                          sp:varName "myPropertySet"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "myPropertySet"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type ui:group ;
              letrs:superclasses [
                  rdf:type sp:Select ;
                  sp:distinct "true"^^xsd:boolean ;
                  sp:orderBy (
                      [
                        sp:varName "depth"^^xsd:string ;
                      ]
                      [
                        rdf:type ui:label ;
                        sp:arg1 [
                            sp:varName "super"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:resultVariables (
                      [
                        sp:varName "super"^^xsd:string ;
                      ]
                      [
                        sp:varName "depth"^^xsd:string ;
                      ]
                    ) ;
                  sp:where (
                      [
                        sp:object [
                            sp:varName "super"^^xsd:string ;
                          ] ;
                        sp:predicate lmlib:mySuperClass ;
                        sp:subject [
                            sp:varName "class"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "class"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "super"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "depth"^^xsd:string ;
                          ] ;
                        sp:predicate lmlib:inheritanceDepth ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-subtitle"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Inheritance Table"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:InheritanceTable ;
                      arg:resourceSet [
                          sp:varName "superclasses"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "superclasses"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              rdf:type lmdoc:ClassInstances ;
              arg:class [
                  sp:varName "class"^^xsd:string ;
                ] ;
              ui:childIndex 5 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:queryGraph [
          rdf:type ui:graphWithImports ;
          sp:arg1 [
              rdf:type lmlib:maybeConvertToURI ;
              sp:arg1 [
                  sp:varName "context"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue lmdoc:createLinkForMainForm ;
    ] ;
  rdfs:label "Detailed Class View"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
