lmdoc:WhereUsedLabeledSubjects
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to only allow at most one subject for this component."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:if ;
      ui:child [
          rdf:type html:Tr ;
          html:class "lm-row"^^xsd:string ;
          ui:child [
              rdf:type html:Td ;
              html:class "lm-table-column align-top"^^xsd:string ;
              ui:child [
                  rdf:type lmdoc:URIResourceViewer ;
                  arg:object [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Td ;
              html:class "lm-table-column"^^xsd:string ;
              html:id [
                  rdf:type ui:concat ;
                  sp:arg1 [
                      sp:varName "pid"^^xsd:string ;
                    ] ;
                  sp:arg2 "-body"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type lmdoc:WhereUsedSubjectsBody ;
                  ui:args "*"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:condition [
          rdf:type sp:or ;
          sp:arg1 [
              rdf:type sp:or ;
              sp:arg1 [
                  rdf:type sp:or ;
                  sp:arg1 [
                      rdf:type sp:not ;
                      sp:arg1 [
                          rdf:type sp:bound ;
                          sp:arg1 [
                              sp:varName "hideIfEmpty"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  sp:arg2 [
                      rdf:type sp:ne ;
                      sp:arg1 [
                          sp:varName "hideIfEmpty"^^xsd:string ;
                        ] ;
                      sp:arg2 "true"^^xsd:boolean ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type sp:ne ;
                  sp:arg1 [
                      rdf:type swa:mode ;
                    ] ;
                  sp:arg2 swa:ViewMode ;
                ] ;
            ] ;
          sp:arg2 [
              rdf:type sp:and ;
              sp:arg1 [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type sp:exists ;
                  sp:elements (
                      [
                        sp:object [
                            sp:varName "object"^^xsd:string ;
                          ] ;
                        sp:predicate [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                        sp:subject [
                            sp:varName "anySubject"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "Where used labelled subjects"^^xsd:string ;
  rdfs:label "Labeled subjects"^^xsd:string ;
  rdfs:subClassOf lmdoc:Subjects ;
.
lmdoc:WhereUsedSubjects
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:object ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicates ;
      spl:valueType sp:Select ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      letrs:rs [
          rdf:type sp:Select ;
          sp:resultVariables (
              [
                sp:varName "predicate"^^xsd:string ;
              ]
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "predicates"^^xsd:string ;
                  ] ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object 0 ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object () ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "predicate"^^xsd:string ;
                  ] ;
                sp:predicate spr:colCells ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                rdf:type sp:Filter ;
                sp:expression [
                    rdf:type sp:or ;
                    sp:arg1 [
                        rdf:type sp:not ;
                        sp:arg1 [
                            rdf:type sp:bound ;
                            sp:arg1 [
                                sp:varName "filterFunction"^^xsd:string ;
                              ] ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        rdf:type spif:invoke ;
                        sp:arg1 [
                            sp:varName "filterFunction"^^xsd:string ;
                          ] ;
                        sp:arg2 [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                        sp:arg3 [
                            sp:varName "subject"^^xsd:string ;
                          ] ;
                      ] ;
                  ] ;
              ]
              [
                rdf:type sp:Filter ;
                sp:expression [
                    rdf:type sp:not ;
                    sp:arg1 [
                        rdf:type swa:isHiddenProperty ;
                        arg:property [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                      ] ;
                  ] ;
              ]
            ) ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Table ;
              html:class "lm-table"^^xsd:string ;
              let:pid [
                  rdf:type ui:uniqueId ;
                ] ;
              ui:child [
                  rdf:type html:Tbody ;
                  html:class "lm-table-body"^^xsd:string ;
                  ui:child [
                      rdf:type ui:forEach ;
                      ui:child [
                          rdf:type lmdoc:WhereUsedLabeledSubjects ;
                          arg:property [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          arg:single "false"^^xsd:boolean ;
                          ui:args "*"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:resultSet [
                          sp:varName "rs"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Thead ;
                  html:class "lm-table-header"^^xsd:string ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Referencing Property"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Subject"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:gt ;
              sp:arg1 [
                  rdf:type spr:rowCount ;
                  sp:arg1 [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "Inserts a widget for a given predicate/object combination, showing the subjects as values. This is typically known as \"Incoming References\"."^^xsd:string ;
  rdfs:label "Subjects"^^xsd:string ;
  rdfs:subClassOf lmdoc:Subjects ;
.
lmdoc:WhereUsedSubjectsBody
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to allow at most one value."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-object-row"^^xsd:string ;
              ui:child [
                  rdf:type swa:SubjectWidgetRow ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-add-button-div"^^xsd:string ;
              html:style [
                  rdf:type sp:if ;
                  sp:arg1 [
                      sp:varName "single"^^xsd:string ;
                    ] ;
                  sp:arg2 "display: none" ;
                  sp:arg3 [
                      sp:varName "none"^^xsd:string ;
                    ] ;
                ] ;
              let:pid [
                  rdf:type ui:uniqueId ;
                ] ;
              ui:child [
                  rdf:type html:A ;
                  html:class "swa-add-row-button"^^xsd:string ;
                  html:href "javascript:void(0)"^^xsd:string ;
                  html:onclick [
                      rdf:type fn:concat ;
                      sp:arg1 "swa.addRow('"^^xsd:string ;
                      sp:arg2 [
                          sp:varName "pid"^^xsd:string ;
                        ] ;
                      sp:arg3 "', "^^xsd:string ;
                      sp:arg4 [
                          rdf:type sp:coalesce ;
                          sp:arg1 [
                              sp:varName "single"^^xsd:string ;
                            ] ;
                          sp:arg2 "false"^^xsd:boolean ;
                        ] ;
                      sp:arg5 ")"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:id [
                      sp:varName "pid"^^xsd:string ;
                    ] ;
                  html:style "display: none"^^xsd:string ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type ui:setContext ;
                          ui:child [
                              rdf:type swa:SubjectWidgetRow ;
                              arg:object [
                                  sp:varName "object"^^xsd:string ;
                                ] ;
                              arg:predicate [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:varName "createLinkFunction"^^xsd:string ;
                          ui:varValue lmdoc:createLinkForMainForm ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 2 ;
          ui:condition [
              rdf:type swa:isEditMode ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:call ;
              arg:object [
                  sp:varName "object"^^xsd:string ;
                ] ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa_widget_value_slot"^^xsd:string ;
                      ui:child [
                          rdf:type swa:SubjectWidgetRow ;
                          arg:object [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          arg:subject [
                              sp:varName "subject"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type swa:SubjectWidgetRow ;
                          arg:object [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:eq ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "rs"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template swa:SortedSubjects ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "Where used subjects body"^^xsd:string ;
  rdfs:label "Subjects body"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubjectElements ;
.
lmdoc:WhereUsedSubjectsGroup
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:filterFunction ;
      spl:valueType spin:Function ;
      rdfs:comment "An optional filter function that takes a predicate, subject and subjectType as arguments and returns true for all predicates that should be displayed."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
      rdfs:comment "The title label."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:object ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The resource to display."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicates ;
      spl:valueType sp:Select ;
      rdfs:comment "A result set (e.g., SPARQL SELECT query) that delivers the predicates in this group."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-objects-group"^^xsd:string ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-sub-title"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "label"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:bound ;
                      sp:arg1 [
                          sp:varName "label"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type lmdoc:WhereUsedSubjects ;
                  arg:object [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                  arg:predicates [
                      sp:varName "predicates"^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:gt ;
              sp:arg1 [
                  rdf:type spr:rowCount ;
                  sp:arg1 [
                      sp:varName "predicates"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A group of subject widgets."^^xsd:string ;
  rdfs:label "Where used subjects group"^^xsd:string ;
  rdfs:subClassOf lmdoc:Subjects ;
.
lmdoc:countOfInstanceOfType
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:expression [
                rdf:type sp:Count ;
                sp:expression [
                    sp:varName "instance"^^xsd:string ;
                  ] ;
              ] ;
            sp:varName "count"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:type ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:integer ;
  rdfs:comment "Returns a count of  instancesof a given type defined in a given graph."^^xsd:string ;
  rdfs:label "All instances"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:createLinkForMainForm
  rdf:type ui:NodeClass ;
  rdfs:subClassOf lmdoc:CreateLinkFunctions ;
.
lmdoc:getDefinition
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          _:b95165
        ) ;
      sp:where (
          [
            sp:object _:b95165 ;
            sp:predicate vaem:description ;
            sp:subject [
                sp:varName "resource"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:label "get definition"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:getDescription
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "description"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object dct:description ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject [
                sp:varName "descriptionProperty"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "description"^^xsd:string ;
              ] ;
            sp:predicate [
                sp:varName "descriptionProperty"^^xsd:string ;
              ] ;
            sp:subject [
                sp:varName "resource"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:label "get description"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:getTitle
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          _:b55599
        ) ;
      sp:where (
          [
            sp:object _:b55599 ;
            sp:predicate <http://purl.org/dc/elements/1.1/title> ;
            sp:subject [
                sp:varName "resource"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:label "get title"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:htmlString
  rdf:type owl:DatatypeProperty ;
  rdfs:comment "A string that can include html tags."^^xsd:string ;
  rdfs:domain rdfs:Resource ;
  rdfs:label "html string"^^xsd:string ;
  rdfs:range xsd:string ;
.
lmdoc:inheritanceDepth
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "d"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "x"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject spin:_arg1 ;
                  ]
                  [
                    rdf:type sp:Filter ;
                    sp:expression [
                        rdf:type sp:ne ;
                        sp:arg1 [
                            sp:varName "x"^^xsd:string ;
                          ] ;
                        sp:arg2 spin:_arg2 ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "x"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object spin:_arg2 ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "inc"^^xsd:string ;
                      ] ;
                    sp:predicate lmdoc:inheritanceDepth ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        rdf:type sp:add ;
                        sp:arg1 [
                            sp:varName "inc"^^xsd:string ;
                          ] ;
                        sp:arg2 1 ;
                      ] ;
                    sp:variable [
                        sp:varName "d"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object spin:_arg2 ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject spin:_arg1 ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression 1 ;
                    sp:variable [
                        sp:varName "d"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    rdf:type sp:Filter ;
                    sp:expression [
                        rdf:type sp:eq ;
                        sp:arg1 spin:_arg1 ;
                        sp:arg2 spin:_arg2 ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression 0 ;
                    sp:variable [
                        sp:varName "d"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "Current subclass"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "Current superclass"^^xsd:string ;
    ] ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:labelText
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          _:b90604
        ) ;
      sp:where (
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object _:b54653 ;
                    sp:predicate rdfs:label ;
                    sp:subject _:b4674 ;
                  ]
                )
                (
                  [
                    sp:object _:b54653 ;
                    sp:predicate skos:prefLabel ;
                    sp:subject _:b4674 ;
                  ]
                )
              ) ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 " -- " ;
                sp:arg2 _:b54653 ;
              ] ;
            sp:variable _:b90604 ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate tui:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "label text"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:makeAnchorFromResource
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "anchor"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:qname ;
                sp:arg1 [
                    sp:varName "resource"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "a1"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:regex ;
                sp:arg1 [
                    sp:varName "a1"^^xsd:string ;
                  ] ;
                sp:arg2 ":" ;
                sp:arg3 "_" ;
              ] ;
            sp:variable [
                sp:varName "anchor"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:label "make anchor from resource"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:makeAnchorFromString
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "anchor"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:regex ;
                sp:arg1 [
                    sp:varName "label"^^xsd:string ;
                  ] ;
                sp:arg2 " " ;
                sp:arg3 "_" ;
              ] ;
            sp:variable [
                sp:varName "anchor"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:label "make anchor from string"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:mySuperClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "super"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object owl:Class ;
            sp:predicate rdf:type ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "super"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            sp:object [
                sp:varName "superType"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "super"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:ne ;
                sp:arg1 [
                    sp:varName "superType"^^xsd:string ;
                  ] ;
                sp:arg2 owl:Restriction ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "super"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "super"^^xsd:string ;
                      ] ;
                    sp:arg2 spin:_arg1 ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
    ] ;
  rdfs:label "my super class"^^xsd:string ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:numberLines
  rdf:type spin:Function ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:defaultValue 60 ;
      spl:predicate sp:arg5 ;
      spl:valueType xsd:integer ;
      rdfs:comment "width of code block"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:defaultValue 999 ;
      spl:predicate sp:arg3 ;
      spl:valueType xsd:integer ;
      rdfs:comment "number of lines to generate"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:defaultValue "false"^^xsd:boolean ;
      spl:predicate sp:arg4 ;
      spl:valueType xsd:integer ;
      rdfs:comment "indent"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType xsd:integer ;
      rdfs:comment "first index"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg6 ;
      spl:valueType xsd:boolean ;
      rdfs:comment "debug"^^xsd:string ;
    ] ;
  spin:returnType xsd:string ;
  spinx:javaScriptCode """// ----------
// numberLines
// ----------
//
// numberLines(text, firstLine, lineCount, depth, maxWidth, debug)
//
// @text:             what to number
// @firstLine:      where to start in the array of split strings
// @lineCount:    max number of lines to generate
// @depth:         width of margin
// @width:          width of code block
// @debug:         trace rules in the output
//


var debug2 = false,
     lineNo = 0 ,
     offset= 0 ;

function formatNumber(n) {
   var str=n.toString() ;
   if (n<10) str+= '  '
   else  if (n<100) str += ' ';
  return str + ' '
  };


function createShiftArr(step) {

	var space = '     ';
	
	if ( isNaN(parseInt(step)) ) {  // argument is string
		space = step;
	} else { // argument is integer
		switch(step) {
			case 1: space = ' '; break;
			case 2: space = '  '; break;
			case 3: space = '   '; break;
			case 4: space = '    '; break;
			case 5: space = '     '; break;
			case 6: space = '      '; break;
			case 7: space = '       '; break;
			case 8: space = '        '; break;
			case 9: space = '         '; break;
			case 10: space = '          '; break;
			case 11: space = '           '; break;
			case 12: space = '            '; break;
		}
	};

	var shift = ['\\n!NN!']; // array of shifts
	for(ix=0;ix<100;ix++){
		shift.push(shift[ix]+space); 
	}
	return shift;
   };

function createSpacesArray() {
	var ar = [''];
	for(ix=0;ix<100;ix++){
		ar.push(ar[ix] + ' '); 
	}
	return ar;
};                                                                   

function formatLine(str,width) {       
  var ix,
      adjWidth = width + 4,
    
    linesSplitOnComma = function (str, margin, width) {
      if ( str.search(/, /) > -1)  {
       var jx,
           fla = str.replace(/, /,\",~==~  \" + margin)
                  .split(\"~==~\") ,
           splits = fla.length ,                         
           fla2= [] ;
      
       for (jx=0; jx < splits ; jx++) {
          var splitLine= fla[jx] ;     
          if ((splitLine.length > adjWidth )  && ( splitLine.indexOf(\",\") > -1 )) {
              fla2 = fla2.concat(linesSplitOnComma(splitLine, margin, adjWidth)) 
            } else {
            len = fla2.push(splitLine) 
            }
        } ;
      return fla2
      } else return [str]
    } ;

  function trySplitOnBracedExpression(width) {
    var splitIndex = str.search(/{/) ,
        safeIndex = (splitIndex > 3)? splitIndex - 3: 0 ;
        margin = spacesArray[safeIndex] ,
        newLine = \"\" ;
    if ( str.search(/(\"{.*}\")/) > -1)  {
      var fla = str.replace(/(\"{[=#]\\s[a-zA-Z0-9_&,;\\(\\)\\s':\\?]+}\")(&gt;|\\s)/g,\"~==~$1$2\") 
                    .split(\"~==~\") ,
          splits = fla.length ,
          ar2 = [] ;
      
      newLine += fla[0] ;

      for (ix=1; ix < splits ; ix++) {
        var splitLine= margin + fla[ix] ;     
        if (splitLine.length > adjWidth ) {
              ar2 = ar2.concat(linesSplitOnComma(splitLine, margin, adjWidth)) 
            } else {
           len = ar2.push(splitLine) 
          }
        } 
    } else {
       var ar2 =  linesSplitOnComma(str, margin, adjWidth) ;
       for(ix=0;ix < ar2.length; ix++) {
          var splitLine= margin + ar2[ix] ;
          newLine +=    splitLine ;
         } 
       } ; 
     return newLine
  } ;
  
  function trySplitOnIF(width) {
    var splitIndex = str.search(/ \\(IF/) ,
        safeIndex = (splitIndex > 2)? splitIndex - 2: 0 ;
        margin = spacesArray[safeIndex] ,
        newLine = \"\" ;
    if ( str.search(/,\\sIF/) > -1)  {
      var fla =str.replace(/,(\\sIF)/g,\",~==~$1\") 
                    .split(\"~==~\") ,
          splits = fla.length ,
          ar2 = [] ;
      
      newLine += fla[0] ;

      for (ix=1; ix < splits ; ix++) {
        var splitLine= margin + fla[ix] ;     
        if (splitLine.length > adjWidth ) {
              ar2 = ar2.concat(linesSplitOnComma(splitLine, margin, adjWidth)) 
            } else {
           len = ar2.push(splitLine) 
          }
        } ;

      for(ix=0;ix < ar2.length; ix++) {
        var splitLine= margin + ar2[ix] ;
        lineNo +=  1;
        newLine += \"\\n\" + formatNumber(lineNo - offset) +  splitLine ;
       } ; 
     return newLine
      } else { newLine = trySplitOnBracedExpression(width) } ;
     return newLine   
    } ;
  
  function makeSplits(width) {  
    newLine = trySplitOnIF(width);
    return newLine
  }
  
   return makeSplits(width)
} ;

   function numberedTextLines(text, firstLine, lineCount, depth, maxWidth, debug) {

       var ar = text.split('\\n'),
             len =  ar.length ,
             lastLine = (firstLine > 0)? lineCount + firstLine - 1 : lineCount ,
             shift = step ? createShiftArr(step) : shift;
        
       function numberedIndentation(text) {
            var offset = (firstLine > 0)? firstLine -1 : 0 ,
                myStr = String(text).replace(\"!NN!\", formatNumber(lineNo - offset))  ;
            return myStr
            };

        function numberText() {
            var text = '';
            for (i=firstLine;i< lastLine && i < len ; i++) {
                var aLine = ar[i] + '' ;
                lineNo++;
                text += numberedIndentation(shift[1]) + formatLine(aLine,maxWidth) ;
             } ;
          return text
         } ;

         return numberText()

    } ;

   var step = 2 ,                          // 2 spaces
      shift = createShiftArr(step),
      spacesArray = createSpacesArray(),
      result = numberedTextLines(arg1,arg2, arg3, arg4, arg5, arg6) ;
      return result ;
"""^^xsd:string ;
  rdfs:subClassOf spin:Functions ;
.
lmdoc:optionalLinkArgs
  rdf:type owl:DatatypeProperty ;
  rdfs:label "optional link args"^^xsd:string ;
  rdfs:range xsd:string ;
.
lmdoc:parentsOfPropertiesAtClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "parent"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg2 ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "superClass"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:domain ;
                    sp:subject [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:variable [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:NotExists ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "value"^^xsd:string ;
                            ] ;
                          sp:predicate owl:hasValue ;
                          sp:subject [
                              sp:varName "superClass"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "value"^^xsd:string ;
                      ] ;
                    sp:predicate owl:hasValue ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:isIRI ;
                sp:arg1 [
                    sp:varName "parent"^^xsd:string ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "a property on the left"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdf:Property ;
      rdfs:comment "property"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  spin:returnType rdfs:Class ;
  rdfs:label "parents of properties at class"^^xsd:string ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:rangeOfPropertyAtClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "range"^^xsd:string ;
          ]
          [
            sp:varName "valueRestriction"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "superClass"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "aProperty"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg2 ;
          ]
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "range"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:range ;
                    sp:subject [
                        sp:varName "aProperty"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression "false"^^xsd:boolean ;
                    sp:variable [
                        sp:varName "valueRestriction"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "aProperty"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "range"^^xsd:string ;
                      ] ;
                    sp:predicate owl:allValuesFrom ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression "false"^^xsd:boolean ;
                    sp:variable [
                        sp:varName "valueRestriction"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "aProperty"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "range"^^xsd:string ;
                      ] ;
                    sp:predicate owl:hasValue ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression "true"^^xsd:boolean ;
                    sp:variable [
                        sp:varName "valueRestriction"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "false"^^xsd:boolean ;
      spl:predicate sp:arg2 ;
      spl:valueType rdf:Property ;
      rdfs:comment "property"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of"^^xsd:string ;
    ] ;
  spin:labelTemplate "Range(s) for {?arg2} at class {?arg1}"^^xsd:string ;
  rdfs:comment "Gets a list of ranges for a given class and property based on all superclasses."^^xsd:string ;
  rdfs:label "Range of property at class"^^xsd:string ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:relevantPropertiesAtClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "parent"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object spin:_arg1 ;
            sp:predicate spl:relevantPropertyAtClass ;
            sp:subject [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "superClass"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "aProperty"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:domain ;
                    sp:subject [
                        sp:varName "aProperty"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "aProperty"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  rdfs:comment "Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels."^^xsd:string ;
  rdfs:label "Relevant properties at class"^^xsd:string ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:relevantPropertiesAtClassWithParent
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "class"^^xsd:string ;
          ]
          [
            sp:varName "parent"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "superClass"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:domain ;
                    sp:subject [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:variable [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:NotExists ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "value"^^xsd:string ;
                            ] ;
                          sp:predicate owl:hasValue ;
                          sp:subject [
                              sp:varName "superClass"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:isIRI ;
                sp:arg1 [
                    sp:varName "class"^^xsd:string ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "a property on the left"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  spin:returnType rdfs:Class ;
  rdfs:comment """Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels. 

A magic property that establishes a relationship between properties (left) and classes (right) to determine which properties are \"relevant\" for the class. Relevant means that they have the class in their domain and/or restrictions, including superclasses and sub-properties.

Note that the performance of the body of this magic property has been optimized for the case in which the class is given, so ideally use this for queries such as  ?property iess:relevantPropertyAtClass skos:Concept ."""^^xsd:string ;
  rdfs:label "Relevant properties at class with parent"^^xsd:string ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:relevantPropertyDetailsAtClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "parent"^^xsd:string ;
          ]
          [
            sp:varName "range"^^xsd:string ;
          ]
          [
            sp:varName "valueRestriction"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "?0"^^xsd:string ;
              ] ;
            sp:predicate lmdoc:relevantPropertiesAtClass ;
            sp:subject spin:_arg1 ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "parent"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object spin:_arg1 ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?3"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?4"^^xsd:string ;
              ] ;
            sp:predicate lmdoc:rangeOfPropertyAtClass ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "range"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?4"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?5"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?4"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "valueRestriction"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?5"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?5"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  rdfs:comment "Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels."^^xsd:string ;
  rdfs:label "Relevant property details at class"^^xsd:string ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
lmdoc:ruleSet
  rdf:type owl:ObjectProperty ;
  rdfs:label "rule set"^^xsd:string ;
.
lmdoc:valueRestrictionsForPropertyAtClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "range"^^xsd:string ;
          ]
          [
            sp:varName "superClass"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "superClass"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:NotExists ;
            sp:elements (
                [
                  sp:object owl:Restriction ;
                  sp:predicate rdf:type ;
                  sp:subject [
                      sp:varName "superClass"^^xsd:string ;
                    ] ;
                ]
              ) ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "aProperty"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg2 ;
          ]
          [
            sp:object [
                sp:varName "res"^^xsd:string ;
              ] ;
            sp:predicate rdfs:subClassOf ;
            sp:subject [
                sp:varName "superClass"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "aProperty"^^xsd:string ;
              ] ;
            sp:predicate owl:onProperty ;
            sp:subject [
                sp:varName "res"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "range"^^xsd:string ;
              ] ;
            sp:predicate owl:hasValue ;
            sp:subject [
                sp:varName "res"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "false"^^xsd:boolean ;
      spl:predicate sp:arg2 ;
      spl:valueType rdf:Property ;
      rdfs:comment "property"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of"^^xsd:string ;
    ] ;
  spin:labelTemplate "Value restriction(s) for property {?arg2} at class {?arg1}"^^xsd:string ;
  rdfs:comment "Gets restricted values for a given class and property based on all superclasses."^^xsd:string ;
  rdfs:label "Value restrictions for property at class."^^xsd:string ;
  rdfs:subClassOf lmdoc:MagicProperties ;
.
