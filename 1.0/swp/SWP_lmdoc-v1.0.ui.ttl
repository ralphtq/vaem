# baseURI: http://www.linkedmodel.org/1.1/swp/lmdoc
# imports: http://spinrdf.org/spin.ui
# imports: http://spinrdf.org/spinx
# imports: http://topbraid.org/swa
# imports: http://uispin.org/ui
# imports: http://uispin.org/ui.ui
# imports: http://voag.linkedmodel.org/2.0/schema/voag
# imports: http://www.linkedmodel.org/schema/vaem
# imports: http://www.w3.org/2004/02/skos/core

@prefix afn: <http://jena.hpl.hp.com/ARQ/function#> .
@prefix arg: <http://spinrdf.org/arg#> .
@prefix catalog: <http://www.linkedmodel.org/schema/catalog#> .
@prefix css: <http://uispin.org/css#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix fn: <http://www.w3.org/2005/xpath-functions#> .
@prefix html: <http://uispin.org/html#> .
@prefix iess: <http://ies.topbraidlive.org/schema/ies#> .
@prefix let: <http://uispin.org/let#> .
@prefix letrs: <http://uispin.org/letrs#> .
@prefix lmdoc: <http://www.linkedmodel.org/oui/lmdoc#> .
@prefix lmlib: <http://vaem.linkedmodel.org/spin/lib/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix smf: <http://topbraid.org/sparqlmotionfunctions#> .
@prefix sp: <http://spinrdf.org/sp#> .
@prefix spif: <http://spinrdf.org/spif#> .
@prefix spin: <http://spinrdf.org/spin#> .
@prefix spin.ui: <http://spinrdf.org/spin.ui#> .
@prefix spinx: <http://spinrdf.org/spinx#> .
@prefix spl: <http://spinrdf.org/spl#> .
@prefix spr: <http://spinrdf.org/spr#> .
@prefix swa: <http://topbraid.org/swa#> .
@prefix tui: <http://uispin.org/tui#> .
@prefix ui: <http://uispin.org/ui#> .
@prefix uix: <http://topbraidlive.org/uix#> .
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#> .
@prefix voag: <http://voag.linkedmodel.org/voag/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dct:description
  rdf:type rdf:Property ;
  rdfs:range xsd:string ;
.
arg:heading
  rdf:type rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:instancesTemplate
  rdf:type rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:logo
  rdf:type rdf:Property ;
.
arg:margin
  rdf:type rdf:Property ;
  rdfs:label "margin"^^xsd:string ;
.
arg:options
  rdf:type rdf:Property ;
  rdfs:range xsd:string ;
.
arg:parentLevel
  rdf:type owl:DatatypeProperty ;
  rdfs:label "parent level"^^xsd:string ;
  rdfs:range xsd:string ;
.
arg:propertySet
  rdf:type rdf:Property ;
.
arg:resourceSet
  rdf:type rdf:Property ;
.
arg:sectionHeading
  rdf:type rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:showConstructors
  rdf:type rdf:Property ;
  rdfs:range xsd:boolean ;
  rdfs:subPropertyOf sp:arg ;
.
arg:showInstances
  rdf:type rdf:Property ;
  rdfs:range xsd:boolean ;
  rdfs:subPropertyOf sp:arg ;
.
arg:showRules
  rdf:type rdf:Property ;
  rdfs:range xsd:boolean ;
  rdfs:subPropertyOf sp:arg ;
.
arg:showTitle
  rdf:type rdf:Property ;
  rdfs:range xsd:boolean ;
  rdfs:subPropertyOf sp:arg ;
.
spin:RuleProperty
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty lmdoc:htmlString ;
    ] ;
.
<http://topbraid.org/email#TestAddress>
  rdf:type owl:Class ;
  rdfs:label "Test address"^^xsd:string ;
  rdfs:subClassOf <http://topbraid.org/email#Address> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty vaem:id ;
    ] ;
.
<http://topbraid.org/xhtml#Area>
  rdf:type rdfs:Resource ;
.
<http://voag.linkedmodel.org/schema/voag#Figure_1>
  rdf:type owl:Class ;
  rdfs:subClassOf voag:Figure ;
.
<http://voag.linkedmodel.org/schema/voag#Figure_2>
  rdf:type owl:Class ;
  rdfs:subClassOf <http://voag.linkedmodel.org/schema/voag#Figure_1> ;
.
<http://voag.linkedmodel.org/schema/voag#Figure_3>
  rdf:type owl:Class ;
  rdfs:subClassOf <http://voag.linkedmodel.org/schema/voag#Figure_2> ;
.
voag:Graph
  rdf:type owl:Class ;
  ui:instanceView [
      rdf:type html:Div ;
      tui:resource spin:_this ;
      ui:child [
          rdf:type html:P ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  rdf:type spl:object ;
                  sp:arg1 spin:_this ;
                  sp:arg2 vaem:namespacePrefix ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:id "graphLabel"^^xsd:string ;
      ui:priority 2 ;
    ] ;
.
<http://www.linkedmodel.org/1.1/swp/lmdoc>
  rdf:type owl:Ontology ;
  vaem:hasGraphMetadata <http://www.linkedmodel.org/1.1/swp/lmdoc/GMD_LMDOC> ;
  vaem:hasGraphRole vaem:ViewGraph ;
  owl:imports <http://spinrdf.org/spin.ui> ;
  owl:imports <http://spinrdf.org/spinx> ;
  owl:imports <http://topbraid.org/swa> ;
  owl:imports <http://uispin.org/ui> ;
  owl:imports <http://uispin.org/ui.ui> ;
  owl:imports <http://voag.linkedmodel.org/2.0/schema/voag> ;
  owl:imports <http://www.linkedmodel.org/schema/vaem> ;
  owl:imports <http://www.w3.org/2004/02/skos/core> ;
  owl:versionInfo "Created with TopBraid Composer"^^xsd:string ;
.
<http://www.linkedmodel.org/1.1/swp/lmdoc/GMD_LMDOC>
  rdf:type <vaem:DocumentationGraph> ;
  dct:created "2014-08-06"^^xsd:date ;
  vaem:hasOwner vaem:TopQuadrant ;
  vaem:hasSteward vaem:TopQuadrant ;
  vaem:name "lmdoc"^^xsd:string ;
  vaem:namespace "http://www.linkedmodel.org/oui/lmdoc#"^^xsd:anyURI ;
  vaem:namespacePrefix "lmdoc"^^xsd:string ;
  vaem:owner "TopQuadrant"^^xsd:string ;
  vaem:revision "1.1"^^xsd:string ;
.
lmdoc:AbstractSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:metadata ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:ns [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "metadata"^^xsd:string ;
            ] ;
          sp:arg2 vaem:namespace ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "lm-abstract"^^xsd:string ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              let:graphType [
                  rdf:type fn:lower-case ;
                  sp:arg1 [
                      rdf:type ui:label ;
                      sp:arg1 [
                          rdf:type spl:object ;
                          sp:arg1 [
                              sp:varName "metadata"^^xsd:string ;
                            ] ;
                          sp:arg2 vaem:hasGraphRole ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type html:A ;
                  html:href [
                      rdf:type spl:object ;
                      sp:arg1 [
                          sp:varName "metadata"^^xsd:string ;
                        ] ;
                      sp:arg2 vaem:rdfxmlFileURL ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "RDF/XML"^^xsd:string ;
                    ] ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  rdf:type html:A ;
                  html:href [
                      rdf:type spl:object ;
                      sp:arg1 [
                          sp:varName "metadata"^^xsd:string ;
                        ] ;
                      sp:arg2 vaem:turtleFileURL ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Turtle"^^xsd:string ;
                    ] ;
                  ui:childIndex 5 ;
                ] ;
              ui:child [
                  rdf:type html:Code ;
                  html:class "boxed"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "graphType"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "The "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text " is available as  "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 4 ;
                  ui:text " and "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 6 ;
                  ui:text "."^^xsd:string ;
                ] ;
              ui:childIndex 4 ;
            ] ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              ui:child [
                  rdf:type html:Code ;
                  html:class "boxed"^^xsd:string ;
                  ui:child [
                      rdf:type html:A ;
                      html:href [
                          sp:varName "ns"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "ns"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "The namespace for all resources in this ontology is: "^^xsd:string ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              ui:child [
                  rdf:type html:Code ;
                  html:class "boxed"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type spl:object ;
                          sp:arg1 [
                              sp:varName "myGraphMetadata"^^xsd:string ;
                            ] ;
                          sp:arg2 vaem:namespacePrefix ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Code ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "ns"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "All resources are within the "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text " namespace ("^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 4 ;
                  ui:text ")."^^xsd:string ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type spl:object ;
                      sp:arg1 [
                          sp:varName "metadata"^^xsd:string ;
                        ] ;
                      sp:arg2 vaem:intent ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type lmdoc:MaybeDescription ;
              arg:node [
                  sp:varName "metadata"^^xsd:string ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:H2 ;
          html:id [
              rdf:type fn:lower-case ;
              sp:arg1 [
                  sp:varName "sectionHeading"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "sectionHeading"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  vaem:todo "The namespaces for all referenced vocabularies are giving in the section on <a href=\"#ns\">Namespaces</a>. "^^xsd:string ;
  rdfs:label "Abstract section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:AbstractSubject
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:defaultValue "160px"^^xsd:string ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:labelWidth ;
      spl:valueType xsd:string ;
      rdfs:comment "The label width, defaults to 160px. Set to \"inline\" to have the preferred width, i.e. it will occupy exactly the needed space."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:hideIfEmpty ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to suppress this if the given subject has no value for the given predicate. Has no effect if we are not in view mode."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
      rdfs:comment "A label, overriding the default label."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:linear ;
      spl:valueType xsd:boolean ;
      rdfs:comment "By default (false), the label and the widget will be laid out in a tabular style, with all widgets nicely aligned underneath one another. If set to true, then no such alignment will happen. (In previous versions of SWA this was represented using arg:tabular)."^^xsd:string ;
    ] ;
  ui:abstract "true"^^xsd:boolean ;
  rdfs:comment "Similar to swa:AbstractObject but for the other direction."^^xsd:string ;
  rdfs:label "Abstract subject"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubjectElements ;
.
lmdoc:AllClasses
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            sp:varName "qName"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "class"^^xsd:string ;
          ]
          [
            sp:varName "qName"^^xsd:string ;
          ]
          [
            sp:varName "uri"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object rdfs:Class ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "type"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type xsd:string ;
                sp:arg1 [
                    sp:varName "class"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:qname ;
                sp:arg1 [
                    sp:varName "class"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "qName"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all classes defined in a given graph and orders them by label. Note this may (obviously) not scale if a class has too many instances."^^xsd:string ;
  rdfs:label "All classes"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllConstructors
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            sp:varName "property"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "ruleBody"^^xsd:string ;
          ]
          [
            sp:varName "ruleAsText"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object spin:constructor ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "ruleBody"^^xsd:string ;
              ] ;
            sp:predicate [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:subject [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:convertSPINRDFToString ;
                sp:arg1 [
                    sp:varName "ruleBody"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "ruleAsText"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all constructors defined in a given graph and orders them by step."^^xsd:string ;
  rdfs:label "All constructors"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllDocumentParts
  rdf:type spin:MagicProperty ;
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            sp:varName "i"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "ct"^^xsd:string ;
          ]
          [
            sp:varName "i"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "c"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:SeqPath ;
                sp:path1 [
                    rdf:type sp:SeqPath ;
                    sp:path1 ui:prototype ;
                    sp:path2 ui:child ;
                  ] ;
                sp:path2 ui:child ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            sp:object [
                sp:varName "i"^^xsd:string ;
              ] ;
            sp:predicate ui:childIndex ;
            sp:subject [
                sp:varName "c"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "ct"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "c"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object spin:_arg1 ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "ct"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all classes defined in a given graph and orders them by label. Note this may (obviously) not scale if a class has too many instances."^^xsd:string ;
  rdfs:label "All document parts"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllInstanceOfType
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            rdf:type ui:label ;
            sp:arg1 [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "instance"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:type ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:comment "Gets all instancesof a given type defined in a given graph and orders them by label. "^^xsd:string ;
  rdfs:label "All instances"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllInstanceTypes
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            rdf:type ui:label ;
            sp:arg1 [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "class"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "class"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object owl:Thing ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all the types of instances defined in a given graph and orders them by label. "^^xsd:string ;
  rdfs:label "All instances"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllInstances
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            sp:varName "qName"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "instance"^^xsd:string ;
          ]
          [
            sp:varName "qName"^^xsd:string ;
          ]
          [
            sp:varName "uri"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object owl:Thing ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "type"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type xsd:string ;
                sp:arg1 [
                    sp:varName "instance"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:qname ;
                sp:arg1 [
                    sp:varName "instance"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "qName"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all instances defined in a given graph and orders them by label. Note this may (obviously) not scale if a class has too many instances."^^xsd:string ;
  rdfs:label "All instances"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllOwners
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            sp:varName "owner"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "owner"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "owner"^^xsd:string ;
              ] ;
            sp:predicate vaem:owner ;
            sp:subject [
                sp:varName "resource"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all owners of a given graph."^^xsd:string ;
  rdfs:label "All owners"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllProperties
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            sp:varName "qName"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "qName"^^xsd:string ;
          ]
          [
            sp:varName "uri"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object rdf:Property ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "type"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type xsd:string ;
                sp:arg1 [
                    sp:varName "property"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:qname ;
                sp:arg1 [
                    sp:varName "property"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "qName"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all properties defined in a given graph and orders them by label. Note this may (obviously) not scale if a class has too many instances."^^xsd:string ;
  rdfs:label "All properties"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllRules
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            sp:varName "ruleProperty"^^xsd:string ;
          ]
          [
            sp:varName "stepText"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "ruleProperty"^^xsd:string ;
          ]
          [
            sp:varName "ruleBody"^^xsd:string ;
          ]
          [
            sp:varName "ruleAsText"^^xsd:string ;
          ]
          [
            sp:varName "stepText"^^xsd:string ;
          ]
          [
            sp:varName "ruleComment"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object spin:rule ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject [
                sp:varName "ruleProperty"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "ruleBody"^^xsd:string ;
              ] ;
            sp:predicate [
                sp:varName "ruleProperty"^^xsd:string ;
              ] ;
            sp:subject [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:convertSPINRDFToString ;
                sp:arg1 [
                    sp:varName "ruleBody"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "ruleAsText"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type lmdoc:ExtractStepTextFromRule ;
                arg:rule [
                    sp:varName "ruleBody"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "stepText"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type lmdoc:ExtractCommentTextFromRule ;
                arg:rule [
                    sp:varName "ruleBody"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "ruleComment"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all rules defined in a given graph and orders them by step."^^xsd:string ;
  rdfs:label "All rules"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AnyURILiteralViewer
  rdf:type swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:eq ;
          sp:arg1 [
              sp:varName "type"^^xsd:string ;
            ] ;
          sp:arg2 xsd:anyURI ;
        ] ;
      swa:weight 2 ;
    ] ;
  ui:overrides swa:AnyURILiteralViewer ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type html:Div ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              html:title [
                  sp:varName "title"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type xsd:string ;
                      sp:arg1 [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type fn:starts-with ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
              sp:arg2 "http" ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The LM Doc viewer for xsd:anyURI values: shows a hyperlink to the URI."^^xsd:string ;
  rdfs:label "AnyURI literal viewer"^^xsd:string ;
  rdfs:subClassOf swa:AnyURILiteralViewer ;
.
lmdoc:AskTemplates
  rdf:type spin:AskTemplate ;
  rdfs:label "Ask templates"^^xsd:string ;
  rdfs:subClassOf spin:AskTemplates ;
.
lmdoc:BuildMetadataRecord
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:graphName [
          rdf:type spif:regex ;
          sp:arg1 [
              rdf:type xsd:string ;
              sp:arg1 [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ] ;
          sp:arg2 ".*/([A-Za-z0-9-]+)$" ;
          sp:arg3 "$1" ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:metadataName [
              rdf:type fn:concat ;
              sp:arg1 "GMD_" ;
              sp:arg2 [
                  rdf:type fn:upper-case ;
                  sp:arg1 [
                      sp:varName "graphName"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              rdf:type html:P ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Make graph metadata "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text [
                      sp:varName "metadataName"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:transaction ;
              ui:child [
                  rdf:type ui:update ;
                  ui:childIndex 0 ;
                  ui:updateQuery [
                      rdf:type sp:Modify ;
                      sp:insertPattern (
                          [
                            rdf:type sp:NamedGraph ;
                            sp:elements (
                                [
                                  sp:object vaem:GraphMetaData ;
                                  sp:predicate rdf:type ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object [
                                      sp:varName "graphName"^^xsd:string ;
                                    ] ;
                                  sp:predicate vaem:name ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object [
                                      sp:varName "date"^^xsd:string ;
                                    ] ;
                                  sp:predicate dct:created ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object [
                                      sp:varName "date"^^xsd:string ;
                                    ] ;
                                  sp:predicate dct:modified ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object ""^^xsd:string ;
                                  sp:predicate dct:description ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object ""^^xsd:string ;
                                  sp:predicate dct:title ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object ""^^xsd:string ;
                                  sp:predicate dct:subject ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object ""^^xsd:string ;
                                  sp:predicate vaem:intent ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                  sp:predicate vaem:hasGraphMetadata ;
                                  sp:subject [
                                      sp:varName "graph"^^xsd:string ;
                                    ] ;
                                ]
                              ) ;
                            sp:graphNameNode [
                                sp:varName "graph"^^xsd:string ;
                              ] ;
                          ]
                        ) ;
                      sp:where (
                          [
                            rdf:type sp:Bind ;
                            sp:expression [
                                rdf:type sp:iri ;
                                sp:arg1 [
                                    rdf:type fn:concat ;
                                    sp:arg1 [
                                        rdf:type xsd:string ;
                                        sp:arg1 [
                                            sp:varName "graph"^^xsd:string ;
                                          ] ;
                                      ] ;
                                    sp:arg2 "/" ;
                                    sp:arg3 [
                                        sp:varName "metadataName"^^xsd:string ;
                                      ] ;
                                  ] ;
                              ] ;
                            sp:variable [
                                sp:varName "gmdU"^^xsd:string ;
                              ] ;
                          ]
                          [
                            rdf:type sp:Bind ;
                            sp:expression [
                                rdf:type afn:now ;
                              ] ;
                            sp:variable [
                                sp:varName "date"^^xsd:string ;
                              ] ;
                          ]
                        ) ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:subClassOf lmdoc:Factories ;
.
lmdoc:ClassInstances
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type ui:group ;
          letrs:instances [
              rdf:type sp:Select ;
              sp:orderBy (
                  [
                    rdf:type ui:label ;
                    sp:arg1 [
                        sp:varName "instance"^^xsd:string ;
                      ] ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "instance"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "class"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:type ;
                    sp:subject [
                        sp:varName "instance"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:Dd ;
                  ui:child [
                      rdf:type ui:forEach ;
                      ui:child [
                          rdf:type lmdoc:ResourceDocLink ;
                          arg:resource [
                              sp:varName "instance"^^xsd:string ;
                            ] ;
                          arg:title [
                              rdf:type xsd:string ;
                              sp:arg1 [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:resultSet [
                          sp:varName "instances"^^xsd:string ;
                        ] ;
                      ui:separator " | "^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:class "swa-sub-title"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Instances"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "instances"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue lmdoc:createLinkForMainForm ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Class Instances"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ClassesSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      ui:child [
          rdf:type ui:CommentNode ;
          ui:childIndex 1 ;
          rdfs:comment "div style=\"margin: 40px 0 25px 0;\"/"^^xsd:string ;
        ] ;
      ui:child [
          rdf:type ui:call ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:H2 ;
                  html:id [
                      rdf:type lmdoc:makeAnchorFromString ;
                      arg:label [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type ui:call ;
                      arg:subject [
                          sp:varName "class"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "lm-header-box"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:ResourceDocAnchor ;
                              arg:node [
                                  sp:varName "class"^^xsd:string ;
                                ] ;
                              arg:typeLabel "Class "^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:DetailedClassView ;
                          arg:class [
                              sp:varName "class"^^xsd:string ;
                            ] ;
                          arg:showInstances "true"^^xsd:boolean ;
                          arg:showTitle "false"^^xsd:boolean ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:VSpace ;
                          arg:margin "20px;"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:template [
                          rdf:type swa:modeProperty ;
                          arg:predicate swa:formObjectPredicateSelectionTemplate ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:VSpace ;
                      arg:margin "40px;"^^xsd:string ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "classes"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "classes"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:AllClasses ;
          ui:varName "classes"^^xsd:string ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment """<lmdoc:ObjectsGroup arg:filterFunction=\"swa:isAnnotationProperty\" arg:graph=\"{= ?graph }\" arg:label=\"Annotations\" arg:predicates=\"{= ?rs }\" arg:subject=\"{= ?class }\"/>
                        <lmdoc:VSpace arg:margin=\"30px;\"/>
                        <lmdoc:ObjectsGroup arg:filterFunction=\"swa:isNonAnnotationProperty\" arg:graph=\"{= ?graph }\" arg:label=\"Properties\" arg:predicates=\"{= ?rs }\" arg:subject=\"{= ?class }\"/>"""^^xsd:string ;
  rdfs:label "Classes section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:CopyrightSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:call ;
          arg:resource [
              sp:varName "resource"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:P ;
                  html:class "copyright"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text """Copyright ©2011-2015 
"""^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text """
   , All Rights Reserved.
"""^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:forEach ;
                      ui:child [
                          rdf:type html:Abbr ;
                          html:title [
                              sp:varName "owner"^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "owner"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                      ui:resultSet [
                          sp:varName "rs"^^xsd:string ;
                        ] ;
                      ui:separator ", "^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "rs"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
