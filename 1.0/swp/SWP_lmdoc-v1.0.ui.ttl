                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Graph Header"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
