                      ui:child [
                          rdf:type html:Hr ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          rdf:type html:P ;
                          html:class "lm-para"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Content not generated - test for introductory pieces and footer only"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:Section ;
                          html:class "informative"^^xsd:string ;
                          html:id "classes"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:ClassesSection ;
                              arg:graph [
                                  sp:varName "myGraph"^^xsd:string ;
                                ] ;
                              arg:sectionHeading "Classes"^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:childIndex 8 ;
                    ] ;
                  ui:child [
                      rdf:type html:Section ;
                      html:class "informative"^^xsd:string ;
                      html:id "overview-of-ontology"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:IndexSection ;
                          arg:graph [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                          arg:sectionHeading "Resource Index"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 4 ;
                    ] ;
                  ui:child [
                      rdf:type html:Section ;
                      html:class "introductory"^^xsd:string ;
                      html:id "abstract"^^xsd:string ;
                      html:property "dct:abstract"^^xsd:string ;
                      html:rel "bibo:Chapter"^^xsd:string ;
                      html:resource "#ref"^^xsd:string ;
                      html:typeof "bibo:Chapter"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:AbstractSection ;
                          arg:metadata [
                              sp:varName "myGraphMetadata"^^xsd:string ;
                            ] ;
                          arg:sectionHeading "Abstract"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Section ;
                      html:id "namespaces-1"^^xsd:string ;
                      html:rel "bibo:Chapter"^^xsd:string ;
                      html:resource "#ref"^^xsd:string ;
                      html:typeof "bibo:Chapter"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:ImportedNamespaces ;
                          arg:graph [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                          arg:sectionHeading "Imported Graphs"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 5 ;
                    ] ;
                  ui:child [
                      rdf:type html:Section ;
                      html:id "non-imported-myGraphMetadatas"^^xsd:string ;
                      html:rel "bibo:Chapter"^^xsd:string ;
                      html:resource "#ref"^^xsd:string ;
                      html:typeof "bibo:Chapter"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:NonImportedResources ;
                          arg:metadata [
                              sp:varName "myGraphMetadata"^^xsd:string ;
                            ] ;
                          arg:sectionHeading "Non-imported Resources"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 6 ;
                    ] ;
                  ui:child [
                      rdf:type html:Section ;
                      html:id "toc"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:TableOfContents ;
                          arg:sectionHeading "Table of Contents"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:GraphHeader ;
                      arg:resource [
                          sp:varName "myGraphMetadata"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:queryGraph [
                  rdf:type ui:unionOfGraphs ;
                  sp:arg1 [
                      rdf:type ui:graphWithImports ;
                      sp:arg1 [
                          sp:varName "myGraph"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 [
                      rdf:type ui:graphWithImports ;
                      sp:arg1 <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:varName "graph"^^xsd:string ;
          ui:varValue [
              sp:varName "myGraph"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  vaem:todo "remove dependency on swa.css"^^xsd:string ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=lmdoc:GraphTest&graph=http://www.linkedmodel.org/2.0/schema/vaem"""^^xsd:string ;
  rdfs:label "Graph Documentation"^^xsd:string ;
  rdfs:subClassOf lmdoc:Pages ;
.
lmdoc:ImageResourceViewer
  rdf:type swa:ObjectViewerClass ;
  ui:overrides swa:ImageResourceViewer ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      let:myImage [
          sp:varName "object"^^xsd:string ;
        ] ;
      ui:child [
          rdf:type html:A ;
          html:href [
              sp:varName "myImage"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type html:Img ;
              html:src [
                  sp:varName "myImage"^^xsd:string ;
                ] ;
              html:width "100px;"^^xsd:string ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "The LM Doc viewer for URI resources that appear to be images, judged by their file extension."^^xsd:string ;
  rdfs:label "Image resource viewer"^^xsd:string ;
  rdfs:subClassOf swa:ImageResourceViewer ;
.
lmdoc:ImportedNamespaces
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:ns [
          rdf:type spl:object ;
          sp:arg1 [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "graph"^^xsd:string ;
                ] ;
              sp:arg2 vaem:hasGraphMetadata ;
            ] ;
          sp:arg2 vaem:namespace ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          letrs:imports [
              rdf:type sp:Select ;
              sp:orderBy (
                  [
                    sp:varName "importedGraph"^^xsd:string ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "importedGraph"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    rdf:type sp:NamedGraph ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "importedGraph"^^xsd:string ;
                            ] ;
                          sp:predicate owl:imports ;
                          sp:subject [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                    sp:graphNameNode [
                        sp:varName "graph"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type html:P ;
                  html:class "lm-para"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "None"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:H2 ;
                  html:id [
                      rdf:type lmdoc:makeAnchorFromString ;
                      arg:label [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  html:class "lm-para"^^xsd:string ;
                  ui:child [
                      rdf:type html:Code ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "ns"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "The namespace for this graph is "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text """. 
A full set of alphabetically ordered imported graphs is shown in the table below."""^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "lm-table"^^xsd:string ;
                  ui:child [
                      rdf:type html:Tbody ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Tr ;
                              html:class "lm-row"^^xsd:string ;
                              ui:child [
                                  rdf:type html:Td ;
                                  html:class "lm-column"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          rdf:type xsd:string ;
                                          sp:arg1 [
                                              sp:varName "importedGraph"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "imports"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      html:class "lm-table-header"^^xsd:string ;
                      ui:child [
                          rdf:type html:Tr ;
                          html:class "lm-row"^^xsd:string ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Base URI"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "imports"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Imported Namespaces"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:IndexSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:ns [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "myGraphMetadata"^^xsd:string ;
                ] ;
              sp:arg2 vaem:namespace ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:style "margin: 40px 0 25px 0;"^^xsd:string ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:style "margin: 40px 0 25px 0;"^^xsd:string ;
              ui:childIndex 4 ;
            ] ;
          ui:child [
              rdf:type html:H2 ;
              html:id [
                  rdf:type lmdoc:makeAnchorFromString ;
                  arg:label [
                      sp:varName "sectionHeading"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "sectionHeading"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              arg:graph [
                  sp:varName "graph"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type lmdoc:ResourceDocLink ;
                              arg:resource [
                                  sp:varName "class"^^xsd:string ;
                                ] ;
                              arg:title [
                                  rdf:type lmdoc:getDescription ;
                                  arg:resource [
                                      sp:varName "class"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "classes"^^xsd:string ;
                            ] ;
                          ui:separator " | "^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Classes:"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "classes"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
              ui:template lmdoc:AllClasses ;
              ui:varName "classes"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              arg:graph [
                  sp:varName "graph"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type lmdoc:ResourceDocLink ;
                              arg:resource [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              arg:title [
                                  rdf:type lmdoc:getDescription ;
                                  arg:resource [
                                      sp:varName "instance"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "instances"^^xsd:string ;
                            ] ;
                          ui:separator " | "^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Instances:"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "instances"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 5 ;
              ui:template lmdoc:AllInstances ;
              ui:varName "instances"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              arg:graph [
                  sp:varName "graph"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type lmdoc:ResourceDocLink ;
                              arg:resource [
                                  sp:varName "property"^^xsd:string ;
                                ] ;
                              arg:title [
                                  rdf:type lmdoc:getDescription ;
                                  arg:resource [
                                      sp:varName "property"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "properties"^^xsd:string ;
                            ] ;
                          ui:separator " | "^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Properties:"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "properties"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 3 ;
              ui:template lmdoc:AllProperties ;
              ui:varName "properties"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Index section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:InheritanceTable
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resourceSet ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type html:Table ;
          html:class "lm-table"^^xsd:string ;
          ui:child [
              rdf:type html:Tbody ;
              html:class "lm-table"^^xsd:string ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type html:Tr ;
                      html:class "lm-row"^^xsd:string ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column"^^xsd:string ;
                          ui:child [
                              rdf:type html:B ;
                              ui:child [
                                  rdf:type swa:Link ;
                                  arg:resource [
                                      sp:varName "super"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "depth"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 3 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:URIResourceViewer ;
                              arg:object [
                                  sp:varName "super"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 2 ;
                          ui:text """ 
            """^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:resultSet [
                      sp:varName "resourceSet"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Thead ;
              html:class "lm-table-header"^^xsd:string ;
              ui:child [
                  rdf:type html:Tr ;
                  html:class "lm-row"^^xsd:string ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Depth"^^xsd:string ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "QName"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Superclass"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue lmdoc:createLinkForMainForm ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Inheritance table"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:InstancesSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:style "margin: 40px 0 25px 0;"^^xsd:string ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:call ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:H2 ;
                  html:id [
                      rdf:type lmdoc:makeAnchorFromString ;
                      arg:label [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type ui:call ;
                      arg:subject [
                          sp:varName "instance"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "lm-header-box"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:ResourceDocAnchor ;
                              arg:node [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              arg:typeLabel "Instance "^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "lm-resource-box"^^xsd:string ;
                          ui:child [
                              rdf:type html:Dd ;
                              html:class "size-14"^^xsd:string ;
                              ui:child [
                                  rdf:type lmdoc:ObjectsBody ;
                                  arg:predicate rdf:type ;
                                  arg:subject [
                                      sp:varName "instance"^^xsd:string ;
                                    ] ;
                                  ui:args "*"^^xsd:string ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type html:Div ;
                              html:class "swa-sub-title"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Description"^^xsd:string ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type html:Div ;
                              html:class "swa-sub-title"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Type"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:MaybeDescription ;
                              arg:node [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 4 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isAnnotationProperty ;
                              arg:label "Annotations"^^xsd:string ;
                              arg:predicates [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 8 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isNonAnnotationProperty ;
                              arg:label "Properties"^^xsd:string ;
                              arg:predicates [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 6 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ResourceFooter ;
                              arg:options "CSV,JSONLD,RDF,TURTLE"^^xsd:string ;
                              arg:resource [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 10 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "30px;"^^xsd:string ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "30px;"^^xsd:string ;
                              ui:childIndex 5 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "30px;"^^xsd:string ;
                              ui:childIndex 7 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "40px;"^^xsd:string ;
                              ui:childIndex 9 ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:VSpace ;
                          arg:margin "20px;"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:template [
                          rdf:type swa:modeProperty ;
                          arg:predicate swa:formObjectPredicateSelectionTemplate ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:VSpace ;
                      arg:margin "40px;"^^xsd:string ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "instances"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "instances"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:AllInstances ;
          ui:varName "instances"^^xsd:string ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Instances section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:IsDefinedInGraph
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Ask ;
      sp:where (
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:bound ;
                sp:arg1 [
                    sp:varName "graph"^^xsd:string ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                  sp:predicate rdfs:isDefinedBy ;
                  sp:subject [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "Is defined in graph"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:Label
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      rdfs:comment "The RDF node to display."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:class "lm_iri_resource"^^xsd:string ;
              ui:child [
                  rdf:type html:Div ;
                  html:class "lm_hidden_resource_content"^^xsd:string ;
                  ui:child [
                      rdf:type lmdoc:PopUpResourceView ;
                      arg:resource [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  html:class "lm_table_hyperlink_surrogate"^^xsd:string ;
                  ui:child [
                      rdf:type html:U ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              rdf:type smf:qname ;
                              sp:arg1 [
                                  sp:varName "node"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
          ui:condition [
              rdf:type sp:isIRI ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type html:Span ;
                  html:class "tuiLabel"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type ui:label ;
                          sp:arg1 [
                              sp:varName "node"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:A ;
                  html:href [
                      sp:varName "node"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:eq ;
                  sp:arg1 xsd:anyURI ;
                  sp:arg2 [
                      rdf:type sp:datatype ;
                      sp:arg1 [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:isLiteral ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:resourceView ;
              ui:childIndex 0 ;
              ui:matchIds "label"^^xsd:string ;
              ui:resource [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 2 ;
          ui:condition [
              rdf:type sp:isBlank ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Displays an arbitrary RDF node. If the node is a resource, then this will use the configured resource display with id=\"label\" (e.g., the tui:Link). Literals of type xsd:anyURI are turned into hyperlinks. All other literals will be rendered as a simple text node with CSS class tuiLabel, with the text derived using ui:label()."^^xsd:string ;
  rdfs:label "Label"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:LabelList
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resultSet ;
      spl:valueType sp:Select ;
      rdfs:comment "The SELECT query delivering the nodes to display in its first column."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:forEach ;
      ui:child [
          rdf:type lmdoc:Label ;
          arg:node [
              sp:varName "node"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:indexVar "index"^^xsd:string ;
      ui:resultSet [
          rdf:type sp:Select ;
          sp:resultVariables (
              [
                sp:varName "node"^^xsd:string ;
              ]
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "resultSet"^^xsd:string ;
                  ] ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object 0 ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object () ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "node"^^xsd:string ;
                  ] ;
                sp:predicate spr:colCells ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
            ) ;
        ] ;
      ui:separator ", "^^xsd:string ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A comma-separated list of values from a given result set. The individual values will be rendered into lmdoc:Labels."^^xsd:string ;
  rdfs:label "Label list"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:LabeledObjects
  rdf:type ui:NodeClass ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Tr ;
          html:class "lm-row"^^xsd:string ;
          ui:child [
              rdf:type html:Td ;
              html:class "lm-column align-top"^^xsd:string ;
              ui:child [
                  rdf:type lmdoc:URIResourceViewer ;
                  arg:label [
                      rdf:type sp:if ;
                      sp:arg1 [
                          rdf:type sp:bound ;
                          sp:arg1 [
                              sp:varName "label"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          sp:varName "label"^^xsd:string ;
                        ] ;
                      sp:arg3 [
                          rdf:type ui:label ;
                          sp:arg1 [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  arg:object [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:Td ;
              html:class "lm-column"^^xsd:string ;
              html:id [
                  rdf:type ui:concat ;
                  sp:arg1 [
                      sp:varName "pid"^^xsd:string ;
                    ] ;
                  sp:arg2 "-body"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type lmdoc:ObjectsBody ;
                      ui:args "*"^^xsd:string ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "viewWidget"^^xsd:string ;
                  ui:varValue [
                      sp:varName "viewWidget"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Labeled objects"^^xsd:string ;
  rdfs:subClassOf swa:Objects ;
.
lmdoc:Link
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate lmdoc:optionalLinkArgs ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Span ;
      html:class "tuiLink"^^xsd:string ;
      ui:child [
          rdf:type ui:createLink ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  rdf:type fn:concat ;
                  sp:arg1 [
                      sp:varName "link"^^xsd:string ;
                    ] ;
                  sp:arg2 "&" ;
                  sp:arg3 [
                      sp:varName "optionalLinkArgs"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:resource [
              sp:varName "node"^^xsd:string ;
            ] ;
          ui:sendQueryGraph "true"^^xsd:boolean ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A hyperlink to a resource, using the display label of the resource as text. Additional arguments may be passed in 'lmdoc:optionalArgs' for the rest call."^^xsd:string ;
  rdfs:label "Link"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:LiteralViewer
  rdf:type swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:eq ;
          sp:arg1 [
              sp:varName "kind"^^xsd:string ;
            ] ;
          sp:arg2 "literal" ;
        ] ;
      swa:weight 50 ;
    ] ;
  ui:overrides swa:LiteralViewer ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type html:Div ;
      html:class "swa-shifted-label"^^xsd:string ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "object"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type swa:LangDisplay ;
                  arg:lang [
                      rdf:type sp:lang ;
                      sp:arg1 [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
              ui:condition [
                  rdf:type sp:ne ;
                  sp:arg1 [
                      rdf:type sp:lang ;
                      sp:arg1 [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 "" ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type fn:starts-with ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
              sp:arg2 "http" ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A node viewer for literal values, displaying the literal's text. If a language tag is present, then this will be displayed behind the text."^^xsd:string ;
  rdfs:label "Literal viewer"^^xsd:string ;
  rdfs:subClassOf swa:LiteralViewer ;
.
lmdoc:MagicProperties
  rdf:type spin:MagicProperty ;
  rdfs:label "Magic properties"^^xsd:string ;
  rdfs:subClassOf spin:MagicProperties ;
.
lmdoc:MaybeDescription
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type lmdoc:MaybeDescriptionUsingProperty ;
          arg:node [
              sp:varName "node"^^xsd:string ;
            ] ;
          arg:property dct:description ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type lmdoc:MaybeDescriptionUsingProperty ;
          arg:node [
              sp:varName "node"^^xsd:string ;
            ] ;
          arg:property rdfs:comment ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type lmdoc:MaybeHTMLstring ;
          arg:node [
              sp:varName "node"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Maybe Description"^^xsd:string ;
  rdfs:label "Maybe Description"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:MaybeDescriptionUsingProperty
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:desc [
          rdf:type sp:coalesce ;
          sp:arg1 [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
              sp:arg2 [
                  sp:varName "property"^^xsd:string ;
                ] ;
            ] ;
          sp:arg2 "Nothing" ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "desc"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:ne ;
              sp:arg1 [
                  sp:varName "desc"^^xsd:string ;
                ] ;
              sp:arg2 "Nothing" ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Maybe Description using property"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:MaybeHTMLstring
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:desc [
          rdf:type sp:coalesce ;
          sp:arg1 [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
              sp:arg2 lmdoc:htmlString ;
            ] ;
          sp:arg2 [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
              sp:arg2 vaem:description ;
            ] ;
          sp:arg3 [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
              sp:arg2 lmdoc:htmlString ;
            ] ;
          sp:arg4 "Nothing" ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              ui:child [
                  rdf:type ui:parse ;
                  ui:childIndex 0 ;
                  ui:str [
                      sp:varName "desc"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:ne ;
              sp:arg1 [
                  sp:varName "desc"^^xsd:string ;
                ] ;
              sp:arg2 "Nothing" ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Maybe an HTML string"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:MyBNodeViewer
  rdf:type swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:eq ;
          sp:arg1 [
              sp:varName "kind"^^xsd:string ;
            ] ;
          sp:arg2 "blank" ;
        ] ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type html:Div ;
      html:class "swa-shifted-label"^^xsd:string ;
      ui:child [
          rdf:type html:Pre ;
          html:class "query"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  rdf:type ui:label ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type ui:CommentNode ;
          ui:childIndex 1 ;
          rdfs:comment "ui:resourceView ui:matchIds=\"showbnode\" ui:resource=\"{= ?object }\"/"^^xsd:string ;
        ] ;
    ] ;
  rdfs:comment "My object viewer for blank nodes."^^xsd:string ;
  rdfs:label "BNode viewer"^^xsd:string ;
  rdfs:subClassOf swa:BNodeViewer ;
.
lmdoc:NonImportedResources
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:metadata ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:ns [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "metadata"^^xsd:string ;
            ] ;
          sp:arg2 vaem:namespace ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          letrs:nonImportedResources [
              rdf:type sp:Select ;
              sp:orderBy (
                  [
                    sp:varName "qname"^^xsd:string ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "usedResource"^^xsd:string ;
                  ]
                  [
                    sp:varName "qname"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "usedResource"^^xsd:string ;
                      ] ;
                    sp:predicate vaem:usesNonImportedResource ;
                    sp:subject [
                        sp:varName "metadata"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        rdf:type smf:qname ;
                        sp:arg1 [
                            sp:varName "usedResource"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:variable [
                        sp:varName "qname"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:Dd ;
                  ui:child [
                      rdf:type ui:forEach ;
                      ui:child [
                          rdf:type lmdoc:ResourceLink ;
                          arg:resource [
                              sp:varName "usedResource"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:resultSet [
                          sp:varName "nonImportedResources"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  rdf:type html:Dt ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type html:H2 ;
                  html:id [
                      rdf:type lmdoc:makeAnchorFromString ;
                      arg:label [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  html:class "lm-para"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "The graph uses resources from other graphs that are not imported, as listed below:"^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "nonImportedResources"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:separator " | "^^xsd:string ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "non-imported resources"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:ObjectElements
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:elementId ;
      spl:valueType xsd:string ;
      rdfs:comment "An optional HTML ID for the element containing this object."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The subject resource of the form or widget. May be left empty in which case the subjectType will be used."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicate ;
      spl:valueType rdf:Property ;
      rdfs:comment "The predicate."^^xsd:string ;
    ] ;
  rdfs:subClassOf lmdoc:ViewElements ;
.
lmdoc:ObjectViewer
  rdf:type swa:ObjectViewerClass ;
  ui:overrides swa:ObjectViewer ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type html:Div ;
      html:class "swa-object-widget"^^xsd:string ;
      let:class [
          rdf:type sp:coalesce ;
          sp:arg1 [
              rdf:type ui:contextValue ;
              sp:arg1 "viewWidget" ;
            ] ;
          sp:arg2 [
              rdf:type swa:bestObjectViewerClass ;
              arg:object [
                  sp:varName "object"^^xsd:string ;
                ] ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "subject"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "[Error: no ObjectViewer found for "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text ", "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 3 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "predicate"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 4 ;
                  ui:text ", "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 5 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 6 ;
                  ui:text "]"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:CommentNode ;
              ui:childIndex 0 ;
              rdfs:comment "p>In lmdoc:ObjectViewer with class {= ?class }</p"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:dynamicView ;
              arg:object [
                  sp:varName "object"^^xsd:string ;
                ] ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "subject"^^xsd:string ;
                ] ;
              ui:childIndex 1 ;
              ui:class [
                  sp:varName "class"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "class"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment """A read-only widget displaying a single object. In order to be selected on forms, subclasses of this class must specify a weight > 0 and an expression that returns true for the given input variable bindings:
- ?type: the datatype or rdf:type of the object being displayed
- ?kind: \"literal\", \"blank\", \"uri\" or \"image\"
- ?predicate: the property being displayed"""^^xsd:string ;
  rdfs:label "Object viewer"^^xsd:string ;
  rdfs:subClassOf swa:ObjectViewer ;
  rdfs:subClassOf lmdoc:ObjectElements ;
.
lmdoc:ObjectWidgetRow
  rdf:type swa:ObjectWidgetRowClass ;
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:object ;
      rdfs:comment "The object node."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:dynamicView ;
          arg:object [
              sp:varName "object"^^xsd:string ;
            ] ;
          arg:predicate [
              sp:varName "predicate"^^xsd:string ;
            ] ;
          arg:subject [
              sp:varName "subject"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
          ui:class lmdoc:ObjectViewer ;
        ] ;
    ] ;
  rdfs:comment "Superclass for the widget row types."^^xsd:string ;
  rdfs:label "Object widget row"^^xsd:string ;
  rdfs:subClassOf lmdoc:ObjectElements ;
.
lmdoc:Objects
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:tabular ;
      spl:valueType xsd:boolean ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:function [
          rdf:type swa:modeProperty ;
          arg:predicate swa:isSingleFunction ;
        ] ;
      ui:child [
          rdf:type lmdoc:LabeledObjects ;
          arg:single [
              rdf:type sp:if ;
              sp:arg1 [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "function"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type spif:invoke ;
                  sp:arg1 [
                      sp:varName "function"^^xsd:string ;
                    ] ;
                  sp:arg2 [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  sp:arg3 [
                      sp:varName "subject"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg3 [
                  rdf:type swa:modeProperty ;
                  arg:predicate swa:isSingleConstant ;
                ] ;
            ] ;
          ui:args "*"^^xsd:string ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "A two-columned structure with a label on the left and zero or more objects on the right."^^xsd:string ;
  rdfs:label "Objects"^^xsd:string ;
  rdfs:subClassOf swa:AbstractObject ;
.
lmdoc:ObjectsBody
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:offset ;
      spl:valueType xsd:integer ;
      rdfs:comment "The offset for the \"next 50\" recursive calls."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to allow at most one value."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-object-row"^^xsd:string ;
              ui:child [
                  rdf:type swa:ObjectWidgetRow ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:call ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "subject"^^xsd:string ;
                ] ;
              let:special [
                  rdf:type swa:specialAddButtonFunction ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  arg:subject [
                      sp:varName "subject"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:else ;
                  ui:child [
                      rdf:type ui:group ;
                      let:limit 50 ;
                      let:offset [
                          rdf:type sp:coalesce ;
                          sp:arg1 [
                              sp:varName "offset"^^xsd:string ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Div ;
                              html:class "swa-object-row"^^xsd:string ;
                              ui:child [
                                  rdf:type lmdoc:ObjectWidgetRow ;
                                  arg:object [
                                      sp:varName "object"^^xsd:string ;
                                    ] ;
                                  arg:predicate [
                                      sp:varName "predicate"^^xsd:string ;
                                    ] ;
                                  arg:subject [
                                      sp:varName "subject"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:limit [
                              sp:varName "limit"^^xsd:string ;
                            ] ;
                          ui:offset [
                              sp:varName "offset"^^xsd:string ;
                            ] ;
                          ui:resultSet [
                              sp:varName "rs"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:group ;
                          let:id [
                              rdf:type ui:uniqueId ;
                            ] ;
                          let:rowCount [
                              rdf:type spr:rowCount ;
                              sp:arg1 [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:child [
                              rdf:type ui:loadable ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type ui:else ;
                                      ui:child [
                                          rdf:type html:Div ;
                                          html:class "swa-objects-show-more"^^xsd:string ;
                                          ui:child [
                                              rdf:type html:A ;
                                              html:href "javascript:void(0)"^^xsd:string ;
                                              html:onclick [
                                                  rdf:type ui:concat ;
                                                  sp:arg1 "swa.load('"^^xsd:string ;
                                                  sp:arg2 [
                                                      sp:varName "id"^^xsd:string ;
                                                    ] ;
                                                  sp:arg3 "', { newOffset: "^^xsd:string ;
                                                  sp:arg4 [
                                                      rdf:type sp:add ;
                                                      sp:arg1 [
                                                          sp:varName "offset"^^xsd:string ;
                                                        ] ;
                                                      sp:arg2 [
                                                          sp:varName "limit"^^xsd:string ;
                                                        ] ;
                                                    ] ;
                                                  sp:arg5 " })"^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text "Show entries "^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 1 ;
                                                  ui:text [
                                                      rdf:type sp:add ;
                                                      sp:arg1 [
                                                          rdf:type sp:add ;
                                                          sp:arg1 [
                                                              sp:varName "offset"^^xsd:string ;
                                                            ] ;
                                                          sp:arg2 [
                                                              sp:varName "limit"^^xsd:string ;
                                                            ] ;
                                                        ] ;
                                                      sp:arg2 1 ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 2 ;
                                                  ui:text " to "^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 3 ;
                                                  ui:text [
                                                      rdf:type spl:min ;
                                                      sp:arg1 [
                                                          sp:varName "rowCount"^^xsd:string ;
                                                        ] ;
                                                      sp:arg2 [
                                                          rdf:type sp:add ;
                                                          sp:arg1 [
                                                              rdf:type sp:add ;
                                                              sp:arg1 [
                                                                  sp:varName "offset"^^xsd:string ;
                                                                ] ;
                                                              sp:arg2 [
                                                                  sp:varName "limit"^^xsd:string ;
                                                                ] ;
                                                            ] ;
                                                          sp:arg2 [
                                                              sp:varName "limit"^^xsd:string ;
                                                            ] ;
                                                        ] ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 4 ;
                                                  ui:text " of "^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 5 ;
                                                  ui:text [
                                                      sp:varName "rowCount"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:if ;
                                      ui:child [
                                          rdf:type lmdoc:ObjectsBody ;
                                          arg:offset [
                                              sp:varName "newOffset"^^xsd:string ;
                                            ] ;
                                          ui:args "*"^^xsd:string ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                      ui:condition [
                                          rdf:type sp:bound ;
                                          sp:arg1 [
                                              sp:varName "newOffset"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:condition [
                                      rdf:type sp:gt ;
                                      sp:arg1 [
                                          sp:varName "rowCount"^^xsd:string ;
                                        ] ;
                                      sp:arg2 [
                                          rdf:type sp:add ;
                                          sp:arg1 [
                                              sp:varName "offset"^^xsd:string ;
                                            ] ;
                                          sp:arg2 [
                                              sp:varName "limit"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:loadId [
                                  sp:varName "id"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:ObjectWidgetRow ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          arg:subject [
                              sp:varName "subject"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:and ;
                      sp:arg1 [
                          rdf:type sp:and ;
                          sp:arg1 [
                              rdf:type sp:and ;
                              sp:arg1 [
                                  rdf:type spr:isEmpty ;
                                  sp:arg1 [
                                      sp:varName "rs"^^xsd:string ;
                                    ] ;
                                ] ;
                              sp:arg2 [
                                  rdf:type sp:not ;
                                  sp:arg1 [
                                      rdf:type swa:isViewMode ;
                                    ] ;
                                ] ;
                            ] ;
                          sp:arg2 [
                              rdf:type sp:not ;
                              sp:arg1 [
                                  rdf:type sp:bound ;
                                  sp:arg1 [
                                      sp:varName "special"^^xsd:string ;
                                    ] ;
                                ] ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          rdf:type sp:not ;
                          sp:arg1 [
                              rdf:type swa:isBlankNodeProperty ;
                              arg:property [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template swa:SortedObjects ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "subject"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The body of an Object(s) widget, typically containing one row for each value. This can be \"overloaded\" via a mode property."^^xsd:string ;
  rdfs:label "Objects body"^^xsd:string ;
  rdfs:subClassOf lmdoc:ObjectElements ;
.
lmdoc:ObjectsGroup
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:filterFunction ;
      spl:valueType spin:Function ;
      rdfs:comment "An optional filter function that takes a predicate and a subject as arguments and returns true for all predicates that should be displayed."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicates ;
      spl:valueType sp:Select ;
      rdfs:comment "A result set (e.g., SPARQL SELECT query) that delivers the predicates in this group."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The resource to display."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      letrs:rs [
          rdf:type sp:Select ;
          sp:resultVariables (
              [
                sp:varName "predicate"^^xsd:string ;
              ]
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "predicates"^^xsd:string ;
                  ] ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object 0 ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object () ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "predicate"^^xsd:string ;
                  ] ;
                sp:predicate spr:colCells ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                rdf:type sp:Filter ;
                sp:expression [
                    rdf:type sp:or ;
                    sp:arg1 [
                        rdf:type sp:not ;
                        sp:arg1 [
                            rdf:type sp:bound ;
                            sp:arg1 [
                                sp:varName "filterFunction"^^xsd:string ;
                              ] ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        rdf:type spif:invoke ;
                        sp:arg1 [
                            sp:varName "filterFunction"^^xsd:string ;
                          ] ;
                        sp:arg2 [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                        sp:arg3 [
                            sp:varName "subject"^^xsd:string ;
                          ] ;
                      ] ;
                  ] ;
              ]
              [
                rdf:type sp:Filter ;
                sp:expression [
                    rdf:type sp:not ;
                    sp:arg1 [
                        rdf:type swa:isHiddenPropertyAtSubject ;
                        arg:property [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                        arg:subject [
                            sp:varName "subject"^^xsd:string ;
                          ] ;
                      ] ;
                  ] ;
              ]
            ) ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "lm-table"^^xsd:string ;
                  let:pid [
                      rdf:type ui:uniqueId ;
                    ] ;
                  ui:child [
                      rdf:type html:Tbody ;
                      html:class "lm-table-body"^^xsd:string ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type lmdoc:Objects ;
                              arg:predicate [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "subject"^^xsd:string ;
                                ] ;
                              arg:tabular "true"^^xsd:boolean ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "rs"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      html:class "lm-table-header"^^xsd:string ;
                      ui:child [
                          rdf:type html:Th ;
                          html:class "lm-column-labels"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Values"^^xsd:string ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Th ;
                          html:class "lm-column-labels"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "label"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-sub-title"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "label"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:bound ;
                      sp:arg1 [
                          sp:varName "label"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:gt ;
              sp:arg1 [
                  rdf:type spr:rowCount ;
                  sp:arg1 [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A group of lmdoc:Objects elements where the predicates are computed by taking a result set (e.g. of all relevant properties) and applying a filter on top of it, e.g. to only show the annotation properties among those that are relevant."^^xsd:string ;
  rdfs:label "Objects group"^^xsd:string ;
  rdfs:subClassOf swa:ObjectsGroup ;
.
lmdoc:Pages
  rdf:type ui:NodeClass ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:Panes
  rdf:type ui:NodeClass ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:PopUpResourceView
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "curation graph"^^xsd:string ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "PopUp Resource view"^^xsd:string ;
  rdfs:subClassOf lmdoc:Panes ;
.
lmdoc:PropertiesSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:style "margin: 40px 0 25px 0;"^^xsd:string ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:call ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:H2 ;
                  html:id [
                      rdf:type lmdoc:makeAnchorFromString ;
                      arg:label [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type ui:call ;
                      arg:subject [
                          sp:varName "property"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "lm-header-box"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:ResourceDocAnchor ;
                              arg:node [
                                  sp:varName "property"^^xsd:string ;
                                ] ;
                              arg:typeLabel "Property "^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "lm-resource-box"^^xsd:string ;
                          ui:child [
                              rdf:type html:Div ;
                              html:class "swa-sub-title"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Description"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:MaybeDescription ;
                              arg:node [
                                  sp:varName "property"^^xsd:string ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isAnnotationProperty ;
                              arg:label "Annotations"^^xsd:string ;
                              arg:predicates [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "property"^^xsd:string ;
                                ] ;
                              ui:childIndex 5 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isNonAnnotationProperty ;
                              arg:label "Properties"^^xsd:string ;
                              arg:predicates [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "property"^^xsd:string ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ResourceFooter ;
                              arg:options "JSONLD,RDF,TURTLE"^^xsd:string ;
                              arg:resource [
                                  sp:varName "property"^^xsd:string ;
                                ] ;
                              ui:childIndex 7 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "30px;"^^xsd:string ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "30px;"^^xsd:string ;
                              ui:childIndex 4 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "40px;"^^xsd:string ;
                              ui:childIndex 6 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:template [
                          rdf:type swa:modeProperty ;
                          arg:predicate swa:formObjectPredicateSelectionTemplate ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:VSpace ;
                      arg:margin "40px;"^^xsd:string ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "properties"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "properties"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:AllProperties ;
          ui:varName "properties"^^xsd:string ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Properties section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:PropertiesTable
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:propertySet ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Table ;
          html:class "lm-table"^^xsd:string ;
          ui:child [
              rdf:type html:Tbody ;
              html:class "lm-table-body"^^xsd:string ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type html:Tr ;
                      html:class "lm-row"^^xsd:string ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column align-top"^^xsd:string ;
                          ui:child [
                              rdf:type html:B ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      rdf:type ui:label ;
                                      sp:arg1 [
                                          sp:varName "property"^^xsd:string ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column align-top"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:URIResourceViewer ;
                              arg:object [
                                  sp:varName "property"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column"^^xsd:string ;
                          ui:child [
                              rdf:type ui:forEach ;
                              ui:child [
                                  rdf:type lmdoc:Label ;
                                  arg:node [
                                      sp:varName "type"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:resultSet [
                                  rdf:type sp:Select ;
                                  sp:orderBy (
                                      [
                                        rdf:type ui:label ;
                                        sp:arg1 [
                                            sp:varName "type"^^xsd:string ;
                                          ] ;
                                      ]
                                    ) ;
                                  sp:resultVariables (
                                      [
                                        sp:varName "type"^^xsd:string ;
                                      ]
                                    ) ;
                                  sp:where (
                                      [
                                        sp:object [
                                            sp:varName "type"^^xsd:string ;
                                          ] ;
                                        sp:predicate rdf:type ;
                                        sp:subject [
                                            sp:varName "property"^^xsd:string ;
                                          ] ;
                                      ]
                                    ) ;
                                ] ;
                              ui:separator ", "^^xsd:string ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column"^^xsd:string ;
                          ui:child [
                              rdf:type ui:group ;
                              letrs:myCardinalities [
                                  rdf:type sp:Select ;
                                  sp:resultVariables (
                                      [
                                        sp:varName "min"^^xsd:string ;
                                      ]
                                      [
                                        sp:varName "max"^^xsd:string ;
                                      ]
                                    ) ;
                                  sp:where (
                                      [
                                        rdf:type sp:Bind ;
                                        sp:expression [
                                            rdf:type smf:minCardinality ;
                                            sp:arg1 [
                                                sp:varName "class"^^xsd:string ;
                                              ] ;
                                            sp:arg2 [
                                                sp:varName "property"^^xsd:string ;
                                              ] ;
                                          ] ;
                                        sp:variable [
                                            sp:varName "min"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        rdf:type sp:Bind ;
                                        sp:expression [
                                            rdf:type smf:maxCardinality ;
                                            sp:arg1 [
                                                sp:varName "class"^^xsd:string ;
                                              ] ;
                                            sp:arg2 [
                                                sp:varName "property"^^xsd:string ;
                                              ] ;
                                          ] ;
                                        sp:variable [
                                            sp:varName "max"^^xsd:string ;
                                          ] ;
                                      ]
                                    ) ;
                                ] ;
                              ui:child [
                                  rdf:type ui:forEach ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "["^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 1 ;
                                      ui:text [
                                          rdf:type sp:if ;
                                          sp:arg1 [
                                              rdf:type sp:bound ;
                                              sp:arg1 [
                                                  sp:varName "min"^^xsd:string ;
                                                ] ;
                                            ] ;
                                          sp:arg2 [
                                              sp:varName "min"^^xsd:string ;
                                            ] ;
                                          sp:arg3 0 ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 2 ;
                                      ui:text ".."^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 3 ;
                                      ui:text [
                                          rdf:type sp:if ;
                                          sp:arg1 [
                                              rdf:type sp:ne ;
                                              sp:arg1 [
                                                  sp:varName "max"^^xsd:string ;
                                                ] ;
                                              sp:arg2 -1 ;
                                            ] ;
                                          sp:arg2 [
                                              sp:varName "max"^^xsd:string ;
                                            ] ;
                                          sp:arg3 "*" ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 4 ;
                                      ui:text "]"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:resultSet [
                                      sp:varName "myCardinalities"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 3 ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:PropertyDetailsTable ;
                          arg:class [
                              sp:varName "class"^^xsd:string ;
                            ] ;
                          arg:parent [
                              sp:varName "parent"^^xsd:string ;
                            ] ;
                          arg:property [
                              sp:varName "property"^^xsd:string ;
                            ] ;
                          ui:childIndex 4 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:resultSet [
                      sp:varName "propertySet"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Thead ;
              html:class "lm-table-header"^^xsd:string ;
              ui:child [
                  rdf:type html:Tr ;
                  html:class "lm-row"^^xsd:string ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "#"^^xsd:string ;
                        ] ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Defined in Class"^^xsd:string ;
                        ] ;
                      ui:childIndex 5 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Permissible Values"^^xsd:string ;
                        ] ;
                      ui:childIndex 4 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Property QName"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Property"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Type"^^xsd:string ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Properties table"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:PropertyDetailsTable
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:parent ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdf:Property ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:group ;
          letrs:myParents [
              rdf:type sp:Select ;
              sp:resultVariables (
                  [
                    sp:varName "parent"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "class"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?2"^^xsd:string ;
                      ] ;
                    sp:predicate lmdoc:parentsOfPropertiesAtClass ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?2"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?2"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type ui:forEach ;
              ui:child [
                  rdf:type html:Td ;
                  html:class "lm-column"^^xsd:string ;
                  ui:child [
                      rdf:type ui:else ;
                      ui:child [
                          rdf:type html:I ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "self"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type html:B ;
                          ui:child [
                              rdf:type swa:Link ;
                              arg:resource [
                                  sp:varName "parent"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text "["^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 2 ;
                          ui:text [
                              rdf:type ui:encodeNode ;
                              sp:arg1 [
                                  sp:varName "parent"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 3 ;
                          ui:text "]"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          rdf:type sp:ne ;
                          sp:arg1 [
                              sp:varName "parent"^^xsd:string ;
                            ] ;
                          sp:arg2 [
                              sp:varName "class"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type html:Td ;
                  html:class "lm-column"^^xsd:string ;
                  ui:child [
                      rdf:type ui:group ;
                      let:range [
                          rdf:type sp:Select ;
                          sp:resultVariables (
                              [
                                sp:varName "range"^^xsd:string ;
                              ]
                            ) ;
                          sp:where (
                              [
                                sp:object [
                                    sp:varName "parent"^^xsd:string ;
                                  ] ;
                                sp:predicate rdf:first ;
                                sp:subject [
                                    sp:varName "?0"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object [
                                    sp:varName "?1"^^xsd:string ;
                                  ] ;
                                sp:predicate rdf:rest ;
                                sp:subject [
                                    sp:varName "?0"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object [
                                    sp:varName "property"^^xsd:string ;
                                  ] ;
                                sp:predicate rdf:first ;
                                sp:subject [
                                    sp:varName "?1"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object () ;
                                sp:predicate rdf:rest ;
                                sp:subject [
                                    sp:varName "?1"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object [
                                    sp:varName "?2"^^xsd:string ;
                                  ] ;
                                sp:predicate lmdoc:rangeOfPropertyAtClass ;
                                sp:subject [
                                    sp:varName "?0"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object [
                                    sp:varName "range"^^xsd:string ;
                                  ] ;
                                sp:predicate rdf:first ;
                                sp:subject [
                                    sp:varName "?2"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object () ;
                                sp:predicate rdf:rest ;
                                sp:subject [
                                    sp:varName "?2"^^xsd:string ;
                                  ] ;
                              ]
                            ) ;
                        ] ;
                      ui:child [
                          rdf:type swa:ObjectViewer ;
                          arg:object [
                              sp:varName "range"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:group ;
                  letrs:myRestrictions [
                      rdf:type sp:Select ;
                      sp:resultVariables (
                          [
                            sp:varName "range"^^xsd:string ;
                          ]
                        ) ;
                      sp:where (
                          [
                            sp:object [
                                sp:varName "parent"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:first ;
                            sp:subject [
                                sp:varName "?0"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "?1"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:rest ;
                            sp:subject [
                                sp:varName "?0"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "property"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:first ;
                            sp:subject [
                                sp:varName "?1"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object () ;
                            sp:predicate rdf:rest ;
                            sp:subject [
                                sp:varName "?1"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "?2"^^xsd:string ;
                              ] ;
                            sp:predicate lmdoc:valueRestrictionsForPropertyAtClass ;
                            sp:subject [
                                sp:varName "?0"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "range"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:first ;
                            sp:subject [
                                sp:varName "?2"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "?3"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:rest ;
                            sp:subject [
                                sp:varName "?2"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "parent"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:first ;
                            sp:subject [
                                sp:varName "?3"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object () ;
                            sp:predicate rdf:rest ;
                            sp:subject [
                                sp:varName "?3"^^xsd:string ;
                              ] ;
                          ]
                        ) ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Td ;
                              html:class "lm-column"^^xsd:string ;
                              ui:child [
                                  rdf:type html:B ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text " only "^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:child [
                                  rdf:type ui:else ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          rdf:type ui:label ;
                                          sp:arg1 [
                                              sp:varName "range"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 2 ;
                                ] ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type swa:Link ;
                                      arg:resource [
                                          sp:varName "range"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 1 ;
                                      ui:text "["^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 2 ;
                                      ui:text [
                                          rdf:type ui:encodeNode ;
                                          sp:arg1 [
                                              sp:varName "range"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 3 ;
                                      ui:text "]"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 1 ;
                                  ui:condition [
                                      rdf:type sp:isIRI ;
                                      sp:arg1 [
                                          sp:varName "range"^^xsd:string ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type html:Td ;
                              html:class "lm-column"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:else ;
                                  ui:child [
                                      rdf:type html:I ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "self"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type html:B ;
                                      ui:child [
                                          rdf:type swa:Link ;
                                          arg:resource [
                                              sp:varName "parent"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 1 ;
                                      ui:text "["^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 2 ;
                                      ui:text [
                                          rdf:type ui:encodeNode ;
                                          sp:arg1 [
                                              sp:varName "parent"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 3 ;
                                      ui:text "]"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:condition [
                                      rdf:type sp:ne ;
                                      sp:arg1 [
                                          sp:varName "parent"^^xsd:string ;
                                        ] ;
                                      sp:arg2 [
                                          sp:varName "class"^^xsd:string ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "myRestrictions"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          rdf:type sp:gt ;
                          sp:arg1 [
                              rdf:type spr:rowCount ;
                              sp:arg1 [
                                  sp:varName "myRestrictions"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:resultSet [
                  sp:varName "myParents"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Property details table"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ReferencesToResourceInGivenGraph
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            rdf:type ui:label ;
            sp:arg1 [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "property"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "resource"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "resource"^^xsd:string ;
              ] ;
            sp:predicate [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:subject [
                sp:varName "subject"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:ne ;
                sp:arg1 [
                    sp:varName "property"^^xsd:string ;
                  ] ;
                sp:arg2 rdfs:isDefinedBy ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:comment "Gets all properties for subjects that reference a resource as object in given class."^^xsd:string ;
  rdfs:label "All instances"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:ResourceDocAnchor
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:typeLabel ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Span ;
      ui:child [
          rdf:type html:A ;
          html:id [
              rdf:type lmdoc:makeAnchorFromResource ;
              arg:resource [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type html:Strong ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "typeLabel"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 1 ;
              ui:text [
                  rdf:type smf:qname ;
                  sp:arg1 [
                      sp:varName "node"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "An anchor in the documentaiton entry for a resource."^^xsd:string ;
  rdfs:label "Resource Doc Ancor"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ResourceDocLink
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:title ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Span ;
      ui:child [
          rdf:type html:A ;
          html:href [
              rdf:type fn:concat ;
              sp:arg1 "#" ;
              sp:arg2 [
                  rdf:type lmdoc:makeAnchorFromResource ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          html:title [
              sp:varName "title"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  rdf:type smf:qname ;
                  sp:arg1 [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type ui:TextNode ;
          ui:childIndex 1 ;
          ui:text [
              sp:varName "label"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A hyperlink to the documentaiton entry for a resource."^^xsd:string ;
  rdfs:label "Resource Doc Link"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ResourceFooter
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:options ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type html:Div ;
      html:class "lm-buttons-dock"^^xsd:string ;
      ui:child [
          rdf:type html:Div ;
          html:style "clear:both;"^^xsd:string ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:style "float:left; text-align:middle; padding:10px;"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text """View as: 
"""^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type lmdoc:ViewAsCSV ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
              ui:condition [
                  rdf:type fn:contains ;
                  sp:arg1 [
                      sp:varName "options"^^xsd:string ;
                    ] ;
                  sp:arg2 "CSV" ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type lmdoc:ViewAsJSON ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 4 ;
              ui:condition [
                  rdf:type fn:contains ;
                  sp:arg1 [
                      sp:varName "options"^^xsd:string ;
                    ] ;
                  sp:arg2 "json" ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type lmdoc:ViewAsJSON-LD ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 5 ;
              ui:condition [
                  rdf:type fn:contains ;
                  sp:arg1 [
                      sp:varName "options"^^xsd:string ;
                    ] ;
                  sp:arg2 "JSONLD" ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type lmdoc:ViewAsRDFXML ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 2 ;
              ui:condition [
                  rdf:type fn:contains ;
                  sp:arg1 [
                      sp:varName "options"^^xsd:string ;
                    ] ;
                  sp:arg2 "RDF" ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type lmdoc:ViewAsTurtle ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 3 ;
              ui:condition [
                  rdf:type fn:contains ;
                  sp:arg1 [
                      sp:varName "options"^^xsd:string ;
                    ] ;
                  sp:arg2 "TURTLE" ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type lmdoc:ViewAsXML ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 6 ;
              ui:condition [
                  rdf:type fn:contains ;
                  sp:arg1 [
                      sp:varName "options"^^xsd:string ;
                    ] ;
                  sp:arg2 "XML" ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:style "float:left;"^^xsd:string ;
          ui:child [
              rdf:type html:A ;
              html:href "#lmdoc_top"^^xsd:string ;
              ui:child [
                  rdf:type html:Img ;
                  html:src "http://linkedmodel.org/lib/lm/images/icons/doc-back-arrow.png"^^xsd:string ;
                  html:width "24px;"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Resource footer"^^xsd:string ;
  rdfs:label "Resource Footer"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ResourceLink
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:title ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Span ;
      ui:child [
          rdf:type html:A ;
          html:href [
              rdf:type xsd:string ;
              sp:arg1 [
                  sp:varName "resource"^^xsd:string ;
                ] ;
            ] ;
          html:title [
              sp:varName "title"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  rdf:type smf:qname ;
                  sp:arg1 [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type ui:TextNode ;
          ui:childIndex 1 ;
          ui:text [
              sp:varName "label"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A hyperlink to a resource, using the QName of the resource as text. "^^xsd:string ;
  rdfs:label "Resource Link"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:Sections
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:sectionHeading ;
      spl:valueType xsd:string ;
    ] ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:SelectTemplates
  rdf:type spin:SelectTemplate ;
  rdfs:subClassOf spin:SelectTemplates ;
.
lmdoc:SubElements
  rdf:type ui:NodeClass ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:SubjectElements
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:object ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The object (usually the resource of the surrounding form)."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicate ;
      spl:valueType rdf:Property ;
      rdfs:comment "The predicate."^^xsd:string ;
    ] ;
  ui:abstract "true"^^xsd:boolean ;
  ui:private "true"^^xsd:boolean ;
  rdfs:subClassOf lmdoc:ViewElements ;
.
lmdoc:SubjectWidgetRow
  rdf:type ui:SubjectWidgetRowClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The subject to display."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:dynamicView ;
      arg:object [
          sp:varName "object"^^xsd:string ;
        ] ;
      arg:predicate [
          sp:varName "predicate"^^xsd:string ;
        ] ;
      arg:subject [
          sp:varName "subject"^^xsd:string ;
        ] ;
      ui:class swa:ObjectViewerRow ;
    ] ;
  rdfs:comment "A row of a SubjectWidget."^^xsd:string ;
  rdfs:label "Subject widget row"^^xsd:string ;
  rdfs:subClassOf lmdoc:ViewElements ;
.
lmdoc:Subjects
  rdf:type ui:NodeClass ;
  rdfs:subClassOf lmdoc:AbstractSubject ;
.
lmdoc:TOCEntry
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:count ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:heading ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myCountString [
          rdf:type sp:if ;
          sp:arg1 [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "count"^^xsd:string ;
                ] ;
            ] ;
          sp:arg2 [
              rdf:type fn:concat ;
              sp:arg1 " [" ;
              sp:arg2 [
                  sp:varName "count"^^xsd:string ;
                ] ;
              sp:arg3 "]" ;
            ] ;
          sp:arg3 "" ;
        ] ;
      ui:child [
          rdf:type html:A ;
          html:class "tocxref"^^xsd:string ;
          html:href [
              rdf:type fn:concat ;
              sp:arg1 "#" ;
              sp:arg2 [
                  rdf:type lmdoc:makeAnchorFromString ;
                  arg:label [
                      sp:varName "heading"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              rdf:type html:Span ;
              html:class "secno"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "heading"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type ui:TextNode ;
          ui:childIndex 1 ;
          ui:text [
              sp:varName "myCountString"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Creates a TOC Entry"^^xsd:string ;
  rdfs:label "Label"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:TableOfContents
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:A ;
          html:id "lmdoc_top"^^xsd:string ;
          ui:child [
              rdf:type html:H2 ;
              html:id [
                  rdf:type lmdoc:makeAnchorFromString ;
                  arg:label [
                      sp:varName "sectionHeading"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "sectionHeading"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type html:Ol ;
          html:class "lm-toc-numeric"^^xsd:string ;
          ui:child [
              rdf:type html:Li ;
              ui:child [
                  rdf:type html:Ol ;
                  html:class "lm-toc"^^xsd:string ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type lmdoc:TOCEntry ;
                          arg:heading "Classes"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type lmdoc:TOCEntry ;
                          arg:heading "Instances"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type lmdoc:TOCEntry ;
                          arg:heading "Properties"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type lmdoc:TOCEntry ;
                  arg:heading "Resource Details"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Li ;
              ui:child [
                  rdf:type html:Ol ;
                  html:class "lm-toc"^^xsd:string ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type lmdoc:TOCEntry ;
                          arg:heading "Imported Graphs"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type lmdoc:TOCEntry ;
                          arg:heading "Non-imported Resources"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type lmdoc:TOCEntry ;
                  arg:heading "Resource Index"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Table of contents"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:URIResourceSubjectViewer
  rdf:type swa:SubjectViewerClass ;
  swa:subjectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:isIRI ;
          sp:arg1 [
              sp:varName "subject"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:overrides swa:URIResourceSubjectViewer ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type ui:contextValue ;
          sp:arg1 "graph" ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "swa-shifted-label"^^xsd:string ;
          html:title [
              sp:varName "subject"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type lmdoc:ResourceLink ;
                  arg:resource [
                      sp:varName "subject"^^xsd:string ;
                    ] ;
                  arg:title [
                      rdf:type xsd:string ;
                      sp:arg1 [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type ui:else ;
                  ui:child [
                      rdf:type lmdoc:ResourceLink ;
                      arg:resource [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                      arg:title [
                          rdf:type xsd:string ;
                          sp:arg1 [
                              sp:varName "subject"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type ui:resourceView ;
                      ui:childIndex 1 ;
                      ui:matchIds "lmdoc-summary"^^xsd:string ;
                      ui:resource [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:ResourceDocLink ;
                      arg:label [
                          sp:varName "myLabel"^^xsd:string ;
                        ] ;
                      arg:resource [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type lmdoc:IsDefinedInGraph ;
                      arg:graph [
                          sp:varName "myGraph"^^xsd:string ;
                        ] ;
                      arg:resource [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "myGraph"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "A viewer for URI resources, displaying a hyperlink to that resource."^^xsd:string ;
  rdfs:label "URI resource subject viewer"^^xsd:string ;
  rdfs:subClassOf swa:URIResourceSubjectViewer ;
.
lmdoc:URIResourceViewer
  rdf:type swa:ObjectViewerClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  swa:objectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:eq ;
          sp:arg1 [
              sp:varName "kind"^^xsd:string ;
            ] ;
          sp:arg2 "uri" ;
        ] ;
      swa:weight 50 ;
    ] ;
  ui:overrides swa:URIResourceViewer ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type ui:contextValue ;
          sp:arg1 "graph" ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:myLabel [
              rdf:type sp:if ;
              sp:arg1 [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "label"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type fn:concat ;
                  sp:arg1 " [" ;
                  sp:arg2 [
                      sp:varName "label"^^xsd:string ;
                    ] ;
                  sp:arg3 "]" ;
                ] ;
              sp:arg3 "" ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-shifted-label"^^xsd:string ;
              html:title [
                  sp:varName "object"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:else ;
                  ui:child [
                      rdf:type lmdoc:ResourceLink ;
                      arg:label [
                          sp:varName "myLabel"^^xsd:string ;
                        ] ;
                      arg:resource [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                      arg:title [
                          rdf:type xsd:string ;
                          sp:arg1 [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type ui:else ;
                      ui:child [
                          rdf:type lmdoc:ResourceLink ;
                          arg:label [
                              sp:varName "myLabel"^^xsd:string ;
                            ] ;
                          arg:resource [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          arg:title [
                              rdf:type xsd:string ;
                              sp:arg1 [
                                  sp:varName "object"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type ui:resourceView ;
                          ui:childIndex 1 ;
                          ui:matchIds "lmdoc-summary"^^xsd:string ;
                          ui:resource [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:ResourceDocLink ;
                          arg:label [
                              sp:varName "myLabel"^^xsd:string ;
                            ] ;
                          arg:resource [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          rdf:type lmdoc:IsDefinedInGraph ;
                          arg:graph [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                          arg:resource [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:bound ;
                      sp:arg1 [
                          sp:varName "myGraph"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "URI resource viewer"^^xsd:string ;
  rdfs:subClassOf swa:URIResourceViewer ;
.
lmdoc:VSpace
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:defaultValue "40px"^^xsd:string ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:margin ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Div ;
      html:style [
          rdf:type ui:concat ;
          sp:arg1 "margin: "^^xsd:string ;
          sp:arg2 [
              sp:varName "margin"^^xsd:string ;
            ] ;
          sp:arg3 "  0;"^^xsd:string ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Vertical space"^^xsd:string ;
  rdfs:label "Vertical Space"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ViewAsCSV
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:A ;
      html:href "javascript:void(0);"^^xsd:string ;
      html:onclick [
          rdf:type ui:concat ;
          sp:arg1 "alert('Linked Data CSV for "^^xsd:string ;
          sp:arg2 [
              rdf:type smf:qname ;
              sp:arg1 [
                  sp:varName "resource"^^xsd:string ;
                ] ;
            ] ;
          sp:arg3 " to be done'); return false;"^^xsd:string ;
        ] ;
      html:style "padding-left:20px; padding-right:20px;"^^xsd:string ;
      ui:child [
          rdf:type ui:TextNode ;
          ui:childIndex 0 ;
          ui:text "CSV"^^xsd:string ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Action to view as CSV"^^xsd:string ;
  rdfs:label "View as CSV"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
