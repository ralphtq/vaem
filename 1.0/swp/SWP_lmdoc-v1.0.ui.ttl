lmdoc:Graph
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type sp:iri ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:setContext ;
          ui:child [
              rdf:type ui:setContext ;
              ui:child [
                  rdf:type ui:group ;
                  let:myGraphMetadata [
                      rdf:type spl:object ;
                      sp:arg1 [
                          sp:varName "myGraph"^^xsd:string ;
                        ] ;
                      sp:arg2 vaem:hasGraphMetadata ;
                    ] ;
                  ui:child [
                      rdf:type html:Hr ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      rdf:type html:Hr ;
                      ui:childIndex 7 ;
                    ] ;
                  ui:child [
                      rdf:type html:Section ;
                      html:class "details"^^xsd:string ;
                      html:id "details"^^xsd:string ;
                      html:property "dct:abstract"^^xsd:string ;
                      html:rel "bibo:Chapter"^^xsd:string ;
                      html:resource "#ref"^^xsd:string ;
                      html:typeof "bibo:Chapter"^^xsd:string ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "size-10"^^xsd:string ;
                          ui:child [
                              rdf:type html:A ;
                              html:href "http://www.topquadrant.com/technology/sparql-web-pages-swp/"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "TopBraid SPARQL Web Pages (SWP)"^^xsd:string ;
                                ] ;
                              ui:childIndex 5 ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Generated "^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text [
