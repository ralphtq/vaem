lmdoc:SubjectWidgetRow
  rdf:type ui:SubjectWidgetRowClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The subject to display."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:dynamicView ;
      arg:object [
          sp:varName "object"^^xsd:string ;
        ] ;
      arg:predicate [
          sp:varName "predicate"^^xsd:string ;
        ] ;
      arg:subject [
          sp:varName "subject"^^xsd:string ;
        ] ;
      ui:class lmdoc:ObjectViewerRow ;
    ] ;
  rdfs:comment "A row of a SubjectWidget."^^xsd:string ;
  rdfs:label "Subject widget row"^^xsd:string ;
  rdfs:subClassOf swa:SubjectElements ;
.
lmdoc:SubjectsBody
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to allow at most one value."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:Div ;
              html:class "ies-object-row"^^xsd:string ;
              ui:child [
                  rdf:type swa:SubjectWidgetRow ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-add-button-div"^^xsd:string ;
              html:style [
                  rdf:type sp:if ;
                  sp:arg1 [
                      sp:varName "single"^^xsd:string ;
                    ] ;
                  sp:arg2 "display: none" ;
                  sp:arg3 [
                      sp:varName "none"^^xsd:string ;
                    ] ;
                ] ;
              let:pid [
                  rdf:type ui:uniqueId ;
                ] ;
              ui:child [
                  rdf:type html:A ;
                  html:class "ies-add-row-button"^^xsd:string ;
                  html:href "javascript:void(0)"^^xsd:string ;
                  html:onclick [
                      rdf:type fn:concat ;
                      sp:arg1 "swa.addRow('"^^xsd:string ;
                      sp:arg2 [
                          sp:varName "pid"^^xsd:string ;
                        ] ;
                      sp:arg3 "', "^^xsd:string ;
                      sp:arg4 [
                          rdf:type sp:coalesce ;
                          sp:arg1 [
                              sp:varName "single"^^xsd:string ;
                            ] ;
                          sp:arg2 "false"^^xsd:boolean ;
                        ] ;
                      sp:arg5 ")"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:id [
                      sp:varName "pid"^^xsd:string ;
                    ] ;
                  html:style "display: none"^^xsd:string ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type ui:setContext ;
                          ui:child [
                              rdf:type lmdoc:SubjectWidgetRow ;
                              arg:object [
                                  sp:varName "object"^^xsd:string ;
                                ] ;
                              arg:predicate [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:varName "createLinkFunction"^^xsd:string ;
                          ui:varValue lmdoc:createLinkForMainForm ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 2 ;
          ui:condition [
              rdf:type swa:isEditMode ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:call ;
              arg:object [
                  sp:varName "object"^^xsd:string ;
                ] ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies_widget_value_slot"^^xsd:string ;
                      ui:child [
                          rdf:type swa:SubjectWidgetRow ;
                          arg:object [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          arg:subject [
                              sp:varName "subject"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:SubjectWidgetRow ;
                          arg:object [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:eq ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "rs"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template swa:SortedSubjects ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
