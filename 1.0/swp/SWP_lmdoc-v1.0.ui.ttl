      rdf:type ui:group ;
      ui:child [
          rdf:type html:Link ;
          html:href [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/swa/css/swa.css"^^xsd:string ;
