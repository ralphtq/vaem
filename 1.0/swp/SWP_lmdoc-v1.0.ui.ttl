      ui:child [
          rdf:type html:Script ;
          html:src [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/jquery/js/jquery-ui.js"^^xsd:string ;
            ] ;
          html:type "text/javascript"^^xsd:string ;
          ui:childIndex 7 ;
        ] ;
      ui:child [
          rdf:type html:Script ;
          html:src [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/jquery/js/jquery.contextmenu.js"^^xsd:string ;
            ] ;
          html:type "text/javascript"^^xsd:string ;
          ui:childIndex 10 ;
        ] ;
      ui:child [
          rdf:type html:Script ;
