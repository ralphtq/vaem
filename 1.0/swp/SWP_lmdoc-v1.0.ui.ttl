          rdf:type html:Section ;
          html:id "toc"^^xsd:string ;
          ui:child [
              rdf:type lmdoc:TableOfContents ;
              arg:sectionHeading "Table of Contents"^^xsd:string ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 3 ;
        ] ;
      ui:child [
          rdf:type lmdoc:GraphHeader ;
          arg:resource [
              sp:varName "resource"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=lmdoc:GraphMetadataView&resource=http%3A%2F%2Fqudt.org%2F2.0%2Fschema%2Fqudt&_base=http://qudt.org/swa/doc&_withImports=true"""^^xsd:string ;
  rdfs:label "Graph metadata view"^^xsd:string ;
  rdfs:subClassOf lmdoc:Pages ;
.
lmdoc:ImageResourceViewer
  rdf:type swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:eq ;
          sp:arg1 [
              sp:varName "kind"^^xsd:string ;
            ] ;
          sp:arg2 "image" ;
        ] ;
      swa:weight 3 ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      let:myImage [
          sp:varName "object"^^xsd:string ;
        ] ;
      ui:child [
          rdf:type html:A ;
          html:href [
              sp:varName "myImage"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type html:Img ;
              html:src [
                  sp:varName "myImage"^^xsd:string ;
                ] ;
              html:width "100px;"^^xsd:string ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "The LM Doc viewer for URI resources that appear to be images, judged by their file extension."^^xsd:string ;
  rdfs:label "Image resource viewer"^^xsd:string ;
  rdfs:subClassOf swa:ImageResourceViewer ;
.
lmdoc:ImportedNamespaces
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:ns [
          rdf:type spl:object ;
          sp:arg1 [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              sp:arg2 vaem:hasGraphMetadata ;
            ] ;
          sp:arg2 vaem:namespace ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          letrs:imports [
              rdf:type sp:Select ;
              sp:orderBy (
                  [
                    sp:varName "graph"^^xsd:string ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "graph"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    rdf:type sp:NamedGraph ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                          sp:predicate owl:imports ;
                          sp:subject [
                              sp:varName "resource"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                    sp:graphNameNode [
                        sp:varName "resource"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type html:H2 ;
              html:id [
                  rdf:type lmdoc:makeAnchorFromString ;
                  arg:label [
                      sp:varName "sectionHeading"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "sectionHeading"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type html:P ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "None"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:P ;
                  ui:child [
                      rdf:type html:Code ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "ns"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "The namespace for this graph is "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text """. 
A full set of alphabetically ordered imported graphs is shown in the table below."""^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Table ;
                  html:id "namespaces"^^xsd:string ;
                  ui:child [
                      rdf:type html:Tbody ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Tr ;
                              ui:child [
                                  rdf:type html:Td ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          rdf:type xsd:string ;
                                          sp:arg1 [
                                              sp:varName "graph"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "imports"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      ui:child [
                          rdf:type html:Tr ;
                          ui:child [
                              rdf:type html:Th ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Base URI"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 1 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "imports"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Imported Namespaces"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:IndexSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "resource"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:ns [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "myGraphMetadata"^^xsd:string ;
                ] ;
              sp:arg2 vaem:namespace ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:style "margin: 40px 0 25px 0;"^^xsd:string ;
              ui:childIndex 4 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:style "margin: 40px 0 25px 0;"^^xsd:string ;
              ui:childIndex 6 ;
            ] ;
          ui:child [
              rdf:type html:H2 ;
              html:id [
                  rdf:type lmdoc:makeAnchorFromString ;
                  arg:label [
                      sp:varName "sectionHeading"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "sectionHeading"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:P ;
              ui:child [
                  rdf:type html:A ;
                  html:href "#ns"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Namespaces"^^xsd:string ;
                    ] ;
                  ui:childIndex 5 ;
                ] ;
              ui:child [
                  rdf:type html:Code ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "ns"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  rdf:type html:Em ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type spl:object ;
                          sp:arg1 [
                              sp:varName "myGraphMetadata"^^xsd:string ;
                            ] ;
                          sp:arg2 vaem:namespacePrefix ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "All defined resources are within the "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text " namespace ("^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 4 ;
                  ui:text """).
The namespaces for all referenced vocabularies are giving in the section on """^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 6 ;
                  ui:text ". "^^xsd:string ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type html:P ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type spl:object ;
                      sp:arg1 [
                          sp:varName "myGraphMetadata"^^xsd:string ;
                        ] ;
                      sp:arg2 vaem:intent ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              arg:graph [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type lmdoc:ResourceDocLink ;
                              arg:resource [
                                  sp:varName "class"^^xsd:string ;
                                ] ;
                              arg:title [
                                  rdf:type lmdoc:getDescription ;
                                  arg:resource [
                                      sp:varName "class"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "classes"^^xsd:string ;
                            ] ;
                          ui:separator " | "^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Classes:"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "classes"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 3 ;
              ui:template lmdoc:AllClasses ;
              ui:varName "classes"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              arg:graph [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type lmdoc:ResourceDocLink ;
                              arg:resource [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              arg:title [
                                  rdf:type lmdoc:getDescription ;
                                  arg:resource [
                                      sp:varName "instance"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "instances"^^xsd:string ;
                            ] ;
                          ui:separator " | "^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Instances:"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "instances"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 7 ;
              ui:template lmdoc:AllInstances ;
              ui:varName "instances"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              arg:graph [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type lmdoc:ResourceDocLink ;
                              arg:resource [
                                  sp:varName "property"^^xsd:string ;
                                ] ;
                              arg:title [
                                  rdf:type lmdoc:getDescription ;
                                  arg:resource [
                                      sp:varName "property"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "properties"^^xsd:string ;
                            ] ;
                          ui:separator " | "^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Properties:"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "properties"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 5 ;
              ui:template lmdoc:AllProperties ;
              ui:varName "properties"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Index section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:InheritanceTable
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resourceSet ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type html:Table ;
          html:class "docPropertiesTable"^^xsd:string ;
          ui:child [
              rdf:type html:Tr ;
              ui:child [
                  rdf:type html:Th ;
                  html:class "docPropertiesTH"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Depth"^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Th ;
                  html:class "docPropertiesTH"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Superclass"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:forEach ;
              ui:child [
                  rdf:type html:Tr ;
                  ui:child [
                      rdf:type html:Td ;
                      html:class "docPropertiesTD"^^xsd:string ;
                      ui:child [
                          rdf:type html:B ;
                          ui:child [
                              rdf:type swa:Link ;
                              arg:resource [
                                  sp:varName "super"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text "["^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 2 ;
                          ui:text [
                              rdf:type ui:encodeNode ;
                              sp:arg1 [
                                  sp:varName "super"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 3 ;
                          ui:text "]"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Td ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "depth"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
              ui:resultSet [
                  sp:varName "resourceSet"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue lmdoc:createLinkForMainForm ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Inheritance table"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:InstancesSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "resource"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:style "margin: 40px 0 25px 0;"^^xsd:string ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type html:H2 ;
          html:id [
              rdf:type lmdoc:makeAnchorFromString ;
              arg:label [
                  sp:varName "sectionHeading"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "sectionHeading"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type ui:call ;
          arg:graph [
              sp:varName "resource"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "resource-box"^^xsd:string ;
                      ui:child [
                          rdf:type ui:call ;
                          arg:subject [
                              sp:varName "instance"^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type html:Div ;
                              html:class "header-box"^^xsd:string ;
                              ui:child [
                                  rdf:type lmdoc:ResourceDocAnchor ;
                                  arg:node [
                                      sp:varName "instance"^^xsd:string ;
                                    ] ;
                                  arg:typeLabel "Instance "^^xsd:string ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type html:P ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      rdf:type lmdoc:getDescription ;
                                      arg:resource [
                                          sp:varName "instance"^^xsd:string ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isAnnotationProperty ;
                              arg:graph [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                              arg:label "Annotations"^^xsd:string ;
                              arg:predicates [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isNonAnnotationProperty ;
                              arg:graph [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                              arg:label "Properties"^^xsd:string ;
                              arg:predicates [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 5 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ResourceFooter ;
                              arg:resource [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 7 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "20px;"^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "30px;"^^xsd:string ;
                              ui:childIndex 4 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "40px;"^^xsd:string ;
                              ui:childIndex 6 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:template [
                              rdf:type swa:modeProperty ;
                              arg:predicate swa:formObjectPredicateSelectionTemplate ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:VSpace ;
                      arg:margin "40px;"^^xsd:string ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:resultSet [
                      sp:varName "instances"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "instances"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 1 ;
          ui:template lmdoc:AllInstances ;
          ui:varName "instances"^^xsd:string ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Instances section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:IntroductionSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:ns [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "resource"^^xsd:string ;
            ] ;
          sp:arg2 vaem:namespace ;
        ] ;
      ui:child [
          rdf:type html:H2 ;
          html:id [
              rdf:type fn:lower-case ;
              sp:arg1 [
                  sp:varName "sectionHeading"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "sectionHeading"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type html:P ;
          let:graphType [
              rdf:type fn:lower-case ;
              sp:arg1 [
                  rdf:type ui:label ;
                  sp:arg1 [
                      rdf:type spl:object ;
                      sp:arg1 [
                          sp:varName "resource"^^xsd:string ;
                        ] ;
                      sp:arg2 vaem:hasGraphRole ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  rdf:type spl:object ;
                  sp:arg1 [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  sp:arg2 vaem:turtleFileURL ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Turtle"^^xsd:string ;
                ] ;
              ui:childIndex 5 ;
            ] ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  sp:varName "rdfxmlFileURL"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "RDF/XML"^^xsd:string ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "The \""^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 1 ;
              ui:text [
                  sp:varName "graphType"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 2 ;
              ui:text "\" is also available in formats: "^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 4 ;
              ui:text " and "^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 6 ;
              ui:text "."^^xsd:string ;
            ] ;
          ui:childIndex 3 ;
        ] ;
      ui:child [
          rdf:type html:P ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  sp:varName "ns"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "ns"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "The namespace for all terms in this ontology is: "^^xsd:string ;
            ] ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type html:P ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  rdf:type spl:object ;
                  sp:arg1 [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  sp:arg2 vaem:description ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Introduction section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:IsDefinedInGraph
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Ask ;
      sp:where (
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:bound ;
                sp:arg1 [
                    sp:varName "graph"^^xsd:string ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                  sp:predicate rdfs:isDefinedBy ;
                  sp:subject [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "Is defined in graph"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:Label
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate tui:node ;
      rdfs:comment "The RDF node to display."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:class "lm_iri_resource"^^xsd:string ;
              ui:child [
                  rdf:type html:Div ;
                  html:class "lm_hidden_resource_content"^^xsd:string ;
                  ui:child [
                      rdf:type lmdoc:PopUpResourceView ;
                      tui:resource [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  html:class "lm_table_hyperlink_surrogate"^^xsd:string ;
                  ui:child [
                      rdf:type html:U ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              rdf:type smf:qname ;
                              sp:arg1 [
                                  sp:varName "node"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 1 ;
                      ui:text [
                          rdf:type lmdoc:labelText ;
                          tui:resource [
                              sp:varName "node"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
          ui:condition [
              rdf:type sp:isIRI ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type html:Span ;
                  html:class "tuiLabel"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type ui:label ;
                          sp:arg1 [
                              sp:varName "node"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:A ;
                  html:href [
                      sp:varName "node"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:eq ;
                  sp:arg1 xsd:anyURI ;
                  sp:arg2 [
                      rdf:type sp:datatype ;
                      sp:arg1 [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:isLiteral ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:resourceView ;
              ui:childIndex 0 ;
              ui:matchIds "label"^^xsd:string ;
              ui:resource [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 2 ;
          ui:condition [
              rdf:type sp:isBlank ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Displays an arbitrary RDF node. If the node is a resource, then this will use the configured resource display with id=\"label\" (e.g., the tui:Link). Literals of type xsd:anyURI are turned into hyperlinks. All other literals will be rendered as a simple text node with CSS class tuiLabel, with the text derived using ui:label()."^^xsd:string ;
  rdfs:label "Label"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:LabelList
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate ui:resultSet ;
      spl:valueType sp:Select ;
      rdfs:comment "The SELECT query delivering the nodes to display in its first column."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:forEach ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text ", "^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:gt ;
              sp:arg1 [
                  sp:varName "index"^^xsd:string ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
      ui:child [
          rdf:type lmdoc:Label ;
          tui:node [
              sp:varName "node"^^xsd:string ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:indexVar "index"^^xsd:string ;
      ui:resultSet [
          rdf:type sp:Select ;
          sp:resultVariables (
              _:b40132
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "resultSet"^^xsd:string ;
                  ] ;
                sp:predicate rdf:first ;
                sp:subject _:b33596 ;
              ]
              [
                sp:object _:b49932 ;
                sp:predicate rdf:rest ;
                sp:subject _:b33596 ;
              ]
              [
                sp:object 0 ;
                sp:predicate rdf:first ;
                sp:subject _:b49932 ;
              ]
              [
                sp:object () ;
                sp:predicate rdf:rest ;
                sp:subject _:b49932 ;
              ]
              [
                sp:object _:b40132 ;
                sp:predicate spr:colCells ;
                sp:subject _:b33596 ;
              ]
            ) ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A comma-separated list of values from a given result set. The individual values will be rendered into tui:Labels."^^xsd:string ;
  rdfs:label "Label list"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:LabeledObjects
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Tr ;
          ui:child [
              rdf:type html:Td ;
              html:class "prop"^^xsd:string ;
              ui:child [
                  rdf:type swa:PropertyLabel ;
                  arg:id [
                      rdf:type ui:concat ;
                      sp:arg1 "property-label-"^^xsd:string ;
                      sp:arg2 [
                          sp:varName "predicate"^^xsd:string ;
                        ] ;
                    ] ;
                  arg:label [
                      rdf:type sp:if ;
                      sp:arg1 [
                          rdf:type sp:bound ;
                          sp:arg1 [
                              sp:varName "label"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          sp:varName "label"^^xsd:string ;
                        ] ;
                      sp:arg3 [
                          rdf:type ui:label ;
                          sp:arg1 [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  arg:property [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:Td ;
              html:id [
                  rdf:type ui:concat ;
                  sp:arg1 [
                      sp:varName "pid"^^xsd:string ;
                    ] ;
                  sp:arg2 "-body"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type lmdoc:ObjectsBody ;
                      arg:graph [
                          sp:varName "graph"^^xsd:string ;
                        ] ;
                      ui:args "*"^^xsd:string ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "viewWidget"^^xsd:string ;
                  ui:varValue [
                      sp:varName "viewWidget"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Labeled objects"^^xsd:string ;
  rdfs:subClassOf swa:Objects ;
.
lmdoc:Link
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate lmdoc:optionalLinkArgs ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Span ;
      html:class "tuiLink"^^xsd:string ;
      ui:child [
          rdf:type ui:createLink ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  rdf:type fn:concat ;
                  sp:arg1 [
                      sp:varName "link"^^xsd:string ;
                    ] ;
                  sp:arg2 "&" ;
                  sp:arg3 [
                      sp:varName "optionalLinkArgs"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:resource [
              sp:varName "node"^^xsd:string ;
            ] ;
          ui:sendQueryGraph "true"^^xsd:boolean ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A hyperlink to a resource, using the display label of the resource as text. Additional arguments may be passed in 'lmdoc:optionalArgs' for the rest call."^^xsd:string ;
  rdfs:label "Link"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:NonImportedResources
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:ns [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "resource"^^xsd:string ;
            ] ;
          sp:arg2 vaem:namespace ;
        ] ;
      ui:child [
          rdf:type html:H2 ;
          html:id [
              rdf:type lmdoc:makeAnchorFromString ;
              arg:label [
                  sp:varName "sectionHeading"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "sectionHeading"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type html:P ;
          ui:child [
              rdf:type html:Dd ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type lmdoc:ResourceLink ;
                      arg:resource [
                          sp:varName "usedResource"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:resultSet [
                      rdf:type sp:Select ;
                      sp:orderBy (
                          [
                            sp:varName "qname"^^xsd:string ;
                          ]
                        ) ;
                      sp:resultVariables (
                          [
                            sp:varName "usedResource"^^xsd:string ;
                          ]
                          [
                            sp:varName "qname"^^xsd:string ;
                          ]
                        ) ;
                      sp:where (
                          [
                            sp:object [
                                sp:varName "usedResource"^^xsd:string ;
                              ] ;
                            sp:predicate vaem:usesNonImportedResource ;
                            sp:subject [
                                sp:varName "resource"^^xsd:string ;
                              ] ;
                          ]
                          [
                            rdf:type sp:Bind ;
                            sp:expression [
                                rdf:type smf:qname ;
                                sp:arg1 [
                                    sp:varName "usedResource"^^xsd:string ;
                                  ] ;
                              ] ;
                            sp:variable [
                                sp:varName "qname"^^xsd:string ;
                              ] ;
                          ]
                        ) ;
                    ] ;
                  ui:separator " | "^^xsd:string ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Dt ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type html:P ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "The graph uses resources from other graphs that are not imported. These are shown below:"^^xsd:string ;
            ] ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "non-imported resources"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:ObjectViewer
  rdf:type swa:ObjectViewerClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type html:Div ;
      html:class "swa-object-widget"^^xsd:string ;
      let:class [
          rdf:type sp:coalesce ;
          sp:arg1 [
              rdf:type ui:contextValue ;
              sp:arg1 "viewWidget" ;
            ] ;
          sp:arg2 [
              rdf:type swa:bestObjectViewerClass ;
              arg:object [
                  sp:varName "object"^^xsd:string ;
                ] ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "subject"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "[Error: no ObjectViewer found for "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text ", "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 3 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "predicate"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 4 ;
                  ui:text ", "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 5 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 6 ;
                  ui:text "]"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:dynamicView ;
              arg:graph [
                  sp:varName "graph"^^xsd:string ;
                ] ;
              arg:object [
                  sp:varName "object"^^xsd:string ;
                ] ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "subject"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
              ui:class [
                  sp:varName "class"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "class"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment """A read-only widget displaying a single object. In order to be selected on forms, subclasses of this class must specify a weight > 0 and an expression that returns true for the given input variable bindings:
- ?type: the datatype or rdf:type of the object being displayed
- ?kind: \"literal\", \"blank\", \"uri\" or \"image\"
- ?predicate: the property being displayed"""^^xsd:string ;
  rdfs:label "Object viewer"^^xsd:string ;
  rdfs:subClassOf swa:ObjectWidget ;
.
lmdoc:ObjectWidgetRow
  rdf:type swa:ObjectWidgetRowClass ;
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:object ;
      rdfs:comment "The object node."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:dynamicView ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          arg:object [
              sp:varName "object"^^xsd:string ;
            ] ;
          arg:predicate [
              sp:varName "predicate"^^xsd:string ;
            ] ;
          arg:subject [
              sp:varName "subject"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
          ui:class lmdoc:ObjectViewer ;
        ] ;
    ] ;
  rdfs:comment "Superclass for the widget row types."^^xsd:string ;
  rdfs:label "Object widget row"^^xsd:string ;
  rdfs:subClassOf swa:ObjectElements ;
.
lmdoc:Objects
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:function [
          rdf:type swa:modeProperty ;
          arg:predicate swa:isSingleFunction ;
        ] ;
      ui:child [
          rdf:type lmdoc:LabeledObjects ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          arg:single [
              rdf:type sp:if ;
              sp:arg1 [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "function"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type spif:invoke ;
                  sp:arg1 [
                      sp:varName "function"^^xsd:string ;
                    ] ;
                  sp:arg2 [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  sp:arg3 [
                      sp:varName "subject"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg3 [
                  rdf:type swa:modeProperty ;
                  arg:predicate swa:isSingleConstant ;
                ] ;
            ] ;
          ui:args "*"^^xsd:string ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "A two-columned structure with a label on the left and zero or more objects on the right."^^xsd:string ;
  rdfs:label "Objects"^^xsd:string ;
  rdfs:subClassOf swa:AbstractObject ;
.
lmdoc:ObjectsBody
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:offset ;
      spl:valueType xsd:integer ;
      rdfs:comment "The offset for the \"next 50\" recursive calls."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to allow at most one value."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-object-row"^^xsd:string ;
              ui:child [
                  rdf:type swa:ObjectWidgetRow ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:call ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "subject"^^xsd:string ;
                ] ;
              let:special [
                  rdf:type swa:specialAddButtonFunction ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  arg:subject [
                      sp:varName "subject"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:else ;
                  ui:child [
                      rdf:type ui:group ;
                      let:limit 50 ;
                      let:offset [
                          rdf:type sp:coalesce ;
                          sp:arg1 [
                              sp:varName "offset"^^xsd:string ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Div ;
                              html:class "swa-object-row"^^xsd:string ;
                              ui:child [
                                  rdf:type lmdoc:ObjectWidgetRow ;
                                  arg:graph [
                                      sp:varName "graph"^^xsd:string ;
                                    ] ;
                                  arg:object [
                                      sp:varName "object"^^xsd:string ;
                                    ] ;
                                  arg:predicate [
                                      sp:varName "predicate"^^xsd:string ;
                                    ] ;
                                  arg:subject [
                                      sp:varName "subject"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:limit [
                              sp:varName "limit"^^xsd:string ;
                            ] ;
                          ui:offset [
                              sp:varName "offset"^^xsd:string ;
                            ] ;
                          ui:resultSet [
                              sp:varName "rs"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:group ;
                          let:id [
                              rdf:type ui:uniqueId ;
                            ] ;
                          let:rowCount [
                              rdf:type spr:rowCount ;
                              sp:arg1 [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:child [
                              rdf:type ui:loadable ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type ui:else ;
                                      ui:child [
                                          rdf:type html:Div ;
                                          html:class "swa-objects-show-more"^^xsd:string ;
                                          ui:child [
                                              rdf:type html:A ;
                                              html:href "javascript:void(0)"^^xsd:string ;
                                              html:onclick [
                                                  rdf:type ui:concat ;
                                                  sp:arg1 "swa.load('"^^xsd:string ;
                                                  sp:arg2 [
                                                      sp:varName "id"^^xsd:string ;
                                                    ] ;
                                                  sp:arg3 "', { newOffset: "^^xsd:string ;
                                                  sp:arg4 [
                                                      rdf:type sp:add ;
                                                      sp:arg1 [
                                                          sp:varName "offset"^^xsd:string ;
                                                        ] ;
                                                      sp:arg2 [
                                                          sp:varName "limit"^^xsd:string ;
                                                        ] ;
                                                    ] ;
                                                  sp:arg5 " })"^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text "Show entries "^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 1 ;
                                                  ui:text [
                                                      rdf:type sp:add ;
                                                      sp:arg1 [
                                                          rdf:type sp:add ;
                                                          sp:arg1 [
                                                              sp:varName "offset"^^xsd:string ;
                                                            ] ;
                                                          sp:arg2 [
                                                              sp:varName "limit"^^xsd:string ;
                                                            ] ;
                                                        ] ;
                                                      sp:arg2 1 ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 2 ;
                                                  ui:text " to "^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 3 ;
                                                  ui:text [
                                                      rdf:type spl:min ;
                                                      sp:arg1 [
                                                          sp:varName "rowCount"^^xsd:string ;
                                                        ] ;
                                                      sp:arg2 [
                                                          rdf:type sp:add ;
                                                          sp:arg1 [
                                                              rdf:type sp:add ;
                                                              sp:arg1 [
                                                                  sp:varName "offset"^^xsd:string ;
                                                                ] ;
                                                              sp:arg2 [
                                                                  sp:varName "limit"^^xsd:string ;
                                                                ] ;
                                                            ] ;
                                                          sp:arg2 [
                                                              sp:varName "limit"^^xsd:string ;
                                                            ] ;
                                                        ] ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 4 ;
                                                  ui:text " of "^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 5 ;
                                                  ui:text [
                                                      sp:varName "rowCount"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:if ;
                                      ui:child [
                                          rdf:type lmdoc:ObjectsBody ;
                                          arg:graph [
                                              sp:varName "graph"^^xsd:string ;
                                            ] ;
                                          arg:offset [
                                              sp:varName "newOffset"^^xsd:string ;
                                            ] ;
                                          ui:args "*"^^xsd:string ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                      ui:condition [
                                          rdf:type sp:bound ;
                                          sp:arg1 [
                                              sp:varName "newOffset"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:condition [
                                      rdf:type sp:gt ;
                                      sp:arg1 [
                                          sp:varName "rowCount"^^xsd:string ;
                                        ] ;
                                      sp:arg2 [
                                          rdf:type sp:add ;
                                          sp:arg1 [
                                              sp:varName "offset"^^xsd:string ;
                                            ] ;
                                          sp:arg2 [
                                              sp:varName "limit"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:loadId [
                                  sp:varName "id"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:ObjectWidgetRow ;
                          arg:graph [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          arg:subject [
                              sp:varName "subject"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:and ;
                      sp:arg1 [
                          rdf:type sp:and ;
                          sp:arg1 [
                              rdf:type sp:and ;
                              sp:arg1 [
                                  rdf:type spr:isEmpty ;
                                  sp:arg1 [
                                      sp:varName "rs"^^xsd:string ;
                                    ] ;
                                ] ;
                              sp:arg2 [
                                  rdf:type sp:not ;
                                  sp:arg1 [
                                      rdf:type swa:isViewMode ;
                                    ] ;
                                ] ;
                            ] ;
                          sp:arg2 [
                              rdf:type sp:not ;
                              sp:arg1 [
                                  rdf:type sp:bound ;
                                  sp:arg1 [
                                      sp:varName "special"^^xsd:string ;
                                    ] ;
                                ] ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          rdf:type sp:not ;
                          sp:arg1 [
                              rdf:type swa:isBlankNodeProperty ;
                              arg:property [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template swa:SortedObjects ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "subject"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The body of an Object(s) widget, typically containing one row for each value. This can be \"overloaded\" via a mode property."^^xsd:string ;
  rdfs:label "Objects body"^^xsd:string ;
  rdfs:subClassOf swa:ObjectElements ;
.
lmdoc:ObjectsGroup
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:filterFunction ;
      spl:valueType spin:Function ;
      rdfs:comment "An optional filter function that takes a predicate and a subject as arguments and returns true for all predicates that should be displayed."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicates ;
      spl:valueType sp:Select ;
      rdfs:comment "A result set (e.g., SPARQL SELECT query) that delivers the predicates in this group."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The resource to display."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      letrs:rs [
          rdf:type sp:Select ;
          sp:resultVariables (
              [
                sp:varName "predicate"^^xsd:string ;
              ]
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "predicates"^^xsd:string ;
                  ] ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object 0 ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object () ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "predicate"^^xsd:string ;
                  ] ;
                sp:predicate spr:colCells ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                rdf:type sp:Filter ;
                sp:expression [
                    rdf:type sp:or ;
                    sp:arg1 [
                        rdf:type sp:not ;
                        sp:arg1 [
                            rdf:type sp:bound ;
                            sp:arg1 [
                                sp:varName "filterFunction"^^xsd:string ;
                              ] ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        rdf:type spif:invoke ;
                        sp:arg1 [
                            sp:varName "filterFunction"^^xsd:string ;
                          ] ;
                        sp:arg2 [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                        sp:arg3 [
                            sp:varName "subject"^^xsd:string ;
                          ] ;
                      ] ;
                  ] ;
              ]
              [
                rdf:type sp:Filter ;
                sp:expression [
                    rdf:type sp:not ;
                    sp:arg1 [
                        rdf:type swa:isHiddenPropertyAtSubject ;
                        arg:property [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                        arg:subject [
                            sp:varName "subject"^^xsd:string ;
                          ] ;
                      ] ;
                  ] ;
              ]
            ) ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "definition"^^xsd:string ;
                  let:pid [
                      rdf:type ui:uniqueId ;
                    ] ;
                  ui:child [
                      rdf:type html:Tbody ;
                      html:class "lm-table-body"^^xsd:string ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type lmdoc:Objects ;
                              arg:graph [
                                  sp:varName "graph"^^xsd:string ;
                                ] ;
                              arg:predicate [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "subject"^^xsd:string ;
                                ] ;
                              arg:tabular "true"^^xsd:boolean ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "rs"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      html:class "lm-table-header"^^xsd:string ;
                      ui:child [
                          rdf:type html:Th ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Definitions"^^xsd:string ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Th ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "label"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-sub-title"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "label"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:bound ;
                      sp:arg1 [
                          sp:varName "label"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:gt ;
              sp:arg1 [
                  rdf:type spr:rowCount ;
                  sp:arg1 [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A group of lmdoc:Objects elements where the predicates are computed by taking a result set (e.g. of all relevant properties) and applying a filter on top of it, e.g. to only show the annotation properties among those that are relevant."^^xsd:string ;
  rdfs:label "Objects group"^^xsd:string ;
  rdfs:subClassOf swa:ObjectsGroup ;
.
lmdoc:OntologyView
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:ns [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "resource"^^xsd:string ;
            ] ;
          sp:arg2 vaem:namespace ;
        ] ;
      let:thisVersion [
          rdf:type xsd:string ;
          sp:arg1 [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              sp:arg2 owl:versionIRI ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:rdfxmlFileURL [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              sp:arg2 vaem:rdfxmlFileURL ;
            ] ;
          let:replacesVersion [
              rdf:type sp:coalesce ;
              sp:arg1 [
                  rdf:type spl:object ;
                  sp:arg1 [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  sp:arg2 dct:replaces ;
                ] ;
              sp:arg2 "none" ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:class "head"^^xsd:string ;
              html:id "respecHeader"^^xsd:string ;
              ui:child [
                  rdf:type html:Dl ;
                  ui:child [
                      rdf:type html:Dd ;
                      html:class "p-author h-card vcard"^^xsd:string ;
                      html:rel "bibo:editor"^^xsd:string ;
                      ui:child [
                          rdf:type html:Span ;
                          html:typeof "foaf:Person"^^xsd:string ;
                          ui:child [
                              rdf:type html:A ;
                              html:class "p-org org h-org h-card"^^xsd:string ;
                              html:href "http://www.topquadrant.com/"^^xsd:string ;
                              html:rel "foaf:workplaceHomepage"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "TopQuadrant, Inc"^^xsd:string ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type html:Span ;
                              html:class "p-name fn"^^xsd:string ;
                              html:property "foaf:name"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Ralph Hodgson"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text ", "^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 7 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type html:A ;
                          html:class "u-url"^^xsd:string ;
                          html:href [
                              sp:varName "ns"^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "ns"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type html:A ;
                          html:href [
                              sp:varName "thisVersion"^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "thisVersion"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              rdf:type spl:object ;
                              sp:arg1 [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                              sp:arg2 dct:modified ;
                            ] ;
                        ] ;
                      ui:childIndex 9 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type ui:else ;
                          ui:child [
                              rdf:type html:A ;
                              html:href [
                                  sp:varName "replacesVersion"^^xsd:string ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      sp:varName "replacesVersion"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type ui:if ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "replacesVersion"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:condition [
                              rdf:type sp:eq ;
                              sp:arg1 [
                                  sp:varName "replacesVersion"^^xsd:string ;
                                ] ;
                              sp:arg2 "none" ;
                            ] ;
                        ] ;
                      ui:childIndex 5 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Editor:"^^xsd:string ;
                        ] ;
                      ui:childIndex 6 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Last Modified:"^^xsd:string ;
                        ] ;
                      ui:childIndex 8 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Latest published version:"^^xsd:string ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Previous published version:"^^xsd:string ;
                        ] ;
                      ui:childIndex 4 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "This version:"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type html:H1 ;
                  html:class "title p-name"^^xsd:string ;
                  html:id "title"^^xsd:string ;
                  html:property "dct:title"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type ui:label ;
                          sp:arg1 [
                              sp:varName "resource"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:H2 ;
                  html:id "h2_synopsis"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Synopsis"^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type lmdoc:CopyrightSection ;
                  ui:childIndex 3 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              let:myLogo [
                  rdf:type sp:coalesce ;
                  sp:arg1 [
                      rdf:type spl:object ;
                      sp:arg1 [
                          sp:varName "resource"^^xsd:string ;
