                              ui:childIndex 9 ;
                            ] ;
                          ui:child [
                              rdf:type html:Dd ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      rdf:type spl:object ;
                                      sp:arg1 [
                                          sp:varName "resource"^^xsd:string ;
                                        ] ;
                                      sp:arg2 vaem:revision ;
                                    ] ;
