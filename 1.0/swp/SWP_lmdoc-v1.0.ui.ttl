    ] ;
  rdfs:comment "Gets all properties defined in a given graph and orders them by label. Note this may (obviously) not scale if a class has too many instances."^^xsd:string ;
  rdfs:label "All properties"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:CopyrightSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:call ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:P ;
                  html:class "copyright"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text """Copyright ©2011-2014 
"""^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text """
   , All Rights Reserved.
"""^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:forEach ;
                      ui:child [
                          rdf:type html:Abbr ;
                          html:title [
                              sp:varName "owner"^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "owner"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                      ui:resultSet [
                          sp:varName "rs"^^xsd:string ;
                        ] ;
                      ui:separator ", "^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "rs"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:AllOwners ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Copyright section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:Elements
  rdf:type ui:NodeClass ;
  ui:abstract "true"^^xsd:boolean ;
  ui:headIncludes [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Link ;
          html:href "http://qudt.org/css/lm.css"^^xsd:string ;
          html:rel "stylesheet"^^xsd:string ;
          html:type "text/css"^^xsd:string ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:Link ;
          html:href "http://qudt.org/css/qudt.css"^^xsd:string ;
          html:rel "stylesheet"^^xsd:string ;
          html:type "text/css"^^xsd:string ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type html:Link ;
          html:href [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/jquery/css/jquery.contextmenu.css"^^xsd:string ;
            ] ;
          html:rel "stylesheet"^^xsd:string ;
          html:type "text/css"^^xsd:string ;
          ui:childIndex 4 ;
        ] ;
      ui:child [
          rdf:type html:Link ;
          html:href [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/jquery/css/jquery.jqplot.min.css"^^xsd:string ;
            ] ;
          html:rel "stylesheet"^^xsd:string ;
          html:type "text/css"^^xsd:string ;
          ui:childIndex 17 ;
        ] ;
      ui:child [
          rdf:type html:Link ;
          html:href [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/jquery/css/smoothness/jquery-ui.css"^^xsd:string ;
            ] ;
          html:rel "stylesheet"^^xsd:string ;
          html:type "text/css"^^xsd:string ;
          ui:childIndex 3 ;
        ] ;
      ui:child [
          rdf:type html:Link ;
          html:href [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/jquery/css/ui.jqgrid.css"^^xsd:string ;
            ] ;
          html:rel "stylesheet"^^xsd:string ;
          html:type "text/css"^^xsd:string ;
          ui:childIndex 5 ;
        ] ;
      ui:child [
          rdf:type html:Script ;
          html:language "javascript"^^xsd:string ;
          html:src [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/jquery/js/jquery.jqplot.min.js"^^xsd:string ;
            ] ;
          html:type "text/javascript"^^xsd:string ;
          ui:childIndex 16 ;
        ] ;
      ui:child [
          rdf:type html:Script ;
          html:src [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/jquery/js/i18n/grid.locale-en.js"^^xsd:string ;
            ] ;
