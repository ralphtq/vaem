            ] ;
          html:type "text/javascript"^^xsd:string ;
          ui:childIndex 14 ;
        ] ;
      ui:child [
          rdf:type html:Script ;
          html:src [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/jquery/js/jquery.layout.js"^^xsd:string ;
            ] ;
          html:type "text/javascript"^^xsd:string ;
          ui:childIndex 13 ;
        ] ;
      ui:child [
          rdf:type html:Script ;
          html:src [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/swa/js/swa.js"^^xsd:string ;
            ] ;
          html:type "text/javascript"^^xsd:string ;
          ui:childIndex 19 ;
        ] ;
      ui:child [
          rdf:type html:Script ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "$.jqplot.config.enablePlugins = true;"^^xsd:string ;
            ] ;
          ui:childIndex 18 ;
        ] ;
      ui:child [
          rdf:type ui:CommentNode ;
          ui:childIndex 15 ;
          rdfs:comment "[if lt IE 9]><script language=\"javascript\" type=\"text/javascript\" src=\"{= ui:lib() }/jquery/js/excanvas.min.js\"></script><![endif]"^^xsd:string ;
        ] ;
      ui:child [
          rdf:type ui:CommentNode ;
          ui:childIndex 2 ;
          rdfs:comment "[if lt IE 9]><script src='https://www.w3.org/2008/site/js/html5shiv.js'></script><![endif]"^^xsd:string ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Elements"^^xsd:string ;
  rdfs:subClassOf ui:Element ;
.
lmdoc:Functions
  rdf:type spin:Function ;
  rdfs:label "Functions"^^xsd:string ;
  rdfs:subClassOf spin:Functions ;
.
lmdoc:ImportedNamespaces
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:ns [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "resource"^^xsd:string ;
            ] ;
          sp:arg2 vaem:namespace ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          letrs:imports [
              rdf:type sp:Select ;
              sp:orderBy (
                  [
                    sp:varName "graph"^^xsd:string ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "graph"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "graph"^^xsd:string ;
                      ] ;
                    sp:predicate owl:imports ;
                    sp:subject [
                        sp:varName "resource"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type html:H2 ;
              html:id "ns"^^xsd:string ;
              ui:child [
                  rdf:type html:Span ;
                  html:class "secno"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text "Imported Namespaces"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type html:P ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "None"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:P ;
                  ui:child [
                      rdf:type html:Code ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "ns"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "The namespace for this graph is "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text """. 
A full set of alphabetically ordered imported graphs is shown in the table below."""^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Table ;
                  html:id "namespaces"^^xsd:string ;
                  ui:child [
                      rdf:type html:Tbody ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Tr ;
                              ui:child [
                                  rdf:type html:Td ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          rdf:type xsd:string ;
                                          sp:arg1 [
                                              sp:varName "graph"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "imports"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      ui:child [
                          rdf:type html:Tr ;
                          ui:child [
                              rdf:type html:Th ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Base URI"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 1 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "imports"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Imported Namespaces"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:Label
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate tui:node ;
      rdfs:comment "The RDF node to display."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:class "lm_iri_resource"^^xsd:string ;
              ui:child [
                  rdf:type html:Div ;
                  html:class "lm_hidden_resource_content"^^xsd:string ;
                  ui:child [
                      rdf:type lmdoc:PopUpResourceView ;
                      tui:resource [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  html:class "lm_table_hyperlink_surrogate"^^xsd:string ;
                  ui:child [
                      rdf:type html:U ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              rdf:type smf:qname ;
                              sp:arg1 [
                                  sp:varName "node"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 1 ;
                      ui:text [
                          rdf:type lmdoc:labelText ;
                          tui:resource [
                              sp:varName "node"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
          ui:condition [
              rdf:type sp:isIRI ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type html:Span ;
                  html:class "tuiLabel"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type ui:label ;
                          sp:arg1 [
                              sp:varName "node"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:A ;
                  html:href [
                      sp:varName "node"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:eq ;
                  sp:arg1 xsd:anyURI ;
                  sp:arg2 [
                      rdf:type sp:datatype ;
                      sp:arg1 [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:isLiteral ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:resourceView ;
              ui:childIndex 0 ;
              ui:matchIds "label"^^xsd:string ;
              ui:resource [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 2 ;
          ui:condition [
              rdf:type sp:isBlank ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Displays an arbitrary RDF node. If the node is a resource, then this will use the configured resource display with id=\"label\" (e.g., the tui:Link). Literals of type xsd:anyURI are turned into hyperlinks. All other literals will be rendered as a simple text node with CSS class tuiLabel, with the text derived using ui:label()."^^xsd:string ;
  rdfs:label "Label"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:LabelList
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate ui:resultSet ;
      spl:valueType sp:Select ;
      rdfs:comment "The SELECT query delivering the nodes to display in its first column."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:forEach ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text ", "^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:gt ;
              sp:arg1 [
                  sp:varName "index"^^xsd:string ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
      ui:child [
          rdf:type lmdoc:Label ;
          tui:node [
              sp:varName "node"^^xsd:string ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:indexVar "index"^^xsd:string ;
      ui:resultSet [
          rdf:type sp:Select ;
          sp:resultVariables (
              _:b40132
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "resultSet"^^xsd:string ;
                  ] ;
                sp:predicate rdf:first ;
                sp:subject _:b33596 ;
              ]
              [
                sp:object _:b49932 ;
                sp:predicate rdf:rest ;
                sp:subject _:b33596 ;
              ]
              [
                sp:object 0 ;
                sp:predicate rdf:first ;
                sp:subject _:b49932 ;
              ]
              [
                sp:object () ;
                sp:predicate rdf:rest ;
                sp:subject _:b49932 ;
              ]
              [
                sp:object _:b40132 ;
                sp:predicate spr:colCells ;
                sp:subject _:b33596 ;
              ]
            ) ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A comma-separated list of values from a given result set. The individual values will be rendered into tui:Labels."^^xsd:string ;
  rdfs:label "Label list"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:Link
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate lmdoc:optionalLinkArgs ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Span ;
      html:class "tuiLink"^^xsd:string ;
      ui:child [
          rdf:type ui:createLink ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  rdf:type fn:concat ;
                  sp:arg1 [
                      sp:varName "link"^^xsd:string ;
                    ] ;
                  sp:arg2 "&" ;
                  sp:arg3 [
                      sp:varName "optionalLinkArgs"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:resource [
              sp:varName "node"^^xsd:string ;
            ] ;
          ui:sendQueryGraph "true"^^xsd:boolean ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A hyperlink to a resource, using the display label of the resource as text. Additional arguments may be passed in 'lmdoc:optionalArgs' for the rest call."^^xsd:string ;
  rdfs:label "Link"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:NonImportedResources
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:ns [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "resource"^^xsd:string ;
            ] ;
          sp:arg2 vaem:namespace ;
        ] ;
      ui:child [
          rdf:type html:H2 ;
          html:id "ns"^^xsd:string ;
          ui:child [
              rdf:type html:Span ;
              html:class "secno"^^xsd:string ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 1 ;
              ui:text "Non-Imported Resources"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type html:P ;
          ui:child [
              rdf:type html:Dd ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type lmdoc:ResourceLink ;
                      arg:resource [
                          sp:varName "usedResource"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:resultSet [
                      rdf:type sp:Select ;
                      sp:orderBy (
                          [
                            sp:varName "qname"^^xsd:string ;
                          ]
                        ) ;
                      sp:resultVariables (
                          [
                            sp:varName "usedResource"^^xsd:string ;
                          ]
                          [
                            sp:varName "qname"^^xsd:string ;
                          ]
                        ) ;
                      sp:where (
                          [
                            sp:object [
                                sp:varName "usedResource"^^xsd:string ;
                              ] ;
                            sp:predicate vaem:usesNonImportedResource ;
                            sp:subject [
                                sp:varName "resource"^^xsd:string ;
                              ] ;
                          ]
                          [
                            rdf:type sp:Bind ;
                            sp:expression [
                                rdf:type smf:qname ;
                                sp:arg1 [
                                    sp:varName "usedResource"^^xsd:string ;
                                  ] ;
                              ] ;
                            sp:variable [
                                sp:varName "qname"^^xsd:string ;
                              ] ;
                          ]
                        ) ;
                    ] ;
                  ui:separator " | "^^xsd:string ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Dt ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type html:P ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "The graph uses resources from other graphs that are not imported. These are shown below:"^^xsd:string ;
            ] ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "non-imported resources"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:OntologyView
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:ns [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "resource"^^xsd:string ;
            ] ;
          sp:arg2 vaem:namespace ;
        ] ;
      let:thisVersion [
          rdf:type xsd:string ;
          sp:arg1 [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              sp:arg2 owl:versionIRI ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:rdfxmlFileURL [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              sp:arg2 vaem:rdfxmlFileURL ;
            ] ;
          let:replacesVersion [
              rdf:type sp:coalesce ;
              sp:arg1 [
                  rdf:type spl:object ;
                  sp:arg1 [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  sp:arg2 dct:replaces ;
                ] ;
              sp:arg2 "none" ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:class "head"^^xsd:string ;
              html:id "respecHeader"^^xsd:string ;
              ui:child [
                  rdf:type html:Dl ;
                  ui:child [
                      rdf:type html:Dd ;
                      html:class "p-author h-card vcard"^^xsd:string ;
                      html:rel "bibo:editor"^^xsd:string ;
                      ui:child [
                          rdf:type html:Span ;
                          html:typeof "foaf:Person"^^xsd:string ;
                          ui:child [
                              rdf:type html:A ;
                              html:class "p-org org h-org h-card"^^xsd:string ;
                              html:href "http://www.topquadrant.com/"^^xsd:string ;
                              html:rel "foaf:workplaceHomepage"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "TopQuadrant, Inc"^^xsd:string ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type html:Span ;
                              html:class "p-name fn"^^xsd:string ;
                              html:property "foaf:name"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Ralph Hodgson"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text ", "^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 7 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type html:A ;
                          html:class "u-url"^^xsd:string ;
                          html:href [
                              sp:varName "ns"^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "ns"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type html:A ;
                          html:href [
                              sp:varName "thisVersion"^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "thisVersion"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              rdf:type spl:object ;
                              sp:arg1 [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                              sp:arg2 dct:modified ;
                            ] ;
                        ] ;
                      ui:childIndex 9 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dd ;
                      ui:child [
                          rdf:type ui:else ;
                          ui:child [
                              rdf:type html:A ;
                              html:href [
                                  sp:varName "replacesVersion"^^xsd:string ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      sp:varName "replacesVersion"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type ui:if ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "replacesVersion"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:condition [
                              rdf:type sp:eq ;
                              sp:arg1 [
                                  sp:varName "replacesVersion"^^xsd:string ;
                                ] ;
                              sp:arg2 "none" ;
                            ] ;
                        ] ;
                      ui:childIndex 5 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Editor:"^^xsd:string ;
                        ] ;
                      ui:childIndex 6 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Last Modified:"^^xsd:string ;
                        ] ;
                      ui:childIndex 8 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Latest published version:"^^xsd:string ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Previous published version:"^^xsd:string ;
                        ] ;
                      ui:childIndex 4 ;
                    ] ;
                  ui:child [
                      rdf:type html:Dt ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "This version:"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:H1 ;
                  html:class "title p-name"^^xsd:string ;
                  html:id "title"^^xsd:string ;
                  html:property "dct:title"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type ui:label ;
                          sp:arg1 [
                              sp:varName "resource"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type lmdoc:CopyrightSection ;
                  ui:childIndex 2 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              let:myLogo [
                  rdf:type sp:coalesce ;
                  sp:arg1 [
                      rdf:type spl:object ;
                      sp:arg1 [
                          sp:varName "resource"^^xsd:string ;
                        ] ;
                      sp:arg2 vaem:logo ;
                    ] ;
                  sp:arg2 "http://linkedmodel.org/lib/lm/images/logos/TopBraid-RDM-Graph-Logo.png" ;
                ] ;
              ui:child [
                  rdf:type html:Img ;
                  html:src [
                      sp:varName "myLogo"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:Hr ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type html:Section ;
              html:class "informative"^^xsd:string ;
              html:id "overview-of-ontology"^^xsd:string ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "margin: 40px 0 25px 0;"^^xsd:string ;
                  ui:childIndex 4 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "margin: 40px 0 25px 0;"^^xsd:string ;
                  ui:childIndex 6 ;
                ] ;
              ui:child [
                  rdf:type html:H2 ;
                  html:id "index-of-resources"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Specified Resources"^^xsd:string ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  ui:child [
                      rdf:type html:A ;
                      html:href "#ns"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Namespaces"^^xsd:string ;
                        ] ;
                      ui:childIndex 5 ;
                    ] ;
                  ui:child [
                      rdf:type html:Code ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "ns"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      rdf:type html:Em ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              rdf:type spl:object ;
                              sp:arg1 [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                              sp:arg2 vaem:namespacePrefix ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "All defined resources are within the "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text " namespace ("^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 4 ;
                      ui:text """).
The namespaces for all referenced vocabularies are giving in the section on """^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 6 ;
                      ui:text ". "^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type spl:object ;
                          sp:arg1 [
                              sp:varName "resource"^^xsd:string ;
                            ] ;
                          sp:arg2 vaem:intent ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type ui:call ;
                  arg:graph [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type html:Dd ;
                          ui:child [
                              rdf:type ui:forEach ;
                              ui:child [
                                  rdf:type lmdoc:ResourceLink ;
                                  arg:resource [
                                      sp:varName "class"^^xsd:string ;
                                    ] ;
                                  arg:title [
                                      rdf:type lmdoc:getDescription ;
                                      arg:resource [
                                          sp:varName "class"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:resultSet [
                                  sp:varName "classes"^^xsd:string ;
                                ] ;
                              ui:separator " | "^^xsd:string ;
                            ] ;
                          ui:childIndex 1 ;
