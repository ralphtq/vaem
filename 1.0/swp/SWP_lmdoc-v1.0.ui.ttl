                          ui:child [
                              rdf:type html:Dd ;
                              ui:child [
                                  rdf:type ui:else ;
                                  ui:child [
                                      rdf:type html:A ;
                                      html:href [
                                          sp:varName "previousVersion"^^xsd:string ;
