      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:abstract "true"^^xsd:boolean ;
  ui:headIncludes [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Link ;
          html:href [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/css/spin/spin.css"^^xsd:string ;
            ] ;
          ui:childIndex 3 ;
        ] ;
      ui:child [
          rdf:type html:Link ;
          html:href [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/vaem/css/lm.css"^^xsd:string ;
            ] ;
          html:rel "stylesheet"^^xsd:string ;
          html:type "text/css"^^xsd:string ;
          ui:childIndex 4 ;
        ] ;
      ui:child [
          rdf:type html:Meta ;
          html:content "TopBraid,RDF,OWL,SPARQL,SPIN,SWP,SPARQLMotion,LinkedData"^^xsd:string ;
          html:name "keywords"^^xsd:string ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:Meta ;
          html:content "TopQuadrant"^^xsd:string ;
          html:name "author"^^xsd:string ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type html:Meta ;
          html:content [
              rdf:type ui:concat ;
              sp:arg1 "Generated from RDF/OWL by TopBraid SWP on "^^xsd:string ;
              sp:arg2 [
                  rdf:type afn:now ;
                ] ;
            ] ;
          html:name "description"^^xsd:string ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type ui:CommentNode ;
          ui:childIndex 5 ;
          rdfs:comment "[if lt IE 9]><script src='https://www.w3.org/2008/site/js/html5shiv.js'></script><![endif]"^^xsd:string ;
        ] ;
