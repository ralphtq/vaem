lmdoc:getDefinition
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          _:b95165
        ) ;
      sp:where (
          [
            sp:object _:b95165 ;
            sp:predicate vaem:description ;
            sp:subject [
                sp:varName "resource"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:label "get definition"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:getDescription
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "description"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "description"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:AltPath ;
                sp:path1 [
                    rdf:type sp:AltPath ;
                    sp:path1 skos:definition ;
                    sp:path2 dct:description ;
                  ] ;
                sp:path2 vaem:description ;
              ] ;
            sp:subject [
                sp:varName "resource"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:label "get description"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:getTitle
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          _:b55599
        ) ;
      sp:where (
          [
            sp:object _:b55599 ;
            sp:predicate <http://purl.org/dc/elements/1.1/title> ;
            sp:subject [
                sp:varName "resource"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:label "get title"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:labelText
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          _:b90604
        ) ;
      sp:where (
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object _:b54653 ;
                    sp:predicate rdfs:label ;
                    sp:subject _:b4674 ;
                  ]
                )
                (
                  [
                    sp:object _:b54653 ;
                    sp:predicate skos:prefLabel ;
                    sp:subject _:b4674 ;
                  ]
                )
              ) ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 " -- " ;
                sp:arg2 _:b54653 ;
              ] ;
            sp:variable _:b90604 ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate tui:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "label text"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:makeAnchorFromResource
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "anchor"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:qname ;
                sp:arg1 [
                    sp:varName "resource"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "a1"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:regex ;
                sp:arg1 [
                    sp:varName "a1"^^xsd:string ;
                  ] ;
                sp:arg2 ":" ;
                sp:arg3 "_" ;
              ] ;
            sp:variable [
                sp:varName "anchor"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:label "make anchor from resource"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:makeAnchorFromString
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "anchor"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:regex ;
                sp:arg1 [
                    sp:varName "label"^^xsd:string ;
                  ] ;
                sp:arg2 " " ;
                sp:arg3 "_" ;
              ] ;
            sp:variable [
                sp:varName "anchor"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:label "make anchor from string"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
