                          arg:sectionHeading "Imported Graphs"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      rdf:type html:Section ;
                      html:id "non-imported-myGraphMetadatas"^^xsd:string ;
                      html:rel "bibo:Chapter"^^xsd:string ;
                      html:resource "#ref"^^xsd:string ;
                      html:typeof "bibo:Chapter"^^xsd:string ;
                      ui:child [
