          sp:arg2 vaem:namespace ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          letrs:imports [
              rdf:type sp:Select ;
              sp:orderBy (
                  [
                    sp:varName "importedGraph"^^xsd:string ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "importedGraph"^^xsd:string ;
                  ]
                  [
                    sp:varName "nameSpacePrefix"^^xsd:string ;
                  ]
                  [
                    sp:varName "slashOrHash"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    rdf:type sp:NamedGraph ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "importedGraph"^^xsd:string ;
                            ] ;
                          sp:predicate owl:imports ;
                          sp:subject [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ]
                        [
                          rdf:type sp:NamedGraph ;
                          sp:elements (
                              [
                                rdf:type sp:Union ;
                                sp:elements (
                                    (
                                      [
                                        rdf:type sp:Bind ;
                                        sp:expression [
                                            rdf:type sp:concat ;
                                            sp:arg1 [
                                                rdf:type xsd:string ;
                                                sp:arg1 [
                                                    sp:varName "importedGraph"^^xsd:string ;
                                                  ] ;
                                              ] ;
                                            sp:arg2 "/" ;
                                          ] ;
                                        sp:variable [
                                            sp:varName "uri"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        sp:object [
                                            sp:varName "nameSpacePrefix"^^xsd:string ;
                                          ] ;
                                        sp:predicate spif:prefix ;
                                        sp:subject [
                                            sp:varName "uri"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        rdf:type sp:Bind ;
                                        sp:expression "/" ;
                                        sp:variable [
                                            sp:varName "slashOrHash"^^xsd:string ;
                                          ] ;
                                      ]
                                    )
                                    (
                                      [
                                        rdf:type sp:Bind ;
                                        sp:expression [
                                            rdf:type sp:concat ;
                                            sp:arg1 [
                                                rdf:type xsd:string ;
                                                sp:arg1 [
                                                    sp:varName "importedGraph"^^xsd:string ;
                                                  ] ;
                                              ] ;
                                            sp:arg2 "#" ;
                                          ] ;
                                        sp:variable [
                                            sp:varName "uri"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        sp:object [
                                            sp:varName "nameSpacePrefix"^^xsd:string ;
                                          ] ;
                                        sp:predicate spif:prefix ;
                                        sp:subject [
                                            sp:varName "uri"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        rdf:type sp:Bind ;
                                        sp:expression "#" ;
                                        sp:variable [
                                            sp:varName "slashOrHash"^^xsd:string ;
                                          ] ;
                                      ]
                                    )
                                  ) ;
                              ]
                            ) ;
                          sp:graphNameNode [
                              sp:varName "importedGraph"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                    sp:graphNameNode [
                        sp:varName "graph"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type html:P ;
                  html:class "lm-para"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "None"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:H2 ;
                  html:id [
                      rdf:type lmdoc:makeAnchorFromString ;
                      arg:label [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  html:class "lm-para"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "An alphabetically ordered list of imported graphs is shown in the table below."^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "lm-table"^^xsd:string ;
                  ui:child [
                      rdf:type html:Tbody ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Tr ;
                              html:class "lm-row"^^xsd:string ;
                              ui:child [
                                  rdf:type html:Td ;
                                  html:class "lm-column"^^xsd:string ;
                                  ui:child [
                                      rdf:type html:A ;
                                      html:href [
                                          rdf:type sp:str ;
                                          sp:arg1 [
                                              sp:varName "importedGraph"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              rdf:type sp:str ;
                                              sp:arg1 [
                                                  sp:varName "importedGraph"^^xsd:string ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Td ;
                                  html:class "lm-column"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          sp:varName "nameSpacePrefix"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "imports"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      html:class "lm-table-header"^^xsd:string ;
                      ui:child [
                          rdf:type html:Tr ;
                          html:class "lm-row"^^xsd:string ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Graph URI"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Namespace Prefix"^^xsd:string ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "imports"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Imported Namespaces"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:IndexSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate vaem:namespacePrefix ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:ns [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "myGraphMetadata"^^xsd:string ;
                ] ;
              sp:arg2 vaem:namespace ;
            ] ;
          let:nsPrefix [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "myGraphMetadata"^^xsd:string ;
                ] ;
              sp:arg2 vaem:namespacePrefix ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:style "margin: 40px 0 25px 0;"^^xsd:string ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:style "margin: 40px 0 25px 0;"^^xsd:string ;
              ui:childIndex 5 ;
            ] ;
          ui:child [
              rdf:type html:H2 ;
              html:id [
                  rdf:type lmdoc:makeAnchorFromString ;
                  arg:label [
                      sp:varName "sectionHeading"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "sectionHeading"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              ui:child [
                  rdf:type html:Code ;
                  html:class "boxed"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "ns"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Code ;
                  html:class "boxed"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "nsPrefix"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "The main namespace for resources in this graph is "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text " with the prefix "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 4 ;
                  ui:text "."^^xsd:string ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              arg:graph [
                  sp:varName "graph"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:group ;
                  let:count [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "classes"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:else ;
                      ui:child [
                          rdf:type html:P ;
                          html:class "lm-para"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "No Classes Defined"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type html:H3 ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Classes"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:P ;
                          html:class "lm-para"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "The graph defines "^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text [
                                  sp:varName "count"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 2 ;
                              ui:text " classes, as indexed below:"^^xsd:string ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:MultiColumnList ;
                          arg:columns 4 ;
                          arg:resultSet [
                              sp:varName "classes"^^xsd:string ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          rdf:type sp:gt ;
                          sp:arg1 [
                              sp:varName "count"^^xsd:string ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 2 ;
              ui:template lmdoc:AllClasses ;
              ui:varName "classes"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              arg:graph [
                  sp:varName "graph"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:group ;
                  let:count [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "instances"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:else ;
                      ui:child [
                          rdf:type html:P ;
                          html:class "lm-para"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "No Instances Defined"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type html:H3 ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Instances"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:P ;
                          html:class "lm-para"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "The graph defines "^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text [
                                  sp:varName "count"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 2 ;
                              ui:text " instances, as indexed below:"^^xsd:string ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:MultiColumnList ;
                          arg:columns 4 ;
                          arg:resultSet [
                              sp:varName "instances"^^xsd:string ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          rdf:type sp:gt ;
                          sp:arg1 [
                              sp:varName "count"^^xsd:string ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 6 ;
              ui:template lmdoc:getInstancesOfTypeWithNamespacePrefix ;
              ui:varName "instances"^^xsd:string ;
              vaem:namespacePrefix [
                  sp:varName "namespacePrefix"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              arg:graph [
                  sp:varName "graph"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:group ;
                  let:count [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "properties"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:else ;
                      ui:child [
                          rdf:type html:P ;
                          html:class "lm-para"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "No Properties Defined"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type html:H3 ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Properties"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:P ;
                          html:class "lm-para"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "The graph defines "^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text [
                                  sp:varName "count"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 2 ;
                              ui:text " properties, as indexed below:"^^xsd:string ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:MultiColumnList ;
                          arg:columns 4 ;
                          arg:resultSet [
                              sp:varName "properties"^^xsd:string ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          rdf:type sp:gt ;
                          sp:arg1 [
                              sp:varName "count"^^xsd:string ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 4 ;
              ui:template lmdoc:AllProperties ;
              ui:varName "properties"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Index section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:InheritanceTable
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resourceSet ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type html:Table ;
          html:class "lm-table"^^xsd:string ;
          ui:child [
              rdf:type html:Tbody ;
              html:class "lm-table"^^xsd:string ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type html:Tr ;
                      html:class "lm-row"^^xsd:string ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column"^^xsd:string ;
                          ui:child [
                              rdf:type html:B ;
                              ui:child [
                                  rdf:type swa:Link ;
                                  arg:resource [
                                      sp:varName "super"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "depth"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 3 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:URIResourceViewer ;
                              arg:object [
                                  sp:varName "super"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 2 ;
                          ui:text """ 
            """^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:resultSet [
                      sp:varName "resourceSet"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Thead ;
              html:class "lm-table-header"^^xsd:string ;
              ui:child [
                  rdf:type html:Tr ;
                  html:class "lm-row"^^xsd:string ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Depth"^^xsd:string ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "QName"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Superclass"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue lmdoc:createLinkForMainForm ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Inheritance table"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:Instance
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:errorPrototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type ui:group ;
              let:myGraphMetadata [
                  rdf:type spl:objectInGraph ;
                  sp:arg1 [
                      sp:varName "myGraph"^^xsd:string ;
                    ] ;
                  sp:arg2 vaem:hasGraphMetadata ;
                  sp:arg3 [
                      rdf:type sp:iri ;
                      sp:arg1 [
                          sp:varName "graph"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:P ;
                      html:class "lm-para"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "No graph metadata for graph "^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition "(!bound(?myGraphMetadata))"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Missing graph value"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition "(!bound(?graph))"^^xsd:string ;
        ] ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type sp:iri ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:myGraphMetadata [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "myGraph"^^xsd:string ;
                ] ;
              sp:arg2 vaem:hasGraphMetadata ;
            ] ;
          ui:child [
              rdf:type ui:group ;
              let:myOverlay [
                  rdf:type sp:iri ;
                  sp:arg1 [
                      rdf:type sp:coalesce ;
                      sp:arg1 [
                          sp:varName "overlay"^^xsd:string ;
                        ] ;
                      sp:arg2 ui:tempGraph ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type ui:setContext ;
                      ui:child [
                          rdf:type ui:setContext ;
                          ui:child [
                              rdf:type ui:setContext ;
                              ui:child [
                                  rdf:type ui:group ;
                                  let:myGraphMetadata [
                                      rdf:type spl:object ;
                                      sp:arg1 [
                                          sp:varName "myGraph"^^xsd:string ;
                                        ] ;
                                      sp:arg2 vaem:hasGraphMetadata ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:call ;
                                      arg:subject [
                                          sp:varName "resource"^^xsd:string ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Dd ;
                                          html:class "size-14"^^xsd:string ;
                                          ui:child [
                                              rdf:type lmdoc:ObjectsBody ;
                                              arg:predicate rdf:type ;
                                              arg:subject [
                                                  sp:varName "instance"^^xsd:string ;
                                                ] ;
                                              ui:args "*"^^xsd:string ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 3 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Div ;
                                          html:class "swa-sub-title"^^xsd:string ;
                                          ui:child [
                                              rdf:type ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text "Description"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 5 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Div ;
                                          html:class "swa-sub-title"^^xsd:string ;
                                          ui:child [
                                              rdf:type ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text "Type"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 2 ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:resourceView ;
                                          ui:childIndex 6 ;
                                          ui:matchIds "description"^^xsd:string ;
                                          ui:resource [
                                              sp:varName "resource"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:child [
                                          rdf:type lmdoc:ObjectsGroup ;
                                          arg:filterFunction swa:isAnnotationProperty ;
                                          arg:label "Annotations"^^xsd:string ;
                                          arg:predicates [
                                              sp:varName "rs"^^xsd:string ;
                                            ] ;
                                          arg:subject [
                                              sp:varName "resource"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 10 ;
                                        ] ;
                                      ui:child [
                                          rdf:type lmdoc:ObjectsGroup ;
                                          arg:filterFunction swa:isNonAnnotationProperty ;
                                          arg:label "Properties"^^xsd:string ;
                                          arg:predicates [
                                              sp:varName "rs"^^xsd:string ;
                                            ] ;
                                          arg:subject [
                                              sp:varName "resource"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 8 ;
                                        ] ;
                                      ui:child [
                                          rdf:type lmdoc:ResourceFooter ;
                                          arg:options "CSV,JSONLD,RDF,TURTLE"^^xsd:string ;
                                          arg:resource [
                                              sp:varName "resource"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 12 ;
                                        ] ;
                                      ui:child [
                                          rdf:type lmdoc:ResourceHeader ;
                                          arg:node [
                                              sp:varName "resource"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:child [
                                          rdf:type lmdoc:VSpace ;
                                          arg:margin "20px;"^^xsd:string ;
                                          ui:childIndex 1 ;
                                        ] ;
                                      ui:child [
                                          rdf:type lmdoc:VSpace ;
                                          arg:margin "30px;"^^xsd:string ;
                                          ui:childIndex 4 ;
                                        ] ;
                                      ui:child [
                                          rdf:type lmdoc:VSpace ;
                                          arg:margin "30px;"^^xsd:string ;
                                          ui:childIndex 7 ;
                                        ] ;
                                      ui:child [
                                          rdf:type lmdoc:VSpace ;
                                          arg:margin "30px;"^^xsd:string ;
                                          ui:childIndex 9 ;
                                        ] ;
                                      ui:child [
                                          rdf:type lmdoc:VSpace ;
                                          arg:margin "40px;"^^xsd:string ;
                                          ui:childIndex 11 ;
                                        ] ;
                                      ui:childIndex 1 ;
                                      ui:template [
                                          rdf:type swa:modeProperty ;
                                          arg:predicate swa:formObjectPredicateSelectionTemplate ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      rdf:type lmdoc:Footer ;
                                      ui:childIndex 2 ;
                                    ] ;
                                  ui:child [
                                      rdf:type lmdoc:PartHeader ;
                                      arg:metadata [
                                          sp:varName "myGraphMetadata"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:queryGraph [
                                  rdf:type ui:unionOfGraphs ;
                                  sp:arg1 [
                                      rdf:type ui:graphWithImports ;
                                      sp:arg1 [
                                          sp:varName "myGraph"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  sp:arg2 [
                                      rdf:type ui:graphWithImports ;
                                      sp:arg1 [
                                          sp:varName "myOverlay"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  sp:arg3 [
                                      rdf:type ui:graphWithImports ;
                                      sp:arg1 <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
                                    ] ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:varName "graph"^^xsd:string ;
                          ui:varValue [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:varName "catalogGraph"^^xsd:string ;
                      ui:varValue [
                          sp:varName "catalogGraph"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "flags"^^xsd:string ;
                  ui:varValue [
                      sp:varName "flags"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  vaem:todo "remove dependency on swa.css"^^xsd:string ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=lmdoc:Instance&graph=http://www.linkedmodel.org/2.0/schema/vaem&resource=http%3A%2F%2Fwww.linkedmodel.org%2Fschema%2Fvaem%23ScriptGraph"""^^xsd:string ;
  rdfs:label "Instance Documentation"^^xsd:string ;
  rdfs:subClassOf lmdoc:Pages ;
.
lmdoc:InstancesGeneratorSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      let:tableId "lm_resources"^^xsd:string ;
      ui:child [
          rdf:type html:Div ;
          html:style "margin: 40px 0 25px 0;"^^xsd:string ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type ui:call ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "padding:20px;"^^xsd:string ;
                  ui:child [
                      rdf:type html:Button ;
                      html:class "lm-button"^^xsd:string ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "lmdoc.clearSelection('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "tableId"^^xsd:string ;
                            ] ;
                          sp:arg3 "')"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Clear Selections"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Button ;
                      html:class "lm-button"^^xsd:string ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "lmdoc.selectAll('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "tableId"^^xsd:string ;
                            ] ;
                          sp:arg3 "')"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Select All"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Button ;
                      html:class "lm-button"^^xsd:string ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "lmtest.acceptSelection('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "tableId"^^xsd:string ;
                            ] ;
                          sp:arg3 "', '"^^xsd:string ;
                          sp:arg4 [
                              rdf:type xsd:string ;
                              sp:arg1 [
                                  sp:varName "graph"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:arg5 "', '"^^xsd:string ;
                          sp:arg6 [
                              sp:varName "overlay"^^xsd:string ;
                            ] ;
                          sp:arg7 "')"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Accept Selections"^^xsd:string ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:H2 ;
                  html:id [
                      rdf:type lmdoc:makeAnchorFromString ;
                      arg:label [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "lm-table"^^xsd:string ;
                  html:id [
                      sp:varName "tableId"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type html:Tbody ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Div ;
                              let:id [
                                  rdf:type ui:uniqueId ;
                                ] ;
                              ui:child [
                                  rdf:type html:Tr ;
                                  html:class "lm-row"^^xsd:string ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      html:id [
                                          rdf:type fn:concat ;
                                          sp:arg1 "td-resource_" ;
                                          sp:arg2 [
                                              sp:varName "id"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              rdf:type xsd:string ;
                                              sp:arg1 [
                                                  sp:varName "instance"^^xsd:string ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      ui:child [
                                          rdf:type html:Button ;
                                          html:class "lm-button"^^xsd:string ;
                                          html:onclick [
                                              rdf:type ui:concat ;
                                              sp:arg1 "lmtest.generate('"^^xsd:string ;
                                              sp:arg2 [
                                                  rdf:type xsd:string ;
                                                  sp:arg1 [
                                                      sp:varName "instance"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              sp:arg3 "','"^^xsd:string ;
                                              sp:arg4 [
                                                  rdf:type xsd:string ;
                                                  sp:arg1 [
                                                      sp:varName "graph"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              sp:arg5 "','"^^xsd:string ;
                                              sp:arg6 [
                                                  sp:varName "overlay"^^xsd:string ;
                                                ] ;
                                              sp:arg7 "')"^^xsd:string ;
                                            ] ;
                                          ui:child [
                                              rdf:type ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text "View"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 2 ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      ui:child [
                                          rdf:type html:Input ;
                                          html:name [
                                              rdf:type ui:concat ;
                                              sp:arg1 [
                                                  rdf:type fn:concat ;
                                                  sp:arg1 "CB_" ;
                                                  sp:arg2 [
                                                      sp:varName "id"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              sp:arg2 " "^^xsd:string ;
                                            ] ;
                                          html:type "checkbox"^^xsd:string ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 3 ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              sp:varName "qName"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "instances"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      html:class "lm-table-header"^^xsd:string ;
                      ui:child [
                          rdf:type html:Tr ;
                          html:class "lm-row"^^xsd:string ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Generate"^^xsd:string ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Quick Look"^^xsd:string ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "URI"^^xsd:string ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "instances"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:getInstancesOfTypeWithNamespacePrefix ;
          ui:varName "instances"^^xsd:string ;
        ] ;
      ui:child [
          rdf:type lmdoc:VSpace ;
          arg:margin "40px;"^^xsd:string ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Instances generator section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:InstancesList
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type sp:iri ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:myGraphMetadata [
              rdf:type spl:objectInGraph ;
              sp:arg1 [
                  sp:varName "myGraph"^^xsd:string ;
                ] ;
              sp:arg2 vaem:hasGraphMetadata ;
              sp:arg3 [
                  sp:varName "myGraph"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:group ;
              let:myOverlay [
                  rdf:type sp:iri ;
                  sp:arg1 [
                      rdf:type sp:coalesce ;
                      sp:arg1 [
                          sp:varName "overlay"^^xsd:string ;
                        ] ;
                      sp:arg2 ui:tempGraph ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type ui:setContext ;
                      ui:child [
                          rdf:type html:Section ;
                          html:class "details"^^xsd:string ;
                          html:id "details"^^xsd:string ;
                          html:property "dct:abstract"^^xsd:string ;
                          html:rel "bibo:Chapter"^^xsd:string ;
                          html:resource "#ref"^^xsd:string ;
                          html:typeof "bibo:Chapter"^^xsd:string ;
                          ui:child [
                              rdf:type html:Section ;
                              html:class "informative"^^xsd:string ;
                              html:id "instances"^^xsd:string ;
                              ui:child [
                                  rdf:type lmdoc:InstancesTable ;
                                  arg:graph [
                                      sp:varName "myGraph"^^xsd:string ;
                                    ] ;
                                  arg:overlay [
                                      sp:varName "overlay"^^xsd:string ;
                                    ] ;
                                  arg:sectionHeading "Instances"^^xsd:string ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 4 ;
                        ] ;
                      ui:child [
                          rdf:type html:Section ;
                          html:class "introductory"^^xsd:string ;
                          html:id "abstract"^^xsd:string ;
                          html:property "dct:abstract"^^xsd:string ;
                          html:rel "bibo:Chapter"^^xsd:string ;
                          html:resource "#ref"^^xsd:string ;
                          html:typeof "bibo:Chapter"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:AbstractSection ;
                              arg:metadata [
                                  sp:varName "myGraphMetadata"^^xsd:string ;
                                ] ;
                              arg:sectionHeading "Abstract"^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 3 ;
                        ] ;
                      ui:child [
                          rdf:type ui:if ;
                          ui:child [
                              rdf:type debug-swa:DumpTriplesForResourceAsSubject ;
                              arg:resource [
                                  rdf:type ui:concat ;
                                  sp:arg1 [
                                      sp:varName "myGraphMetadata"^^xsd:string ;
                                    ] ;
                                  sp:arg2 " "^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 2 ;
                          ui:condition [
                              rdf:type fn:contains ;
                              sp:arg1 [
                                  sp:varName "flags"^^xsd:string ;
                                ] ;
                              sp:arg2 "Sgmd" ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:if ;
                          ui:child [
                              rdf:type html:P ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Current query graph is "^^xsd:string ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 1 ;
                                  ui:text [
                                      rdf:type ui:currentQueryGraph ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                          ui:condition [
                              rdf:type fn:contains ;
                              sp:arg1 [
                                  sp:varName "flags"^^xsd:string ;
                                ] ;
                              sp:arg2 "Sqg" ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:GraphHeader ;
                          arg:metadata [
                              sp:varName "myGraphMetadata"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:queryGraph [
                          rdf:type ui:unionOfGraphs ;
                          sp:arg1 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                          sp:arg2 [
                              rdf:type ui:graphWithImports ;
                              sp:arg1 <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
                            ] ;
                          sp:arg3 [
                              rdf:type ui:graphWithImports ;
                              sp:arg1 [
                                  sp:varName "myOverlay"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "flags"^^xsd:string ;
                  ui:varValue [
                      sp:varName "flags"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Instances List"^^xsd:string ;
  rdfs:subClassOf lmdoc:Pages ;
.
lmdoc:InstancesMaintainer
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type lmdoc:ResourcesMaintainer ;
          arg:flags [
              sp:varName "flags"^^xsd:string ;
            ] ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          arg:heading "Instances Maintainer"^^xsd:string ;
          arg:overlay [
              sp:varName "overlay"^^xsd:string ;
            ] ;
          arg:template lmdoc:getInstancesOfTypeWithNamespacePrefix ;
          arg:view lmdoc:Instance ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Instances Mainrainer"^^xsd:string ;
  rdfs:subClassOf lmdoc:Pages ;
.
lmdoc:InstancesSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:style "margin: 40px 0 25px 0;"^^xsd:string ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:call ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:H2 ;
                  html:id [
                      rdf:type lmdoc:makeAnchorFromString ;
                      arg:label [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type ui:call ;
                      arg:subject [
                          sp:varName "instance"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "lm-header-box"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:ResourceDocAnchor ;
                              arg:node [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              arg:typeLabel "Instance "^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "lm-resource-box"^^xsd:string ;
                          ui:child [
                              rdf:type html:Dd ;
                              html:class "size-14"^^xsd:string ;
                              ui:child [
                                  rdf:type lmdoc:ObjectsBody ;
                                  arg:predicate rdf:type ;
                                  arg:subject [
                                      sp:varName "instance"^^xsd:string ;
                                    ] ;
                                  ui:args "*"^^xsd:string ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type html:Div ;
                              html:class "swa-sub-title"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Description"^^xsd:string ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type html:Div ;
                              html:class "swa-sub-title"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Type"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:MaybeDescription ;
                              arg:node [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 4 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isAnnotationProperty ;
                              arg:label "Annotations"^^xsd:string ;
                              arg:predicates [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 8 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isNonAnnotationProperty ;
                              arg:label "Properties"^^xsd:string ;
                              arg:predicates [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 6 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ResourceFooter ;
                              arg:options "CSV,JSONLD,RDF,TURTLE"^^xsd:string ;
                              arg:resource [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 10 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "30px;"^^xsd:string ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "30px;"^^xsd:string ;
                              ui:childIndex 5 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "30px;"^^xsd:string ;
                              ui:childIndex 7 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "40px;"^^xsd:string ;
                              ui:childIndex 9 ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:VSpace ;
                          arg:margin "20px;"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:template [
                          rdf:type swa:modeProperty ;
                          arg:predicate swa:formObjectPredicateSelectionTemplate ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:VSpace ;
                      arg:margin "40px;"^^xsd:string ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "instances"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "instances"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:getInstancesOfTypeWithNamespacePrefix ;
          ui:varName "instances"^^xsd:string ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Instances section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:InstancesTable
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      let:tableId "lm_resources"^^xsd:string ;
      ui:child [
          rdf:type html:Div ;
          html:style "margin: 40px 0 25px 0;"^^xsd:string ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type ui:call ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:H2 ;
                  html:id [
                      rdf:type lmdoc:makeAnchorFromString ;
                      arg:label [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "lm-table"^^xsd:string ;
                  html:id [
                      sp:varName "tableId"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type html:Tbody ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Div ;
                              let:id [
                                  rdf:type ui:uniqueId ;
                                ] ;
                              ui:child [
                                  rdf:type html:Tr ;
                                  html:class "lm-row"^^xsd:string ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      html:id [
                                          rdf:type fn:concat ;
                                          sp:arg1 "td-resource_" ;
                                          sp:arg2 [
                                              sp:varName "id"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              rdf:type xsd:string ;
                                              sp:arg1 [
                                                  sp:varName "instance"^^xsd:string ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              sp:varName "qName"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      ui:child [
                                          rdf:type lmdoc:MaybeDescriptionUsingProperty ;
                                          arg:node [
                                              sp:varName "instance"^^xsd:string ;
                                            ] ;
                                          arg:property vaem:description ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 2 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "instances"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      html:class "lm-table-header"^^xsd:string ;
                      ui:child [
                          rdf:type html:Tr ;
                          html:class "lm-row"^^xsd:string ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Description"^^xsd:string ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "URI"^^xsd:string ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "instances"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:getInstancesOfTypeWithNamespacePrefix ;
          ui:varName "instances"^^xsd:string ;
        ] ;
      ui:child [
          rdf:type lmdoc:Footer ;
          ui:childIndex 3 ;
        ] ;
      ui:child [
          rdf:type lmdoc:VSpace ;
          arg:margin "40px;"^^xsd:string ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Instances table section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:IsDefinedInGraph
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Ask ;
      sp:where (
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:bound ;
                sp:arg1 [
                    sp:varName "graph"^^xsd:string ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                  sp:predicate rdfs:isDefinedBy ;
                  sp:subject [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "Is defined in graph"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:Label
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      rdfs:comment "The RDF node to display."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:A ;
                  html:href [
                      sp:varName "node"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:eq ;
                  sp:arg1 xsd:anyURI ;
                  sp:arg2 [
                      rdf:type sp:datatype ;
                      sp:arg1 [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:isLiteral ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:resourceView ;
              ui:childIndex 0 ;
              ui:matchIds "label"^^xsd:string ;
              ui:resource [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 2 ;
          ui:condition [
              rdf:type sp:isBlank ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type lmdoc:URIResourceViewer ;
              arg:object [
                  sp:varName "node"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
          ui:condition [
              rdf:type sp:isIRI ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Displays an arbitrary RDF node. If the node is a resource, then this will use the configured resource display with id=\"label\" (e.g., the tui:Link). Literals of type xsd:anyURI are turned into hyperlinks. All other literals will be rendered as a simple text node with CSS class tuiLabel, with the text derived using ui:label()."^^xsd:string ;
  rdfs:label "Label"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:LabelList
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resultSet ;
      spl:valueType sp:Select ;
      rdfs:comment "The SELECT query delivering the nodes to display in its first column."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Ol ;
          ui:child [
              rdf:type ui:forEach ;
              ui:child [
                  rdf:type html:Li ;
                  ui:child [
                      rdf:type lmdoc:Label ;
                      arg:node [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:resultSet [
                  rdf:type sp:Select ;
                  sp:resultVariables (
                      [
                        sp:varName "node"^^xsd:string ;
                      ]
                    ) ;
                  sp:where (
                      [
                        sp:object [
                            sp:varName "resultSet"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object 0 ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "node"^^xsd:string ;
                          ] ;
                        sp:predicate spr:colCells ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A list of values from a given result set. The individual values will be rendered into lmdoc:Labels."^^xsd:string ;
  rdfs:label "Label list"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:LabeledObjects
  rdf:type ui:NodeClass ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Tr ;
          html:class "lm-row"^^xsd:string ;
          ui:child [
              rdf:type html:Td ;
              html:class "lm-column align-top"^^xsd:string ;
              ui:child [
                  rdf:type lmdoc:URIResourceViewer ;
                  arg:label [
                      rdf:type sp:if ;
                      sp:arg1 [
                          rdf:type sp:bound ;
                          sp:arg1 [
                              sp:varName "label"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          sp:varName "label"^^xsd:string ;
                        ] ;
                      sp:arg3 [
                          rdf:type ui:label ;
                          sp:arg1 [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  arg:object [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:Td ;
              html:class "lm-column"^^xsd:string ;
              html:id [
                  rdf:type ui:concat ;
                  sp:arg1 [
                      sp:varName "pid"^^xsd:string ;
                    ] ;
                  sp:arg2 "-body"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type lmdoc:ObjectsBody ;
                      ui:args "*"^^xsd:string ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "viewWidget"^^xsd:string ;
                  ui:varValue [
                      sp:varName "viewWidget"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Labeled objects"^^xsd:string ;
  rdfs:subClassOf swa:Objects ;
.
lmdoc:Link
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate lmdoc:optionalLinkArgs ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Span ;
      html:class "tuiLink"^^xsd:string ;
      ui:child [
          rdf:type ui:createLink ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  rdf:type fn:concat ;
                  sp:arg1 [
                      sp:varName "link"^^xsd:string ;
                    ] ;
                  sp:arg2 "&" ;
                  sp:arg3 [
                      sp:varName "optionalLinkArgs"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:resource [
              sp:varName "node"^^xsd:string ;
            ] ;
          ui:sendQueryGraph "true"^^xsd:boolean ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A hyperlink to a resource, using the display label of the resource as text. Additional arguments may be passed in 'lmdoc:optionalArgs' for the rest call."^^xsd:string ;
  rdfs:label "Link"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:LiteralViewer
  rdf:type swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:eq ;
          sp:arg1 [
              sp:varName "kind"^^xsd:string ;
            ] ;
          sp:arg2 "literal" ;
        ] ;
      swa:weight 50 ;
    ] ;
  ui:overrides swa:LiteralViewer ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type html:Div ;
      html:class "swa-shifted-label"^^xsd:string ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "object"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type swa:LangDisplay ;
                  arg:lang [
                      rdf:type sp:lang ;
                      sp:arg1 [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
              ui:condition [
                  rdf:type sp:ne ;
                  sp:arg1 [
                      rdf:type sp:lang ;
                      sp:arg1 [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 "" ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type fn:starts-with ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
              sp:arg2 "http" ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A node viewer for literal values, displaying the literal's text. If a language tag is present, then this will be displayed behind the text."^^xsd:string ;
  rdfs:label "Literal viewer"^^xsd:string ;
  rdfs:subClassOf swa:LiteralViewer ;
.
lmdoc:MagicProperties
  rdf:type spin:MagicProperty ;
  rdfs:label "Magic properties"^^xsd:string ;
  rdfs:subClassOf spin:MagicProperties ;
.
lmdoc:MaybeDescription
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type lmdoc:MaybeDescriptionUsingProperty ;
          arg:node [
              sp:varName "node"^^xsd:string ;
            ] ;
          arg:property dct:description ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type lmdoc:MaybeDescriptionUsingProperty ;
          arg:node [
              sp:varName "node"^^xsd:string ;
            ] ;
          arg:property vaem:description ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type lmdoc:MaybeDescriptionUsingProperty ;
          arg:node [
              sp:varName "node"^^xsd:string ;
            ] ;
          arg:property rdfs:comment ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Maybe Description"^^xsd:string ;
  rdfs:label "Maybe Description"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:MaybeDescriptionUsingProperty
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:desc [
          rdf:type sp:coalesce ;
          sp:arg1 [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
              sp:arg2 [
                  sp:varName "property"^^xsd:string ;
                ] ;
            ] ;
          sp:arg2 "Nothing" ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type html:P ;
                  html:class "lm-para"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "desc"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:P ;
                  html:class "lm-para"^^xsd:string ;
                  ui:child [
                      rdf:type ui:parse ;
                      ui:childIndex 0 ;
                      ui:str [
                          rdf:type sp:str ;
                          sp:arg1 [
                              sp:varName "desc"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:eq ;
                  sp:arg1 [
                      rdf:type sp:str ;
                      sp:arg1 [
                          rdf:type sp:datatype ;
                          sp:arg1 [
                              sp:varName "desc"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  sp:arg2 "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML" ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:ne ;
              sp:arg1 [
                  rdf:type sp:str ;
                  sp:arg1 [
                      sp:varName "desc"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 "Nothing" ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Maybe Description using property"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:MaybeHTMLstring
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:desc [
          rdf:type sp:coalesce ;
          sp:arg1 [
              rdf:type spl:object ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
              sp:arg2 lmdoc:htmlString ;
            ] ;
          sp:arg2 "Nothing" ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              ui:child [
                  rdf:type ui:parse ;
                  ui:childIndex 0 ;
                  ui:str [
                      sp:varName "desc"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:ne ;
              sp:arg1 [
                  sp:varName "desc"^^xsd:string ;
                ] ;
              sp:arg2 "Nothing" ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Maybe an HTML string"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:MultiColumnList
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:titleFunction ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:columns ;
      spl:valueType xsd:integer ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resultSet ;
      spl:valueType sp:Select ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:count [
          rdf:type spr:rowCount ;
          sp:arg1 [
              sp:varName "resultSet"^^xsd:string ;
            ] ;
        ] ;
      let:myTitleFunction [
          rdf:type sp:coalesce ;
          sp:arg1 [
              sp:varName "titleFunction"^^xsd:string ;
            ] ;
          sp:arg2 [
              rdf:type ui:contextValue ;
              sp:arg1 "title-function" ;
            ] ;
          sp:arg3 lmdoc:defaultTitleFunction ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Table ;
              html:class "lm-index-table"^^xsd:string ;
              let:max [
                  rdf:type sp:floor ;
                  sp:arg1 [
                      rdf:type sp:divide ;
                      sp:arg1 [
                          rdf:type xsd:integer ;
                          sp:arg1 [
                              sp:varName "count"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          rdf:type xsd:integer ;
                          sp:arg1 [
                              sp:varName "columns"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type html:Tbody ;
                  html:class "lm-index-table"^^xsd:string ;
                  ui:child [
                      rdf:type ui:forEach ;
                      ui:child [
                          rdf:type ui:if ;
                          ui:child [
                              rdf:type html:Tr ;
                              html:class "lm-index-table-row"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:forEach ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-index-table-cell"^^xsd:string ;
                                      ui:child [
                                          rdf:type ui:if ;
                                          ui:child [
                                              rdf:type ui:group ;
                                              let:cell [
                                                  rdf:type spr:cell ;
                                                  sp:arg1 [
                                                      sp:varName "resultSet"^^xsd:string ;
                                                    ] ;
                                                  sp:arg2 [
                                                      sp:varName "row"^^xsd:string ;
                                                    ] ;
                                                  sp:arg3 0 ;
                                                ] ;
                                              ui:child [
                                                  rdf:type lmdoc:ResourceLink ;
                                                  arg:resource [
                                                      sp:varName "cell"^^xsd:string ;
                                                    ] ;
                                                  arg:title [
                                                      rdf:type smf:invoke ;
                                                      sp:arg1 [
                                                          sp:varName "myTitleFunction"^^xsd:string ;
                                                        ] ;
                                                      sp:arg2 [
                                                          sp:varName "cell"^^xsd:string ;
                                                        ] ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                          ui:condition [
                                              rdf:type sp:lt ;
                                              sp:arg1 [
                                                  sp:varName "row"^^xsd:string ;
                                                ] ;
                                              sp:arg2 [
                                                  sp:varName "count"^^xsd:string ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:resultSet [
                                      rdf:type sp:Select ;
                                      sp:resultVariables (
                                          [
                                            sp:varName "row"^^xsd:string ;
                                          ]
                                        ) ;
                                      sp:where (
                                          [
                                            sp:object [
                                                sp:varName "?0"^^xsd:string ;
                                              ] ;
                                            sp:predicate tops:for ;
                                            sp:subject [
                                                sp:varName "innerIndex"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object 1 ;
                                            sp:predicate rdf:first ;
                                            sp:subject [
                                                sp:varName "?0"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object [
                                                sp:varName "?1"^^xsd:string ;
                                              ] ;
                                            sp:predicate rdf:rest ;
                                            sp:subject [
                                                sp:varName "?0"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object [
                                                sp:varName "columns"^^xsd:string ;
                                              ] ;
                                            sp:predicate rdf:first ;
                                            sp:subject [
                                                sp:varName "?1"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object () ;
                                            sp:predicate rdf:rest ;
                                            sp:subject [
                                                sp:varName "?1"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            rdf:type sp:Bind ;
                                            sp:expression [
                                                rdf:type sp:sub ;
                                                sp:arg1 [
                                                    rdf:type sp:add ;
                                                    sp:arg1 [
                                                        sp:varName "rowOffset"^^xsd:string ;
                                                      ] ;
                                                    sp:arg2 [
                                                        sp:varName "innerIndex"^^xsd:string ;
                                                      ] ;
                                                  ] ;
                                                sp:arg2 1 ;
                                              ] ;
                                            sp:variable [
                                                sp:varName "row"^^xsd:string ;
                                              ] ;
                                          ]
                                        ) ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:condition [
                              rdf:type sp:lt ;
                              sp:arg1 [
                                  sp:varName "rowOffset"^^xsd:string ;
                                ] ;
                              sp:arg2 [
                                  sp:varName "count"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:resultSet [
                          rdf:type sp:Select ;
                          sp:resultVariables (
                              [
                                sp:varName "rowOffset"^^xsd:string ;
                              ]
                            ) ;
                          sp:where (
                              [
                                sp:object [
                                    sp:varName "?0"^^xsd:string ;
                                  ] ;
                                sp:predicate tops:for ;
                                sp:subject [
                                    sp:varName "index"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object 0 ;
                                sp:predicate rdf:first ;
                                sp:subject [
                                    sp:varName "?0"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object [
                                    sp:varName "?1"^^xsd:string ;
                                  ] ;
                                sp:predicate rdf:rest ;
                                sp:subject [
                                    sp:varName "?0"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object [
                                    sp:varName "max"^^xsd:string ;
                                  ] ;
                                sp:predicate rdf:first ;
                                sp:subject [
                                    sp:varName "?1"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object () ;
                                sp:predicate rdf:rest ;
                                sp:subject [
                                    sp:varName "?1"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                rdf:type sp:Bind ;
                                sp:expression [
                                    rdf:type sp:mul ;
                                    sp:arg1 [
                                        sp:varName "columns"^^xsd:string ;
                                      ] ;
                                    sp:arg2 [
                                        sp:varName "index"^^xsd:string ;
                                      ] ;
                                  ] ;
                                sp:variable [
                                    sp:varName "rowOffset"^^xsd:string ;
                                  ] ;
                              ]
                            ) ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:gt ;
              sp:arg1 [
                  sp:varName "count"^^xsd:string ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
    ] ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:MyBNodeViewer
  rdf:type swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:eq ;
          sp:arg1 [
              sp:varName "kind"^^xsd:string ;
            ] ;
          sp:arg2 "blank" ;
        ] ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type html:Div ;
      html:class "swa-shifted-label"^^xsd:string ;
      ui:child [
          rdf:type html:Pre ;
          html:class "query"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  rdf:type ui:label ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type ui:CommentNode ;
          ui:childIndex 1 ;
          rdfs:comment "ui:resourceView ui:matchIds=\"showbnode\" ui:resource=\"{= ?object }\"/"^^xsd:string ;
        ] ;
    ] ;
  rdfs:comment "My object viewer for blank nodes."^^xsd:string ;
  rdfs:label "BNode viewer"^^xsd:string ;
  rdfs:subClassOf swa:BNodeViewer ;
.
lmdoc:NonImportedResources
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:metadata ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:ns [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "metadata"^^xsd:string ;
            ] ;
          sp:arg2 vaem:namespace ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          letrs:nonImportedResources [
              rdf:type sp:Select ;
              sp:orderBy (
                  [
                    sp:varName "qname"^^xsd:string ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "usedResource"^^xsd:string ;
                  ]
                  [
                    sp:varName "qname"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "usedResource"^^xsd:string ;
                      ] ;
                    sp:predicate vaem:usesNonImportedResource ;
                    sp:subject [
                        sp:varName "metadata"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        rdf:type smf:qname ;
                        sp:arg1 [
                            sp:varName "usedResource"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:variable [
                        sp:varName "qname"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type ui:group ;
              let:count [
                  rdf:type spr:rowCount ;
                  sp:arg1 [
                      sp:varName "nonImportedResources"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:H2 ;
                      html:id [
                          rdf:type lmdoc:makeAnchorFromString ;
                          arg:label [
                              sp:varName "sectionHeading"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "sectionHeading"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:P ;
                      html:class "lm-para"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "The graph uses "^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text [
                              sp:varName "count"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 2 ;
                          ui:text " resources from other graphs that are not imported, as listed below:"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:MultiColumnList ;
                      arg:columns 5 ;
                      arg:resultSet [
                          sp:varName "nonImportedResources"^^xsd:string ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          sp:varName "count"^^xsd:string ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "non-imported resources"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:ObjectElements
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:elementId ;
      spl:valueType xsd:string ;
      rdfs:comment "An optional HTML ID for the element containing this object."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The subject resource of the form or widget. May be left empty in which case the subjectType will be used."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicate ;
      spl:valueType rdf:Property ;
      rdfs:comment "The predicate."^^xsd:string ;
    ] ;
  rdfs:subClassOf lmdoc:ViewElements ;
.
lmdoc:ObjectViewer
  rdf:type swa:ObjectViewerClass ;
  ui:overrides swa:ObjectViewer ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type html:Div ;
      html:class "swa-object-widget"^^xsd:string ;
      let:class [
          rdf:type sp:coalesce ;
          sp:arg1 [
              rdf:type ui:contextValue ;
              sp:arg1 "viewWidget" ;
            ] ;
          sp:arg2 [
              rdf:type swa:bestObjectViewerClass ;
              arg:object [
                  sp:varName "object"^^xsd:string ;
                ] ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "subject"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "[Error: no ObjectViewer found for "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text ", "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 3 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "predicate"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 4 ;
                  ui:text ", "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 5 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 6 ;
                  ui:text "]"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:CommentNode ;
              ui:childIndex 0 ;
              rdfs:comment "p>In lmdoc:ObjectViewer with class {= ?class }</p"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:dynamicView ;
              arg:object [
                  sp:varName "object"^^xsd:string ;
                ] ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "subject"^^xsd:string ;
                ] ;
              ui:childIndex 1 ;
              ui:class [
                  sp:varName "class"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "class"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment """A read-only widget displaying a single object. In order to be selected on forms, subclasses of this class must specify a weight > 0 and an expression that returns true for the given input variable bindings:
- ?type: the datatype or rdf:type of the object being displayed
- ?kind: \"literal\", \"blank\", \"uri\" or \"image\"
- ?predicate: the property being displayed"""^^xsd:string ;
  rdfs:label "Object viewer"^^xsd:string ;
  rdfs:subClassOf swa:ObjectViewer ;
  rdfs:subClassOf lmdoc:ObjectElements ;
.
lmdoc:ObjectWidgetRow
  rdf:type swa:ObjectWidgetRowClass ;
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:object ;
      rdfs:comment "The object node."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:dynamicView ;
          arg:object [
              sp:varName "object"^^xsd:string ;
            ] ;
          arg:predicate [
              sp:varName "predicate"^^xsd:string ;
            ] ;
          arg:subject [
              sp:varName "subject"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
          ui:class lmdoc:ObjectViewer ;
        ] ;
    ] ;
  rdfs:comment "Superclass for the widget row types."^^xsd:string ;
  rdfs:label "Object widget row"^^xsd:string ;
  rdfs:subClassOf lmdoc:ObjectElements ;
.
lmdoc:Objects
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:tabular ;
      spl:valueType xsd:boolean ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:function [
          rdf:type swa:modeProperty ;
          arg:predicate swa:isSingleFunction ;
        ] ;
      ui:child [
          rdf:type lmdoc:LabeledObjects ;
          arg:single [
              rdf:type sp:if ;
              sp:arg1 [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "function"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type spif:invoke ;
                  sp:arg1 [
                      sp:varName "function"^^xsd:string ;
                    ] ;
                  sp:arg2 [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  sp:arg3 [
                      sp:varName "subject"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg3 [
                  rdf:type swa:modeProperty ;
                  arg:predicate swa:isSingleConstant ;
                ] ;
            ] ;
          ui:args "*"^^xsd:string ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "A two-columned structure with a label on the left and zero or more objects on the right."^^xsd:string ;
  rdfs:label "Objects"^^xsd:string ;
  rdfs:subClassOf swa:AbstractObject ;
.
lmdoc:ObjectsBody
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:offset ;
      spl:valueType xsd:integer ;
      rdfs:comment "The offset for the \"next 50\" recursive calls."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to allow at most one value."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-object-row"^^xsd:string ;
              ui:child [
                  rdf:type swa:ObjectWidgetRow ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:call ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "subject"^^xsd:string ;
                ] ;
              let:special [
                  rdf:type swa:specialAddButtonFunction ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  arg:subject [
                      sp:varName "subject"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:else ;
                  ui:child [
                      rdf:type ui:group ;
                      let:limit 50 ;
                      let:offset [
                          rdf:type sp:coalesce ;
                          sp:arg1 [
                              sp:varName "offset"^^xsd:string ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Div ;
                              html:class "swa-object-row"^^xsd:string ;
                              ui:child [
                                  rdf:type lmdoc:ObjectWidgetRow ;
                                  arg:object [
                                      sp:varName "object"^^xsd:string ;
                                    ] ;
                                  arg:predicate [
                                      sp:varName "predicate"^^xsd:string ;
                                    ] ;
                                  arg:subject [
                                      sp:varName "subject"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:limit [
                              sp:varName "limit"^^xsd:string ;
                            ] ;
                          ui:offset [
                              sp:varName "offset"^^xsd:string ;
                            ] ;
                          ui:resultSet [
                              sp:varName "rs"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:group ;
                          let:id [
                              rdf:type ui:uniqueId ;
                            ] ;
                          let:rowCount [
                              rdf:type spr:rowCount ;
                              sp:arg1 [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:child [
                              rdf:type ui:loadable ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type ui:else ;
                                      ui:child [
                                          rdf:type html:Div ;
                                          html:class "swa-objects-show-more"^^xsd:string ;
                                          ui:child [
                                              rdf:type html:A ;
                                              html:href "javascript:void(0)"^^xsd:string ;
                                              html:onclick [
                                                  rdf:type ui:concat ;
                                                  sp:arg1 "swa.load('"^^xsd:string ;
                                                  sp:arg2 [
                                                      sp:varName "id"^^xsd:string ;
                                                    ] ;
                                                  sp:arg3 "', { newOffset: "^^xsd:string ;
                                                  sp:arg4 [
                                                      rdf:type sp:add ;
                                                      sp:arg1 [
                                                          sp:varName "offset"^^xsd:string ;
                                                        ] ;
                                                      sp:arg2 [
                                                          sp:varName "limit"^^xsd:string ;
                                                        ] ;
                                                    ] ;
                                                  sp:arg5 " })"^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text "Show entries "^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 1 ;
                                                  ui:text [
                                                      rdf:type sp:add ;
                                                      sp:arg1 [
                                                          rdf:type sp:add ;
                                                          sp:arg1 [
                                                              sp:varName "offset"^^xsd:string ;
                                                            ] ;
                                                          sp:arg2 [
                                                              sp:varName "limit"^^xsd:string ;
                                                            ] ;
                                                        ] ;
                                                      sp:arg2 1 ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 2 ;
                                                  ui:text " to "^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 3 ;
                                                  ui:text [
                                                      rdf:type spl:min ;
                                                      sp:arg1 [
                                                          sp:varName "rowCount"^^xsd:string ;
                                                        ] ;
                                                      sp:arg2 [
                                                          rdf:type sp:add ;
                                                          sp:arg1 [
                                                              rdf:type sp:add ;
                                                              sp:arg1 [
                                                                  sp:varName "offset"^^xsd:string ;
                                                                ] ;
                                                              sp:arg2 [
                                                                  sp:varName "limit"^^xsd:string ;
                                                                ] ;
                                                            ] ;
                                                          sp:arg2 [
                                                              sp:varName "limit"^^xsd:string ;
                                                            ] ;
                                                        ] ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 4 ;
                                                  ui:text " of "^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 5 ;
                                                  ui:text [
                                                      sp:varName "rowCount"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:if ;
                                      ui:child [
                                          rdf:type lmdoc:ObjectsBody ;
                                          arg:offset [
                                              sp:varName "newOffset"^^xsd:string ;
                                            ] ;
                                          ui:args "*"^^xsd:string ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                      ui:condition [
                                          rdf:type sp:bound ;
                                          sp:arg1 [
                                              sp:varName "newOffset"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:condition [
                                      rdf:type sp:gt ;
                                      sp:arg1 [
                                          sp:varName "rowCount"^^xsd:string ;
                                        ] ;
                                      sp:arg2 [
                                          rdf:type sp:add ;
                                          sp:arg1 [
                                              sp:varName "offset"^^xsd:string ;
                                            ] ;
                                          sp:arg2 [
                                              sp:varName "limit"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:loadId [
                                  sp:varName "id"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:ObjectWidgetRow ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          arg:subject [
                              sp:varName "subject"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:and ;
                      sp:arg1 [
                          rdf:type sp:and ;
                          sp:arg1 [
                              rdf:type sp:and ;
                              sp:arg1 [
                                  rdf:type spr:isEmpty ;
                                  sp:arg1 [
                                      sp:varName "rs"^^xsd:string ;
                                    ] ;
                                ] ;
                              sp:arg2 [
                                  rdf:type sp:not ;
                                  sp:arg1 [
                                      rdf:type swa:isViewMode ;
                                    ] ;
                                ] ;
                            ] ;
                          sp:arg2 [
                              rdf:type sp:not ;
                              sp:arg1 [
                                  rdf:type sp:bound ;
                                  sp:arg1 [
                                      sp:varName "special"^^xsd:string ;
                                    ] ;
                                ] ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          rdf:type sp:not ;
                          sp:arg1 [
                              rdf:type swa:isBlankNodeProperty ;
                              arg:property [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template swa:SortedObjects ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "subject"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The body of an Object(s) widget, typically containing one row for each value. This can be \"overloaded\" via a mode property."^^xsd:string ;
  rdfs:label "Objects body"^^xsd:string ;
  rdfs:subClassOf lmdoc:ObjectElements ;
.
lmdoc:ObjectsGroup
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:filterFunction ;
      spl:valueType spin:Function ;
      rdfs:comment "An optional filter function that takes a predicate and a subject as arguments and returns true for all predicates that should be displayed."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicates ;
      spl:valueType sp:Select ;
      rdfs:comment "A result set (e.g., SPARQL SELECT query) that delivers the predicates in this group."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The resource to display."^^xsd:string ;
    ] ;
  ui:overrides swa:ObjectsGroup ;
  ui:prototype [
      rdf:type ui:group ;
      letrs:rs [
          rdf:type sp:Select ;
          sp:resultVariables (
              [
                sp:varName "predicate"^^xsd:string ;
              ]
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "predicates"^^xsd:string ;
                  ] ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object 0 ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object () ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "predicate"^^xsd:string ;
                  ] ;
                sp:predicate spr:colCells ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                rdf:type sp:Filter ;
                sp:expression [
                    rdf:type sp:or ;
                    sp:arg1 [
                        rdf:type sp:not ;
                        sp:arg1 [
                            rdf:type sp:bound ;
                            sp:arg1 [
                                sp:varName "filterFunction"^^xsd:string ;
                              ] ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        rdf:type spif:invoke ;
                        sp:arg1 [
                            sp:varName "filterFunction"^^xsd:string ;
                          ] ;
                        sp:arg2 [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                        sp:arg3 [
                            sp:varName "subject"^^xsd:string ;
                          ] ;
                      ] ;
                  ] ;
              ]
              [
                rdf:type sp:Filter ;
                sp:expression [
                    rdf:type sp:not ;
                    sp:arg1 [
                        rdf:type swa:isHiddenPropertyAtSubject ;
                        arg:property [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                        arg:subject [
                            sp:varName "subject"^^xsd:string ;
                          ] ;
                      ] ;
                  ] ;
              ]
            ) ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "lm-table"^^xsd:string ;
                  let:pid [
                      rdf:type ui:uniqueId ;
                    ] ;
                  ui:child [
                      rdf:type html:Tbody ;
                      html:class "lm-table-body"^^xsd:string ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type lmdoc:Objects ;
                              arg:predicate [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "subject"^^xsd:string ;
                                ] ;
                              arg:tabular "true"^^xsd:boolean ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "rs"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      html:class "lm-table-header"^^xsd:string ;
                      ui:child [
                          rdf:type html:Th ;
                          html:class "lm-column-labels"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Values"^^xsd:string ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Th ;
                          html:class "lm-column-labels"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  sp:varName "label"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-sub-title"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "label"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:bound ;
                      sp:arg1 [
                          sp:varName "label"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:gt ;
              sp:arg1 [
                  rdf:type spr:rowCount ;
                  sp:arg1 [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A group of lmdoc:Objects elements where the predicates are computed by taking a result set (e.g. of all relevant properties) and applying a filter on top of it, e.g. to only show the annotation properties among those that are relevant."^^xsd:string ;
  rdfs:label "Objects group"^^xsd:string ;
  rdfs:subClassOf swa:ObjectsGroup ;
.
lmdoc:Pages
  rdf:type ui:NodeClass ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:Panes
  rdf:type ui:NodeClass ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:PartHeader
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:metadata ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          sp:varName "metadata"^^xsd:string ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          let:myLogo [
              rdf:type sp:coalesce ;
              sp:arg1 [
                  rdf:type spl:object ;
                  sp:arg1 [
                      sp:varName "myGraphMetadata"^^xsd:string ;
                    ] ;
                  sp:arg2 vaem:logo ;
                ] ;
              sp:arg2 "http://www.topquadrant.com/wp-content/uploads/2013/09/topquadrant-logo1.png" ;
            ] ;
          ui:child [
              rdf:type html:Img ;
              html:height "60px"^^xsd:string ;
              html:src [
                  sp:varName "myLogo"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Part header"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:PopUpResourceView
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "curation graph"^^xsd:string ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "PopUp Resource view"^^xsd:string ;
  rdfs:subClassOf lmdoc:Panes ;
.
lmdoc:Preview
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type sp:iri ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:setContext ;
          ui:child [
              rdf:type ui:group ;
              let:myOverlay [
                  rdf:type sp:iri ;
                  sp:arg1 [
                      rdf:type sp:coalesce ;
                      sp:arg1 [
                          sp:varName "overlay"^^xsd:string ;
                        ] ;
                      sp:arg2 ui:tempGraph ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type ui:group ;
                      let:myGraphMetadata [
                          rdf:type spl:objectInGraph ;
                          sp:arg1 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                          sp:arg2 vaem:hasGraphMetadata ;
                          sp:arg3 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:group ;
                          let:namespacePrefix [
                              rdf:type spl:objectInGraph ;
                              sp:arg1 [
                                  sp:varName "myGraphMetadata"^^xsd:string ;
                                ] ;
                              sp:arg2 vaem:name ;
                              sp:arg3 [
                                  sp:varName "myGraph"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:child [
                              rdf:type ui:setContext ;
                              ui:child [
                                  rdf:type html:Hr ;
                                  ui:childIndex 5 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Section ;
                                  html:class "informative"^^xsd:string ;
                                  html:id "overview-of-ontology"^^xsd:string ;
                                  ui:child [
                                      rdf:type lmdoc:IndexSection ;
                                      arg:graph [
                                          sp:varName "myGraph"^^xsd:string ;
                                        ] ;
                                      arg:sectionHeading "Resource Index"^^xsd:string ;
                                      ui:childIndex 0 ;
                                      vaem:namespacePrefix [
                                          sp:varName "namespacePrefix"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 8 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Section ;
                                  html:class "introductory"^^xsd:string ;
                                  html:id "abstract"^^xsd:string ;
                                  html:property "dct:abstract"^^xsd:string ;
                                  html:rel "bibo:Chapter"^^xsd:string ;
                                  html:resource "#ref"^^xsd:string ;
                                  html:typeof "bibo:Chapter"^^xsd:string ;
                                  ui:child [
                                      rdf:type lmdoc:AbstractSection ;
                                      arg:metadata [
                                          sp:varName "myGraphMetadata"^^xsd:string ;
                                        ] ;
                                      arg:sectionHeading "Abstract"^^xsd:string ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 3 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Section ;
                                  html:id "namespaces-1"^^xsd:string ;
                                  html:rel "bibo:Chapter"^^xsd:string ;
                                  html:resource "#ref"^^xsd:string ;
                                  html:typeof "bibo:Chapter"^^xsd:string ;
                                  ui:child [
                                      rdf:type lmdoc:ImportedNamespaces ;
                                      arg:graph [
                                          sp:varName "myGraph"^^xsd:string ;
                                        ] ;
                                      arg:sectionHeading "Imported Graphs"^^xsd:string ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 6 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Section ;
                                  html:id "non-imported-myGraphMetadatas"^^xsd:string ;
                                  html:rel "bibo:Chapter"^^xsd:string ;
                                  html:resource "#ref"^^xsd:string ;
                                  html:typeof "bibo:Chapter"^^xsd:string ;
                                  ui:child [
                                      rdf:type lmdoc:NonImportedResources ;
                                      arg:metadata [
                                          sp:varName "myGraphMetadata"^^xsd:string ;
                                        ] ;
                                      arg:sectionHeading "Non-imported Resources"^^xsd:string ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 7 ;
                                ] ;
                              ui:child [
                                  rdf:type ui:CommentNode ;
                                  ui:childIndex 4 ;
                                  rdfs:comment """section id=\"toc\">
<lmdoc:TableOfContents arg:sectionHeading=\"Table of Contents\"/>
</section"""^^xsd:string ;
                                ] ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type html:P ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "Current query graph is "^^xsd:string ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 1 ;
                                          ui:text [
                                              rdf:type ui:currentQueryGraph ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 2 ;
                                  ui:condition [
                                      rdf:type fn:contains ;
                                      sp:arg1 [
                                          sp:varName "flags"^^xsd:string ;
                                        ] ;
                                      sp:arg2 "Sqg" ;
                                    ] ;
                                ] ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type html:P ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "Graph metadata is "^^xsd:string ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 1 ;
                                          ui:text [
                                              sp:varName "myGraphMetaData"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 1 ;
                                  ui:condition [
                                      rdf:type fn:contains ;
                                      sp:arg1 [
                                          sp:varName "flags"^^xsd:string ;
                                        ] ;
                                      sp:arg2 "Sgm" ;
                                    ] ;
                                ] ;
                              ui:child [
                                  rdf:type lmdoc:Footer ;
                                  ui:childIndex 9 ;
                                ] ;
                              ui:child [
                                  rdf:type lmdoc:GraphHeader ;
                                  arg:metadata [
                                      sp:varName "myGraphMetadata"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:varName "namespacePrefix"^^xsd:string ;
                              ui:varValue [
                                  sp:varName "namespacePrefix"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:queryGraph [
                      rdf:type ui:unionOfGraphs ;
                      sp:arg1 [
                          rdf:type ui:graphWithImports ;
                          sp:arg1 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          rdf:type ui:graphWithImports ;
                          sp:arg1 <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
                        ] ;
                      sp:arg3 [
                          rdf:type ui:graphWithImports ;
                          sp:arg1 [
                              sp:varName "myOverlay"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:varName "graph"^^xsd:string ;
          ui:varValue [
              sp:varName "myGraph"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=lmdoc:Preview&graph=http://www.linkedmodel.org/2.0/schema/vaem"""^^xsd:string ;
  rdfs:label "Preview Graph Documentation"^^xsd:string ;
  rdfs:subClassOf lmdoc:Pages ;
.
lmdoc:PropertiesMaintainer
