.
lmdoc:ExtractCommentTextFromRule
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "commentText"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "comment"^^xsd:string ;
              ] ;
            sp:predicate rdfs:comment ;
            sp:subject [
                sp:varName "rule"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:regex ;
                sp:arg1 [
                    sp:varName "comment"^^xsd:string ;
                  ] ;
                sp:arg2 "^(STEP [A-Z]+-[A-Z]+-[0-9]+).*\\n(.*)" ;
                sp:arg3 "$2" ;
              ] ;
            sp:variable [
                sp:varName "commentText"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:not ;
                sp:arg1 [
                    rdf:type fn:starts-with ;
                    sp:arg1 [
                        sp:varName "commentText"^^xsd:string ;
                      ] ;
                    sp:arg2 "STEP" ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:rule ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:label "Extract comment text from rule"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:ExtractStepTextFromRule
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "stepText"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "comment"^^xsd:string ;
              ] ;
            sp:predicate rdfs:comment ;
            sp:subject [
                sp:varName "rule"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:regex ;
                sp:arg1 [
                    sp:varName "comment"^^xsd:string ;
                  ] ;
                sp:arg2 "^(.*)$" ;
                sp:arg3 "$1" ;
              ] ;
            sp:variable [
                sp:varName "stepText"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:rule ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:label "Extract Step text from rule"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
