                                        ] ;
                                      sp:arg2 dct:modified ;
                                    ] ;
                                ] ;
                              ui:childIndex 11 ;
                            ] ;
                          ui:child [
                              rdf:type html:Dd ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      rdf:type spl:object ;
                                      sp:arg1 [
                                          sp:varName "myGraphMetadata"^^xsd:string ;
                                        ] ;
                                      sp:arg2 vaem:revision ;
                                    ] ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type html:Dd ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type html:A ;
                                      html:href [
                                          sp:varName "previousVersion"^^xsd:string ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              sp:varName "previousVersion"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:condition [
                                      rdf:type sp:ne ;
                                      sp:arg1 [
                                          sp:varName "previousVersion"^^xsd:string ;
                                        ] ;
                                      sp:arg2 "none" ;
                                    ] ;
                                ] ;
                              ui:childIndex 5 ;
                            ] ;
                          ui:child [
                              rdf:type html:Dd ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type html:A ;
                                      html:href [
                                          sp:varName "thisVersion"^^xsd:string ;
