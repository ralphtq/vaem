                              arg:subject [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                              ui:childIndex 5 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ObjectsGroup ;
                              arg:filterFunction swa:isNonAnnotationProperty ;
                              arg:label "Properties"^^xsd:string ;
                              arg:predicates [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ResourceFooter ;
                              arg:options "JSONLD,RDF,TURTLE"^^xsd:string ;
                              arg:resource [
                                  sp:varName "property"^^xsd:string ;
                                ] ;
                              ui:childIndex 7 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "30px;"^^xsd:string ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "30px;"^^xsd:string ;
                              ui:childIndex 4 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:VSpace ;
                              arg:margin "40px;"^^xsd:string ;
                              ui:childIndex 6 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:template [
                          rdf:type swa:modeProperty ;
                          arg:predicate swa:formObjectPredicateSelectionTemplate ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:VSpace ;
                      arg:margin "40px;"^^xsd:string ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "properties"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "properties"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template lmdoc:AllProperties ;
          ui:varName "properties"^^xsd:string ;
        ] ;
