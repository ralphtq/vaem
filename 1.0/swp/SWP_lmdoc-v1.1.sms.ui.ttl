                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:InheritanceTable ;
                      arg:resourceSet [
                          sp:varName "superclasses"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:VSpace ;
                      arg:margin "20px;"^^xsd:string ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "superclasses"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
