lmdoc:DetailedClassView
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:defaultValue "false"^^xsd:boolean ;
      spl:predicate arg:showConstructors ;
      spl:valueType xsd:boolean ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:defaultValue "false"^^xsd:boolean ;
      spl:predicate arg:showInstances ;
      spl:valueType xsd:boolean ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:defaultValue "false"^^xsd:boolean ;
      spl:predicate arg:showRules ;
      spl:valueType xsd:boolean ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:defaultValue "true"^^xsd:boolean ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:showTitle ;
      spl:valueType xsd:boolean ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type html:Div ;
          html:class "lm-resource-box"^^xsd:string ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-sub-title"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Description"^^xsd:string ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              arg:resource [
                  sp:varName "class"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "class"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type lmdoc:ObjectsGroup ;
                  arg:filterFunction swa:isAnnotationProperty ;
                  arg:label "Annotations"^^xsd:string ;
                  arg:predicates [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                  arg:subject [
                      sp:varName "class"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 9 ;
              ui:template [
                  rdf:type swa:modeProperty ;
                  arg:predicate swa:formObjectPredicateSelectionTemplate ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:group ;
              let:t1 [
                  rdf:type spif:currentTimeMillis ;
                ] ;
              ui:child [
                  rdf:type ui:group ;
                  let:t3 [
                      rdf:type spif:currentTimeMillis ;
                    ] ;
                  ui:child [
                      rdf:type ui:group ;
                      let:d2 [
                          rdf:type smf:trace ;
                          sp:arg1 "Show class properties for {?2} took {?1} millisecs" ;
                          sp:arg2 [
                              rdf:type sp:sub ;
                              sp:arg1 [
                                  sp:varName "t3"^^xsd:string ;
                                ] ;
                              sp:arg2 [
                                  sp:varName "t1"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:arg3 [
                              rdf:type ui:encodeNode ;
                              sp:arg1 [
                                  sp:varName "class"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:group ;
                  letrs:myPropertySet [
                      rdf:type sp:Select ;
                      sp:distinct "true"^^xsd:boolean ;
                      sp:orderBy (
                          [
                            rdf:type ui:label ;
                            sp:arg1 [
                                sp:varName "property"^^xsd:string ;
                              ] ;
                          ]
                        ) ;
                      sp:resultVariables (
                          [
                            sp:varName "property"^^xsd:string ;
                          ]
                          [
                            sp:varName "parent"^^xsd:string ;
                          ]
                        ) ;
                      sp:where (
                          [
                            sp:object [
                                sp:varName "?0"^^xsd:string ;
                              ] ;
                            sp:predicate lmdoc:relevantPropertiesAtClassWithParent ;
                            sp:subject [
                                sp:varName "property"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "class"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:first ;
                            sp:subject [
                                sp:varName "?0"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "?1"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:rest ;
                            sp:subject [
                                sp:varName "?0"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "parent"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:first ;
                            sp:subject [
                                sp:varName "?1"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object () ;
                            sp:predicate rdf:rest ;
                            sp:subject [
                                sp:varName "?1"^^xsd:string ;
                              ] ;
                          ]
                        ) ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "swa-sub-title"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Relevant Properties for "^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text [
                                  rdf:type ui:label ;
                                  sp:arg1 [
                                      sp:varName "class"^^xsd:string ;
                                    ] ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:PropertiesTable ;
                          arg:class [
                              sp:varName "class"^^xsd:string ;
                            ] ;
                          arg:propertySet [
                              sp:varName "myPropertySet"^^xsd:string ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:VSpace ;
                          arg:margin "20px;"^^xsd:string ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          rdf:type sp:gt ;
                          sp:arg1 [
                              rdf:type spr:rowCount ;
                              sp:arg1 [
                                  sp:varName "myPropertySet"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 5 ;
            ] ;
          ui:child [
              rdf:type ui:group ;
              letrs:superclasses [
                  rdf:type sp:Select ;
                  sp:distinct "true"^^xsd:boolean ;
                  sp:orderBy (
                      [
                        sp:varName "depth"^^xsd:string ;
                      ]
                      [
                        rdf:type ui:label ;
                        sp:arg1 [
                            sp:varName "super"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:resultVariables (
                      [
                        sp:varName "super"^^xsd:string ;
                      ]
                      [
                        sp:varName "depth"^^xsd:string ;
                      ]
                    ) ;
                  sp:where (
                      [
                        sp:object [
                            sp:varName "super"^^xsd:string ;
                          ] ;
                        sp:predicate lmdoc:mySuperClass ;
                        sp:subject [
                            sp:varName "class"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "class"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "super"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "depth"^^xsd:string ;
                          ] ;
                        sp:predicate lmdoc:inheritanceDepth ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-sub-title"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
