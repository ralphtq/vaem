    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Table ;
          html:class "lm-table"^^xsd:string ;
          ui:child [
              rdf:type html:Tbody ;
              html:class "lm-table-body"^^xsd:string ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type html:Tr ;
                      html:class "lm-row"^^xsd:string ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column align-top"^^xsd:string ;
                          ui:child [
                              rdf:type html:B ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      rdf:type ui:label ;
                                      sp:arg1 [
                                          sp:varName "property"^^xsd:string ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
