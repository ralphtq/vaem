                    sp:predicate rdfs:range ;
                    sp:subject [
                        sp:varName "aProperty"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression "false"^^xsd:boolean ;
                    sp:variable [
                        sp:varName "valueRestriction"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "aProperty"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "range"^^xsd:string ;
                      ] ;
                    sp:predicate owl:allValuesFrom ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression "false"^^xsd:boolean ;
                    sp:variable [
                        sp:varName "valueRestriction"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "aProperty"^^xsd:string ;
