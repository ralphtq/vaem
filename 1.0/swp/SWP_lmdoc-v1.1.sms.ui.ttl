          rdf:type ui:concat ;
          sp:arg1 "margin: "^^xsd:string ;
          sp:arg2 [
              sp:varName "margin"^^xsd:string ;
            ] ;
          sp:arg3 "  0;"^^xsd:string ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Vertical space"^^xsd:string ;
  rdfs:label "Vertical Space"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
