lmdoc:GraphTest
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:errorPrototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type ui:group ;
              let:myGraphMetadata [
                  rdf:type spl:object ;
                  sp:arg1 [
                      sp:varName "myGraph"^^xsd:string ;
                    ] ;
                  sp:arg2 vaem:hasGraphMetadata ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:P ;
                      html:class "lm-para"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "No metadata for graph "^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition "(!bound(?graph))"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Missiing graph value"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition "(!bound(?graph))"^^xsd:string ;
        ] ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type sp:iri ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:setContext ;
          ui:child [
              rdf:type ui:setContext ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type ui:group ;
                      let:myGraphMetadata [
                          rdf:type spl:object ;
                          sp:arg1 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                          sp:arg2 vaem:hasGraphMetadata ;
                        ] ;
                      ui:child [
                          rdf:type html:Hr ;
                          ui:childIndex 3 ;
                        ] ;
                      ui:child [
                          rdf:type html:Hr ;
                          ui:childIndex 7 ;
                        ] ;
                      ui:child [
                          rdf:type html:Section ;
                          html:class "details"^^xsd:string ;
                          html:id "details"^^xsd:string ;
                          html:property "dct:abstract"^^xsd:string ;
                          html:rel "bibo:Chapter"^^xsd:string ;
                          html:resource "#ref"^^xsd:string ;
                          html:typeof "bibo:Chapter"^^xsd:string ;
                          ui:child [
                              rdf:type html:Div ;
                              html:class "size-10"^^xsd:string ;
                              ui:child [
                                  rdf:type html:A ;
                                  html:href "http://www.topquadrant.com/technology/sparql-web-pages-swp/"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "TopBraid SPARQL Web Pages (SWP)"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 5 ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Generated "^^xsd:string ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 1 ;
                                  ui:text [
                                      rdf:type xsd:date ;
                                      sp:arg1 [
                                          rdf:type afn:now ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 2 ;
                                  ui:text " by lmdoc version "^^xsd:string ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 3 ;
                                  ui:text [
                                      rdf:type spl:object ;
                                      sp:arg1 lmdoc:GMD_LMDOC ;
                                      sp:arg2 vaem:revision ;
                                    ] ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 4 ;
                                  ui:text " using "^^xsd:string ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type html:Hr ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type ui:else ;
                              ui:child [
                                  rdf:type html:Section ;
                                  html:class "informative"^^xsd:string ;
                                  html:id "classes"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:CommentNode ;
                                      ui:childIndex 1 ;
                                      rdfs:comment "div style=\"margin: 40px 0 25px 0;\"/"^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:call ;
                                      arg:graph [
                                          sp:varName "myGraph"^^xsd:string ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:if ;
                                          ui:child [
                                              rdf:type html:H2 ;
                                              html:id [
                                                  rdf:type lmdoc:makeAnchorFromString ;
                                                  arg:label [
                                                      sp:varName "sectionHeading"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text [
                                                      sp:varName "sectionHeading"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:child [
                                              rdf:type ui:forEach ;
                                              ui:child [
                                                  rdf:type ui:call ;
                                                  arg:subject [
                                                      sp:varName "class"^^xsd:string ;
                                                    ] ;
                                                  ui:child [
                                                      rdf:type html:Div ;
                                                      html:class "lm-header-box"^^xsd:string ;
                                                      ui:child [
                                                          rdf:type lmdoc:ResourceDocAnchor ;
                                                          arg:node [
                                                              sp:varName "class"^^xsd:string ;
                                                            ] ;
                                                          arg:typeLabel "Class "^^xsd:string ;
                                                          ui:childIndex 0 ;
                                                        ] ;
                                                      ui:childIndex 1 ;
                                                    ] ;
                                                  ui:child [
                                                      rdf:type lmdoc:DetailedClassView ;
                                                      arg:class [
                                                          sp:varName "class"^^xsd:string ;
                                                        ] ;
                                                      arg:showInstances "false"^^xsd:boolean ;
                                                      arg:showTitle "false"^^xsd:boolean ;
                                                      ui:childIndex 2 ;
                                                    ] ;
                                                  ui:child [
                                                      rdf:type lmdoc:VSpace ;
                                                      arg:margin "20px;"^^xsd:string ;
                                                      ui:childIndex 0 ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                  ui:template [
                                                      rdf:type swa:modeProperty ;
                                                      arg:predicate swa:formObjectPredicateSelectionTemplate ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type lmdoc:VSpace ;
                                                  arg:margin "40px;"^^xsd:string ;
                                                  ui:childIndex 1 ;
                                                ] ;
                                              ui:childIndex 1 ;
                                              ui:limit 3 ;
                                              ui:resultSet [
                                                  sp:varName "classes"^^xsd:string ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 0 ;
                                          ui:condition [
                                              rdf:type sp:gt ;
                                              sp:arg1 [
                                                  rdf:type spr:rowCount ;
                                                  sp:arg1 [
                                                      sp:varName "classes"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              sp:arg2 0 ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                      ui:template lmdoc:AllClasses ;
                                      ui:varName "classes"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type ui:if ;
                              ui:child [
                                  rdf:type html:P ;
                                  html:class "lm-para"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Class details suppressed by 'Nsc' flag"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:condition "{ fn:contains(?flags,'Nsc')}"^^xsd:string ;
                            ] ;
                          ui:childIndex 8 ;
                        ] ;
                      ui:child [
                          rdf:type html:Section ;
                          html:class "informative"^^xsd:string ;
                          html:id "overview-of-ontology"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:IndexSection ;
                              arg:graph [
                                  sp:varName "myGraph"^^xsd:string ;
                                ] ;
                              arg:sectionHeading "Resource Index"^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 4 ;
                        ] ;
                      ui:child [
                          rdf:type html:Section ;
                          html:class "introductory"^^xsd:string ;
                          html:id "abstract"^^xsd:string ;
                          html:property "dct:abstract"^^xsd:string ;
                          html:rel "bibo:Chapter"^^xsd:string ;
                          html:resource "#ref"^^xsd:string ;
                          html:typeof "bibo:Chapter"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:AbstractSection ;
                              arg:metadata [
                                  sp:varName "myGraphMetadata"^^xsd:string ;
                                ] ;
                              arg:sectionHeading "Abstract"^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Section ;
                          html:id "namespaces-1"^^xsd:string ;
                          html:rel "bibo:Chapter"^^xsd:string ;
                          html:resource "#ref"^^xsd:string ;
                          html:typeof "bibo:Chapter"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:ImportedNamespaces ;
                              arg:graph [
                                  sp:varName "myGraph"^^xsd:string ;
                                ] ;
                              arg:sectionHeading "Imported Graphs"^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 5 ;
                        ] ;
                      ui:child [
                          rdf:type html:Section ;
                          html:id "non-imported-myGraphMetadatas"^^xsd:string ;
                          html:rel "bibo:Chapter"^^xsd:string ;
                          html:resource "#ref"^^xsd:string ;
                          html:typeof "bibo:Chapter"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:NonImportedResources ;
                              arg:metadata [
                                  sp:varName "myGraphMetadata"^^xsd:string ;
                                ] ;
                              arg:sectionHeading "Non-imported Resources"^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 6 ;
                        ] ;
                      ui:child [
                          rdf:type html:Section ;
                          html:id "toc"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:TableOfContents ;
                              arg:sectionHeading "Table of Contents"^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:GraphHeader ;
                          arg:metadata [
                              sp:varName "myGraphMetadata"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:queryGraph [
                      rdf:type ui:unionOfGraphs ;
                      sp:arg1 [
                          rdf:type ui:graphWithImports ;
                          sp:arg1 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          rdf:type ui:graphWithImports ;
                          sp:arg1 <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:varName "graph"^^xsd:string ;
              ui:varValue [
                  sp:varName "myGraph"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:varName "flags"^^xsd:string ;
          ui:varValue [
              sp:varName "flags"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  vaem:todo "remove dependency on swa.css"^^xsd:string ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=lmdoc:GraphTest&graph=http://www.linkedmodel.org/2.0/schema/vaem"""^^xsd:string ;
  rdfs:label "Graph Documentation"^^xsd:string ;
  rdfs:subClassOf lmdoc:Pages ;
