lmdoc:PropertyDetailsTable
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:parent ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdf:Property ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:group ;
          letrs:myParents [
              rdf:type sp:Select ;
              sp:resultVariables (
                  [
                    sp:varName "parent"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "class"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?2"^^xsd:string ;
                      ] ;
                    sp:predicate lmdoc:parentsOfPropertiesAtClass ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?2"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?2"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type ui:forEach ;
              ui:child [
                  rdf:type html:Td ;
                  html:class "lm-column"^^xsd:string ;
                  ui:child [
                      rdf:type ui:else ;
                      ui:child [
                          rdf:type html:I ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "self"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type html:B ;
                          ui:child [
                              rdf:type swa:Link ;
                              arg:resource [
                                  sp:varName "parent"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text "["^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 2 ;
                          ui:text [
                              rdf:type ui:encodeNode ;
                              sp:arg1 [
                                  sp:varName "parent"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 3 ;
                          ui:text "]"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          rdf:type sp:ne ;
                          sp:arg1 [
                              sp:varName "parent"^^xsd:string ;
                            ] ;
                          sp:arg2 [
                              sp:varName "class"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type html:Td ;
                  html:class "lm-column"^^xsd:string ;
                  ui:child [
                      rdf:type ui:group ;
                      let:range [
                          rdf:type sp:Select ;
                          sp:resultVariables (
                              [
                                sp:varName "range"^^xsd:string ;
                              ]
                            ) ;
                          sp:where (
                              [
                                sp:object [
                                    sp:varName "parent"^^xsd:string ;
                                  ] ;
                                sp:predicate rdf:first ;
                                sp:subject [
                                    sp:varName "?0"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object [
                                    sp:varName "?1"^^xsd:string ;
                                  ] ;
                                sp:predicate rdf:rest ;
                                sp:subject [
                                    sp:varName "?0"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object [
                                    sp:varName "property"^^xsd:string ;
                                  ] ;
                                sp:predicate rdf:first ;
                                sp:subject [
                                    sp:varName "?1"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object () ;
                                sp:predicate rdf:rest ;
                                sp:subject [
                                    sp:varName "?1"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object [
                                    sp:varName "?2"^^xsd:string ;
                                  ] ;
                                sp:predicate lmdoc:rangeOfPropertyAtClass ;
                                sp:subject [
                                    sp:varName "?0"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object [
                                    sp:varName "range"^^xsd:string ;
                                  ] ;
                                sp:predicate rdf:first ;
                                sp:subject [
                                    sp:varName "?2"^^xsd:string ;
                                  ] ;
                              ]
                              [
                                sp:object () ;
                                sp:predicate rdf:rest ;
                                sp:subject [
                                    sp:varName "?2"^^xsd:string ;
                                  ] ;
                              ]
                            ) ;
                        ] ;
                      ui:child [
                          rdf:type swa:ObjectViewer ;
                          arg:object [
                              sp:varName "range"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:group ;
                  letrs:myRestrictions [
                      rdf:type sp:Select ;
                      sp:resultVariables (
                          [
                            sp:varName "range"^^xsd:string ;
                          ]
                        ) ;
                      sp:where (
                          [
                            sp:object [
                                sp:varName "parent"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:first ;
                            sp:subject [
                                sp:varName "?0"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "?1"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:rest ;
                            sp:subject [
                                sp:varName "?0"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "property"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:first ;
                            sp:subject [
                                sp:varName "?1"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object () ;
                            sp:predicate rdf:rest ;
                            sp:subject [
                                sp:varName "?1"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "?2"^^xsd:string ;
                              ] ;
                            sp:predicate lmdoc:valueRestrictionsForPropertyAtClass ;
                            sp:subject [
                                sp:varName "?0"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "range"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:first ;
                            sp:subject [
                                sp:varName "?2"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "?3"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:rest ;
                            sp:subject [
                                sp:varName "?2"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object [
                                sp:varName "parent"^^xsd:string ;
                              ] ;
                            sp:predicate rdf:first ;
                            sp:subject [
                                sp:varName "?3"^^xsd:string ;
                              ] ;
                          ]
                          [
                            sp:object () ;
                            sp:predicate rdf:rest ;
                            sp:subject [
                                sp:varName "?3"^^xsd:string ;
                              ] ;
                          ]
                        ) ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Td ;
                              html:class "lm-column"^^xsd:string ;
                              ui:child [
                                  rdf:type html:B ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text " only "^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:child [
                                  rdf:type ui:else ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          rdf:type ui:label ;
                                          sp:arg1 [
                                              sp:varName "range"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 2 ;
                                ] ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type swa:Link ;
                                      arg:resource [
                                          sp:varName "range"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 1 ;
                                      ui:text "["^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 2 ;
                                      ui:text [
                                          rdf:type ui:encodeNode ;
                                          sp:arg1 [
                                              sp:varName "range"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 3 ;
                                      ui:text "]"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 1 ;
                                  ui:condition [
                                      rdf:type sp:isIRI ;
                                      sp:arg1 [
                                          sp:varName "range"^^xsd:string ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type html:Td ;
                              html:class "lm-column"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:else ;
                                  ui:child [
                                      rdf:type html:I ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "self"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type html:B ;
                                      ui:child [
                                          rdf:type swa:Link ;
                                          arg:resource [
                                              sp:varName "parent"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 1 ;
                                      ui:text "["^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 2 ;
                                      ui:text [
                                          rdf:type ui:encodeNode ;
                                          sp:arg1 [
                                              sp:varName "parent"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 3 ;
                                      ui:text "]"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:condition [
                                      rdf:type sp:ne ;
                                      sp:arg1 [
                                          sp:varName "parent"^^xsd:string ;
                                        ] ;
                                      sp:arg2 [
                                          sp:varName "class"^^xsd:string ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "myRestrictions"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          rdf:type sp:gt ;
                          sp:arg1 [
                              rdf:type spr:rowCount ;
                              sp:arg1 [
                                  sp:varName "myRestrictions"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:resultSet [
                  sp:varName "myParents"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Property details table"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ReferencesToResourceInGivenGraph
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            rdf:type ui:label ;
            sp:arg1 [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "property"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "resource"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "resource"^^xsd:string ;
              ] ;
            sp:predicate [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:subject [
                sp:varName "subject"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:ne ;
                sp:arg1 [
                    sp:varName "property"^^xsd:string ;
                  ] ;
                sp:arg2 rdfs:isDefinedBy ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:comment "Gets all properties for subjects that reference a resource as object in given class."^^xsd:string ;
  rdfs:label "All instances"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:ResourceDocAnchor
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Span ;
          ui:child [
              rdf:type html:A ;
              html:id [
                  rdf:type lmdoc:makeAnchorFromResource ;
                  arg:resource [
                      sp:varName "node"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  html:class "size-24"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type smf:qname ;
                          sp:arg1 [
                              sp:varName "node"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "An anchor in the documentaiton entry for a resource."^^xsd:string ;
  rdfs:label "Resource Doc Ancor"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ResourceDocLink
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:title ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:catalogGraph [
          rdf:type ui:contextValue ;
          sp:arg1 "catalogGraph" ;
        ] ;
      ui:child [
          rdf:type html:Span ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  rdf:type lmdoc:buildResourceDocLink ;
                  lmdoc:catalogGraph [
                      rdf:type sp:iri ;
                      sp:arg1 [
                          sp:varName "catalogGraph"^^xsd:string ;
                        ] ;
                    ] ;
                  lmdoc:graph [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ] ;
              html:title [
                  sp:varName "title"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type smf:qname ;
                      sp:arg1 [
                          sp:varName "resource"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 1 ;
              ui:text [
                  sp:varName "label"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A hyperlink to the documentation entry for a resource."^^xsd:string ;
  rdfs:label "Resource Doc Link"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ResourceFooter
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:options ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type html:Div ;
      html:class "lm-buttons-dock"^^xsd:string ;
      ui:child [
          rdf:type html:Div ;
          html:style "clear:both;"^^xsd:string ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:style "float:left; text-align:middle; padding:10px;"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text """View as: 
"""^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type lmdoc:ViewAsCSV ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
              ui:condition [
                  rdf:type fn:contains ;
                  sp:arg1 [
                      sp:varName "options"^^xsd:string ;
                    ] ;
                  sp:arg2 "CSV" ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type lmdoc:ViewAsJSON ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 4 ;
              ui:condition [
                  rdf:type fn:contains ;
                  sp:arg1 [
                      sp:varName "options"^^xsd:string ;
                    ] ;
                  sp:arg2 "json" ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type lmdoc:ViewAsJSON-LD ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 5 ;
              ui:condition [
                  rdf:type fn:contains ;
                  sp:arg1 [
                      sp:varName "options"^^xsd:string ;
                    ] ;
                  sp:arg2 "JSONLD" ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type lmdoc:ViewAsRDFXML ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 2 ;
              ui:condition [
                  rdf:type fn:contains ;
                  sp:arg1 [
                      sp:varName "options"^^xsd:string ;
                    ] ;
                  sp:arg2 "RDF" ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type lmdoc:ViewAsTurtle ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 3 ;
              ui:condition [
                  rdf:type fn:contains ;
                  sp:arg1 [
                      sp:varName "options"^^xsd:string ;
                    ] ;
                  sp:arg2 "TURTLE" ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type lmdoc:ViewAsXML ;
                  arg:resource [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 6 ;
              ui:condition [
                  rdf:type fn:contains ;
                  sp:arg1 [
                      sp:varName "options"^^xsd:string ;
                    ] ;
                  sp:arg2 "XML" ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:style "float:left;"^^xsd:string ;
          ui:child [
              rdf:type html:A ;
              html:href "#lmdoc_top"^^xsd:string ;
              ui:child [
                  rdf:type html:Img ;
                  html:src "http://linkedmodel.org/lib/lm/images/icons/doc-back-arrow.png"^^xsd:string ;
                  html:width "24px;"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Resource footer"^^xsd:string ;
  rdfs:label "Resource Footer"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ResourceFormBody
  rdf:type ui:ResourceViewClass ;
  ui:overrides swa:ResourceFormBody ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:call ;
          arg:subject [
              sp:varName "resource"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type swa:ObjectsGroup ;
              arg:filterFunction swa:isAnnotationProperty ;
              arg:label "Annotations"^^xsd:string ;
              arg:predicates [
                  sp:varName "rs"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type swa:ObjectsGroup ;
              arg:filterFunction swa:isNonAnnotationProperty ;
              arg:label "Properties"^^xsd:string ;
              arg:predicates [
                  sp:varName "rs"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:class "vspace-20"^^xsd:string ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:class "vspace-20"^^xsd:string ;
              ui:childIndex 2 ;
            ] ;
          ui:childIndex 0 ;
          ui:template [
              rdf:type swa:modeProperty ;
              arg:predicate swa:formObjectPredicateSelectionTemplate ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The lmdoc view for rdfs:Resource, with widget groups for Annotation Properties and Other Properties."^^xsd:string ;
  rdfs:label "Resource form body"^^xsd:string ;
  rdfs:subClassOf swa:ResourceFormBody ;
.
lmdoc:ResourceHeader
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:node ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display. Blank nodes or literals are not permitted. Use tui:Label to disambiguate."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Div ;
          html:class "lm-header-box"^^xsd:string ;
          ui:child [
              rdf:type html:P ;
              html:class "size-12"^^xsd:string ;
              ui:child [
                  rdf:type html:A ;
                  html:href [
                      sp:varName "node"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "node"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Strong ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "URI: "^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:P ;
              html:class "size-24"^^xsd:string ;
              ui:child [
                  rdf:type html:Strong ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type smf:qname ;
                          sp:arg1 [
                              sp:varName "node"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Format a header for a resource"^^xsd:string ;
  rdfs:label "Resource Header"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ResourceLink
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The URI resource to display."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:title ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Span ;
      ui:child [
          rdf:type html:A ;
          html:href [
              rdf:type xsd:string ;
              sp:arg1 [
                  sp:varName "resource"^^xsd:string ;
                ] ;
            ] ;
          html:title [
              sp:varName "title"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  rdf:type smf:qname ;
                  sp:arg1 [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type ui:TextNode ;
          ui:childIndex 1 ;
          ui:text [
              sp:varName "label"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "A hyperlink to a resource, using the QName of the resource as text. "^^xsd:string ;
  rdfs:label "Resource Link"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ResourceViews
  rdf:type ui:ResourceViewClass ;
  rdfs:label "Resource views"^^xsd:string ;
  rdfs:subClassOf ui:ResourceViews ;
.
lmdoc:ResourcesGenerator
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:template ;
      spl:valueType spin:SelectTemplate ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:view ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The view class to use"^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      let:tableId "lm_resources"^^xsd:string ;
      ui:child [
          rdf:type html:Div ;
          html:style "margin: 40px 0 25px 0;"^^xsd:string ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type ui:call ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "padding:20px;"^^xsd:string ;
                  ui:child [
                      rdf:type html:Button ;
                      html:class "lm-button"^^xsd:string ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "lmdoc.clearSelection('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "tableId"^^xsd:string ;
                            ] ;
                          sp:arg3 "')"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Clear Selections"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Button ;
                      html:class "lm-button"^^xsd:string ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "lmdoc.selectAll('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "tableId"^^xsd:string ;
                            ] ;
                          sp:arg3 "')"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Select All"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Button ;
                      html:class "lm-button"^^xsd:string ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "lmtest.acceptSelection('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "tableId"^^xsd:string ;
                            ] ;
                          sp:arg3 "', '"^^xsd:string ;
                          sp:arg4 [
                              rdf:type xsd:string ;
                              sp:arg1 [
                                  sp:varName "graph"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:arg5 "', '"^^xsd:string ;
                          sp:arg6 [
                              sp:varName "overlay"^^xsd:string ;
                            ] ;
                          sp:arg7 "')"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Accept Selections"^^xsd:string ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "lm-table"^^xsd:string ;
                  html:id [
                      sp:varName "tableId"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type html:Tbody ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Div ;
                              let:id [
                                  rdf:type ui:uniqueId ;
                                ] ;
                              ui:child [
                                  rdf:type html:Tr ;
                                  html:class "lm-row"^^xsd:string ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      html:id [
                                          rdf:type fn:concat ;
                                          sp:arg1 "td-resource_" ;
                                          sp:arg2 [
                                              sp:varName "id"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              rdf:type xsd:string ;
                                              sp:arg1 [
                                                  sp:varName "resource"^^xsd:string ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 2 ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      ui:child [
                                          rdf:type html:Button ;
                                          html:class "lm-button"^^xsd:string ;
                                          html:onclick [
                                              rdf:type ui:concat ;
                                              sp:arg1 "lmtest.generate('"^^xsd:string ;
                                              sp:arg2 [
                                                  rdf:type xsd:string ;
                                                  sp:arg1 [
                                                      sp:varName "resource"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              sp:arg3 "','"^^xsd:string ;
                                              sp:arg4 [
                                                  rdf:type xsd:string ;
                                                  sp:arg1 [
                                                      sp:varName "graph"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              sp:arg5 "','"^^xsd:string ;
                                              sp:arg6 [
                                                  rdf:type ui:encodeURL ;
                                                  sp:arg1 [
                                                      sp:varName "view"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              sp:arg7 "','"^^xsd:string ;
                                              sp:arg8 [
                                                  sp:varName "overlay"^^xsd:string ;
                                                ] ;
                                              sp:arg9 "')"^^xsd:string ;
                                            ] ;
                                          ui:child [
                                              rdf:type ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text "View"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 3 ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      ui:child [
                                          rdf:type html:Input ;
                                          html:name [
                                              rdf:type ui:concat ;
                                              sp:arg1 [
                                                  rdf:type fn:concat ;
                                                  sp:arg1 "CB_" ;
                                                  sp:arg2 [
                                                      sp:varName "id"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              sp:arg2 " "^^xsd:string ;
                                            ] ;
                                          html:type "checkbox"^^xsd:string ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 4 ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              rdf:type sp:add ;
                                              sp:arg1 [
                                                  sp:varName "index"^^xsd:string ;
                                                ] ;
                                              sp:arg2 1 ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              sp:varName "qName"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:indexVar "index"^^xsd:string ;
                          ui:resultSet [
                              sp:varName "resources"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      html:class "lm-table-header"^^xsd:string ;
                      ui:child [
                          rdf:type html:Tr ;
                          html:class "lm-row"^^xsd:string ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "#"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Generate"^^xsd:string ;
                                ] ;
                              ui:childIndex 4 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Quick Look"^^xsd:string ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Resource"^^xsd:string ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "URI"^^xsd:string ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "resources"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:template [
              sp:varName "template"^^xsd:string ;
            ] ;
          ui:varName "resources"^^xsd:string ;
        ] ;
      ui:child [
          rdf:type lmdoc:VSpace ;
          arg:margin "40px;"^^xsd:string ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Resources generator"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:ResourcesMaintainer
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:heading ;
      spl:valueType xsd:string ;
      rdfs:comment "Section heading"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:template ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:view ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The view class to use"^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type sp:iri ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:myGraphMetadata [
              rdf:type spl:objectInGraph ;
              sp:arg1 [
                  sp:varName "myGraph"^^xsd:string ;
                ] ;
              sp:arg2 vaem:hasGraphMetadata ;
              sp:arg3 [
                  sp:varName "myGraph"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:setContext ;
              ui:child [
                  rdf:type ui:group ;
                  let:myOverlay [
                      rdf:type sp:iri ;
                      sp:arg1 [
                          rdf:type sp:coalesce ;
                          sp:arg1 [
                              sp:varName "overlay"^^xsd:string ;
                            ] ;
                          sp:arg2 ui:tempGraph ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:setContext ;
                      ui:child [
                          rdf:type ui:setContext ;
                          ui:child [
                              rdf:type html:H1 ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      sp:varName "heading"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type html:Section ;
                              html:class "details"^^xsd:string ;
                              html:id "details"^^xsd:string ;
                              ui:child [
                                  rdf:type html:Div ;
                                  html:style "font-size:small;"^^xsd:string ;
                                  ui:child [
                                      rdf:type html:A ;
                                      html:href "http://www.topquadrant.com/technology/sparql-web-pages-swp/"^^xsd:string ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "TopBraid SPARQL Web Pages (SWP)"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 3 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Generated "^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 1 ;
                                      ui:text [
                                          rdf:type xsd:date ;
                                          sp:arg1 [
                                              rdf:type afn:now ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 2 ;
                                      ui:text " using"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 2 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Hr ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Section ;
                                  html:class "informative"^^xsd:string ;
                                  html:id [
                                      sp:varName "heading"^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type lmdoc:ResourcesGenerator ;
                                      arg:graph [
                                          sp:varName "myGraph"^^xsd:string ;
                                        ] ;
                                      arg:overlay [
                                          sp:varName "overlay"^^xsd:string ;
                                        ] ;
                                      arg:sectionHeading [
                                          sp:varName "heading"^^xsd:string ;
                                        ] ;
                                      arg:template [
                                          sp:varName "template"^^xsd:string ;
                                        ] ;
                                      arg:view [
                                          sp:varName "view"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 5 ;
                            ] ;
                          ui:child [
                              rdf:type html:Section ;
                              html:class "introductory"^^xsd:string ;
                              html:id "abstract"^^xsd:string ;
                              ui:child [
                                  rdf:type lmdoc:AbstractSection ;
                                  arg:metadata [
                                      sp:varName "myGraphMetadata"^^xsd:string ;
                                    ] ;
                                  arg:sectionHeading "Abstract"^^xsd:string ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 4 ;
                            ] ;
                          ui:child [
                              rdf:type ui:if ;
                              ui:child [
                                  rdf:type html:P ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Current query graph is "^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 1 ;
                                      ui:text [
                                          rdf:type ui:currentQueryGraph ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 1 ;
                              ui:condition [
                                  rdf:type fn:contains ;
                                  sp:arg1 [
                                      sp:varName "flags"^^xsd:string ;
                                    ] ;
                                  sp:arg2 "Sqg" ;
                                ] ;
                            ] ;
                          ui:child [
                              rdf:type ui:if ;
                              ui:child [
                                  rdf:type ui:CommentNode ;
                                  ui:childIndex 0 ;
                                  rdfs:comment "debug-swa:DumpTriplesForResourceAsSubject arg:resource=\"{= ?myGraphMetadata } \"/"^^xsd:string ;
                                ] ;
                              ui:childIndex 2 ;
                              ui:condition [
                                  rdf:type fn:contains ;
                                  sp:arg1 [
                                      sp:varName "flags"^^xsd:string ;
                                    ] ;
                                  sp:arg2 "Sgmd" ;
                                ] ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:GraphHeader ;
                              arg:metadata [
                                  sp:varName "myGraphMetadata"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:queryGraph [
                              rdf:type ui:unionOfGraphs ;
                              sp:arg1 [
                                  sp:varName "myGraph"^^xsd:string ;
                                ] ;
                              sp:arg2 [
                                  rdf:type ui:graphWithImports ;
                                  sp:arg1 <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
                                ] ;
                              sp:arg3 [
                                  rdf:type ui:graphWithImports ;
                                  sp:arg1 [
                                      sp:varName "myOverlay"^^xsd:string ;
                                    ] ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:varName "flags"^^xsd:string ;
                      ui:varValue [
                          sp:varName "flags"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:varName "namespacePrefix"^^xsd:string ;
              ui:varValue [
                  rdf:type spl:objectInGraph ;
                  sp:arg1 [
                      sp:varName "myGraphMetadata"^^xsd:string ;
                    ] ;
                  sp:arg2 vaem:name ;
                  sp:arg3 [
                      sp:varName "myGraph"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Resources Maintainer"^^xsd:string ;
  rdfs:subClassOf lmdoc:Pages ;
.
lmdoc:SaveSWPdoc
  rdf:type sml:ExportToTextFile ;
  sm:next lmdoc:returnFromCreateHTMLforResource ;
  sml:encoding "ISO-8859-1"^^xsd:string ;
  sml:replace "true"^^xsd:boolean ;
  sml:targetFilePath "{?docFilePath}"^^xsd:string ;
  sml:text "{?resourceDoc}"^^xsd:string ;
  rdfs:label "Save SWP doc"^^xsd:string ;
.
lmdoc:Sections
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:sectionHeading ;
      spl:valueType xsd:string ;
    ] ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:SelectTemplates
  rdf:type spin:SelectTemplate ;
  rdfs:subClassOf spin:SelectTemplates ;
.
lmdoc:Services
  rdf:type ui:Service ;
  rdfs:label "Services"^^xsd:string ;
  rdfs:subClassOf ui:Services ;
.
lmdoc:SubElements
  rdf:type ui:NodeClass ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:SubjectElements
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:object ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The object (usually the resource of the surrounding form)."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicate ;
      spl:valueType rdf:Property ;
      rdfs:comment "The predicate."^^xsd:string ;
    ] ;
  ui:abstract "true"^^xsd:boolean ;
  ui:private "true"^^xsd:boolean ;
  rdfs:subClassOf lmdoc:ViewElements ;
.
lmdoc:SubjectWidgetRow
  rdf:type ui:SubjectWidgetRowClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The subject to display."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:dynamicView ;
      arg:object [
          sp:varName "object"^^xsd:string ;
        ] ;
      arg:predicate [
          sp:varName "predicate"^^xsd:string ;
        ] ;
      arg:subject [
          sp:varName "subject"^^xsd:string ;
        ] ;
      ui:class swa:ObjectViewerRow ;
    ] ;
  rdfs:comment "A row of a SubjectWidget."^^xsd:string ;
  rdfs:label "Subject widget row"^^xsd:string ;
  rdfs:subClassOf lmdoc:ViewElements ;
.
lmdoc:Subjects
  rdf:type ui:NodeClass ;
  rdfs:subClassOf lmdoc:AbstractSubject ;
.
lmdoc:SwitchableForm
  rdf:type swa:FormClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:allowHistoryMode ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to have a \"Show history\" check box show up in view mode. This mode is currently only supported by the teamwork framework, not general SWA."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:allowLogMessage ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to also show a check box in edit mode, where the user can enter a commit message when pressing Save Changes"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:allowProvenanceMode ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to have a \"Show provenance\" check box show up in view mode. This mode is currently only supported by the Insight product, not general SWA."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:editable ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to add an option to allow the user to switch the form to edit mode."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:editing ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to make the form editing by default."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:formId ;
      spl:valueType xsd:string ;
      rdfs:comment "The id of the form if this is in edit mode."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:matchIds ;
      spl:valueType xsd:string ;
      rdfs:comment "An optional list of matchIds that shall be tried first when selecting the actual view. This allows users to define multiple forms for the same class, while specific SwitchableForms can pick which one of them they would like to use. If specified, then there should not be any commas at the end, but are allowed between the values."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The resource to display."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:showFooter ;
      spl:valueType xsd:boolean ;
      rdfs:comment "If set to true, a footer will always show up, even if ?showResourceActions and ?editable are false."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:showResourceActions ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to also display a button to run ResourceActions."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:showURI ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to display the URI of the resource on the right hand side of the header. Even if left to false (default), the URI will be the tool tip text of the header."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:suppressHeader ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to suppress any header."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:viewModeName ;
      spl:valueType xsd:string ;
      rdfs:comment "An optional name of the mode that shall be activated if the form is in view mode. This can be used to replace the default view with a specialized mode, e.g. history mode in EVN."^^xsd:string ;
    ] ;
  ui:overrides swa:SwitchableForm ;
  ui:prototype [
      rdf:type ui:group ;
      let:extraMatchIds [
          rdf:type sp:if ;
          sp:arg1 [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "matchIds"^^xsd:string ;
                ] ;
            ] ;
          sp:arg2 [
              rdf:type sp:concat ;
              sp:arg1 [
                  sp:varName "matchIds"^^xsd:string ;
                ] ;
              sp:arg2 "," ;
            ] ;
          sp:arg3 [
              sp:varName "none"^^xsd:string ;
            ] ;
        ] ;
      let:fid [
          rdf:type sp:coalesce ;
          sp:arg1 [
              sp:varName "formId"^^xsd:string ;
            ] ;
          sp:arg2 [
              rdf:type ui:uniqueId ;
            ] ;
        ] ;
      let:headerLabelFunction [
          rdf:type sp:coalesce ;
          sp:arg1 [
              rdf:type ui:contextValue ;
              sp:arg1 "headerLabelFunction" ;
            ] ;
          sp:arg2 swa:DefaultHeaderLabelFunction ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          ui:child [
              rdf:type ui:insertionPoint ;
              ui:childIndex 0 ;
              ui:pointId "extraFooter"^^xsd:string ;
            ] ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          let:ei [
              rdf:type sp:coalesce ;
              sp:arg1 [
                  sp:varName "editing"^^xsd:string ;
                ] ;
              sp:arg2 "false"^^xsd:boolean ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-form-footer"^^xsd:string ;
              ui:child [
                  rdf:type swa:Button ;
                  arg:disabled [
                      rdf:type sp:not ;
                      sp:arg1 [
                          sp:varName "editable"^^xsd:string ;
                        ] ;
                    ] ;
                  arg:iconClass "ui-icon ui-icon-wrench"^^xsd:string ;
                  arg:id [
                      rdf:type ui:concat ;
                      sp:arg1 [
                          sp:varName "fid"^^xsd:string ;
                        ] ;
                      sp:arg2 "-editButton"^^xsd:string ;
                    ] ;
                  arg:label "Edit"^^xsd:string ;
                  arg:onClick [
                      rdf:type ui:concat ;
                      sp:arg1 "swa.switchToEditForm('"^^xsd:string ;
                      sp:arg2 [
                          sp:varName "fid"^^xsd:string ;
                        ] ;
                      sp:arg3 "')"^^xsd:string ;
                    ] ;
                  arg:style [
                      rdf:type sp:if ;
                      sp:arg1 [
                          sp:varName "ei"^^xsd:string ;
                        ] ;
                      sp:arg2 "visibility: hidden" ;
                      sp:arg3 [
                          sp:varName "none"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "float: right"^^xsd:string ;
                  ui:child [
                      rdf:type ui:insertionPoint ;
                      ui:childIndex 0 ;
                      ui:pointId "bottomBar"^^xsd:string ;
                    ] ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  rdf:type html:Span ;
                  html:id [
                      rdf:type ui:concat ;
                      sp:arg1 [
                          sp:varName "fid"^^xsd:string ;
                        ] ;
                      sp:arg2 "-editModeButtonBar"^^xsd:string ;
                    ] ;
                  html:style [
                      rdf:type sp:if ;
                      sp:arg1 [
                          sp:varName "ei"^^xsd:string ;
                        ] ;
                      sp:arg2 [
                          sp:varName "none"^^xsd:string ;
                        ] ;
                      sp:arg3 "display: none" ;
                    ] ;
                  ui:child [
                      rdf:type swa:Button ;
                      arg:class "test-save-button"^^xsd:string ;
                      arg:iconClass "ui-icon ui-icon-check"^^xsd:string ;
                      arg:id [
                          rdf:type ui:concat ;
                          sp:arg1 [
                              sp:varName "fid"^^xsd:string ;
                            ] ;
                          sp:arg2 "-saveButton"^^xsd:string ;
                        ] ;
                      arg:label "Save Changes"^^xsd:string ;
                      arg:onClick [
                          rdf:type ui:concat ;
                          sp:arg1 "swa.submitForm('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "fid"^^xsd:string ;
                            ] ;
                          sp:arg3 "', null, swa.checkRestartWarning())"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type swa:Button ;
                      arg:iconClass "ui-icon ui-icon-cancel"^^xsd:string ;
                      arg:id [
                          rdf:type ui:concat ;
                          sp:arg1 [
                              sp:varName "fid"^^xsd:string ;
                            ] ;
                          sp:arg2 "-cancelButton"^^xsd:string ;
                        ] ;
                      arg:label "Cancel"^^xsd:string ;
                      arg:onClick [
                          rdf:type ui:concat ;
                          sp:arg1 "swa.switchToViewForm('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "fid"^^xsd:string ;
                            ] ;
                          sp:arg3 "')"^^xsd:string ;
                        ] ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      rdf:type swa:Space ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type swa:Space ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          rdf:type swa:Space ;
                          ui:childIndex 4 ;
                        ] ;
                      ui:child [
                          rdf:type swa:Space ;
                          ui:childIndex 5 ;
                        ] ;
                      ui:child [
                          rdf:type html:Input ;
                          html:id "logMessageBox"^^xsd:string ;
                          html:onclick "swa.rememberLogMessageBoxStatus()"^^xsd:string ;
                          html:style "width: 13px; height: 13px; padding: 0; margin:0; vertical-align: middle; position: relative; top: -1px; *overflow: hidden;"^^xsd:string ;
                          html:type "checkbox"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:Script ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "swa.restoreLogMessageBoxStatus();"^^xsd:string ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Span ;
                          html:class "swa-base-font"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Enter log message"^^xsd:string ;
                            ] ;
                          ui:childIndex 3 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          sp:varName "allowLogMessage"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type swa:ResourceActionsButton ;
                      arg:id [
                          rdf:type ui:concat ;
                          sp:arg1 [
                              sp:varName "fid"^^xsd:string ;
                            ] ;
                          sp:arg2 "-actionsButton"^^xsd:string ;
                        ] ;
                      arg:resource [
                          sp:varName "resource"^^xsd:string ;
                        ] ;
                      arg:style [
                          rdf:type sp:if ;
                          sp:arg1 [
                              sp:varName "ei"^^xsd:string ;
                            ] ;
                          sp:arg2 "visibility: hidden" ;
                          sp:arg3 [
                              sp:varName "none"^^xsd:string ;
                            ] ;
                        ] ;
                      arg:toolTip [
                          rdf:type ui:concat ;
                          sp:arg1 "Actions for "^^xsd:string ;
                          sp:arg2 [
                              rdf:type ui:label ;
                              sp:arg1 [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type swa:Space ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      sp:varName "showResourceActions"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-history-checkbox"^^xsd:string ;
                      html:id [
                          rdf:type ui:concat ;
                          sp:arg1 [
                              sp:varName "fid"^^xsd:string ;
                            ] ;
                          sp:arg2 "-historyModeBoxDiv"^^xsd:string ;
                        ] ;
                      html:style [
                          rdf:type sp:if ;
                          sp:arg1 [
                              sp:varName "ei"^^xsd:string ;
                            ] ;
                          sp:arg2 "visibility: hidden" ;
                          sp:arg3 [
                              sp:varName "none"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type html:Input ;
                          html:id [
                              rdf:type ui:concat ;
                              sp:arg1 [
                                  sp:varName "fid"^^xsd:string ;
                                ] ;
                              sp:arg2 "-historyModeBox"^^xsd:string ;
                            ] ;
                          html:onclick [
                              rdf:type ui:concat ;
                              sp:arg1 "swa.switchToViewForm('"^^xsd:string ;
                              sp:arg2 [
                                  sp:varName "fid"^^xsd:string ;
                                ] ;
                              sp:arg3 "')"^^xsd:string ;
                            ] ;
                          html:style "width: 13px; height: 13px; padding: 0; margin:0; vertical-align: bottom; position: relative; top: -2px; *overflow: hidden;"^^xsd:string ;
                          html:type "checkbox"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text " Show History"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 4 ;
                  ui:condition [
                      sp:varName "allowHistoryMode"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-provenance-checkbox"^^xsd:string ;
                      html:id [
                          rdf:type ui:concat ;
                          sp:arg1 [
                              sp:varName "fid"^^xsd:string ;
                            ] ;
                          sp:arg2 "-provenanceModeBoxDiv"^^xsd:string ;
                        ] ;
                      html:style [
                          rdf:type sp:if ;
                          sp:arg1 [
                              sp:varName "ei"^^xsd:string ;
                            ] ;
                          sp:arg2 "visibility: hidden" ;
                          sp:arg3 [
                              sp:varName "none"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type html:Input ;
                          html:id [
                              rdf:type ui:concat ;
                              sp:arg1 [
                                  sp:varName "fid"^^xsd:string ;
                                ] ;
                              sp:arg2 "-provenanceModeBox"^^xsd:string ;
                            ] ;
                          html:onclick [
                              rdf:type ui:concat ;
                              sp:arg1 "swa.switchToViewForm('"^^xsd:string ;
                              sp:arg2 [
                                  sp:varName "fid"^^xsd:string ;
                                ] ;
                              sp:arg3 "')"^^xsd:string ;
                            ] ;
                          html:style "width: 13px; height: 13px; padding: 0; margin:0; vertical-align: bottom; position: relative; top: -2px; *overflow: hidden;"^^xsd:string ;
                          html:type "checkbox"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text " Show Data Sources"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 5 ;
                  ui:condition [
                      sp:varName "allowProvenanceMode"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 3 ;
          ui:condition [
              rdf:type sp:or ;
              sp:arg1 [
                  rdf:type sp:or ;
                  sp:arg1 [
                      sp:varName "editable"^^xsd:string ;
                    ] ;
                  sp:arg2 [
                      sp:varName "showResourceActions"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  sp:varName "showFooter"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type swa:FormHeader ;
              arg:label [
                  rdf:type spif:invoke ;
                  sp:arg1 [
                      sp:varName "headerLabelFunction"^^xsd:string ;
                    ] ;
                  sp:arg2 [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ] ;
              arg:toolTip [
                  sp:varName "resource"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Span ;
                      html:class "swa-form-header-uri"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "resource"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      sp:varName "showURI"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:or ;
              sp:arg1 [
                  rdf:type sp:not ;
                  sp:arg1 [
                      rdf:type sp:bound ;
                      sp:arg1 [
                          sp:varName "suppressHeader"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type sp:not ;
                  sp:arg1 [
                      sp:varName "suppressHeader"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:loadable ;
          html:class "ui-layout-content"^^xsd:string ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type html:Form ;
                      html:class "swa-form"^^xsd:string ;
                      html:id [
                          sp:varName "fid"^^xsd:string ;
                        ] ;
                      html:resource [
                          sp:varName "resource"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "swa-form-body"^^xsd:string ;
                          ui:child [
                              rdf:type swa:DataViewsSection ;
                              arg:resource [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type ui:resourceView ;
                              ui:childIndex 0 ;
                              ui:matchIds [
                                  rdf:type ui:concat ;
                                  sp:arg1 [
                                      sp:varName "extraMatchIds"^^xsd:string ;
                                    ] ;
                                  sp:arg2 "view,form"^^xsd:string ;
                                ] ;
                              ui:resource [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "mode"^^xsd:string ;
                  ui:varValue [
                      rdf:type sp:coalesce ;
                      sp:arg1 [
                          sp:varName "viewModeName"^^xsd:string ;
                        ] ;
                      sp:arg2 "view" ;
                    ] ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:Div ;
                  html:class "swa-uri"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "resource"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  sp:varName "showURI"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type html:Form ;
                      html:autocomplete "off"^^xsd:string ;
                      html:class "swa-form"^^xsd:string ;
                      html:id [
                          sp:varName "fid"^^xsd:string ;
                        ] ;
                      html:resource [
                          rdf:type swa:resourceURIOrBNodeId ;
                          arg:resource [
                              sp:varName "resource"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "swa-form-body"^^xsd:string ;
                          ui:child [
                              rdf:type ui:else ;
                              ui:child [
                                  rdf:type ui:classView ;
                                  ui:childIndex 0 ;
                                  ui:class [
                                      rdf:type swa:resourceType ;
                                    ] ;
                                  ui:matchIds [
                                      rdf:type ui:concat ;
                                      sp:arg1 [
                                          sp:varName "extraMatchIds"^^xsd:string ;
                                        ] ;
                                      sp:arg2 "edit,form"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type ui:if ;
                              ui:child [
                                  rdf:type ui:resourceView ;
                                  ui:childIndex 0 ;
                                  ui:matchIds [
                                      rdf:type ui:concat ;
                                      sp:arg1 [
                                          sp:varName "extraMatchIds"^^xsd:string ;
                                        ] ;
                                      sp:arg2 "edit,form"^^xsd:string ;
                                    ] ;
                                  ui:resource [
                                      sp:varName "resource"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:condition [
                                  rdf:type sp:bound ;
                                  sp:arg1 [
                                      sp:varName "resource"^^xsd:string ;
                                    ] ;
                                ] ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          rdf:type ui:if ;
                          ui:child [
                              rdf:type html:Input ;
                              html:name "_base"^^xsd:string ;
                              html:type "hidden"^^xsd:string ;
                              html:value [
                                  rdf:type ui:currentQueryGraph ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:condition [
                              sp:varName "editable"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:if ;
                          ui:child [
                              rdf:type html:Input ;
                              html:name "resourceType"^^xsd:string ;
                              html:type "hidden"^^xsd:string ;
                              html:value [
                                  rdf:type swa:resourceType ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                          ui:condition [
                              rdf:type sp:not ;
                              sp:arg1 [
                                  rdf:type sp:bound ;
                                  sp:arg1 [
                                      sp:varName "resource"^^xsd:string ;
                                    ] ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "mode"^^xsd:string ;
                  ui:varValue "edit"^^xsd:string ;
                ] ;
              ui:childIndex 1 ;
              ui:condition [
                  sp:varName "editing"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 1 ;
          ui:loadId [
              rdf:type ui:concat ;
              sp:arg1 [
                  sp:varName "fid"^^xsd:string ;
                ] ;
              sp:arg2 "-loadable"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A form displaying details of a given resource. The form displays a header on top, with label and type of the resource. If arg:editable is set to true, the form will have a button at the bottom to switch it to edit mode."^^xsd:string ;
  rdfs:label "View form"^^xsd:string ;
  rdfs:subClassOf swa:SwitchableForm ;
.
lmdoc:TOCEntry
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:count ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:heading ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myCountString [
          rdf:type sp:if ;
          sp:arg1 [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "count"^^xsd:string ;
                ] ;
            ] ;
          sp:arg2 [
              rdf:type fn:concat ;
              sp:arg1 " [" ;
              sp:arg2 [
                  sp:varName "count"^^xsd:string ;
                ] ;
              sp:arg3 "]" ;
            ] ;
          sp:arg3 "" ;
        ] ;
      ui:child [
          rdf:type html:A ;
          html:href [
              rdf:type fn:concat ;
              sp:arg1 "#" ;
              sp:arg2 [
                  rdf:type lmdoc:makeAnchorFromString ;
                  arg:label [
                      sp:varName "heading"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "heading"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type ui:TextNode ;
          ui:childIndex 1 ;
          ui:text [
              sp:varName "myCountString"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Creates a TOC Entry"^^xsd:string ;
  rdfs:label "Label"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:TableOfContents
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:A ;
          html:id "lmdoc_top"^^xsd:string ;
          ui:child [
              rdf:type html:H2 ;
              html:id [
                  rdf:type lmdoc:makeAnchorFromString ;
                  arg:label [
                      sp:varName "sectionHeading"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "sectionHeading"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type html:Ol ;
          html:class "lm-toc-numeric"^^xsd:string ;
          ui:child [
              rdf:type html:Li ;
              html:class "lm-toce"^^xsd:string ;
              ui:child [
                  rdf:type html:Ol ;
                  html:class "lm-toc"^^xsd:string ;
                  ui:child [
                      rdf:type html:Li ;
                      html:class "lm-toce"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:TOCEntry ;
                          arg:heading "Classes"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      html:class "lm-toce"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:TOCEntry ;
                          arg:heading "Instances"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      html:class "lm-toce"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:TOCEntry ;
                          arg:heading "Properties"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type lmdoc:TOCEntry ;
                  arg:heading "Resource Details"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Li ;
              html:class "lm-toce"^^xsd:string ;
              ui:child [
                  rdf:type html:Ol ;
                  html:class "lm-toc"^^xsd:string ;
                  ui:child [
                      rdf:type html:Li ;
                      html:class "lm-toce"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:TOCEntry ;
                          arg:heading "Imported Graphs"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      html:class "lm-toce"^^xsd:string ;
                      ui:child [
                          rdf:type lmdoc:TOCEntry ;
                          arg:heading "Non-imported Resources"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type lmdoc:TOCEntry ;
                  arg:heading "Resource Index"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Table of contents"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
.
lmdoc:URIResourceSubjectViewer
  rdf:type swa:SubjectViewerClass ;
  swa:subjectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:isIRI ;
          sp:arg1 [
              sp:varName "subject"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:overrides swa:URIResourceSubjectViewer ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type ui:contextValue ;
          sp:arg1 "graph" ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "swa-shifted-label"^^xsd:string ;
          html:title [
              sp:varName "subject"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type lmdoc:ResourceLink ;
                  arg:resource [
                      sp:varName "subject"^^xsd:string ;
                    ] ;
                  arg:title [
                      rdf:type xsd:string ;
                      sp:arg1 [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type ui:else ;
                  ui:child [
                      rdf:type lmdoc:ResourceLink ;
                      arg:resource [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                      arg:title [
                          rdf:type xsd:string ;
                          sp:arg1 [
                              sp:varName "subject"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type ui:resourceView ;
                      ui:childIndex 1 ;
                      ui:matchIds "lmdoc-summary"^^xsd:string ;
                      ui:resource [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type lmdoc:ResourceDocLink ;
                      arg:label [
                          sp:varName "myLabel"^^xsd:string ;
                        ] ;
                      arg:resource [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type lmdoc:IsDefinedInGraph ;
                      arg:graph [
                          sp:varName "myGraph"^^xsd:string ;
                        ] ;
                      arg:resource [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "myGraph"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "A viewer for URI resources, displaying a hyperlink to that resource."^^xsd:string ;
  rdfs:label "URI resource subject viewer"^^xsd:string ;
  rdfs:subClassOf swa:URIResourceSubjectViewer ;
.
lmdoc:URIResourceViewer
  rdf:type swa:ObjectViewerClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
    ] ;
  swa:objectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:eq ;
          sp:arg1 [
              sp:varName "kind"^^xsd:string ;
            ] ;
          sp:arg2 "uri" ;
        ] ;
      swa:weight 50 ;
    ] ;
  ui:overrides swa:URIResourceViewer ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type ui:contextValue ;
          sp:arg1 "graph" ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:myLabel [
              rdf:type sp:if ;
              sp:arg1 [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "label"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type fn:concat ;
                  sp:arg1 " [" ;
                  sp:arg2 [
                      sp:varName "label"^^xsd:string ;
                    ] ;
                  sp:arg3 "]" ;
                ] ;
              sp:arg3 "" ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-shifted-label"^^xsd:string ;
              html:title [
                  sp:varName "object"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:else ;
                  ui:child [
                      rdf:type lmdoc:ResourceLink ;
                      arg:label [
                          sp:varName "myLabel"^^xsd:string ;
                        ] ;
                      arg:resource [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                      arg:title [
                          rdf:type xsd:string ;
                          sp:arg1 [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type ui:else ;
                      ui:child [
                          rdf:type lmdoc:ResourceLink ;
                          arg:label [
                              sp:varName "myLabel"^^xsd:string ;
                            ] ;
                          arg:resource [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          arg:title [
                              rdf:type xsd:string ;
                              sp:arg1 [
                                  sp:varName "object"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type ui:resourceView ;
                          ui:childIndex 1 ;
                          ui:matchIds "lmdoc-summary"^^xsd:string ;
                          ui:resource [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:ResourceLink ;
                          arg:label [
                              sp:varName "myLabel"^^xsd:string ;
                            ] ;
                          arg:resource [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          arg:title [
                              rdf:type xsd:string ;
                              sp:arg1 [
                                  sp:varName "object"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          rdf:type lmdoc:IsDefinedInGraph ;
                          arg:graph [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                          arg:resource [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:bound ;
                      sp:arg1 [
                          sp:varName "myGraph"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment """<ui:group let:myGraph=\"{= ui:contextValue(&quot;graph&quot;) }\">
    <ui:group let:myLabel=\"{= IF(bound(?label), fn:concat(&quot; [&quot;, ?label, &quot;]&quot;), &quot;&quot;) }\">
        <div class=\"swa-shifted-label\" title=\"{= ?object }\">
            <ui:if ui:condition=\"{= bound(?myGraph) }\">
                <ui:if ui:condition=\"{= lmdoc:IsDefinedInGraph(?myGraph, ?object) }\">
                    <lmdoc:ResourceDocLink arg:label=\"{= ?myLabel }\" arg:resource=\"{= ?object }\"/>
                    <ui:resourceView ui:matchIds=\"lmdoc-summary\" ui:resource=\"{= ?object }\"/>
                </ui:if>
                <ui:else>
                    <lmdoc:ResourceLink arg:label=\"{= ?myLabel }\" arg:resource=\"{= ?object }\" arg:title=\"{= xsd:string(?object) }\"/>
                </ui:else>
            </ui:if>
            <ui:else>
                <lmdoc:ResourceLink arg:label=\"{= ?myLabel }\" arg:resource=\"{= ?object }\" arg:title=\"{= xsd:string(?object) }\"/>
            </ui:else>
        </div>
    </ui:group>
</ui:group>"""^^xsd:string ;
  rdfs:label "URI resource viewer"^^xsd:string ;
  rdfs:subClassOf swa:URIResourceViewer ;
.
lmdoc:VSpace
  rdf:type ui:NodeClass ;
