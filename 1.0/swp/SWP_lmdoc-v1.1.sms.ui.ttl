lmdoc:Footer
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Div ;
          html:class "size-10"^^xsd:string ;
          ui:child [
              rdf:type html:A ;
