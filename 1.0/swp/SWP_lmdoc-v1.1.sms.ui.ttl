                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              rdf:type xsd:string ;
                                              sp:arg1 [
                                                  sp:varName "class"^^xsd:string ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      ui:child [
                                          rdf:type html:Button ;
                                          html:class "lm-button"^^xsd:string ;
                                          html:onclick [
                                              rdf:type ui:concat ;
                                              sp:arg1 "lmtest.generate('"^^xsd:string ;
                                              sp:arg2 [
                                                  rdf:type xsd:string ;
                                                  sp:arg1 [
                                                      sp:varName "class"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              sp:arg3 "','"^^xsd:string ;
                                              sp:arg4 [
                                                  rdf:type xsd:string ;
                                                  sp:arg1 [
                                                      sp:varName "graph"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              sp:arg5 "','"^^xsd:string ;
                                              sp:arg6 [
