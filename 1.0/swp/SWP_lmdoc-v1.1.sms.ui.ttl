        ] ;
      ui:child [
          rdf:type ui:call ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:H2 ;
