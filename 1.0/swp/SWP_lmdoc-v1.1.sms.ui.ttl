lmdoc:Class
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:errorPrototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type ui:group ;
              let:myGraphMetadata [
                  rdf:type spl:object ;
                  sp:arg1 [
                      sp:varName "myGraph"^^xsd:string ;
                    ] ;
                  sp:arg2 vaem:hasGraphMetadata ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:P ;
                      html:class "lm-para"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "No graph metadata for graph "^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition "(!bound(?myGraphMetadata))"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Missiing graph value"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition "(!bound(?graph))"^^xsd:string ;
        ] ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type sp:iri ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:myOverlay [
              rdf:type sp:iri ;
              sp:arg1 [
                  rdf:type sp:coalesce ;
                  sp:arg1 [
                      sp:varName "overlay"^^xsd:string ;
                    ] ;
                  sp:arg2 ui:tempGraph ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:setContext ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type ui:setContext ;
                      ui:child [
                          rdf:type ui:group ;
                          let:myGraphMetadata [
                              rdf:type spl:object ;
                              sp:arg1 [
                                  sp:varName "myGraph"^^xsd:string ;
                                ] ;
                              sp:arg2 vaem:hasGraphMetadata ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:DetailedClassView ;
                              arg:class [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                              arg:showInstances "false"^^xsd:boolean ;
                              arg:showTitle "false"^^xsd:boolean ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:Footer ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:PartHeader ;
                              arg:metadata [
                                  sp:varName "myGraphMetadata"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:ResourceHeader ;
                              arg:node [
                                  sp:varName "resource"^^xsd:string ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:queryGraph [
                          rdf:type ui:unionOfGraphs ;
                          sp:arg1 [
                              rdf:type ui:graphWithImports ;
                              sp:arg1 [
                                  sp:varName "myGraph"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:arg2 [
                              rdf:type ui:graphWithImports ;
                              sp:arg1 [
                                  sp:varName "myOverlay"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:arg3 [
                              rdf:type ui:graphWithImports ;
                              sp:arg1 <http://www.linkedmodel.org/1.1/swp/lmdoc> ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "graph"^^xsd:string ;
                  ui:varValue [
                      sp:varName "myGraph"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:varName "flags"^^xsd:string ;
              ui:varValue [
                  sp:varName "flags"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  vaem:todo "remove dependency on swa.css"^^xsd:string ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=lmdoc:Class&graph=http://www.linkedmodel.org/2.0/schema/vaem&resource=http%3A%2F%2Fwww.linkedmodel.org%2Fschema%2Fvaem%23GraphRole"""^^xsd:string ;
  rdfs:label "Class Documentation"^^xsd:string ;
  rdfs:subClassOf lmdoc:Pages ;
.
lmdoc:ClassInstances
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type ui:group ;
          letrs:instances [
              rdf:type sp:Select ;
              sp:orderBy (
                  [
                    rdf:type ui:label ;
                    sp:arg1 [
                        sp:varName "instance"^^xsd:string ;
                      ] ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "instance"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "class"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:type ;
                    sp:subject [
                        sp:varName "instance"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:Dd ;
                  ui:child [
                      rdf:type ui:forEach ;
                      ui:child [
                          rdf:type lmdoc:ResourceDocLink ;
                          arg:resource [
                              sp:varName "instance"^^xsd:string ;
                            ] ;
                          arg:title [
                              rdf:type xsd:string ;
                              sp:arg1 [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:resultSet [
                          sp:varName "instances"^^xsd:string ;
                        ] ;
                      ui:separator " | "^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:class "swa-sub-title"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Instances"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "instances"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue lmdoc:createLinkForMainForm ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Class Instances"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
lmdoc:ClassesGeneratorSection
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraphMetadata [
          rdf:type spl:object ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
          sp:arg2 vaem:hasGraphMetadata ;
        ] ;
      let:tableId "lm_resources"^^xsd:string ;
      ui:child [
          rdf:type html:Div ;
          html:style "margin: 40px 0 25px 0;"^^xsd:string ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type ui:call ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "padding:20px;"^^xsd:string ;
                  ui:child [
                      rdf:type html:Button ;
                      html:class "lm-button"^^xsd:string ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "lmdoc.clearSelection('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "tableId"^^xsd:string ;
                            ] ;
                          sp:arg3 "')"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Clear Selections"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Button ;
                      html:class "lm-button"^^xsd:string ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "lmdoc.selectAll('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "tableId"^^xsd:string ;
                            ] ;
                          sp:arg3 "')"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Select All"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Button ;
                      html:class "lm-button"^^xsd:string ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "lmtest.acceptSelection('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "tableId"^^xsd:string ;
                            ] ;
                          sp:arg3 "', '"^^xsd:string ;
                          sp:arg4 [
                              rdf:type xsd:string ;
                              sp:arg1 [
                                  sp:varName "graph"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:arg5 "', '"^^xsd:string ;
                          sp:arg6 [
