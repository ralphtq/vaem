                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Generate"^^xsd:string ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "lm-column-labels"^^xsd:string ;
                              ui:child [
