                                                    ] ;
                                                ] ;
                                              sp:arg2 " "^^xsd:string ;
                                            ] ;
                                          html:type "checkbox"^^xsd:string ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 3 ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              sp:varName "qName"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "classes"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      html:class "lm-table-header"^^xsd:string ;
                      ui:child [
                          rdf:type html:Tr ;
