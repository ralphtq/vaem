                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
