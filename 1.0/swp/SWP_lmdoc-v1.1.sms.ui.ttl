              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "TopBraid SPARQL Web Pages (SWP)"^^xsd:string ;
                ] ;
              ui:childIndex 5 ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "Generated "^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 1 ;
              ui:text [
                  rdf:type xsd:date ;
                  sp:arg1 [
                      rdf:type afn:now ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 2 ;
              ui:text " by lmdoc version "^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 3 ;
              ui:text [
                  rdf:type spl:object ;
                  sp:arg1 lmdoc:GMD_LMDOC ;
                  sp:arg2 vaem:revision ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 4 ;
              ui:text " using "^^xsd:string ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:Hr ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Footer"^^xsd:string ;
  rdfs:subClassOf lmdoc:Sections ;
