lmdoc:WhereUsedLabeledSubjects
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to only allow at most one subject for this component."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:if ;
      ui:child [
          rdf:type html:Tr ;
          html:class "lm-row"^^xsd:string ;
          ui:child [
              rdf:type html:Td ;
              html:class "lm-table-column align-top"^^xsd:string ;
              ui:child [
                  rdf:type lmdoc:URIResourceViewer ;
                  arg:object [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Td ;
              html:class "lm-table-column"^^xsd:string ;
              html:id [
                  rdf:type ui:concat ;
                  sp:arg1 [
                      sp:varName "pid"^^xsd:string ;
                    ] ;
                  sp:arg2 "-body"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type lmdoc:WhereUsedSubjectsBody ;
                  ui:args "*"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:condition [
          rdf:type sp:or ;
          sp:arg1 [
              rdf:type sp:or ;
              sp:arg1 [
                  rdf:type sp:or ;
                  sp:arg1 [
                      rdf:type sp:not ;
                      sp:arg1 [
                          rdf:type sp:bound ;
                          sp:arg1 [
                              sp:varName "hideIfEmpty"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  sp:arg2 [
                      rdf:type sp:ne ;
                      sp:arg1 [
                          sp:varName "hideIfEmpty"^^xsd:string ;
                        ] ;
                      sp:arg2 "true"^^xsd:boolean ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type sp:ne ;
                  sp:arg1 [
                      rdf:type swa:mode ;
                    ] ;
                  sp:arg2 swa:ViewMode ;
                ] ;
            ] ;
          sp:arg2 [
              rdf:type sp:and ;
              sp:arg1 [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type sp:exists ;
                  sp:elements (
                      [
                        sp:object [
                            sp:varName "object"^^xsd:string ;
                          ] ;
                        sp:predicate [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                        sp:subject [
                            sp:varName "anySubject"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "Where used labelled subjects"^^xsd:string ;
  rdfs:label "Labeled subjects"^^xsd:string ;
  rdfs:subClassOf lmdoc:Subjects ;
.
lmdoc:WhereUsedSubjects
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:object ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicates ;
      spl:valueType sp:Select ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      letrs:rs [
          rdf:type sp:Select ;
          sp:resultVariables (
              [
                sp:varName "predicate"^^xsd:string ;
              ]
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "predicates"^^xsd:string ;
                  ] ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object 0 ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object () ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "predicate"^^xsd:string ;
                  ] ;
                sp:predicate spr:colCells ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                rdf:type sp:Filter ;
                sp:expression [
                    rdf:type sp:or ;
                    sp:arg1 [
                        rdf:type sp:not ;
                        sp:arg1 [
                            rdf:type sp:bound ;
                            sp:arg1 [
                                sp:varName "filterFunction"^^xsd:string ;
                              ] ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        rdf:type spif:invoke ;
                        sp:arg1 [
                            sp:varName "filterFunction"^^xsd:string ;
                          ] ;
                        sp:arg2 [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                        sp:arg3 [
                            sp:varName "subject"^^xsd:string ;
                          ] ;
                      ] ;
                  ] ;
              ]
              [
                rdf:type sp:Filter ;
                sp:expression [
                    rdf:type sp:not ;
                    sp:arg1 [
                        rdf:type swa:isHiddenProperty ;
                        arg:property [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                      ] ;
                  ] ;
              ]
            ) ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Table ;
              html:class "lm-table"^^xsd:string ;
              let:pid [
                  rdf:type ui:uniqueId ;
                ] ;
              ui:child [
                  rdf:type html:Tbody ;
                  html:class "lm-table-body"^^xsd:string ;
                  ui:child [
                      rdf:type ui:forEach ;
                      ui:child [
                          rdf:type lmdoc:WhereUsedLabeledSubjects ;
                          arg:property [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          arg:single "false"^^xsd:boolean ;
                          ui:args "*"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:resultSet [
                          sp:varName "rs"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Thead ;
                  html:class "lm-table-header"^^xsd:string ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Referencing Property"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Subject"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:gt ;
              sp:arg1 [
                  rdf:type spr:rowCount ;
                  sp:arg1 [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "Inserts a widget for a given predicate/object combination, showing the subjects as values. This is typically known as \"Incoming References\"."^^xsd:string ;
  rdfs:label "Subjects"^^xsd:string ;
  rdfs:subClassOf lmdoc:Subjects ;
.
lmdoc:WhereUsedSubjectsBody
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to allow at most one value."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-object-row"^^xsd:string ;
              ui:child [
                  rdf:type swa:SubjectWidgetRow ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-add-button-div"^^xsd:string ;
              html:style [
                  rdf:type sp:if ;
                  sp:arg1 [
                      sp:varName "single"^^xsd:string ;
                    ] ;
                  sp:arg2 "display: none" ;
                  sp:arg3 [
                      sp:varName "none"^^xsd:string ;
                    ] ;
                ] ;
              let:pid [
                  rdf:type ui:uniqueId ;
                ] ;
              ui:child [
                  rdf:type html:A ;
                  html:class "swa-add-row-button"^^xsd:string ;
                  html:href "javascript:void(0)"^^xsd:string ;
                  html:onclick [
                      rdf:type fn:concat ;
                      sp:arg1 "swa.addRow('"^^xsd:string ;
                      sp:arg2 [
                          sp:varName "pid"^^xsd:string ;
                        ] ;
                      sp:arg3 "', "^^xsd:string ;
                      sp:arg4 [
                          rdf:type sp:coalesce ;
                          sp:arg1 [
                              sp:varName "single"^^xsd:string ;
                            ] ;
                          sp:arg2 "false"^^xsd:boolean ;
                        ] ;
                      sp:arg5 ")"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:id [
                      sp:varName "pid"^^xsd:string ;
                    ] ;
                  html:style "display: none"^^xsd:string ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type ui:setContext ;
                          ui:child [
                              rdf:type swa:SubjectWidgetRow ;
                              arg:object [
                                  sp:varName "object"^^xsd:string ;
                                ] ;
                              arg:predicate [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:varName "createLinkFunction"^^xsd:string ;
                          ui:varValue lmdoc:createLinkForMainForm ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 2 ;
          ui:condition [
              rdf:type swa:isEditMode ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:call ;
              arg:object [
                  sp:varName "object"^^xsd:string ;
                ] ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa_widget_value_slot"^^xsd:string ;
                      ui:child [
                          rdf:type swa:SubjectWidgetRow ;
                          arg:object [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          arg:subject [
                              sp:varName "subject"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type swa:SubjectWidgetRow ;
                          arg:object [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:eq ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "rs"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template swa:SortedSubjects ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "Where used subjects body"^^xsd:string ;
  rdfs:label "Subjects body"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubjectElements ;
.
lmdoc:WhereUsedSubjectsGroup
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:filterFunction ;
      spl:valueType spin:Function ;
      rdfs:comment "An optional filter function that takes a predicate, subject and subjectType as arguments and returns true for all predicates that should be displayed."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:label ;
      spl:valueType xsd:string ;
      rdfs:comment "The title label."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:object ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The resource to display."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicates ;
      spl:valueType sp:Select ;
      rdfs:comment "A result set (e.g., SPARQL SELECT query) that delivers the predicates in this group."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-objects-group"^^xsd:string ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-sub-title"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "label"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:bound ;
                      sp:arg1 [
                          sp:varName "label"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type lmdoc:WhereUsedSubjects ;
                  arg:object [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                  arg:predicates [
                      sp:varName "predicates"^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:gt ;
              sp:arg1 [
                  rdf:type spr:rowCount ;
                  sp:arg1 [
                      sp:varName "predicates"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A group of subject widgets."^^xsd:string ;
  rdfs:label "Where used subjects group"^^xsd:string ;
  rdfs:subClassOf lmdoc:Subjects ;
.
lmdoc:buildDocFilePath
  rdf:type sml:BindBySelect ;
  sm:next lmdoc:SaveSWPdoc ;
  sml:selectQuery [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "docFilePath"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 "/" ;
                sp:arg2 [
                    rdf:type spif:regex ;
                    sp:arg1 [
                        rdf:type xsd:string ;
                        sp:arg1 [
                            sp:varName "resource"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:arg2 ".*//(.*)" ;
                    sp:arg3 "$1" ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "docFilePath"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:label "build doc file path"^^xsd:string ;
.
lmdoc:buildResourceDocLink
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "link"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "definingGraph"^^xsd:string ;
                    ] ;
                  sp:predicate rdfs:isDefinedBy ;
                  sp:subject [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type lmdoc:getCatalogDocURL ;
                lmdoc:catalogGraph [
                    sp:varName "catalogGraph"^^xsd:string ;
                  ] ;
                lmdoc:graph [
                    sp:varName "definingGraph"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "docURI"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type lmdoc:makeAnchorFromResource ;
                arg:resource [
                    sp:varName "resource"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "anchor"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 [
                    sp:varName "docURI"^^xsd:string ;
                  ] ;
                sp:arg2 "#" ;
                sp:arg3 [
                    sp:varName "anchor"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "link"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate lmdoc:catalogGraph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate lmdoc:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "build resource doc link"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:catalogGraph
  rdf:type owl:ObjectProperty ;
  rdfs:label "catalog graph"^^xsd:string ;
  rdfs:range rdfs:Resource ;
.
lmdoc:countOfInstanceOfType
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:expression [
                rdf:type sp:Count ;
                sp:expression [
                    sp:varName "instance"^^xsd:string ;
                  ] ;
              ] ;
            sp:varName "count"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "instance"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:type ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:integer ;
  rdfs:comment "Returns a count of  instancesof a given type defined in a given graph."^^xsd:string ;
  rdfs:label "All instances"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:createHTMLdocumentForResource
  rdf:type sm:Function ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:defaultValue " "^^xsd:string ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
      sm:next lmdoc:CreateHTMLforResource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:overlay ;
      spl:valueType xsd:string ;
      sm:next lmdoc:CreateHTMLforResource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      sm:next lmdoc:CreateHTMLforResource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
      sm:next lmdoc:CreateHTMLforResource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:swpElement ;
      spl:valueType ui:NodeClass ;
      sm:next lmdoc:CreateHTMLforResource ;
    ] ;
  sm:returnModule lmdoc:returnFromCreateHTMLforResource ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/sparqlmotion?id=createHTMLdocumentForResource&swpElement=http%3A%2F%2Fwww.linkedmodel.org%2Foui%2Flmdoc%23Instance&graph=http://www.linkedmodel.org/2.0/schema/vaem&resource=http%3A%2F%2Fwww.linkedmodel.org%2Fschema%2Fvaem%23ScriptGraph

http://localhost:8083/tbl/sparqlmotion?id=createHTMLdocumentForResource&swpElement=http%3A%2F%2Fwww.linkedmodel.org%2Foui%2Flmdoc%23Instance&graph=http://www.linkedmodel.org/2.0/schema/vaem&resource=http%3A%2F%2Fwww.linkedmodel.org%2Fschema%2Fvaem%23SchemaGraph"""^^xsd:string ;
  rdfs:label "create HTML document for resource"^^xsd:string ;
  rdfs:subClassOf sm:Functions ;
.
lmdoc:createLinkForMainForm
  rdf:type ui:NodeClass ;
  rdfs:subClassOf lmdoc:CreateLinkFunctions ;
.
lmdoc:defaultTitleFunction
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "title"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:coalesce ;
                sp:arg1 [
                    rdf:type spl:object ;
                    sp:arg1 [
                        sp:varName "resource"^^xsd:string ;
                      ] ;
                    sp:arg2 dct:description ;
                  ] ;
                sp:arg2 [
                    rdf:type spl:object ;
                    sp:arg1 [
                        sp:varName "resource"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:comment ;
                  ] ;
                sp:arg3 [
                    rdf:type xsd:string ;
                    sp:arg1 [
                        sp:varName "resource"^^xsd:string ;
                      ] ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "title"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:getCatalogDocURL
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "url"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:bound ;
                sp:arg1 [
                    sp:varName "catalogGraph"^^xsd:string ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                  sp:predicate lmcat:catalogedGraph ;
                  sp:subject [
                      sp:varName "rec"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "url"^^xsd:string ;
                    ] ;
                  sp:predicate vaem:latestPublishedVersion ;
                  sp:subject [
                      sp:varName "rec"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "catalogGraph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate lmdoc:catalogGraph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The graph resource that holds the catalog"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate lmdoc:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The base uri of the graph that is being looked for in the catalog"^^xsd:string ;
    ] ;
  rdfs:label "get catalog doc url"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:getCatalogRecords
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            rdf:type ui:label ;
            sp:arg1 [
                sp:varName "role"^^xsd:string ;
              ] ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "rec"^^xsd:string ;
          ]
          [
            sp:varName "role"^^xsd:string ;
          ]
          [
            sp:varName "latestPublishedVersion"^^xsd:string ;
          ]
          [
            sp:varName "catalogedGraph"^^xsd:string ;
          ]
          [
            sp:varName "overlayGraph"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "rec"^^xsd:string ;
              ] ;
            sp:predicate <http://www.w3.org/ns/dcat#record> ;
            sp:subject [
                sp:varName "catalog"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spl:object ;
                sp:arg1 [
                    sp:varName "catalog"^^xsd:string ;
                  ] ;
                sp:arg2 lmcat:documentationOverlayGraph ;
              ] ;
            sp:variable [
                sp:varName "overlayGraph"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spl:object ;
                sp:arg1 [
                    sp:varName "rec"^^xsd:string ;
                  ] ;
                sp:arg2 vaem:hasGraphRole ;
              ] ;
            sp:variable [
                sp:varName "role"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spl:object ;
                sp:arg1 [
                    sp:varName "rec"^^xsd:string ;
                  ] ;
                sp:arg2 vaem:latestPublishedVersion ;
              ] ;
            sp:variable [
                sp:varName "latestPublishedVersion"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spl:object ;
                sp:arg1 [
                    sp:varName "rec"^^xsd:string ;
                  ] ;
                sp:arg2 lmcat:catalogedGraph ;
              ] ;
            sp:variable [
                sp:varName "catalogedGraph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:label "get catalog records"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:getDefinition
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          _:b95165
        ) ;
      sp:where (
          [
            sp:object _:b95165 ;
            sp:predicate vaem:description ;
            sp:subject [
                sp:varName "resource"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:label "get definition"^^xsd:string ;
  rdfs:subClassOf lmdoc:Functions ;
.
lmdoc:getInstances
  rdf:type ui:Service ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type sp:iri ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:setContext ;
          ui:child [
              rdf:type ui:call ;
              arg:graph [
                  sp:varName "myGraph"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:else ;
                  ui:child [
                      rdf:type swon:Value ;
                      arg:name "nothing"^^xsd:string ;
                      arg:value [
                          rdf:type ui:concat ;
                          sp:arg1 "No instances in graph "^^xsd:string ;
                          sp:arg2 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type swon:Object ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type swon:Value ;
                              arg:name "instance"^^xsd:string ;
                              arg:value [
                                  sp:varName "instance"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "instances"^^xsd:string ;
                            ] ;
                          ui:separator ", "^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "instances"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template lmdoc:getInstancesOfTypeWithNamespacePrefix ;
              ui:varName "instances"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
          ui:queryGraph [
              rdf:type ui:unionOfGraphs ;
              sp:arg1 [
                  sp:varName "myGraph"^^xsd:string ;
                ] ;
              sp:arg2 [
                  rdf:type ui:graphWithImports ;
                  sp:arg1 <http://qudt.org/swa/doc> ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:JSON ;
  rdfs:label "Instances section"^^xsd:string ;
  rdfs:subClassOf lmdoc:Services ;
.
lmdoc:getInstancesOfTypeWithNamespacePrefix
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            sp:varName "qName"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "resource"^^xsd:string ;
          ]
          [
            sp:varName "qName"^^xsd:string ;
          ]
          [
            sp:varName "uri"^^xsd:string ;
          ]
        ) ;
      sp:where (
          (
            [
              sp:object [
                  sp:varName "graph"^^xsd:string ;
                ] ;
              sp:predicate rdfs:isDefinedBy ;
              sp:subject [
                  sp:varName "resource"^^xsd:string ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "type"^^xsd:string ;
                ] ;
              sp:predicate rdf:type ;
              sp:subject [
                  sp:varName "resource"^^xsd:string ;
                ] ;
            ]
            [
              rdf:type sp:Filter ;
              sp:expression [
                  rdf:type sp:notExists ;
                  sp:elements (
                      [
                        sp:object "true"^^xsd:boolean ;
                        sp:predicate vaem:exclude ;
                        sp:subject [
                            sp:varName "type"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ]
            [
              rdf:type sp:Bind ;
              sp:expression [
                  rdf:type ui:contextValue ;
                  sp:arg1 "namespacePrefix" ;
                ] ;
              sp:variable [
                  sp:varName "namespacePrefix"^^xsd:string ;
                ] ;
            ]
            [
              rdf:type sp:Bind ;
              sp:expression [
                  rdf:type smf:prefix ;
                  sp:arg1 [
                      sp:varName "type"^^xsd:string ;
                    ] ;
                ] ;
              sp:variable [
                  sp:varName "ns"^^xsd:string ;
                ] ;
            ]
            [
              rdf:type sp:Filter ;
              sp:expression [
                  rdf:type sp:eq ;
                  sp:arg1 [
                      sp:varName "ns"^^xsd:string ;
                    ] ;
                  sp:arg2 [
                      sp:varName "namespacePrefix"^^xsd:string ;
                    ] ;
                ] ;
            ]
          )
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type xsd:string ;
                sp:arg1 [
                    sp:varName "resource"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:qname ;
                sp:arg1 [
                    sp:varName "resource"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "qName"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all instances defined in a given graph, filtered by matching the namespace of their type with a given type, and orders them by label. Note this may (obviously) not scale if a class has too many instances."^^xsd:string ;
  rdfs:label "get instances of type with namespace prefix"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:getTitle
