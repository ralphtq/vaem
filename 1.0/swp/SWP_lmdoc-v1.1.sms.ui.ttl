lmdoc:Header
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:title ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type html:Div ;
      html:class "left pad-10"^^xsd:string ;
      ui:child [
          rdf:type html:Div ;
          html:class "clear-both"^^xsd:string ;
          ui:childIndex 3 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "left lm-poweredby-logo"^^xsd:string ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "left pad-10 size-24 lm-indigo lm-bold"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "title"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "right"^^xsd:string ;
          ui:child [
              rdf:type ui:insertionPoint ;
              ui:childIndex 0 ;
              ui:pointId "lmhdr1"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:insertionPoint ;
              ui:childIndex 1 ;
              ui:pointId "lmhdr2"^^xsd:string ;
            ] ;
          ui:childIndex 2 ;
        ] ;
    ] ;
  rdfs:subClassOf lmdoc:Elements ;
.
lmdoc:ImageResourceViewer
  rdf:type swa:ObjectViewerClass ;
