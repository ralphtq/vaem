lmdoc:AllProperties
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            sp:varName "qName"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "resource"^^xsd:string ;
          ]
          [
            sp:varName "qName"^^xsd:string ;
          ]
          [
            sp:varName "uri"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate rdfs:isDefinedBy ;
            sp:subject [
                sp:varName "resource"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "type"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "resource"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object rdf:Property ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "type"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type xsd:string ;
                sp:arg1 [
                    sp:varName "resource"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:qname ;
                sp:arg1 [
                    sp:varName "resource"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "qName"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all properties defined in a given graph and orders them by label. Note this may (obviously) not scale if a class has too many instances."^^xsd:string ;
  rdfs:label "All properties"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AllRules
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            sp:varName "ruleProperty"^^xsd:string ;
          ]
          [
            sp:varName "stepText"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "ruleProperty"^^xsd:string ;
          ]
          [
            sp:varName "ruleBody"^^xsd:string ;
          ]
          [
            sp:varName "ruleAsText"^^xsd:string ;
          ]
          [
            sp:varName "stepText"^^xsd:string ;
          ]
          [
            sp:varName "ruleComment"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object spin:rule ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject [
                sp:varName "ruleProperty"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "ruleBody"^^xsd:string ;
              ] ;
            sp:predicate [
                sp:varName "ruleProperty"^^xsd:string ;
              ] ;
            sp:subject [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:convertSPINRDFToString ;
                sp:arg1 [
                    sp:varName "ruleBody"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "ruleAsText"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type lmdoc:ExtractStepTextFromRule ;
                arg:rule [
                    sp:varName "ruleBody"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "stepText"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type lmdoc:ExtractCommentTextFromRule ;
                arg:rule [
                    sp:varName "ruleBody"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "ruleComment"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The class that the instances must have."^^xsd:string ;
    ] ;
  rdfs:comment "Gets all rules defined in a given graph and orders them by step."^^xsd:string ;
  rdfs:label "All rules"^^xsd:string ;
  rdfs:subClassOf lmdoc:SelectTemplates ;
.
lmdoc:AnyURILiteralViewer
  rdf:type swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:eq ;
          sp:arg1 [
              sp:varName "type"^^xsd:string ;
            ] ;
          sp:arg2 xsd:anyURI ;
        ] ;
      swa:weight 2 ;
    ] ;
  ui:overrides swa:AnyURILiteralViewer ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type html:Div ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              html:title [
                  sp:varName "title"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type xsd:string ;
                      sp:arg1 [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:A ;
              html:href [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type fn:starts-with ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
              sp:arg2 "http" ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The LM Doc viewer for xsd:anyURI values: shows a hyperlink to the URI."^^xsd:string ;
  rdfs:label "AnyURI literal viewer"^^xsd:string ;
  rdfs:subClassOf swa:AnyURILiteralViewer ;
.
lmdoc:AskTemplates
  rdf:type spin:AskTemplate ;
  rdfs:label "Ask templates"^^xsd:string ;
  rdfs:subClassOf spin:AskTemplates ;
.
lmdoc:BuildMetadataRecord
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:graphName [
          rdf:type spif:regex ;
          sp:arg1 [
              rdf:type xsd:string ;
              sp:arg1 [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ] ;
          sp:arg2 ".*/([A-Za-z0-9-]+)$" ;
          sp:arg3 "$1" ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:metadataName [
              rdf:type fn:concat ;
              sp:arg1 "GMD_" ;
              sp:arg2 [
                  rdf:type fn:upper-case ;
                  sp:arg1 [
                      sp:varName "graphName"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Make graph metadata "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text [
                      sp:varName "metadataName"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:transaction ;
              let:gmdU [
                  rdf:type sp:iri ;
                  sp:arg1 [
                      rdf:type fn:concat ;
                      sp:arg1 [
                          rdf:type xsd:string ;
                          sp:arg1 [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 "/" ;
                      sp:arg3 [
                          sp:varName "metadataName"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "URI is "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 1 ;
                      ui:text [
                          sp:varName "gmdU"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type ui:update ;
                  ui:childIndex 1 ;
                  ui:updateQuery [
                      rdf:type sp:Modify ;
                      sp:insertPattern (
                          [
                            rdf:type sp:NamedGraph ;
                            sp:elements (
                                [
                                  sp:object vaem:GraphMetaData ;
                                  sp:predicate rdf:type ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object [
                                      sp:varName "graphName"^^xsd:string ;
                                    ] ;
                                  sp:predicate vaem:name ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object [
                                      sp:varName "date"^^xsd:string ;
                                    ] ;
                                  sp:predicate dct:created ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object [
                                      sp:varName "date"^^xsd:string ;
                                    ] ;
                                  sp:predicate dct:modified ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object ""^^xsd:string ;
                                  sp:predicate dct:description ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object ""^^xsd:string ;
                                  sp:predicate dct:title ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object ""^^xsd:string ;
                                  sp:predicate dct:subject ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object ""^^xsd:string ;
                                  sp:predicate vaem:intent ;
                                  sp:subject [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                ]
                                [
                                  sp:object [
                                      sp:varName "gmdU"^^xsd:string ;
                                    ] ;
                                  sp:predicate vaem:hasGraphMetadata ;
                                  sp:subject [
                                      sp:varName "graph"^^xsd:string ;
                                    ] ;
                                ]
                              ) ;
                            sp:graphNameNode [
                                sp:varName "graph"^^xsd:string ;
                              ] ;
                          ]
                        ) ;
                      sp:where (
                          [
                            rdf:type sp:Bind ;
                            sp:expression [
                                rdf:type afn:now ;
                              ] ;
                            sp:variable [
                                sp:varName "date"^^xsd:string ;
                              ] ;
                          ]
                        ) ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:subClassOf lmdoc:Factories ;
.
lmdoc:CatalogManager
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType xsd:string ;
    ] ;
  ui:errorPrototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type sp:iri ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "No graph given"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:not ;
              sp:arg1 [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "myGraph"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type sp:iri ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:setContext ;
          ui:child [
              rdf:type ui:group ;
              let:myCatalog [
                  rdf:type spl:subject ;
                  sp:arg1 rdf:type ;
                  sp:arg2 lmcat:Catalog ;
                ] ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "lm-container"^^xsd:string ;
                      ui:child [
                          rdf:type html:H2 ;
                          html:class "size-12"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Catalog URI= "^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text [
                                  sp:varName "myCatalog"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type ui:call ;
                          ui:child [
                              rdf:type ui:if ;
                              ui:child [
                                  rdf:type html:Table ;
                                  html:class "lm-table"^^xsd:string ;
                                  ui:child [
                                      rdf:type html:Tbody ;
                                      html:class "lm-table-body"^^xsd:string ;
                                      ui:child [
                                          rdf:type ui:forEach ;
                                          ui:child [
                                              rdf:type html:Tr ;
                                              html:class "lm-row"^^xsd:string ;
                                              ui:child [
                                                  rdf:type html:Td ;
                                                  html:class "lm-column"^^xsd:string ;
                                                  ui:child [
                                                      rdf:type ui:TextNode ;
                                                      ui:childIndex 0 ;
                                                      ui:text [
                                                          rdf:type sp:add ;
                                                          sp:arg1 [
                                                              sp:varName "index"^^xsd:string ;
                                                            ] ;
                                                          sp:arg2 1 ;
                                                        ] ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:child [
                                                  rdf:type html:Td ;
                                                  html:class "lm-column"^^xsd:string ;
                                                  ui:child [
                                                      rdf:type ui:TextNode ;
                                                      ui:childIndex 0 ;
                                                      ui:text [
                                                          rdf:type ui:label ;
                                                          sp:arg1 [
                                                              sp:varName "rec"^^xsd:string ;
                                                            ] ;
                                                        ] ;
                                                    ] ;
                                                  ui:childIndex 2 ;
                                                ] ;
                                              ui:child [
                                                  rdf:type html:Td ;
                                                  html:class "lm-column"^^xsd:string ;
                                                  ui:child [
                                                      rdf:type ui:TextNode ;
                                                      ui:childIndex 0 ;
                                                      ui:text [
                                                          rdf:type ui:label ;
                                                          sp:arg1 [
                                                              sp:varName "role"^^xsd:string ;
                                                            ] ;
                                                        ] ;
                                                    ] ;
                                                  ui:childIndex 1 ;
                                                ] ;
                                              ui:child [
                                                  rdf:type html:Td ;
                                                  html:class "lm-column"^^xsd:string ;
                                                  ui:child [
                                                      rdf:type ui:TextNode ;
                                                      ui:childIndex 0 ;
                                                      ui:text [
