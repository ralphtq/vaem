                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column align-top"^^xsd:string ;
                          ui:child [
                              rdf:type lmdoc:URIResourceViewer ;
                              arg:object [
                                  sp:varName "property"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column"^^xsd:string ;
                          ui:child [
                              rdf:type html:Ol ;
                              ui:child [
                                  rdf:type ui:forEach ;
                                  ui:child [
                                      rdf:type html:Li ;
                                      ui:child [
                                          rdf:type lmdoc:Label ;
                                          arg:node [
                                              sp:varName "type"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:resultSet [
                                      rdf:type sp:Select ;
                                      sp:orderBy (
                                          [
                                            rdf:type ui:label ;
                                            sp:arg1 [
                                                sp:varName "type"^^xsd:string ;
                                              ] ;
                                          ]
                                        ) ;
                                      sp:resultVariables (
                                          [
                                            sp:varName "type"^^xsd:string ;
                                          ]
                                        ) ;
                                      sp:where (
                                          [
                                            sp:object [
                                                sp:varName "type"^^xsd:string ;
                                              ] ;
                                            sp:predicate rdf:type ;
                                            sp:subject [
                                                sp:varName "property"^^xsd:string ;
                                              ] ;
                                          ]
                                        ) ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "lm-column"^^xsd:string ;
                          ui:child [
                              rdf:type ui:group ;
                              let:max [
                                  rdf:type sp:Select ;
                                  sp:resultVariables (
                                      [
                                        sp:varName "c"^^xsd:string ;
                                      ]
                                    ) ;
                                  sp:where (
                                      [
                                        rdf:type sp:TriplePath ;
                                        sp:object [
                                            sp:varName "parent"^^xsd:string ;
                                          ] ;
                                        sp:path [
                                            rdf:type sp:ModPath ;
                                            sp:modMax -2 ;
                                            sp:modMin 0 ;
                                            sp:subPath rdfs:subClassOf ;
                                          ] ;
                                        sp:subject [
                                            sp:varName "class"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        sp:object [
                                            sp:varName "res"^^xsd:string ;
                                          ] ;
                                        sp:predicate rdfs:subClassOf ;
                                        sp:subject [
                                            sp:varName "parent"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        sp:object owl:Restriction ;
                                        sp:predicate rdf:type ;
                                        sp:subject [
                                            sp:varName "res"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        sp:object [
                                            sp:varName "property"^^xsd:string ;
                                          ] ;
                                        sp:predicate owl:onProperty ;
                                        sp:subject [
                                            sp:varName "res"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        rdf:type sp:TriplePath ;
                                        sp:object [
                                            sp:varName "c"^^xsd:string ;
                                          ] ;
                                        sp:path [
                                            rdf:type sp:AltPath ;
                                            sp:path1 owl:cardinality ;
                                            sp:path2 owl:maxCardinality ;
                                          ] ;
                                        sp:subject [
                                            sp:varName "res"^^xsd:string ;
                                          ] ;
                                      ]
                                    ) ;
                                ] ;
                              let:min [
                                  rdf:type sp:Select ;
                                  sp:resultVariables (
                                      [
                                        sp:varName "c"^^xsd:string ;
                                      ]
                                    ) ;
                                  sp:where (
                                      [
                                        rdf:type sp:TriplePath ;
                                        sp:object [
                                            sp:varName "parent"^^xsd:string ;
                                          ] ;
                                        sp:path [
                                            rdf:type sp:ModPath ;
                                            sp:modMax -2 ;
                                            sp:modMin 0 ;
                                            sp:subPath rdfs:subClassOf ;
                                          ] ;
                                        sp:subject [
                                            sp:varName "class"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        sp:object [
                                            sp:varName "res"^^xsd:string ;
                                          ] ;
                                        sp:predicate rdfs:subClassOf ;
                                        sp:subject [
                                            sp:varName "parent"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        sp:object owl:Restriction ;
                                        sp:predicate rdf:type ;
                                        sp:subject [
                                            sp:varName "res"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        sp:object [
                                            sp:varName "property"^^xsd:string ;
                                          ] ;
                                        sp:predicate owl:onProperty ;
                                        sp:subject [
                                            sp:varName "res"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        rdf:type sp:TriplePath ;
                                        sp:object [
                                            sp:varName "c"^^xsd:string ;
                                          ] ;
                                        sp:path [
                                            rdf:type sp:AltPath ;
                                            sp:path1 owl:cardinality ;
                                            sp:path2 owl:minCardinality ;
                                          ] ;
                                        sp:subject [
                                            sp:varName "res"^^xsd:string ;
                                          ] ;
                                      ]
                                    ) ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "["^^xsd:string ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 1 ;
                                  ui:text [
                                      rdf:type sp:coalesce ;
                                      sp:arg1 [
                                          sp:varName "min"^^xsd:string ;
                                        ] ;
                                      sp:arg2 0 ;
                                    ] ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 2 ;
                                  ui:text ".."^^xsd:string ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 3 ;
                                  ui:text [
                                      rdf:type sp:coalesce ;
                                      sp:arg1 [
                                          sp:varName "max"^^xsd:string ;
                                        ] ;
                                      sp:arg2 "*" ;
                                    ] ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 4 ;
                                  ui:text "]"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 3 ;
                        ] ;
                      ui:child [
                          rdf:type lmdoc:PropertyDetailsTable ;
                          arg:class [
                              sp:varName "class"^^xsd:string ;
                            ] ;
                          arg:parent [
                              sp:varName "parent"^^xsd:string ;
                            ] ;
                          arg:property [
                              sp:varName "property"^^xsd:string ;
                            ] ;
                          ui:childIndex 4 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:resultSet [
                      sp:varName "propertySet"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Thead ;
              html:class "lm-table-header"^^xsd:string ;
              ui:child [
                  rdf:type html:Tr ;
                  html:class "lm-row"^^xsd:string ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "#"^^xsd:string ;
                        ] ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Defined in Class"^^xsd:string ;
                        ] ;
                      ui:childIndex 5 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Permissible Values"^^xsd:string ;
                        ] ;
                      ui:childIndex 4 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Property QName"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Property"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Th ;
                      html:class "lm-column-labels"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Type"^^xsd:string ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Properties table"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
