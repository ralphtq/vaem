              arg:margin "40px;"^^xsd:string ;
              ui:childIndex 11 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue lmdoc:createLinkForMainForm ;
    ] ;
  rdfs:label "Detailed Class View"^^xsd:string ;
  rdfs:subClassOf lmdoc:SubElements ;
.
