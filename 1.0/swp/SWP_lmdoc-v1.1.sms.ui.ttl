lmdoc:GraphMetadata
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:errorPrototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type ui:group ;
              let:myGraph [
                  rdf:type sp:iri ;
                  sp:arg1 [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type ui:group ;
                      let:maybeGraphMetadata [
                          rdf:type spl:objectInGraph ;
                          sp:arg1 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                          sp:arg2 vaem:hasGraphMetadata ;
                          sp:arg3 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:if ;
                          ui:child [
                              rdf:type lmdoc:BuildMetadataRecord ;
                              arg:graph [
                                  sp:varName "myGraph"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:condition [
                              rdf:type sp:not ;
                              sp:arg1 [
                                  rdf:type sp:bound ;
                                  sp:arg1 [
                                      sp:varName "maybeGraphMetadata"^^xsd:string ;
                                    ] ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:varName "graph"^^xsd:string ;
                  ui:varValue [
                      sp:varName "myGraph"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:P ;
              html:class "lm-para"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "No Graph URI provided"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:not ;
              sp:arg1 [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:headIncludes [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Link ;
          html:href "http://linkedmodel.org/css/spin/spin.css"^^xsd:string ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:Link ;
          html:href "http://linkedmodel.org/vaem/css/lm.css"^^xsd:string ;
          html:rel "stylesheet"^^xsd:string ;
          html:type "text/css"^^xsd:string ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type html:Link ;
          html:href [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/tbladmin/css/tbladmin.css"^^xsd:string ;
            ] ;
          html:rel "stylesheet"^^xsd:string ;
          html:type "text/css"^^xsd:string ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type sp:iri ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type html:P ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "My graph is "^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 1 ;
              ui:text [
                  sp:varName "myGraph"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type ui:setContext ;
          ui:child [
              rdf:type lmdoc:Header ;
              arg:title "Graph Metadata Maintainer"^^xsd:string ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type ui:group ;
                      let:maybeGraphMetadata [
                          rdf:type spl:objectInGraph ;
                          sp:arg1 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                          sp:arg2 vaem:hasGraphMetadata ;
                          sp:arg3 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:group ;
                          let:myGraphMetadata [
                              rdf:type spl:objectInGraph ;
                              sp:arg1 [
                                  sp:varName "myGraph"^^xsd:string ;
                                ] ;
                              sp:arg2 vaem:hasGraphMetadata ;
                              sp:arg3 [
                                  sp:varName "myGraph"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:child [
                              rdf:type swa:Header ;
                              arg:label [
                                  rdf:type ui:concat ;
                                  sp:arg1 "Metadata for Graph "^^xsd:string ;
                                  sp:arg2 [
                                      sp:varName "myGraph"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type swa:SwitchableForm ;
                              arg:editable "true"^^xsd:boolean ;
                              arg:resource [
                                  sp:varName "myGraphMetadata"^^xsd:string ;
                                ] ;
                              arg:showURI "false"^^xsd:boolean ;
                              arg:suppressHeader "true"^^xsd:boolean ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type ui:if ;
                          ui:child [
                              rdf:type html:P ;
                              html:class "lm-para"^^xsd:string ;
                              ui:child [
                                  rdf:type html:Span ;
                                  html:style "font-weight:italic"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text [
                                          sp:varName "myGraph"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Metadata for graph "^^xsd:string ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 2 ;
                                  ui:text " not found - building initial metadata"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type lmdoc:BuildMetadataRecord ;
                              arg:graph [
                                  sp:varName "myGraph"^^xsd:string ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:condition [
                              rdf:type sp:not ;
                              sp:arg1 [
                                  rdf:type sp:bound ;
                                  sp:arg1 [
                                      sp:varName "maybeGraphMetadata"^^xsd:string ;
                                    ] ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:queryGraph [
                      rdf:type ui:unionOfGraphs ;
                      sp:arg1 [
                          rdf:type ui:graphWithImports ;
                          sp:arg1 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
          ui:varName "graph"^^xsd:string ;
          ui:varValue [
              sp:varName "myGraph"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=lmdoc:GraphMetadata&graph=http://www.linkedmodel.org/2.0/schema/vaem
http://localhost:8083/tbl/swp?_viewClass=lmdoc:GraphMetadata&graph=http://www.linkedmodel.org/1.2/schema/dtype
