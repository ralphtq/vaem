          rdf:type sp:coalesce ;
          sp:arg1 [
              rdf:type spl:object ;
              sp:arg1 spin:_this ;
              sp:arg2 dct:description ;
            ] ;
          sp:arg2 [
              rdf:type spl:object ;
              sp:arg1 spin:_this ;
              sp:arg2 dct:description ;
            ] ;
          sp:arg3 [
              rdf:type spl:object ;
              sp:arg1 spin:_this ;
              sp:arg2 vaem:description ;
            ] ;
          sp:arg4 [
              rdf:type spl:object ;
              sp:arg1 spin:_this ;
              sp:arg2 rdfs:comment ;
