                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          sp:varName "sectionHeading"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "lm-table"^^xsd:string ;
                  html:id [
                      sp:varName "tableId"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type html:Tbody ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type html:Div ;
                              let:id [
                                  rdf:type ui:uniqueId ;
                                ] ;
                              ui:child [
                                  rdf:type html:Tr ;
                                  html:class "lm-row"^^xsd:string ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "lm-column"^^xsd:string ;
                                      html:id [
                                          rdf:type fn:concat ;
                                          sp:arg1 "td-resource_" ;
                                          sp:arg2 [
                                              sp:varName "id"^^xsd:string ;
