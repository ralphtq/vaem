                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              sp:varName "thisVersion"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:condition [
                                      rdf:type sp:ne ;
                                      sp:arg1 [
                                          sp:varName "thisVersion"^^xsd:string ;
                                        ] ;
                                      sp:arg2 "none" ;
                                    ] ;
                                ] ;
                              ui:childIndex 3 ;
                            ] ;
                          ui:child [
                              rdf:type html:Dt ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Contributors:"^^xsd:string ;
                                ] ;
                              ui:childIndex 8 ;
                            ] ;
                          ui:child [
                              rdf:type html:Dt ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Editor:"^^xsd:string ;
                                ] ;
                              ui:childIndex 6 ;
                            ] ;
                          ui:child [
                              rdf:type html:Dt ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Last Modified:"^^xsd:string ;
                                ] ;
                              ui:childIndex 10 ;
                            ] ;
                          ui:child [
                              rdf:type html:Dt ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Latest published version:"^^xsd:string ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type html:Dt ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Previous published version:"^^xsd:string ;
                                ] ;
                              ui:childIndex 4 ;
                            ] ;
                          ui:child [
                              rdf:type html:Dt ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "This version:"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:H1 ;
                          html:class "title p-name"^^xsd:string ;
                          html:id "title"^^xsd:string ;
                          html:property "dct:title"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text [
                                  rdf:type spl:object ;
                                  sp:arg1 [
                                      sp:varName "myGraphMetadata"^^xsd:string ;
                                    ] ;
                                  sp:arg2 vaem:title ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:P ;
                          html:class "size-10"^^xsd:string ;
                          ui:child [
