lmdoc:GMD_LMDOC
  rdf:type vaem:GraphMetaData ;
  dct:modified "2015-12-22"^^xsd:date ;
  vaem:hasOwner vaem:TopQuadrant ;
  vaem:name "LMDOC"^^xsd:string ;
  vaem:namespacePrefix "lmdoc"^^xsd:string ;
  vaem:revision "1.1"^^xsd:string ;
.
lmdoc:Graph
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:flags ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:overlay ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:myGraph [
          rdf:type sp:iri ;
          sp:arg1 [
              sp:varName "graph"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:setContext ;
          ui:child [
              rdf:type ui:group ;
              let:myOverlay [
                  rdf:type sp:iri ;
                  sp:arg1 [
                      rdf:type sp:coalesce ;
                      sp:arg1 [
                          sp:varName "overlay"^^xsd:string ;
                        ] ;
                      sp:arg2 ui:tempGraph ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type ui:group ;
                      let:myGraphMetadata [
                          rdf:type spl:objectInGraph ;
                          sp:arg1 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                          sp:arg2 vaem:hasGraphMetadata ;
                          sp:arg3 [
                              sp:varName "myGraph"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:group ;
                          let:namespacePrefix [
                              rdf:type spl:objectInGraph ;
                              sp:arg1 [
                                  sp:varName "myGraphMetadata"^^xsd:string ;
                                ] ;
                              sp:arg2 vaem:name ;
                              sp:arg3 [
                                  sp:varName "myGraph"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:child [
                              rdf:type html:Hr ;
                              ui:childIndex 5 ;
                            ] ;
                          ui:child [
                              rdf:type html:Section ;
                              html:class "informative"^^xsd:string ;
                              html:id "overview-of-ontology"^^xsd:string ;
                              ui:child [
