                                  ui:child [
                                      rdf:type html:Span ;
                                      html:class "p-name fn"^^xsd:string ;
                                      html:property "foaf:name"^^xsd:string ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "Ralph Hodgson"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 1 ;
                                      ui:text ", "^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 7 ;
                            ] ;
                          ui:child [
                              rdf:type html:Dd ;
                              html:class "p-author h-card vcard"^^xsd:string ;
                              ui:child [
                                  rdf:type html:Span ;
                                  html:typeof "foaf:Person"^^xsd:string ;
                                  ui:child [
                                      rdf:type html:Span ;
                                      html:class "p-name fn"^^xsd:string ;
                                      html:property "foaf:name"^^xsd:string ;
                                      ui:child [
                                          rdf:type ui:forEach ;
                                          ui:child [
                                              rdf:type ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text [
                                                  sp:varName "name"^^xsd:string ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 0 ;
                                          ui:resultSet [
                                              rdf:type sp:Select ;
                                              sp:orderBy (
                                                  [
                                                    sp:varName "name"^^xsd:string ;
                                                  ]
                                                ) ;
                                              sp:resultVariables (
                                                  [
                                                    sp:varName "name"^^xsd:string ;
                                                  ]
                                                ) ;
                                              sp:where (
                                                  [
                                                    sp:object [
                                                        sp:varName "name"^^xsd:string ;
                                                      ] ;
                                                    sp:predicate dct:contributor ;
                                                    sp:subject [
                                                        sp:varName "myGraphMetadata"^^xsd:string ;
                                                      ] ;
                                                  ]
                                                ) ;
                                            ] ;
                                          ui:separator ", "^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 9 ;
                            ] ;
                          ui:child [
                              rdf:type html:Dd ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
