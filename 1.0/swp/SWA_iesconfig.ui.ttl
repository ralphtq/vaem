                  arg:project [
                      sp:varName "project"^^xsd:string ;
                    ] ;
                  ui:childIndex 4 ;
                ] ;
              ui:child [
                  rdf:type iess:UpdateConfigTimestamp ;
                  ui:childIndex 6 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
