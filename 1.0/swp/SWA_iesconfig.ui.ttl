                  ui:child [
                      rdf:type html:P ;
                      html:class "IES_body"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "No XML Schmema Pragma graphs were found for being converted to XSD schemas were found in project "^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text [
                              sp:varName "project"^^xsd:string ;
