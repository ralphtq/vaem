                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type iess:DeleteSession ;
                  arg:project [
                      sp:varName "project"^^xsd:string ;
                    ] ;
                  ui:childIndex 3 ;
