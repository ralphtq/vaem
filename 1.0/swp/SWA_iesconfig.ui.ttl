iess:UpdateConfigTimestamp
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:project ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:graph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type ui:transaction ;
          ui:child [
              rdf:type ui:update ;
              ui:childIndex 0 ;
              ui:updateQuery [
                  rdf:type sp:Modify ;
                  sp:deletePattern (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              sp:object [
                                  sp:varName "time"^^xsd:string ;
                                ] ;
                              sp:predicate vaem:lastUpdated ;
                              sp:subject [
                                  sp:varName "config"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:insertPattern (
                      [
                        sp:object [
                            sp:varName "now"^^xsd:string ;
                          ] ;
                        sp:predicate vaem:lastUpdated ;
                        sp:subject [
                            sp:varName "config"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:where (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              rdf:type sp:Bind ;
                              sp:expression [
                                  rdf:type iess:getUserSession ;
                                ] ;
                              sp:variable [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                            [
                              rdf:type sp:Bind ;
                              sp:expression [
                                  rdf:type iess:makeUserSessionResource ;
                                  arg:prefix "CONFIG" ;
                                  arg:resource "" ;
                                ] ;
                              sp:variable [
                                  sp:varName "config"^^xsd:string ;
                                ] ;
                            ]
                            [
                              rdf:type sp:Bind ;
                              sp:expression [
                                  rdf:type afn:now ;
                                ] ;
                              sp:variable [
                                  sp:varName "now"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "time"^^xsd:string ;
                                ] ;
                              sp:predicate vaem:lastUpdated ;
                              sp:subject [
                                  sp:varName "config"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Update Config Timestamp"^^xsd:string ;
  rdfs:subClassOf iess:UpdateHandlers ;
.
iess:UpdateHandlers
  rdf:type ui:NodeClass ;
  rdfs:label "Update handlers"^^xsd:string ;
  rdfs:subClassOf iess:Handlers ;
