          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:Button ;
          html:onclick [
              rdf:type ui:concat ;
              sp:arg1 "swa.openResourceSelectionDialog('"^^xsd:string ;
              sp:arg2 vaem:GraphRole ;
              sp:arg3 "', null, 'Test Resource Selection with vaem:GraphRole')"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "Test Resource Selector"^^xsd:string ;
