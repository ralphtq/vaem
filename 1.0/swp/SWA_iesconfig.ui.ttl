      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdf:Property ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:comment "Returns a configuration property from the user's configuration settings"^^xsd:string ;
  rdfs:label "get user configuration property"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getUserSession
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "session"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:makeUserSessionResource ;
                arg:prefix "SN" ;
                arg:resource "" ;
              ] ;
            sp:variable [
                sp:varName "session"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:label "get user session"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getWorkspaceFilePath
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            rdf:type xsd:string ;
            sp:arg1 [
                sp:varName "path"^^xsd:string ;
              ] ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:trimPath ;
                sp:arg1 spin:_arg1 ;
              ] ;
            sp:variable [
                sp:varName "trimmedProjectName"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:trimPath ;
                sp:arg1 spin:_arg2 ;
              ] ;
            sp:variable [
                sp:varName "trimmedRelativePath"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:trimPath ;
                sp:arg1 spin:_arg3 ;
              ] ;
            sp:variable [
                sp:varName "trimmedFilePath"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:if ;
                sp:arg1 [
                    rdf:type sp:eq ;
                    sp:arg1 [
                        sp:varName "trimmedRelativePath"^^xsd:string ;
                      ] ;
                    sp:arg2 "" ;
                  ] ;
                sp:arg2 [
                    rdf:type fn:concat ;
                    sp:arg1 "/" ;
                    sp:arg2 [
                        sp:varName "trimmedProjectName"^^xsd:string ;
                      ] ;
                    sp:arg3 "/" ;
                    sp:arg4 [
                        sp:varName "trimmedFilePath"^^xsd:string ;
                      ] ;
                  ] ;
                sp:arg3 [
                    rdf:type fn:concat ;
                    sp:arg1 "/" ;
                    sp:arg2 [
                        sp:varName "trimmedProjectName"^^xsd:string ;
                      ] ;
                    sp:arg3 "/" ;
                    sp:arg4 [
                        sp:varName "trimmedRelativePath"^^xsd:string ;
                      ] ;
                    sp:arg5 "/" ;
                    sp:arg6 [
                        sp:varName "trimmedFilePath"^^xsd:string ;
                      ] ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "path"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "Project name"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType xsd:string ;
      rdfs:comment "Relative path within project"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg3 ;
      spl:valueType xsd:string ;
      rdfs:comment "File name"^^xsd:string ;
    ] ;
  rdfs:label "get workspace file path"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getXSD-FileDetails
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            sp:varName "xsdFile"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "xsdFile"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:getSessionGraph ;
              ] ;
            sp:variable [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  rdf:type sp:Bind ;
                  sp:expression [
                      rdf:type iess:getUserSession ;
                    ] ;
                  sp:variable [
                      sp:varName "session"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "ontProject"^^xsd:string ;
                    ] ;
                  sp:predicate iess:requires ;
                  sp:subject [
                      sp:varName "session"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "config"^^xsd:string ;
                    ] ;
                  sp:predicate iess:hasConfiguration ;
                  sp:subject [
                      sp:varName "ontProject"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "projectName"^^xsd:string ;
                    ] ;
                  sp:predicate vaem:name ;
                  sp:subject [
                      sp:varName "ontProject"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "xsdFilesPath"^^xsd:string ;
                    ] ;
                  sp:predicate iess:xsdFilesPath ;
                  sp:subject [
                      sp:varName "config"^^xsd:string ;
                    ] ;
                ]
                [
                  rdf:type sp:Bind ;
                  sp:expression [
                      rdf:type xsd:string ;
                      sp:arg1 [
                          rdf:type fn:concat ;
                          sp:arg1 "/" ;
                          sp:arg2 [
                              sp:varName "projectName"^^xsd:string ;
                            ] ;
                          sp:arg3 [
                              sp:varName "xsdFilesPath"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  sp:variable [
                      sp:varName "wsRelativePath"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "?0"^^xsd:string ;
                    ] ;
                  sp:predicate tops:files ;
                  sp:subject [
                      sp:varName "path"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "wsRelativePath"^^xsd:string ;
                    ] ;
                  sp:predicate rdf:first ;
                  sp:subject [
                      sp:varName "?0"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "?1"^^xsd:string ;
                    ] ;
                  sp:predicate rdf:rest ;
                  sp:subject [
                      sp:varName "?0"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object "true"^^xsd:boolean ;
                  sp:predicate rdf:first ;
                  sp:subject [
                      sp:varName "?1"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "?2"^^xsd:string ;
                    ] ;
                  sp:predicate rdf:rest ;
                  sp:subject [
                      sp:varName "?1"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object "true"^^xsd:boolean ;
                  sp:predicate rdf:first ;
                  sp:subject [
                      sp:varName "?2"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object () ;
                  sp:predicate rdf:rest ;
                  sp:subject [
                      sp:varName "?2"^^xsd:string ;
                    ] ;
                ]
                [
                  rdf:type sp:Filter ;
                  sp:expression [
                      rdf:type fn:ends-with ;
                      sp:arg1 [
                          sp:varName "path"^^xsd:string ;
                        ] ;
                      sp:arg2 ".xsd" ;
                    ] ;
                ]
                [
                  rdf:type sp:Bind ;
                  sp:expression [
                      rdf:type spif:regex ;
                      sp:arg1 [
                          sp:varName "path"^^xsd:string ;
                        ] ;
                      sp:arg2 "/(.*)/\\.xsd" ;
                      sp:arg3 "$1" ;
                    ] ;
                  sp:variable [
                      sp:varName "xsdFile"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:label "get XSD File Details"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:hasValueForProperty
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Ask ;
      sp:where (
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  rdf:type sp:Exists ;
                  sp:elements (
                      [
                        sp:object [
                            sp:varName "value"^^xsd:string ;
                          ] ;
                        sp:predicate [
                            sp:varName "property"^^xsd:string ;
                          ] ;
                        sp:subject [
                            sp:varName "resource"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdf:Property ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "has value for property"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:helpBlind
  rdf:type iess:HelpTab ;
  rdfs:comment """Test using:

http://localhost:8083/tbl/swp?_view=iess:helpBlind"""^^xsd:string ;
  rdfs:label "help blind"^^xsd:string ;
.
iess:inheritanceDepth
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "d"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "x"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject spin:_arg1 ;
                  ]
                  [
                    rdf:type sp:Filter ;
                    sp:expression [
                        rdf:type sp:ne ;
                        sp:arg1 [
                            sp:varName "x"^^xsd:string ;
                          ] ;
                        sp:arg2 spin:_arg2 ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "x"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object spin:_arg2 ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "inc"^^xsd:string ;
                      ] ;
                    sp:predicate iess:inheritanceDepth ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        rdf:type sp:add ;
                        sp:arg1 [
                            sp:varName "inc"^^xsd:string ;
                          ] ;
                        sp:arg2 1 ;
                      ] ;
                    sp:variable [
                        sp:varName "d"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object spin:_arg2 ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject spin:_arg1 ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression 1 ;
                    sp:variable [
                        sp:varName "d"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    rdf:type sp:Filter ;
                    sp:expression [
                        rdf:type sp:eq ;
                        sp:arg1 spin:_arg1 ;
                        sp:arg2 spin:_arg2 ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression 0 ;
                    sp:variable [
                        sp:varName "d"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "Current subclass"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "Current superclass"^^xsd:string ;
    ] ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:isFileSubPath
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Ask ;
      sp:where (
          [
            sp:object [
                sp:varName "?0"^^xsd:string ;
              ] ;
            sp:predicate tops:files ;
            sp:subject [
                sp:varName "path"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "project"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object "true"^^xsd:boolean ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?2"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object "false"^^xsd:boolean ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:substring ;
                sp:arg1 [
                    sp:varName "path"^^xsd:string ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:add ;
                    sp:arg1 [
                        rdf:type fn:string-length ;
                        sp:arg1 [
                            sp:varName "project"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:arg2 3 ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "path2"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type fn:starts-with ;
                sp:arg1 [
                    sp:varName "path2"^^xsd:string ;
                  ] ;
                sp:arg2 [
                    sp:varName "subPath"^^xsd:string ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:project ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:subPath ;
      spl:valueType xsd:string ;
    ] ;
  rdfs:label "is file sub path"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:isXSPforOntology
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Ask ;
      sp:where (
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  sp:object spin:_arg2 ;
                  sp:predicate <http://xspl.us/schema/xsp#annotatesGraph> ;
                  sp:subject spin:_arg1 ;
                ]
              ) ;
            sp:graphNameNode spin:_arg1 ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "is XSPfor ontology"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:makeUserSessionResource
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "uri"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:if ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "resource"^^xsd:string ;
                      ] ;
                    sp:arg2 "" ;
                  ] ;
                sp:arg2 [
                    rdf:type fn:concat ;
                    sp:arg1 "-" ;
                    sp:arg2 [
                        sp:varName "resource"^^xsd:string ;
                      ] ;
                  ] ;
                sp:arg3 "" ;
              ] ;
            sp:variable [
                sp:varName "suffix"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:iri ;
                sp:arg1 [
                    rdf:type fn:concat ;
                    sp:arg1 [
                        rdf:type xsd:string ;
                        sp:arg1 [
                            rdf:type iess:getSessionGraph ;
                          ] ;
                      ] ;
                    sp:arg2 "#" ;
                    sp:arg3 [
                        sp:varName "prefix"^^xsd:string ;
                      ] ;
                    sp:arg4 "_" ;
                    sp:arg5 [
                        rdf:type iess:currentUser ;
                      ] ;
                    sp:arg6 [
                        sp:varName "suffix"^^xsd:string ;
                      ] ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:prefix ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType xsd:string ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:label "make user session resource"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:maybeConvertToURI
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "uri"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:if ;
                sp:arg1 [
                    rdf:type sp:isIRI ;
                    sp:arg1 spin:_arg1 ;
                  ] ;
                sp:arg2 spin:_arg1 ;
                sp:arg3 [
                    rdf:type sp:iri ;
                    sp:arg1 [
                        rdf:type smf:buildURI ;
                        sp:arg1 spin:_arg1 ;
                      ] ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:comment "Checks if an argument is a URI. If not converts it to a URI."^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:maybeDescription
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "desc"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Optional ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "desc1"^^xsd:string ;
                    ] ;
                  sp:predicate <http://purl.org/dc/elements/1.1/description> ;
                  sp:subject [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ]
              ) ;
          ]
          [
            rdf:type sp:Optional ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "desc2"^^xsd:string ;
                    ] ;
                  sp:predicate vaem:description ;
                  sp:subject [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ]
              ) ;
          ]
          [
            rdf:type sp:Optional ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "desc3"^^xsd:string ;
                    ] ;
                  sp:predicate <http://www.w3.org/2004/02/skos/core#definition> ;
                  sp:subject [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                ]
              ) ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:if ;
                sp:arg1 [
                    rdf:type sp:bound ;
                    sp:arg1 [
                        sp:varName "desc1"^^xsd:string ;
                      ] ;
                  ] ;
                sp:arg2 [
                    sp:varName "desc1"^^xsd:string ;
                  ] ;
                sp:arg3 [
                    rdf:type sp:if ;
                    sp:arg1 [
                        rdf:type sp:bound ;
                        sp:arg1 [
                            sp:varName "desc2"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        sp:varName "desc2"^^xsd:string ;
                      ] ;
                    sp:arg3 [
                        rdf:type sp:if ;
                        sp:arg1 [
                            rdf:type sp:bound ;
                            sp:arg1 [
                                sp:varName "desc3"^^xsd:string ;
                              ] ;
                          ] ;
                        sp:arg2 [
                            sp:varName "desc3"^^xsd:string ;
                          ] ;
                        sp:arg3 "" ;
                      ] ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "desc"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "maybe description"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:mySuperClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "super"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object owl:Class ;
            sp:predicate rdf:type ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "super"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            sp:object [
                sp:varName "superType"^^xsd:string ;
              ] ;
            sp:predicate rdf:type ;
            sp:subject [
                sp:varName "super"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:ne ;
                sp:arg1 [
                    sp:varName "superType"^^xsd:string ;
                  ] ;
                sp:arg2 owl:Restriction ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:and ;
                    sp:arg1 [
                        rdf:type sp:ne ;
                        sp:arg1 [
                            sp:varName "super"^^xsd:string ;
                          ] ;
                        sp:arg2 rdfs:Resource ;
                      ] ;
                    sp:arg2 [
                        rdf:type sp:ne ;
                        sp:arg1 [
                            sp:varName "super"^^xsd:string ;
                          ] ;
                        sp:arg2 owl:Thing ;
                      ] ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "super"^^xsd:string ;
                      ] ;
                    sp:arg2 spin:_arg1 ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
    ] ;
  rdfs:label "my super class"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:parentsOfPropertiesAtClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "parent"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg2 ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "superClass"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:domain ;
                    sp:subject [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:variable [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:NotExists ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "value"^^xsd:string ;
                            ] ;
                          sp:predicate owl:hasValue ;
                          sp:subject [
                              sp:varName "superClass"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "value"^^xsd:string ;
                      ] ;
                    sp:predicate owl:hasValue ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:isIRI ;
                sp:arg1 [
                    sp:varName "parent"^^xsd:string ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "a property on the left"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdf:Property ;
      rdfs:comment "property"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  spin:returnType rdfs:Class ;
  rdfs:label "parents of properties at class"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:rangeOfPropertyAtClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "range"^^xsd:string ;
          ]
          [
            sp:varName "valueRestriction"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "superClass"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "aProperty"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg2 ;
          ]
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "range"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:range ;
                    sp:subject [
                        sp:varName "aProperty"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression "false"^^xsd:boolean ;
                    sp:variable [
                        sp:varName "valueRestriction"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "aProperty"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "range"^^xsd:string ;
                      ] ;
                    sp:predicate owl:allValuesFrom ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression "false"^^xsd:boolean ;
                    sp:variable [
                        sp:varName "valueRestriction"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "aProperty"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "range"^^xsd:string ;
                      ] ;
                    sp:predicate owl:hasValue ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression "true"^^xsd:boolean ;
                    sp:variable [
                        sp:varName "valueRestriction"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "false"^^xsd:boolean ;
      spl:predicate sp:arg2 ;
      spl:valueType rdf:Property ;
      rdfs:comment "property"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of"^^xsd:string ;
    ] ;
  spin:labelTemplate "Range(s) for {?arg2} at class {?arg1}"^^xsd:string ;
  rdfs:comment "Gets a list of ranges for a given class and property based on all superclasses."^^xsd:string ;
  rdfs:label "Range of property at class"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:relevantPropertiesAtClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "parent"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object spin:_arg1 ;
            sp:predicate spl:relevantPropertyAtClass ;
            sp:subject [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "superClass"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "aProperty"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject [
                sp:varName "property"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:domain ;
                    sp:subject [
                        sp:varName "aProperty"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "aProperty"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  rdfs:comment "Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels."^^xsd:string ;
  rdfs:label "Relevant properties at class"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:relevantPropertiesAtClassWithParent
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "class"^^xsd:string ;
          ]
          [
            sp:varName "parent"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "superClass"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject [
                sp:varName "class"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:domain ;
                    sp:subject [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:variable [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                    sp:predicate owl:onProperty ;
                    sp:subject [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:NotExists ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "value"^^xsd:string ;
                            ] ;
                          sp:predicate owl:hasValue ;
                          sp:subject [
                              sp:varName "superClass"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                  ]
                  [
                    sp:object [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject [
                        sp:varName "parent"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:isIRI ;
                sp:arg1 [
                    sp:varName "class"^^xsd:string ;
                  ] ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "a property on the left"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  spin:returnType rdfs:Class ;
  rdfs:comment """Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels. 

A magic property that establishes a relationship between properties (left) and classes (right) to determine which properties are \"relevant\" for the class. Relevant means that they have the class in their domain and/or restrictions, including superclasses and sub-properties.

Note that the performance of the body of this magic property has been optimized for the case in which the class is given, so ideally use this for queries such as  ?property iess:relevantPropertyAtClass skos:Concept ."""^^xsd:string ;
  rdfs:label "Relevant properties at class with parent"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:relevantPropertyDetailsAtClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "parent"^^xsd:string ;
          ]
          [
            sp:varName "range"^^xsd:string ;
          ]
          [
            sp:varName "valueRestriction"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "?0"^^xsd:string ;
              ] ;
            sp:predicate iess:relevantPropertiesAtClass ;
            sp:subject spin:_arg1 ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "parent"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object spin:_arg1 ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?3"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?4"^^xsd:string ;
              ] ;
            sp:predicate iess:rangeOfPropertyAtClass ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "range"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?4"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?5"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?4"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "valueRestriction"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?5"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?5"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  rdfs:comment "Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels."^^xsd:string ;
  rdfs:label "Relevant property details at class"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:relevantPropertyDetailsAtClassWithCardinalities
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:orderBy (
          [
            rdf:type fn:lower-case ;
            sp:arg1 [
                rdf:type ui:label ;
                sp:arg1 [
                    sp:varName "property"^^xsd:string ;
                  ] ;
              ] ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "property"^^xsd:string ;
          ]
          [
            sp:varName "parent"^^xsd:string ;
          ]
          [
            sp:varName "range"^^xsd:string ;
          ]
          [
            sp:varName "valueRestriction"^^xsd:string ;
          ]
          [
            sp:varName "min"^^xsd:string ;
          ]
          [
            sp:varName "max"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "?0"^^xsd:string ;
              ] ;
            sp:predicate iess:relevantPropertyDetailsAtClass ;
            sp:subject spin:_arg1 ;
          ]
          [
            sp:object [
                sp:varName "property"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "parent"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?2"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "range"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?3"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "valueRestriction"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?3"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:minCardinality ;
                sp:arg1 spin:_arg1 ;
                sp:arg2 [
                    sp:varName "property"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "min"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:maxCardinality ;
                sp:arg1 spin:_arg1 ;
                sp:arg2 [
                    sp:varName "property"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "max"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of"^^xsd:string ;
    ] ;
  spin:labelTemplate "Relevant properties at {?class}"^^xsd:string ;
  rdfs:comment "Gets a list of relevant properties for a given class (arg:class), ordered by ui:labels."^^xsd:string ;
  rdfs:label "Relevant property details at class with cardinalities"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:trimPath
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "trimmed"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type spif:trim ;
                sp:arg1 spin:_arg1 ;
              ] ;
            sp:variable [
                sp:varName "trim0"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:if ;
                sp:arg1 [
                    rdf:type fn:starts-with ;
                    sp:arg1 [
                        sp:varName "trim0"^^xsd:string ;
                      ] ;
                    sp:arg2 "/" ;
                  ] ;
                sp:arg2 [
                    rdf:type spif:regex ;
                    sp:arg1 [
                        sp:varName "trim0"^^xsd:string ;
                      ] ;
                    sp:arg2 "/(.*)" ;
                    sp:arg3 "$1" ;
                  ] ;
                sp:arg3 [
                    sp:varName "trim0"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "trim1"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:if ;
                sp:arg1 [
                    rdf:type fn:ends-with ;
                    sp:arg1 [
                        sp:varName "trim1"^^xsd:string ;
                      ] ;
                    sp:arg2 "/" ;
                  ] ;
                sp:arg2 [
                    rdf:type spif:regex ;
                    sp:arg1 [
                        sp:varName "trim1"^^xsd:string ;
                      ] ;
                    sp:arg2 "(.*)/" ;
                    sp:arg3 "$1" ;
                  ] ;
                sp:arg3 [
                    sp:varName "trim1"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "trimmed"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "Raw path"^^xsd:string ;
    ] ;
  rdfs:label "trim path"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:uniqueId
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "id"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 [
                    sp:varName "prefix"^^xsd:string ;
                  ] ;
                sp:arg2 [
                    rdf:type ui:uniqueId ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "id"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:prefix ;
      spl:valueType xsd:string ;
    ] ;
  rdfs:label "unique Id"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:valueRestrictionsForPropertyAtClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:distinct "true"^^xsd:boolean ;
      sp:resultVariables (
          [
            sp:varName "range"^^xsd:string ;
          ]
          [
            sp:varName "superClass"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "superClass"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subClassOf ;
              ] ;
            sp:subject spin:_arg1 ;
          ]
          [
            rdf:type sp:NotExists ;
            sp:elements (
                [
                  sp:object owl:Restriction ;
                  sp:predicate rdf:type ;
                  sp:subject [
                      sp:varName "superClass"^^xsd:string ;
                    ] ;
                ]
              ) ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 owl:Thing ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:ne ;
                    sp:arg1 [
                        sp:varName "superClass"^^xsd:string ;
                      ] ;
                    sp:arg2 rdfs:Resource ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:TriplePath ;
            sp:object [
                sp:varName "aProperty"^^xsd:string ;
              ] ;
            sp:path [
                rdf:type sp:ModPath ;
                sp:modMax -2 ;
                sp:modMin 0 ;
                sp:subPath rdfs:subPropertyOf ;
              ] ;
            sp:subject spin:_arg2 ;
          ]
          [
            sp:object [
                sp:varName "res"^^xsd:string ;
              ] ;
            sp:predicate rdfs:subClassOf ;
            sp:subject [
                sp:varName "superClass"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "aProperty"^^xsd:string ;
              ] ;
            sp:predicate owl:onProperty ;
            sp:subject [
                sp:varName "res"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "range"^^xsd:string ;
              ] ;
            sp:predicate owl:hasValue ;
            sp:subject [
                sp:varName "res"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "false"^^xsd:boolean ;
      spl:predicate sp:arg2 ;
      spl:valueType rdf:Property ;
      rdfs:comment "property"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Class ;
      rdfs:comment "The class to get the properties of"^^xsd:string ;
    ] ;
  spin:labelTemplate "Value restriction(s) for property {?arg2} at class {?arg1}"^^xsd:string ;
  rdfs:comment "Gets restricted values for a given class and property based on all superclasses."^^xsd:string ;
  rdfs:label "Value restrictions for property at class."^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iesconfig:ConfigEditor
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type html:Div ;
      ui:child [
          rdf:type html:Div ;
          html:style "border: 1px solid black"^^xsd:string ;
          ui:child [
              rdf:type ui:setContext ;
              ui:child [
                  rdf:type swa:SwitchableForm ;
                  arg:editable "true"^^xsd:boolean ;
                  arg:resource <http://ies.topbraidlive.org/env/config#XSD-GeneratorConfiguration> ;
                  arg:showURI "false"^^xsd:boolean ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:queryGraph [
                  rdf:type ui:graphWithImports ;
                  sp:arg1 <http://ies.topbraidlive.org/dynamic/config> ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:Img ;
          html:alt "TopBraid Suite IES Console"^^xsd:string ;
          html:height "50"^^xsd:string ;
          html:src "images/TB_suite_console.png"^^xsd:string ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "Simple application to edit the TBL system configuration."^^xsd:string ;
  rdfs:label "IES Configuration Editor"^^xsd:string ;
  rdfs:subClassOf iess:Editors ;
.
iesconfig:ConfigForm
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:config ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The config instance."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      default:labelWidth "350px"^^xsd:string ;
      default:subject [
          sp:varName "config"^^xsd:string ;
        ] ;
      default:tabular "true"^^xsd:boolean ;
      ui:child [
          rdf:type swa:ObjectsEnum ;
          arg:label "IES File Paths"^^xsd:string ;
          ui:child [
              rdf:type swa:Object ;
              arg:predicate iess:serverURL ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type swa:Object ;
              arg:predicate iess:xsdFilesPath ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type swa:Object ;
              arg:predicate iess:xsdLibraryPath ;
              ui:childIndex 2 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type swa:ObjectsEnum ;
          arg:label "IES XSD Generation Parameters"^^xsd:string ;
          ui:child [
              rdf:type swa:Object ;
              arg:predicate iess:useChoiceForComplexTypeElements ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Config form"^^xsd:string ;
  rdfs:subClassOf iess:Forms ;
.
arg:config
  rdf:type rdf:Property ;
  rdfs:subPropertyOf sp:arg ;
.
arg:graph
  rdf:type owl:ObjectProperty ;
  rdfs:label "graph"^^xsd:string ;
.
arg:ontology
  rdf:type rdf:Property ;
  rdfs:range rdfs:Resource ;
.
arg:ontologyGraph
  rdf:type owl:ObjectProperty ;
  rdfs:label "ontology graph"^^xsd:string ;
.
arg:ontologyList
  rdf:type owl:DatatypeProperty ;
  rdfs:label "ontology list"^^xsd:string ;
  rdfs:range xsd:string ;
.
arg:prefix
  rdf:type owl:DatatypeProperty ;
  rdfs:label "prefix"^^xsd:string ;
  rdfs:range xsd:string ;
.
arg:project
  rdf:type owl:DatatypeProperty ;
  rdfs:label "project"^^xsd:string ;
  rdfs:range xsd:string ;
.
arg:propertySet
  rdf:type rdf:Property ;
  rdfs:label "property set"^^xsd:string ;
  rdfs:range rdf:Property ;
.
arg:resourceSet
  rdf:type rdf:Property ;
  rdfs:label "resource set"^^xsd:string ;
  rdfs:range rdfs:Resource ;
.
arg:sourceOntology
  rdf:type owl:DatatypeProperty ;
  rdfs:label "source ontology uri "^^xsd:string ;
  rdfs:range xsd:string ;
.
arg:subPath
  rdf:type owl:DatatypeProperty ;
  rdfs:label "sub path"^^xsd:string ;
  rdfs:range xsd:string ;
.
arg:table
  rdf:type owl:ObjectProperty ;
  rdfs:label "table"^^xsd:string ;
.
rdfs:Class
  ui:instanceView [
      rdf:type iess:DetailedClassView ;
      arg:class spin:_this ;
      ui:id "form"^^xsd:string ;
      ui:priority 15 ;
    ] ;
.
rdfs:Resource
  ui:instanceView [
      rdf:type iess:DetailedInstanceView ;
      arg:resource spin:_this ;
      ui:id "form"^^xsd:string ;
      ui:priority 15 ;
    ] ;
  ui:instanceView [
      rdf:type swa:ResourceFormBody ;
      arg:resource spin:_this ;
      ui:id "form"^^xsd:string ;
      ui:priority -5 ;
    ] ;
.
owl:Ontology
  ui:instanceView [
      rdf:type ui:group ;
      ui:child [
          rdf:type iess:OntologyMetadata ;
          arg:ontology spin:_this ;
          ui:childIndex 0 ;
        ] ;
      ui:priority 15 ;
    ] ;
.
