              rdf:type sp:Select ;
              sp:orderBy (
                  [
                    sp:varName "file"^^xsd:string ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "graph"^^xsd:string ;
                  ]
                  [
                    sp:varName "file"^^xsd:string ;
                  ]
                  [
                    sp:varName "gLabel"^^xsd:string ;
                  ]
                  [
                    sp:varName "gRole"^^xsd:string ;
                  ]
                  [
