<http://ies.topbraidlive.org/dynamic/sessions#CONFIG_Administrator>
  iess:serverURL "localhost:8083"^^xsd:string ;
  iess:xsdFilesPath "/ies/xsds/"^^xsd:string ;
  iess:xsdLibraryPath "/ies/lib/"^^xsd:string ;
  vaem:lastUpdated "2013-07-11T23:21:51.082-04:00"^^xsd:dateTime ;
.
iess:AdminTab
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:user [
          rdf:type iess:currentUser ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "ies-subtitle"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "Administrator Actions"^^xsd:string ;
            ] ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "ies-subtitle"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "User: "^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 1 ;
              ui:text [
                  sp:varName "user"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 2 ;
              ui:text " Session Actions"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "ies_control_panel"^^xsd:string ;
          ui:child [
              rdf:type html:Br ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:style "padding:10px;"^^xsd:string ;
              ui:child [
                  rdf:type html:Button ;
                  html:onclick "alert('To be implemented in future release');"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Execute Administrator Actions"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              rdf:type html:Input ;
              html:name "ies-user-admin-delete-xsds-cb"^^xsd:string ;
              html:type "checkbox"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Delete XSD Files"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:Input ;
              html:name "ies-user-admin-delete-zips-cb"^^xsd:string ;
              html:type "checkbox"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Delete ZIP Files"^^xsd:string ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:childIndex 3 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "ies_control_panel"^^xsd:string ;
          ui:child [
              rdf:type html:Div ;
              html:style "padding:10px;"^^xsd:string ;
              ui:child [
                  rdf:type html:Button ;
                  html:onclick "ies.userSessionActions();"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Execute User: "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 1 ;
                      ui:text [
                          sp:varName "user"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text " Actions"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Input ;
              html:name "ies-user-admin-delete-jobs-cb"^^xsd:string ;
              html:type "checkbox"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Delete User: "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text [
                      sp:varName "user"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text " Jobs"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:P ;
          html:class "ies_body"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "The Information Exchange Server (IES) administration pages can be accessed by clicking on the button below."^^xsd:string ;
            ] ;
          ui:childIndex 4 ;
        ] ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:Div ;
              html:style "padding:20px;"^^xsd:string ;
              ui:child [
                  rdf:type html:Form ;
                  ui:child [
                      rdf:type html:Input ;
                      html:onclick "location.href=\"http://localhost:8083/tbl/admin/\""^^xsd:string ;
                      html:type "button"^^xsd:string ;
                      html:value "IES Administration"^^xsd:string ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 6 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:style "padding:20px;"^^xsd:string ;
              ui:child [
                  rdf:type html:Button ;
                  html:onclick "ies.openAdministrationPage()"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "IES Administration"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 5 ;
          ui:condition [
              rdf:type smf:isTBL ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Admin Tab"^^xsd:string ;
  rdfs:subClassOf iess:Tabs ;
.
iess:AnyURILiteralViewer
  rdf:type swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:and ;
          sp:arg1 [
              rdf:type sp:isLiteral ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
            ] ;
          sp:arg2 [
              rdf:type sp:eq ;
              sp:arg1 [
                  rdf:type sp:datatype ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 xsd:anyURL ;
            ] ;
        ] ;
      swa:weight 10 ;
    ] ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type html:Div ;
      html:class "swa-shifted-label"^^xsd:string ;
      ui:child [
          rdf:type swa:Link ;
          arg:resource [
              rdf:type sp:iri ;
              sp:arg1 [
                  rdf:type sp:str ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "ies any URILiteral viewer"^^xsd:string ;
  rdfs:subClassOf swa:AnyURILiteralViewer ;
.
iess:Blinds
  rdf:type ui:NodeClass ;
  ui:responseType ui:HTML ;
  rdfs:label "Blinds"^^xsd:string ;
  rdfs:subClassOf iess:Elements ;
.
iess:BrowserHeader
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:ontology [
          rdf:type swa:defaultOntology ;
        ] ;
      ui:child [
          rdf:type iess:Mast ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "ies-header"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  rdf:type ui:label ;
                  sp:arg1 [
                      sp:varName "ontology"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  vaem:todo """Search widget needs more work:

        <table>
            <tr>
                <td style=\"padding-right: 32px;\">
                    <a href=\"ieshome\">
                        <div class=\"ies-logo\"/>
                    </a>
                    <div class=\"ies-navigation-bar\" let:ontology=\"{= swa:defaultOntology() }\">
                        <span>{= ui:label(?ontology) }</span>
                    </div>
                </td>
                <td style=\"width: 100%; padding: 0px; vertical-align: top\">
                    <swa:Index arg:cache=\"true\" arg:labelProperty=\"skos:prefLabel\" arg:onSelect=\"evn.setSelectedResource(resource)\" arg:resourceType=\"skos:Concept\"/>
                    <div style=\"position: relative; z-index: 10; top: 2px; text-align: right;\">
                        <swa:AutoComplete arg:onSelect=\"evn.setSelectedResource(resource)\" arg:type=\"skos:Concept\"/>
                    </div>
                </td>
            </tr>
        </table>"""^^xsd:string ;
  rdfs:comment "The header area of the IES application(s). Displays logo, name of vocabulary, a global auto-complete field and an index."^^xsd:string ;
  rdfs:label "Browser header"^^xsd:string ;
  rdfs:subClassOf iess:Headers ;
.
iess:BuildDownloadXSD-LibDiv
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Form ;
          html:action [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type iess:getServerURL ;
                ] ;
              sp:arg2 "/tbl/"^^xsd:string ;
              sp:arg3 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg4 "/ies/zips/lib_"^^xsd:string ;
              sp:arg5 [
                  rdf:type iess:getOntologyProjectName ;
                  arg:graph [
                      rdf:type iess:getSessionGraph ;
                    ] ;
                ] ;
              sp:arg6 ".ZIP"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type html:Input ;
              html:type "submit"^^xsd:string ;
              html:value "Download XSD Lib ZIP file"^^xsd:string ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Build Download XSD Lib Div"^^xsd:string ;
  rdfs:subClassOf iess:Builders ;
.
iess:BuildDownloadXSD-SchemasDiv
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Form ;
          html:action [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type iess:getServerURL ;
                ] ;
              sp:arg2 "/tbl/"^^xsd:string ;
              sp:arg3 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg4 "/ies/zips/"^^xsd:string ;
              sp:arg5 [
                  rdf:type iess:getOntologyProjectName ;
                  arg:graph [
                      rdf:type iess:getSessionGraph ;
                    ] ;
                ] ;
              sp:arg6 ".ZIP"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type html:Input ;
              html:type "submit"^^xsd:string ;
              html:value "Download XSD Schemas ZIP file"^^xsd:string ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Build Download XSDs Div"^^xsd:string ;
  rdfs:subClassOf iess:Builders ;
.
iess:BuildGeneratedXSDsTab
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:graph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:userSession [
              rdf:type iess:getUserSession ;
            ] ;
          ui:child [
              rdf:type ui:group ;
              letrs:jobs [
                  rdf:type sp:Select ;
                  sp:orderBy (
                      [
                        sp:varName "fileName"^^xsd:string ;
                      ]
                    ) ;
                  sp:resultVariables (
                      [
                        sp:varName "job"^^xsd:string ;
                      ]
                      [
                        sp:varName "fileName"^^xsd:string ;
                      ]
                      [
                        sp:varName "relativeLocation"^^xsd:string ;
                      ]
                      [
                        sp:varName "targetNamespace"^^xsd:string ;
                      ]
                      [
                        sp:varName "statusLabel"^^xsd:string ;
                      ]
                      [
                        sp:varName "lastUpdated"^^xsd:string ;
                      ]
                    ) ;
                  sp:where (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              sp:object [
                                  sp:varName "job"^^xsd:string ;
                                ] ;
                              sp:predicate iess:hasJob ;
                              sp:subject [
                                  sp:varName "userSession"^^xsd:string ;
                                ] ;
                            ]
                            [
                              rdf:type sp:Optional ;
                              sp:elements (
                                  [
                                    sp:object [
                                        sp:varName "fileName"^^xsd:string ;
                                      ] ;
                                    sp:predicate <http://xspl.us/schema/xsp#xsdFileName> ;
                                    sp:subject [
                                        sp:varName "job"^^xsd:string ;
                                      ] ;
                                  ]
                                ) ;
                            ]
                            [
                              rdf:type sp:Optional ;
                              sp:elements (
                                  [
                                    sp:object [
                                        sp:varName "relativeLocation"^^xsd:string ;
                                      ] ;
                                    sp:predicate iess:relativeLocation ;
                                    sp:subject [
                                        sp:varName "job"^^xsd:string ;
                                      ] ;
                                  ]
                                ) ;
                            ]
                            [
                              rdf:type sp:Optional ;
                              sp:elements (
                                  [
                                    sp:object [
                                        sp:varName "targetNamespace"^^xsd:string ;
                                      ] ;
                                    sp:predicate iess:targetNamespace ;
                                    sp:subject [
                                        sp:varName "job"^^xsd:string ;
                                      ] ;
                                  ]
                                ) ;
                            ]
                            [
                              rdf:type sp:Optional ;
                              sp:elements (
                                  [
                                    sp:object [
                                        sp:varName "status"^^xsd:string ;
                                      ] ;
                                    sp:predicate iess:hasStatus ;
                                    sp:subject [
                                        sp:varName "job"^^xsd:string ;
                                      ] ;
                                  ]
                                ) ;
                            ]
                            [
                              rdf:type sp:Optional ;
                              sp:elements (
                                  [
                                    sp:object [
                                        sp:varName "lastUpdated"^^xsd:string ;
                                      ] ;
                                    sp:predicate vaem:lastUpdated ;
                                    sp:subject [
                                        sp:varName "job"^^xsd:string ;
                                      ] ;
                                  ]
                                ) ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                      [
                        rdf:type sp:Optional ;
                        sp:elements (
                            [
                              sp:object [
                                  sp:varName "statusLabel"^^xsd:string ;
                                ] ;
                              sp:predicate rdfs:label ;
                              sp:subject [
                                  sp:varName "status"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                      ]
                    ) ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "padding:20px;"^^xsd:string ;
                  ui:child [
                      rdf:type html:A ;
                      html:onclick "ies.openHelpDialog('downloading-xsd-schemas-div')"^^xsd:string ;
                      ui:child [
                          rdf:type html:Img ;
                          html:src [
                              rdf:type ui:concat ;
                              sp:arg1 [
                                  rdf:type ui:lib ;
                                ] ;
                              sp:arg2 "/ies/images/help_icon.png"^^xsd:string ;
                            ] ;
                          html:width "15px"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Button ;
                      html:id "ies-create-xsd-button"^^xsd:string ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "ies.createZIPofXSDs('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "tableId"^^xsd:string ;
                            ] ;
                          sp:arg3 "')"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Create XSDs ZIP"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Div ;
                      html:id "ies-download-xsd-div"^^xsd:string ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-subtitle"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Generated XSD Files"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Table ;
                      html:class "docPropertiesTable"^^xsd:string ;
                      html:title [
                          rdf:type iess:constructJobTrace ;
                        ] ;
                      ui:child [
                          rdf:type html:Tbody ;
                          ui:child [
                              rdf:type html:Div ;
                              ui:child [
                                  rdf:type ui:forEach ;
                                  ui:child [
                                      rdf:type html:Tr ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "docPropertiesTD"^^xsd:string ;
                                          ui:child [
                                              rdf:type ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text [
                                                  sp:varName "fileName"^^xsd:string ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "docPropertiesTD"^^xsd:string ;
                                          ui:child [
                                              rdf:type ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text [
                                                  sp:varName "lastUpdated"^^xsd:string ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 4 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "docPropertiesTD"^^xsd:string ;
                                          ui:child [
                                              rdf:type ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text [
                                                  sp:varName "relativeLocation"^^xsd:string ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 2 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "docPropertiesTD"^^xsd:string ;
                                          ui:child [
                                              rdf:type ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text [
                                                  sp:varName "statusLabel"^^xsd:string ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 3 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "docPropertiesTD"^^xsd:string ;
                                          ui:child [
                                              rdf:type ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text [
                                                  sp:varName "targetNamespace"^^xsd:string ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 1 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:resultSet [
                                      sp:varName "jobs"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Thead ;
                          ui:child [
                              rdf:type html:Tr ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "File Name"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Relative Location"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 2 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Status"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 3 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Target Namespace"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Updated"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 4 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:H3 ;
