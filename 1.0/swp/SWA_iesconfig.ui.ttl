                  ui:child [
                      rdf:type html:Table ;
                      html:class "docPropertiesTable"^^xsd:string ;
                      html:id "TBL_Ontology-Schemas"^^xsd:string ;
                      ui:child [
                          rdf:type html:Tbody ;
                          ui:child [
                              rdf:type ui:forEach ;
                              ui:child [
                                  rdf:type html:Div ;
