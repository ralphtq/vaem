iess:Elements
  rdf:type ui:NodeClass ;
  ui:headIncludes [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Link ;
          html:href [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/ies/css/ies.css"^^xsd:string ;
            ] ;
          html:rel "stylesheet"^^xsd:string ;
          html:type "text/css"^^xsd:string ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:Link ;
          html:href [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/swa/css/swa.css"^^xsd:string ;
            ] ;
          html:rel "stylesheet"^^xsd:string ;
          html:type "text/css"^^xsd:string ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type html:Script ;
          html:src [
              rdf:type ui:concat ;
              sp:arg1 [
                  rdf:type ui:lib ;
                ] ;
              sp:arg2 "/ies/js/ies.js"^^xsd:string ;
            ] ;
          html:type "text/javascript"^^xsd:string ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type html:Script ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text """$(document).ready(function() {swa.queryGraphURI='http://rdfex.org/withImports?uri=http://ies.topbraidlive.org/1.0/swa/iesconfig';

 $(\"#ies-ontology-selections\").hide();})"""^^xsd:string ;
            ] ;
          ui:childIndex 3 ;
        ] ;
    ] ;
  rdfs:subClassOf swa:Elements ;
.
iess:FindGraphs
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            sp:varName "gLabel"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "graph"^^xsd:string ;
          ]
          [
            sp:varName "gLabel"^^xsd:string ;
          ]
          [
            sp:varName "gURI"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "relativeLocation"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "hasGraphRole"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate iess:findGraphsWithRole ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          (
            [
              rdf:type sp:NamedGraph ;
              sp:elements (
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        rdf:type xsd:string ;
                        sp:arg1 [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:variable [
                        sp:varName "gURI"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        rdf:type xsd:string ;
                        sp:arg1 [
                            rdf:type ui:label ;
                            sp:arg1 [
                                sp:varName "graph"^^xsd:string ;
                              ] ;
                          ] ;
                      ] ;
                    sp:variable [
                        sp:varName "gLabel"^^xsd:string ;
                      ] ;
                  ]
                ) ;
              sp:graphNameNode [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ]
          )
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate iess:relativeLocation ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate vaem:hasGraphRole ;
    ] ;
  rdfs:label "Find graphs"^^xsd:string ;
  rdfs:subClassOf iess:SelectTemplates ;
.
