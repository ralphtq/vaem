          default:tabular "true"^^xsd:boolean ;
          ui:child [
              rdf:type html:Div ;
              html:style "padding:20px;"^^xsd:string ;
              ui:child [
                  rdf:type html:Button ;
                  html:id "ies-generate-xsd-button"^^xsd:string ;
                  html:onclick [
                      rdf:type ui:concat ;
                      sp:arg1 "ies.generateXSDs('"^^xsd:string ;
                      sp:arg2 [
                          rdf:type xsd:string ;
                          sp:arg1 <http://ies.topbraidlive.org/env/config#XSD-GeneratorConfiguration> ;
                        ] ;
                      sp:arg3 "')"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Generate XSDs"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:queryGraph [
          rdf:type ui:graphWithImports ;
          sp:arg1 [
              sp:varName "ontology"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "ies.execSPARQLMotion('iessm:helloies',  { exampleInput: '{= xsd:string(iesenv:XSD-GeneratorConfiguration) }'});"^^xsd:string ;
  rdfs:label "XSD Generation Blind"^^xsd:string ;
  rdfs:subClassOf iess:Blinds ;
