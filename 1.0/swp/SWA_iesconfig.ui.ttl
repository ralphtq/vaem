                                sp:object [
                                    sp:varName "gRole"^^xsd:string ;
                                  ] ;
                                sp:predicate vaem:hasGraphRole ;
                                sp:subject [
                                    sp:varName "graph"^^xsd:string ;
                                  ] ;
                              ]
                            ) ;
