                  ui:child [
                      rdf:type iess:ConfigXSDsGenerationTab ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 6 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  ui:child [
                      rdf:type html:A ;
                      html:href "http://www.topquadrant.com/products/TB_Suite.html"^^xsd:string ;
                      ui:child [
                          rdf:type html:Img ;
                          html:src [
                              rdf:type ui:concat ;
                              sp:arg1 [
                                  rdf:type ui:lib ;
                                ] ;
                              sp:arg2 "/ies/images/TBS_DeliveredBy.jpg"^^xsd:string ;
                            ] ;
                          html:width "100px"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 10 ;
                ] ;
              ui:child [
                  rdf:type html:Ul ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type html:A ;
                          html:href "#ies_admin"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Admin"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
