iess:Parts
  rdf:type ui:NodeClass ;
  rdfs:label "Parts"^^xsd:string ;
  rdfs:subClassOf iess:Node ;
.
iess:ProjectsTab
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:group ;
          letrs:projects [
              rdf:type sp:Select ;
              sp:orderBy (
                  [
                    sp:varName "project"^^xsd:string ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "project"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                    sp:predicate tops:files ;
                    sp:subject [
                        sp:varName "path"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object "/" ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object "true"^^xsd:boolean ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?2"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object "true"^^xsd:boolean ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?2"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?2"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Filter ;
                    sp:expression [
                        rdf:type fn:ends-with ;
                        sp:arg1 [
                            sp:varName "path"^^xsd:string ;
                          ] ;
                        sp:arg2 ".project" ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        rdf:type spif:regex ;
                        sp:arg1 [
                            sp:varName "path"^^xsd:string ;
                          ] ;
                        sp:arg2 "/(.*)/\\.project" ;
                        sp:arg3 "$1" ;
                      ] ;
                    sp:variable [
                        sp:varName "project"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              let:rbgId [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      rdf:type fn:concat ;
                      sp:arg1 "RBG_" ;
                      sp:arg2 [
                          rdf:type ui:uniqueId ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:class "ies-subtitle"^^xsd:string ;
                  ui:child [
                      rdf:type html:A ;
                      html:onclick "ies.openHelpDialog('selecting-a-project-div')"^^xsd:string ;
                      ui:child [
                          rdf:type html:Img ;
                          html:src [
                              rdf:type ui:concat ;
                              sp:arg1 [
                                  rdf:type ui:lib ;
                                ] ;
                              sp:arg2 "/ies/images/help_icon.png"^^xsd:string ;
                            ] ;
                          html:width "15px"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text """Projects
            """^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:id "ies-project-graphs-spinner"^^xsd:string ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "padding:20px;"^^xsd:string ;
                  ui:child [
                      rdf:type html:Button ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "ies.setProject('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "rbgId"^^xsd:string ;
                            ] ;
                          sp:arg3 "')"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Accept Project Selection"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "docPropertiesTable"^^xsd:string ;
                  html:id "TBL_Projects"^^xsd:string ;
                  ui:child [
                      rdf:type html:Tbody ;
                      ui:child [
                          rdf:type html:Div ;
                          ui:child [
                              rdf:type ui:forEach ;
                              ui:child [
                                  rdf:type html:Tr ;
                                  html:title [
                                      sp:varName "gDesc"^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "docPropertiesTD"^^xsd:string ;
                                      ui:child [
                                          rdf:type iess:ObjectWidgetRow ;
                                          arg:object [
                                              sp:varName "project"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Td ;
                                      html:class "docPropertiesTD"^^xsd:string ;
                                      ui:child [
                                          rdf:type html:Div ;
                                          html:class "ies_widget_value_slot"^^xsd:string ;
                                          ui:child [
                                              rdf:type html:Input ;
                                              html:name [
                                                  sp:varName "rbgId"^^xsd:string ;
                                                ] ;
                                              html:type "radio"^^xsd:string ;
                                              html:value [
                                                  sp:varName "project"^^xsd:string ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:resultSet [
                                  sp:varName "projects"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      ui:child [
                          rdf:type html:Tr ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "docPropertiesTH"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Project"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "docPropertiesTH"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Selected"^^xsd:string ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Projects Tab"^^xsd:string ;
  rdfs:subClassOf iess:Tabs ;
.
iess:PropertiesTable
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:propertySet ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Table ;
          html:class "docPropertiesTable"^^xsd:string ;
          ui:child [
              rdf:type html:Tr ;
              ui:child [
                  rdf:type html:Th ;
                  html:class "docPropertiesTH"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "#"^^xsd:string ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type html:Th ;
                  html:class "docPropertiesTH"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Permissible Values (inherited from Parent Class)"^^xsd:string ;
                    ] ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  rdf:type html:Th ;
                  html:class "docPropertiesTH"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Property"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Th ;
                  html:class "docPropertuesTH"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Type"^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type html:Tr ;
                      ui:child [
                          rdf:type iess:PropertyDetailsTable ;
                          arg:class [
                              sp:varName "class"^^xsd:string ;
                            ] ;
                          arg:parent [
                              sp:varName "parent"^^xsd:string ;
                            ] ;
                          arg:property [
                              sp:varName "property"^^xsd:string ;
                            ] ;
                          ui:childIndex 3 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "docPropertiesTD"^^xsd:string ;
                          ui:child [
                              rdf:type iess:LabelList ;
                              arg:resultSet [
                                  rdf:type sp:Select ;
                                  sp:orderBy (
                                      [
                                        rdf:type ui:label ;
                                        sp:arg1 [
                                            sp:varName "type"^^xsd:string ;
                                          ] ;
                                      ]
                                    ) ;
                                  sp:resultVariables (
                                      [
                                        sp:varName "type"^^xsd:string ;
                                      ]
                                    ) ;
                                  sp:where (
                                      [
                                        sp:object [
                                            sp:varName "type"^^xsd:string ;
                                          ] ;
                                        sp:predicate rdf:type ;
                                        sp:subject [
                                            sp:varName "property"^^xsd:string ;
                                          ] ;
                                      ]
                                    ) ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "docPropertiesTD"^^xsd:string ;
                          ui:child [
                              rdf:type html:B ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text [
                                      rdf:type ui:label ;
                                      sp:arg1 [
                                          sp:varName "property"^^xsd:string ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text " ["^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 2 ;
                              ui:text [
                                  rdf:type ui:encodeNode ;
                                  sp:arg1 [
                                      sp:varName "property"^^xsd:string ;
                                    ] ;
                                ] ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 3 ;
                              ui:text "]"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:Td ;
                          html:class "docPropertiesTD"^^xsd:string ;
                          ui:child [
                              rdf:type ui:group ;
                              letrs:myCardinalities [
                                  rdf:type sp:Select ;
                                  sp:resultVariables (
                                      [
                                        sp:varName "min"^^xsd:string ;
                                      ]
                                      [
                                        sp:varName "max"^^xsd:string ;
                                      ]
                                    ) ;
                                  sp:where (
                                      [
                                        rdf:type sp:Bind ;
                                        sp:expression [
                                            rdf:type smf:minCardinality ;
                                            sp:arg1 [
                                                sp:varName "class"^^xsd:string ;
                                              ] ;
                                            sp:arg2 [
                                                sp:varName "property"^^xsd:string ;
                                              ] ;
                                          ] ;
                                        sp:variable [
                                            sp:varName "min"^^xsd:string ;
                                          ] ;
                                      ]
                                      [
                                        rdf:type sp:Bind ;
                                        sp:expression [
                                            rdf:type smf:maxCardinality ;
                                            sp:arg1 [
                                                sp:varName "class"^^xsd:string ;
                                              ] ;
                                            sp:arg2 [
                                                sp:varName "property"^^xsd:string ;
                                              ] ;
                                          ] ;
                                        sp:variable [
                                            sp:varName "max"^^xsd:string ;
                                          ] ;
                                      ]
                                    ) ;
                                ] ;
                              ui:child [
                                  rdf:type ui:forEach ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "["^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 1 ;
                                      ui:text [
                                          rdf:type sp:if ;
                                          sp:arg1 [
                                              rdf:type sp:bound ;
                                              sp:arg1 [
                                                  sp:varName "min"^^xsd:string ;
                                                ] ;
                                            ] ;
                                          sp:arg2 [
                                              sp:varName "min"^^xsd:string ;
                                            ] ;
                                          sp:arg3 0 ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 2 ;
                                      ui:text ".."^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 3 ;
                                      ui:text [
                                          rdf:type sp:if ;
                                          sp:arg1 [
                                              rdf:type sp:ne ;
                                              sp:arg1 [
                                                  sp:varName "max"^^xsd:string ;
                                                ] ;
                                              sp:arg2 -1 ;
                                            ] ;
                                          sp:arg2 [
                                              sp:varName "max"^^xsd:string ;
                                            ] ;
                                          sp:arg3 "*" ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 4 ;
                                      ui:text "]"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:resultSet [
                                      sp:varName "myCardinalities"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 4 ;
                  ui:resultSet [
                      sp:varName "propertySet"^^xsd:string ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Properties table"^^xsd:string ;
  rdfs:subClassOf iess:Parts ;
.
iess:PropertyDetailsTable
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:parent ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdf:Property ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Td ;
          html:class "docPropertiesTD"^^xsd:string ;
          ui:child [
              rdf:type ui:group ;
              letrs:myParents [
                  rdf:type sp:Select ;
                  sp:resultVariables (
                      [
                        sp:varName "parent"^^xsd:string ;
                      ]
                    ) ;
                  sp:where (
                      [
                        sp:object [
                            sp:varName "class"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "property"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?2"^^xsd:string ;
                          ] ;
                        sp:predicate <http://lib.topquadrant.com/owl/srg/o2o#parentsOfPropertiesAtClass> ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "parent"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?2"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?2"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "lm_inner_table"^^xsd:string ;
                  ui:child [
                      rdf:type ui:forEach ;
                      ui:child [
                          rdf:type html:Tr ;
                          html:class "lm_inner_row"^^xsd:string ;
                          ui:child [
                              rdf:type html:Td ;
                              html:class "lm_inner_column"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:else ;
                                  ui:child [
                                      rdf:type html:I ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "self"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  rdf:type ui:if ;
                                  ui:child [
                                      rdf:type html:B ;
                                      ui:child [
                                          rdf:type swa:Link ;
                                          arg:resource [
                                              sp:varName "parent"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 1 ;
                                      ui:text "["^^xsd:string ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 2 ;
                                      ui:text [
                                          rdf:type ui:encodeNode ;
                                          sp:arg1 [
                                              sp:varName "parent"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 3 ;
                                      ui:text "]"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:condition [
                                      rdf:type sp:ne ;
                                      sp:arg1 [
                                          sp:varName "parent"^^xsd:string ;
                                        ] ;
                                      sp:arg2 [
                                          sp:varName "class"^^xsd:string ;
                                        ] ;
                                    ] ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type html:Td ;
                              html:class "lm_inner_column"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:group ;
                                  let:range [
                                      rdf:type sp:Select ;
                                      sp:resultVariables (
                                          [
                                            sp:varName "range"^^xsd:string ;
                                          ]
                                        ) ;
                                      sp:where (
                                          [
                                            sp:object [
                                                sp:varName "parent"^^xsd:string ;
                                              ] ;
                                            sp:predicate rdf:first ;
                                            sp:subject [
                                                sp:varName "?0"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object [
                                                sp:varName "?1"^^xsd:string ;
                                              ] ;
                                            sp:predicate rdf:rest ;
                                            sp:subject [
                                                sp:varName "?0"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object [
                                                sp:varName "property"^^xsd:string ;
                                              ] ;
                                            sp:predicate rdf:first ;
                                            sp:subject [
                                                sp:varName "?1"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object () ;
                                            sp:predicate rdf:rest ;
                                            sp:subject [
                                                sp:varName "?1"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object [
                                                sp:varName "?2"^^xsd:string ;
                                              ] ;
                                            sp:predicate <http://lib.topquadrant.com/owl/srg/o2o#rangeOfPropertyAtClass> ;
                                            sp:subject [
                                                sp:varName "?0"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object [
                                                sp:varName "range"^^xsd:string ;
                                              ] ;
                                            sp:predicate rdf:first ;
                                            sp:subject [
                                                sp:varName "?2"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object () ;
                                            sp:predicate rdf:rest ;
                                            sp:subject [
                                                sp:varName "?2"^^xsd:string ;
                                              ] ;
                                          ]
                                        ) ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:else ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text [
                                              rdf:type ui:label ;
                                              sp:arg1 [
                                                  sp:varName "range"^^xsd:string ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:childIndex 1 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:if ;
                                      ui:child [
                                          rdf:type swa:Link ;
                                          arg:resource [
                                              sp:varName "range"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 1 ;
                                          ui:text "["^^xsd:string ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 2 ;
                                          ui:text [
                                              rdf:type ui:encodeNode ;
                                              sp:arg1 [
                                                  sp:varName "range"^^xsd:string ;
                                                ] ;
                                            ] ;
                                        ] ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 3 ;
                                          ui:text "]"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                      ui:condition [
                                          rdf:type sp:isIRI ;
                                          sp:arg1 [
                                              sp:varName "range"^^xsd:string ;
                                            ] ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type ui:group ;
                          letrs:myRestrictions [
                              rdf:type sp:Select ;
                              sp:resultVariables (
                                  [
                                    sp:varName "range"^^xsd:string ;
                                  ]
                                ) ;
                              sp:where (
                                  [
                                    sp:object [
                                        sp:varName "parent"^^xsd:string ;
                                      ] ;
                                    sp:predicate rdf:first ;
                                    sp:subject [
                                        sp:varName "?0"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "?1"^^xsd:string ;
                                      ] ;
                                    sp:predicate rdf:rest ;
                                    sp:subject [
                                        sp:varName "?0"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "property"^^xsd:string ;
                                      ] ;
                                    sp:predicate rdf:first ;
                                    sp:subject [
                                        sp:varName "?1"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object () ;
                                    sp:predicate rdf:rest ;
                                    sp:subject [
                                        sp:varName "?1"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "?2"^^xsd:string ;
                                      ] ;
                                    sp:predicate <http://lib.topquadrant.com/owl/srg/o2o#valueRestrictionsForPropertyAtClass> ;
                                    sp:subject [
                                        sp:varName "?0"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "range"^^xsd:string ;
                                      ] ;
                                    sp:predicate rdf:first ;
                                    sp:subject [
                                        sp:varName "?2"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "?3"^^xsd:string ;
                                      ] ;
                                    sp:predicate rdf:rest ;
                                    sp:subject [
                                        sp:varName "?2"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object [
                                        sp:varName "parent"^^xsd:string ;
                                      ] ;
                                    sp:predicate rdf:first ;
                                    sp:subject [
                                        sp:varName "?3"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    sp:object () ;
                                    sp:predicate rdf:rest ;
                                    sp:subject [
                                        sp:varName "?3"^^xsd:string ;
                                      ] ;
                                  ]
                                ) ;
                            ] ;
                          ui:child [
                              rdf:type ui:if ;
                              ui:child [
                                  rdf:type ui:forEach ;
                                  ui:child [
                                      rdf:type html:Tr ;
                                      html:class "lm_inner_row"^^xsd:string ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "lm_inner_column"^^xsd:string ;
                                          ui:child [
                                              rdf:type html:B ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text " only "^^xsd:string ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:child [
                                              rdf:type ui:else ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text [
                                                      rdf:type ui:label ;
                                                      sp:arg1 [
                                                          sp:varName "range"^^xsd:string ;
                                                        ] ;
                                                    ] ;
                                                ] ;
                                              ui:childIndex 2 ;
                                            ] ;
                                          ui:child [
                                              rdf:type ui:if ;
                                              ui:child [
                                                  rdf:type swa:Link ;
                                                  arg:resource [
                                                      sp:varName "range"^^xsd:string ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 1 ;
                                                  ui:text "["^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 2 ;
                                                  ui:text [
                                                      rdf:type ui:encodeNode ;
                                                      sp:arg1 [
                                                          sp:varName "range"^^xsd:string ;
                                                        ] ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 3 ;
                                                  ui:text "]"^^xsd:string ;
                                                ] ;
                                              ui:childIndex 1 ;
                                              ui:condition [
                                                  rdf:type sp:isIRI ;
                                                  sp:arg1 [
                                                      sp:varName "range"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "lm_inner_column"^^xsd:string ;
                                          ui:child [
                                              rdf:type ui:else ;
                                              ui:child [
                                                  rdf:type html:I ;
                                                  ui:child [
                                                      rdf:type ui:TextNode ;
                                                      ui:childIndex 0 ;
                                                      ui:text "self"^^xsd:string ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:childIndex 1 ;
                                            ] ;
                                          ui:child [
                                              rdf:type ui:if ;
                                              ui:child [
                                                  rdf:type html:B ;
                                                  ui:child [
                                                      rdf:type swa:Link ;
                                                      arg:resource [
                                                          sp:varName "parent"^^xsd:string ;
                                                        ] ;
                                                      ui:childIndex 0 ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 1 ;
                                                  ui:text "["^^xsd:string ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 2 ;
                                                  ui:text [
                                                      rdf:type ui:encodeNode ;
                                                      sp:arg1 [
                                                          sp:varName "parent"^^xsd:string ;
                                                        ] ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 3 ;
                                                  ui:text "]"^^xsd:string ;
                                                ] ;
                                              ui:childIndex 0 ;
                                              ui:condition [
                                                  rdf:type sp:ne ;
                                                  sp:arg1 [
                                                      sp:varName "parent"^^xsd:string ;
                                                    ] ;
                                                  sp:arg2 [
                                                      sp:varName "class"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 1 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:resultSet [
                                      sp:varName "myRestrictions"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:condition [
                                  rdf:type sp:gt ;
                                  sp:arg1 [
                                      rdf:type spr:rowCount ;
                                      sp:arg1 [
                                          sp:varName "myRestrictions"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  sp:arg2 0 ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:resultSet [
                          sp:varName "myParents"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:label "Property details table"^^xsd:string ;
  rdfs:subClassOf iess:Parts ;
.
iess:RememberRelevantProjectOntologies
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:project ;
      spl:valueType xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:table ;
      spl:valueType spr:Table ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:sessionGraph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type iess:SaveGraph ;
          arg:graph [
              sp:varName "sessionGraph"^^xsd:string ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:forEach ;
          ui:child [
              rdf:type iess:SetSelectedOntology ;
              arg:ontology [
                  sp:varName "graph"^^xsd:string ;
                ] ;
              arg:project [
                  sp:varName "project"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:resultSet [
              sp:varName "table"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  vaem:todo "Not sure if this is needed. Currently not used."^^xsd:string ;
  rdfs:label "Remember Relecant Project Ontologies"^^xsd:string ;
  rdfs:subClassOf iess:SubElements ;
.
iess:RetrieveGraphsForSelectedOntologies
  rdf:type spin:SelectTemplate ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            sp:varName "ontGraphL"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "ontGraph"^^xsd:string ;
          ]
          [
            sp:varName "ontGraphL"^^xsd:string ;
          ]
          [
            sp:varName "ontGraphU"^^xsd:string ;
          ]
          [
            sp:varName "xspGraph"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "?0"^^xsd:string ;
              ] ;
            sp:predicate iess:getOntologyFromSessionXSP-Graph ;
            sp:subject () ;
          ]
          [
            sp:object [
                sp:varName "ontGraph"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "xspGraph"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          (
            [
              rdf:type sp:NamedGraph ;
              sp:elements (
                  [
                    rdf:type sp:Optional ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "ontGraphL"^^xsd:string ;
                            ] ;
                          sp:predicate rdfs:label ;
                          sp:subject [
                              sp:varName "ontGraph"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        rdf:type xsd:string ;
                        sp:arg1 [
                            sp:varName "ontGraph"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:variable [
                        sp:varName "ontGraphU"^^xsd:string ;
                      ] ;
                  ]
                ) ;
              sp:graphNameNode [
                  sp:varName "ontGraph"^^xsd:string ;
                ] ;
            ]
          )
        ) ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:comment "Retrieves graphs for the selected ontologies from the ontology project instance."^^xsd:string ;
  rdfs:label "Retrieve graphs for selected ontologies"^^xsd:string ;
  rdfs:subClassOf iess:SelectTemplates ;
.
iess:SaveGraph
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Script ;
          html:type "text/javascript"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "var params =  { baseURI: '"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 1 ;
              ui:text [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 2 ;
              ui:text """' };
ies.execSPARQLMotion('iessm:saveGraph', params);"""^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "Uses a SPARQLMotion script to save an updated graph"^^xsd:string ;
  rdfs:label "Save graph"^^xsd:string ;
  rdfs:subClassOf iess:UpdateHandlers ;
.
iess:SaveSessionGraph
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:sessionGraph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type iess:SaveGraph ;
          arg:graph [
              sp:varName "sessionGraph"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "Uses a SPARQLMotion script to save session graph"^^xsd:string ;
  rdfs:label "Save graph"^^xsd:string ;
  rdfs:subClassOf iess:UpdateHandlers ;
.
iess:SelectTemplates
  rdf:type spin:SelectTemplate ;
  rdfs:label "Select templates"^^xsd:string ;
  rdfs:subClassOf spin:SelectTemplates ;
.
iess:SetConfigPropertyValue
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdf:Property ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:value ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:graph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type ui:transaction ;
          let:config [
              rdf:type iess:makeUserSessionResource ;
              arg:prefix "CONFIG" ;
              arg:resource "" ;
            ] ;
          ui:child [
              rdf:type ui:update ;
              ui:childIndex 0 ;
              ui:updateQuery [
                  rdf:type sp:Modify ;
                  sp:insertPattern (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              sp:object [
                                  sp:varName "value"^^xsd:string ;
                                ] ;
                              sp:predicate [
                                  sp:varName "property"^^xsd:string ;
                                ] ;
                              sp:subject [
                                  sp:varName "config"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:where () ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Set Config Property Value"^^xsd:string ;
  rdfs:subClassOf iess:UpdateHandlers ;
.
iess:SetDefaultConfigPropertyValues
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:graph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:config [
              rdf:type iess:makeUserSessionResource ;
              arg:prefix "CONFIG" ;
              arg:resource "" ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type iess:SetConfigPropertyValue ;
                  arg:property iess:serverURL ;
                  arg:value "localhost:8083"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:not ;
                  sp:arg1 [
                      rdf:type iess:hasValueForProperty ;
                      arg:graph [
                          sp:varName "graph"^^xsd:string ;
                        ] ;
                      arg:property iess:serverURL ;
                      arg:resource [
                          sp:varName "config"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type iess:SetConfigPropertyValue ;
                  arg:property iess:xsdFilesPath ;
                  arg:value "/ies/xsds/"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
              ui:condition [
                  rdf:type sp:not ;
                  sp:arg1 [
                      rdf:type iess:hasValueForProperty ;
                      arg:graph [
                          sp:varName "graph"^^xsd:string ;
                        ] ;
                      arg:property iess:xsdFilesPath ;
                      arg:resource [
                          sp:varName "config"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type iess:SetConfigPropertyValue ;
                  arg:property iess:xsdLibraryPath ;
                  arg:value "/ies/lib/"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 2 ;
              ui:condition [
                  rdf:type sp:not ;
                  sp:arg1 [
                      rdf:type iess:hasValueForProperty ;
                      arg:graph [
                          sp:varName "graph"^^xsd:string ;
                        ] ;
                      arg:property iess:xsdLibraryPath ;
                      arg:resource [
                          sp:varName "config"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Set default config property values"^^xsd:string ;
  rdfs:subClassOf iess:UpdateHandlers ;
.
iess:SetJob
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:project ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:graph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type ui:transaction ;
          ui:child [
              rdf:type ui:update ;
              ui:childIndex 0 ;
              ui:updateQuery [
                  rdf:type sp:Modify ;
                  sp:insertPattern (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              sp:object iess:Session ;
                              sp:predicate rdf:type ;
                              sp:subject [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object iess:XSD-GenerationJob ;
                              sp:predicate rdf:type ;
                              sp:subject [
                                  sp:varName "jobURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "xspGraph"^^xsd:string ;
                                ] ;
                              sp:predicate iess:hasSelectedXSPGraph ;
                              sp:subject [
                                  sp:varName "jobURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "targetNamespace"^^xsd:string ;
                                ] ;
                              sp:predicate iess:targetNamespace ;
                              sp:subject [
                                  sp:varName "jobURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "xsdFileName"^^xsd:string ;
                                ] ;
                              sp:predicate <http://xspl.us/schema/xsp#xsdFileName> ;
                              sp:subject [
                                  sp:varName "jobURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "now"^^xsd:string ;
                                ] ;
                              sp:predicate vaem:lastUpdated ;
                              sp:subject [
                                  sp:varName "jobURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object iess:JOB_READY ;
                              sp:predicate iess:hasStatus ;
                              sp:subject [
                                  sp:varName "jobURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "jobURI"^^xsd:string ;
                                ] ;
                              sp:predicate iess:hasJob ;
                              sp:subject [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:where (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              rdf:type sp:Bind ;
                              sp:expression [
                                  rdf:type iess:getUserSession ;
                                ] ;
                              sp:variable [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                            [
                              rdf:type sp:Bind ;
                              sp:expression [
                                  rdf:type iess:getUserSession ;
                                ] ;
                              sp:variable [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "ontProject"^^xsd:string ;
                                ] ;
                              sp:predicate iess:requires ;
                              sp:subject [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "xspGraph"^^xsd:string ;
                                ] ;
                              sp:predicate iess:hasSelectedXSPGraph ;
                              sp:subject [
                                  sp:varName "ontProject"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "projectName"^^xsd:string ;
                                ] ;
                              sp:predicate vaem:name ;
                              sp:subject [
                                  sp:varName "ontProject"^^xsd:string ;
                                ] ;
                            ]
                            [
                              rdf:type sp:NamedGraph ;
                              sp:elements (
                                  [
                                    sp:object [
                                        sp:varName "ontGraph"^^xsd:string ;
                                      ] ;
                                    sp:predicate <http://xspl.us/schema/xsp#annotatesGraph> ;
                                    sp:subject [
                                        sp:varName "xspGraph"^^xsd:string ;
                                      ] ;
                                  ]
                                  [
                                    rdf:type sp:Union ;
                                    sp:elements (
                                        (
                                          [
                                            sp:object [
                                                sp:varName "targetNamespace"^^xsd:string ;
                                              ] ;
                                            sp:predicate <http://xspl.us/schema/xsp#targetNamespace> ;
                                            sp:subject [
                                                sp:varName "xspGraph"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object [
                                                sp:varName "xsdFileName"^^xsd:string ;
                                              ] ;
                                            sp:predicate <http://xspl.us/schema/xsp#xsdFileName> ;
                                            sp:subject [
                                                sp:varName "xspGraph"^^xsd:string ;
                                              ] ;
                                          ]
                                        )
                                        (
                                          [
                                            sp:object [
                                                sp:varName "targetNamespace"^^xsd:string ;
                                              ] ;
                                            sp:predicate <http://xspl.us/schema/xsp#targetNamespace> ;
                                            sp:subject [
                                                sp:varName "ontGraph"^^xsd:string ;
                                              ] ;
                                          ]
                                          [
                                            sp:object [
                                                sp:varName "xsdFileName"^^xsd:string ;
                                              ] ;
                                            sp:predicate <http://xspl.us/schema/xsp#xsdFileName> ;
                                            sp:subject [
                                                sp:varName "ontGraph"^^xsd:string ;
                                              ] ;
                                          ]
                                        )
                                      ) ;
                                  ]
                                ) ;
                              sp:graphNameNode [
                                  sp:varName "xspGraph"^^xsd:string ;
                                ] ;
                            ]
                            [
                              rdf:type sp:Bind ;
                              sp:expression [
                                  rdf:type smf:regex ;
                                  sp:arg1 [
                                      rdf:type xsd:string ;
                                      sp:arg1 [
                                          sp:varName "xspGraph"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  sp:arg2 ".*/(.*)$" ;
                                  sp:arg3 "$1" ;
                                ] ;
                              sp:variable [
                                  sp:varName "suffix"^^xsd:string ;
                                ] ;
                            ]
                            [
                              rdf:type sp:Bind ;
                              sp:expression [
                                  rdf:type fn:concat ;
                                  sp:arg1 [
                                      sp:varName "projectName"^^xsd:string ;
                                    ] ;
                                  sp:arg2 "-" ;
                                  sp:arg3 [
                                      sp:varName "suffix"^^xsd:string ;
                                    ] ;
                                ] ;
                              sp:variable [
                                  sp:varName "suffix2"^^xsd:string ;
                                ] ;
                            ]
                            [
                              rdf:type sp:Bind ;
                              sp:expression [
                                  rdf:type iess:makeUserSessionResource ;
                                  arg:prefix "JOB" ;
                                  arg:resource [
                                      sp:varName "suffix2"^^xsd:string ;
                                    ] ;
                                ] ;
                              sp:variable [
                                  sp:varName "jobURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              rdf:type sp:Bind ;
                              sp:expression [
                                  rdf:type afn:now ;
                                ] ;
                              sp:variable [
                                  sp:varName "now"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:logMessage [
              rdf:type ui:concat ;
              sp:arg1 "Set Job for User Session in Graph "^^xsd:string ;
              sp:arg2 [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:label "Set Job"^^xsd:string ;
  rdfs:subClassOf iess:UpdateHandlers ;
.
iess:SetOntologySelections
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:graph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type html:Script ;
          html:type "text/javascript"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "var params =  { baseURI: '"^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 1 ;
              ui:text [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 2 ;
              ui:text """' };
ies.execSPARQLMotion('iessm:saveGraph', params);"""^^xsd:string ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:transaction ;
          ui:child [
              rdf:type ui:update ;
              ui:childIndex 0 ;
              ui:updateQuery [
                  rdf:type sp:Modify ;
                  sp:insertPattern (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              sp:object iess:XSD-GenerationJob ;
                              sp:predicate rdf:type ;
                              sp:subject [
                                  sp:varName "u"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:where (
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type sp:iri ;
                            sp:arg1 "http://example.com/test1" ;
                          ] ;
                        sp:variable [
                            sp:varName "u"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:logMessage [
              rdf:type ui:concat ;
              sp:arg1 "Set Ontology Selections into Graph "^^xsd:string ;
              sp:arg2 [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:label "Set ontology selections"^^xsd:string ;
  rdfs:subClassOf iess:UpdateHandlers ;
.
iess:SetProject
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:project ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:graph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type ui:transaction ;
          ui:child [
              rdf:type ui:update ;
              ui:childIndex 0 ;
              ui:updateQuery [
                  rdf:type sp:Modify ;
                  sp:insertPattern (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              sp:object iess:Session ;
                              sp:predicate rdf:type ;
                              sp:subject [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object iess:OntologyProject ;
                              sp:predicate rdf:type ;
                              sp:subject [
                                  sp:varName "projectURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "projectURI"^^xsd:string ;
                                ] ;
                              sp:predicate iess:requires ;
                              sp:subject [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "project"^^xsd:string ;
                                ] ;
                              sp:predicate vaem:name ;
                              sp:subject [
                                  sp:varName "projectURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "now"^^xsd:string ;
                                ] ;
                              sp:predicate vaem:lastUpdated ;
                              sp:subject [
                                  sp:varName "projectURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "config"^^xsd:string ;
                                ] ;
                              sp:predicate iess:hasConfiguration ;
                              sp:subject [
                                  sp:varName "projectURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object iess:XSD-GeneratorConfiguration ;
                              sp:predicate rdf:type ;
                              sp:subject [
                                  sp:varName "config"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object "false"^^xsd:boolean ;
                              sp:predicate iess:useChoiceForComplexTypeElements ;
                              sp:subject [
                                  sp:varName "config"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:where (
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type iess:getUserSession ;
                          ] ;
                        sp:variable [
                            sp:varName "session"^^xsd:string ;
                          ] ;
                      ]
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type iess:makeUserSessionResource ;
                            arg:prefix "OPRJ" ;
                            arg:resource "" ;
                          ] ;
                        sp:variable [
                            sp:varName "projectURI"^^xsd:string ;
                          ] ;
                      ]
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type iess:makeUserSessionResource ;
                            arg:prefix "CONFIG" ;
                            arg:resource "" ;
                          ] ;
                        sp:variable [
                            sp:varName "config"^^xsd:string ;
                          ] ;
                      ]
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type fn:concat ;
                            sp:arg1 "ies.topbraidlive.org/lib/xsds/" ;
                          ] ;
                        sp:variable [
                            sp:varName "libPath"^^xsd:string ;
                          ] ;
                      ]
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type afn:now ;
                          ] ;
                        sp:variable [
                            sp:varName "now"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:logMessage [
              rdf:type ui:concat ;
              sp:arg1 "Set User Session into Graph "^^xsd:string ;
              sp:arg2 [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:label "Set Project"^^xsd:string ;
  rdfs:subClassOf iess:UpdateHandlers ;
.
iess:SetSelectedOntology
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:ontology ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:graph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type ui:transaction ;
          ui:child [
              rdf:type ui:update ;
              ui:childIndex 0 ;
              ui:updateQuery [
                  rdf:type sp:Modify ;
                  sp:insertPattern (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              sp:object iess:OntologyProject ;
                              sp:predicate rdf:type ;
                              sp:subject [
                                  sp:varName "projectURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "ontology"^^xsd:string ;
                                ] ;
                              sp:predicate iess:hasSelectedXSPGraph ;
                              sp:subject [
                                  sp:varName "projectURI"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:where (
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type iess:makeUserSessionResource ;
                            arg:prefix "OPRJ" ;
                            arg:resource "" ;
                          ] ;
                        sp:variable [
                            sp:varName "projectURI"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:logMessage "Set Relevant Ontology"^^xsd:string ;
        ] ;
    ] ;
  rdfs:label "Set selected ontology"^^xsd:string ;
  rdfs:subClassOf iess:UpdateHandlers ;
.
iess:SetUserSession
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:graph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type iess:SaveGraph ;
          arg:graph [
              sp:varName "graph"^^xsd:string ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:transaction ;
          ui:child [
              rdf:type ui:update ;
              ui:childIndex 0 ;
              ui:updateQuery [
                  rdf:type sp:Modify ;
                  sp:insertPattern (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              sp:object iess:Session ;
                              sp:predicate rdf:type ;
                              sp:subject [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:where (
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type iess:getUserSession ;
                          ] ;
                        sp:variable [
                            sp:varName "session"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:logMessage [
              rdf:type ui:concat ;
              sp:arg1 "Set User Session into Graph "^^xsd:string ;
              sp:arg2 [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:label "Set user session"^^xsd:string ;
  rdfs:subClassOf iess:UpdateHandlers ;
.
iess:SingleRowObjectsBody
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:Div ;
              html:class "ies-object-row"^^xsd:string ;
              ui:child [
                  rdf:type iess:ObjectWidgetRow ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:call ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "subject"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type iess:ObjectWidgetRow ;
                      arg:object [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                      arg:predicate [
                          sp:varName "predicate"^^xsd:string ;
                        ] ;
                      arg:subject [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type iess:ObjectWidgetRow ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          arg:subject [
                              sp:varName "subject"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:and ;
                      sp:arg1 [
                          rdf:type sp:eq ;
                          sp:arg1 [
                              rdf:type spr:rowCount ;
                              sp:arg1 [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                      sp:arg2 [
                          rdf:type sp:not ;
                          sp:arg1 [
                              rdf:type swa:isViewMode ;
                            ] ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template swa:SortedObjects ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "subject"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The default implementation of swa:ObjectsBody, containing one row for each value."^^xsd:string ;
  rdfs:label "IES Single row objects body"^^xsd:string ;
  rdfs:subClassOf iess:ObjectsBody ;
.
iess:SubElements
  rdf:type ui:NodeClass ;
  rdfs:label "Sub elements"^^xsd:string ;
  rdfs:subClassOf iess:Elements ;
.
iess:SubjectWidgetRow
  rdf:type ui:SubjectWidgetRowClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The subject to display."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:dynamicView ;
      arg:object [
          sp:varName "object"^^xsd:string ;
        ] ;
      arg:predicate [
          sp:varName "predicate"^^xsd:string ;
        ] ;
      arg:subject [
          sp:varName "subject"^^xsd:string ;
        ] ;
      ui:class iess:ObjectViewerRow ;
    ] ;
  rdfs:comment "A row of a SubjectWidget."^^xsd:string ;
  rdfs:label "Subject widget row"^^xsd:string ;
  rdfs:subClassOf swa:SubjectElements ;
.
iess:SubjectsBody
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to allow at most one value."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:Div ;
              html:class "ies-object-row"^^xsd:string ;
              ui:child [
                  rdf:type swa:SubjectWidgetRow ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-add-button-div"^^xsd:string ;
              html:style [
                  rdf:type sp:if ;
                  sp:arg1 [
                      sp:varName "single"^^xsd:string ;
                    ] ;
                  sp:arg2 "display: none" ;
                  sp:arg3 [
                      sp:varName "none"^^xsd:string ;
                    ] ;
                ] ;
              let:pid [
                  rdf:type ui:uniqueId ;
                ] ;
              ui:child [
                  rdf:type html:A ;
                  html:class "ies-add-row-button"^^xsd:string ;
                  html:href "javascript:void(0)"^^xsd:string ;
                  html:onclick [
                      rdf:type fn:concat ;
                      sp:arg1 "swa.addRow('"^^xsd:string ;
                      sp:arg2 [
                          sp:varName "pid"^^xsd:string ;
                        ] ;
                      sp:arg3 "', "^^xsd:string ;
                      sp:arg4 [
                          rdf:type sp:coalesce ;
                          sp:arg1 [
                              sp:varName "single"^^xsd:string ;
                            ] ;
                          sp:arg2 "false"^^xsd:boolean ;
                        ] ;
                      sp:arg5 ")"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:id [
                      sp:varName "pid"^^xsd:string ;
                    ] ;
                  html:style "display: none"^^xsd:string ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type ui:setContext ;
                          ui:child [
                              rdf:type iess:SubjectWidgetRow ;
                              arg:object [
                                  sp:varName "object"^^xsd:string ;
                                ] ;
                              arg:predicate [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:varName "createLinkFunction"^^xsd:string ;
                          ui:varValue iess:createLinkForMainForm ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 2 ;
          ui:condition [
              rdf:type swa:isEditMode ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:call ;
              arg:object [
                  sp:varName "object"^^xsd:string ;
                ] ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies_widget_value_slot"^^xsd:string ;
                      ui:child [
                          rdf:type swa:SubjectWidgetRow ;
                          arg:object [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          arg:subject [
                              sp:varName "subject"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type iess:SubjectWidgetRow ;
                          arg:object [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:eq ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "rs"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template swa:SortedSubjects ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The body of a subjects widget."^^xsd:string ;
  rdfs:label "Subjects body"^^xsd:string ;
  rdfs:subClassOf swa:SubjectElements ;
.
