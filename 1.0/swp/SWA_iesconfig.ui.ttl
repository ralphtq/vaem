                  ]
                  [
                    sp:varName "gRevision"^^xsd:string ;
                  ]
                  [
                    sp:varName "gLastUpdated"^^xsd:string ;
                  ]
                  [
                    sp:varName "gDesc"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "project"^^xsd:string ;
