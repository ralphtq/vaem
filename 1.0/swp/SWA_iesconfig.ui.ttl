iess:XSD-GenerationTab-REDUNDANT
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:toolTip ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:setContext ;
          let:sourceBaseURI [
              rdf:type sp:iri ;
              sp:arg1 [
                  rdf:type spl:object ;
                  sp:arg1 <http://ies.topbraidlive.org/env/config#XSD-GeneratorConfiguration> ;
                  sp:arg2 iess:sourceBaseURI ;
                ] ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-header"^^xsd:string ;
              html:title [
                  sp:varName "toolTip"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type swa:Header ;
                  arg:label "XSD Generation"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              ui:child [
                  rdf:type iess:XSDGenerationBlind ;
                  arg:ontology [
                      sp:varName "sourceBaseURI"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type ui:group ;
                  default:labelWidth "350px"^^xsd:string ;
                  default:subject [
                      sp:varName "ontology"^^xsd:string ;
                    ] ;
                  default:tabular "true"^^xsd:boolean ;
                  ui:child [
                      rdf:type html:Div ;
                      html:style "padding:20px;"^^xsd:string ;
                      ui:child [
                          rdf:type html:Button ;
                          html:id "ies-generate-xsd-button"^^xsd:string ;
                          html:onclick [
                              rdf:type ui:concat ;
                              sp:arg1 "ies.generateXSDs('"^^xsd:string ;
                              sp:arg2 [
                                  rdf:type xsd:string ;
                                  sp:arg1 <http://ies.topbraidlive.org/env/config#XSD-GeneratorConfiguration> ;
                                ] ;
                              sp:arg3 "')"^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Generate XSDs"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 0 ;
          ui:varName "createLinkFunction"^^xsd:string ;
          ui:varValue iess:createLink ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  vaem:todo "remove"^^xsd:string ;
  rdfs:comment """<div>
                <ui:resourceView ui:matchIds=\"form\" ui:resource=\"iesenv:XSD-GeneratorConfiguration\"/>
            </div>"""^^xsd:string ;
  rdfs:comment """old headincludes:

<ui:group>
    <script src=\"lib/ies/js/jquery/jquery.ui.accordion.js\" type=\"text/javascript\"/>
    <script>$(function() {
		$( \"#xsdgen-accordion\" ).accordion({
autoHeight: false,
clearStyle: true
});     
	});</script>
</ui:group>"""^^xsd:string ;
  rdfs:label "XSD Generation Tab"^^xsd:string ;
  rdfs:subClassOf iess:Tabs ;
.
iess:XSD-GeneratorConfiguration
  ui:instanceView [
      rdf:type iesconfig:ConfigForm ;
      arg:config spin:_this ;
      ui:id "form"^^xsd:string ;
    ] ;
.
iess:XSDGenerationBlind
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:ontology ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The config instance."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type ui:group ;
          default:labelWidth "350px"^^xsd:string ;
