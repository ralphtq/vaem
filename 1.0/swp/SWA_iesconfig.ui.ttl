                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          ui:child [
                                              rdf:type iess:ObjectWidgetRow ;
                                              arg:object [
                                                  sp:varName "gLastUpdated"^^xsd:string ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 5 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          ui:child [
                                              rdf:type iess:ObjectWidgetRow ;
                                              arg:object [
