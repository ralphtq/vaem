iess:BuildOntologySelectionsTable
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:project ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:sessionGraph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          letrs:projectGraphs [
              rdf:type sp:Select ;
              sp:orderBy (
                  [
                    sp:varName "gLabel"^^xsd:string ;
                  ]
                ) ;
              sp:resultVariables (
                  [
                    sp:varName "graph"^^xsd:string ;
                  ]
                  [
                    sp:varName "gLabel"^^xsd:string ;
                  ]
                  [
                    sp:varName "gURI"^^xsd:string ;
                  ]
                  [
                    sp:varName "gAnnotationsGraph"^^xsd:string ;
                  ]
                  [
                    sp:varName "gRevision"^^xsd:string ;
                  ]
                  [
                    sp:varName "gLastUpdated"^^xsd:string ;
                  ]
                  [
                    sp:varName "gDesc"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "project"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object vaem:SchemaGraph ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "graph"^^xsd:string ;
                      ] ;
                    sp:predicate iess:findGraphsWithRole ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "project"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?2"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?3"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?2"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "graph"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?3"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?3"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?4"^^xsd:string ;
                      ] ;
                    sp:predicate iess:findAnnotationsGraph ;
                    sp:subject [
                        sp:varName "?2"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "gAnnotationsGraph"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?4"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?4"^^xsd:string ;
                      ] ;
                  ]
                  (
                    [
                      rdf:type sp:NamedGraph ;
                      sp:elements (
                          [
                            rdf:type sp:Optional ;
                            sp:elements (
                                [
                                  sp:object [
                                      sp:varName "gLabel"^^xsd:string ;
                                    ] ;
                                  sp:predicate rdfs:label ;
                                  sp:subject [
                                      sp:varName "graph"^^xsd:string ;
                                    ] ;
                                ]
                              ) ;
                          ]
                          [
                            rdf:type sp:Optional ;
                            sp:elements (
