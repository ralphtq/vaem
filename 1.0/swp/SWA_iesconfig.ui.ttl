                                sp:predicate vaem:lastUpdated ;
                                sp:subject [
                                    sp:varName "graph"^^xsd:string ;
                                  ] ;
                              ]
                            ) ;
                        ]
                        [
                          rdf:type sp:Optional ;
                          sp:elements (
                              [
                                sp:object [
                                    sp:varName "gRevision"^^xsd:string ;
                                  ] ;
                                sp:predicate vaem:revision ;
                                sp:subject [
                                    sp:varName "graph"^^xsd:string ;
                                  ] ;
                              ]
                            ) ;
