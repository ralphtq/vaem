      ui:child [
          rdf:type iess:SaveSessionGraph ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type iess:SetJob ;
          arg:project [
              sp:varName "project"^^xsd:string ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:id "ies-ontology-selections"^^xsd:string ;
          ui:childIndex 3 ;
        ] ;
