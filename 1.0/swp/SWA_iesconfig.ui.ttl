                      ui:childIndex 7 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type html:A ;
                          html:href "#ies_help"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Help"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 8 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type html:A ;
                          html:href "#ies_home"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Home"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type html:A ;
                          html:href "#ies_library"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Library"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 6 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type html:A ;
                          html:href "#ies_ontologies"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Ontologies"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type html:A ;
                          html:href "#ies_ontology_validation"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Validation"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type html:A ;
                          html:href "#ies_projects"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Projects"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type html:A ;
                          html:href "#ies_xml_schemas"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Generated XML Schemas"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 4 ;
                    ] ;
                  ui:child [
                      rdf:type html:Li ;
                      ui:child [
                          rdf:type html:A ;
                          html:href "#ies_xsd_config"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "XSD Configuration"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 5 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 2 ;
          ui:queryGraph [
              rdf:type ui:graphWithImports ;
              sp:arg1 <http://ies.topbraidlive.org/dynamic/config> ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:subClassOf iess:Pages ;
.
iess:HomeTab
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Div ;
          ui:child [
              rdf:type html:Div ;
              html:class "ies-subtitle"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "XML Schema Generation, Release 1.0"^^xsd:string ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:class "ies-title"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "TopBraid Information Exchange Server (IES)"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              ui:child [
                  rdf:type html:Img ;
                  html:src [
                      rdf:type ui:concat ;
                      sp:arg1 [
                          rdf:type ui:lib ;
                        ] ;
                      sp:arg2 "/ies/images/IES-InfoGraphic.png"^^xsd:string ;
                    ] ;
                  html:width "700px"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Home Blind"^^xsd:string ;
  rdfs:subClassOf iess:Tabs ;
.
iess:InheritanceTable
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resourceSet ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type html:Table ;
          html:class "docPropertiesTable"^^xsd:string ;
          ui:child [
              rdf:type html:Tr ;
              ui:child [
                  rdf:type html:Th ;
                  html:class "docPropertiesTH"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Depth"^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Th ;
                  html:class "docPropertiesTH"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Superclass"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:forEach ;
              ui:child [
                  rdf:type html:Tr ;
                  ui:child [
                      rdf:type html:Td ;
                      html:class "docPropertiesTD"^^xsd:string ;
                      ui:child [
                          rdf:type html:B ;
                          ui:child [
                              rdf:type swa:Link ;
                              arg:resource [
                                  sp:varName "super"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text "["^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 2 ;
                          ui:text [
                              rdf:type ui:encodeNode ;
                              sp:arg1 [
                                  sp:varName "super"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 3 ;
                          ui:text "]"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Td ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "depth"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
              ui:resultSet [
                  sp:varName "resourceSet"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue iess:createLinkForMainForm ;
    ] ;
  rdfs:label "Inheritance table"^^xsd:string ;
  rdfs:subClassOf iess:Parts ;
.
iess:JobHandlers
  rdf:type ui:NodeClass ;
  rdfs:label "Job handlers"^^xsd:string ;
  rdfs:subClassOf iess:Handlers ;
.
iess:LabelList
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resultSet ;
      spl:valueType sp:Select ;
      rdfs:comment "The result set to walk"^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:forEach ;
      ui:child [
          rdf:type ui:TextNode ;
          ui:childIndex 1 ;
          ui:text [
              rdf:type ui:label ;
              sp:arg1 [
                  sp:varName "node"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text ", "^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:gt ;
              sp:arg1 [
                  sp:varName "index"^^xsd:string ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
      ui:indexVar "index"^^xsd:string ;
      ui:resultSet [
          rdf:type sp:Select ;
          sp:resultVariables (
              [
                sp:varName "node"^^xsd:string ;
              ]
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "resultSet"^^xsd:string ;
                  ] ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object 0 ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object () ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "node"^^xsd:string ;
                  ] ;
                sp:predicate spr:colCells ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
            ) ;
        ] ;
    ] ;
  rdfs:label "Label list"^^xsd:string ;
  rdfs:subClassOf iess:Node ;
.
iess:LabeledObjects
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to only allow at most one object for this component."^^xsd:string ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      let:aPredicate [
          rdf:type iess:maybeConvertToURI ;
          sp:arg1 [
              sp:varName "predicate"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Tr ;
              html:class "ies-labeled-objects-tr"^^xsd:string ;
              ui:child [
                  rdf:type html:Td ;
                  html:class "ies-labeled-objects-body-td"^^xsd:string ;
                  html:id [
                      rdf:type ui:concat ;
                      sp:arg1 [
                          sp:varName "pid"^^xsd:string ;
                        ] ;
                      sp:arg2 "-body"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:setContext ;
                      ui:child [
                          rdf:type ui:setContext ;
                          ui:child [
                              rdf:type ui:setContext ;
                              ui:child [
                                  rdf:type iess:ObjectsBody ;
                                  ui:args "*"^^xsd:string ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:varName "viewWidget"^^xsd:string ;
                              ui:varValue [
                                  sp:varName "viewWidget"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:varName "searchWidget"^^xsd:string ;
                          ui:varValue [
                              sp:varName "searchWidget"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:varName "editWidget"^^xsd:string ;
                      ui:varValue [
                          sp:varName "editWidget"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type html:Td ;
                  html:class [
                      rdf:type ui:concat ;
                      sp:arg1 "ies-labeled-objects-label-td "^^xsd:string ;
                      sp:arg2 [
                          rdf:type sp:if ;
                          sp:arg1 [
                              sp:varName "tabular"^^xsd:string ;
                            ] ;
                          sp:arg2 "swa-labeled-objects-tabular-label" ;
                          sp:arg3 [
                              sp:varName "none"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  html:style [
                      rdf:type sp:if ;
                      sp:arg1 [
                          rdf:type sp:bound ;
                          sp:arg1 [
                              sp:varName "labelWidth"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          rdf:type sp:concat ;
                          sp:arg1 "width: " ;
                          sp:arg2 [
                              sp:varName "labelWidth"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg3 [
                          sp:varName "none"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-shifted-label"^^xsd:string ;
                      ui:child [
                          rdf:type swa:PropertyLabel ;
                          arg:id [
                              rdf:type ui:concat ;
                              sp:arg1 "property-label-"^^xsd:string ;
                              sp:arg2 [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                            ] ;
                          arg:label [
                              rdf:type ui:label ;
                              sp:arg1 [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                            ] ;
                          arg:property [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type ui:dynamicView ;
                  arg:editWidget [
                      sp:varName "editWidget"^^xsd:string ;
                    ] ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  arg:searchWidget [
                      sp:varName "searchWidget"^^xsd:string ;
                    ] ;
                  arg:single [
                      sp:varName "single"^^xsd:string ;
                    ] ;
                  arg:subject [
                      sp:varName "subject"^^xsd:string ;
                    ] ;
                  arg:uid [
                      sp:varName "pid"^^xsd:string ;
                    ] ;
                  arg:viewWidget [
                      sp:varName "viewWidget"^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:class [
                      rdf:type sp:coalesce ;
                      sp:arg1 [
                          rdf:type swa:modeProperty ;
                          arg:predicate swa:objectWidgetMiddleColumnClass ;
                        ] ;
                      sp:arg2 swa:DefaultObjectWidgetMiddleColumn ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:and ;
              sp:arg1 [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "subject"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type sp:exists ;
                  sp:elements (
                      [
                        sp:object [
                            sp:varName "anyObject"^^xsd:string ;
                          ] ;
                        sp:predicate [
                            sp:varName "aPredicate"^^xsd:string ;
                          ] ;
                        sp:subject [
                            sp:varName "subject"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The IES implementation of ies:Object and swa:Objects. Displays a label on the left and the value widget(s) on the right."^^xsd:string ;
  rdfs:label "Labeled objects"^^xsd:string ;
  rdfs:subClassOf iess:Objects ;
.
iess:LibraryTab
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:sessionGraph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:project [
              rdf:type iess:getOntologyProjectName ;
              arg:graph [
                  sp:varName "sessionGraph"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:group ;
              letrs:libFiles [
                  rdf:type sp:Select ;
                  sp:orderBy (
                      [
                        sp:varName "library"^^xsd:string ;
                      ]
                    ) ;
                  sp:resultVariables (
                      [
                        sp:varName "library"^^xsd:string ;
                      ]
                    ) ;
                  sp:where (
                      [
                        sp:object [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                        sp:predicate tops:files ;
                        sp:subject [
                            sp:varName "path"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object "/ies.topbraidlive.org/1.0/lib/xsd" ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object "true"^^xsd:boolean ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?2"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object "true"^^xsd:boolean ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?2"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?2"^^xsd:string ;
                          ] ;
                      ]
                      [
                        rdf:type sp:Filter ;
                        sp:expression [
                            rdf:type fn:ends-with ;
                            sp:arg1 [
                                sp:varName "path"^^xsd:string ;
                              ] ;
                            sp:arg2 ".xsd" ;
                          ] ;
                      ]
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type spif:regex ;
                            sp:arg1 [
                                sp:varName "path"^^xsd:string ;
                              ] ;
                            sp:arg2 "/(.*)/\\.xsd" ;
                            sp:arg3 "$1" ;
                          ] ;
                        sp:variable [
                            sp:varName "library"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "padding:20px;"^^xsd:string ;
                  ui:child [
                      rdf:type html:Button ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "ies.createZIPofXSDLib('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "tableId"^^xsd:string ;
                            ] ;
                          sp:arg3 "')"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Create XSD LIB ZIP"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Div ;
                      html:id "ies-download-xsd-lib"^^xsd:string ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "padding:20px;"^^xsd:string ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-subtitle"^^xsd:string ;
                      ui:child [
                          rdf:type html:A ;
                          html:onclick "ies.openHelpDialog('required-xsd-library-div')"^^xsd:string ;
                          ui:child [
                              rdf:type html:Img ;
                              html:src [
                                  rdf:type ui:concat ;
                                  sp:arg1 [
                                      rdf:type ui:lib ;
                                    ] ;
                                  sp:arg2 "/ies/images/help_icon.png"^^xsd:string ;
                                ] ;
                              html:width "15px"^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text """XSD Library Files
"""^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Table ;
                      html:class "docPropertiesTable"^^xsd:string ;
                      ui:child [
                          rdf:type html:Tbody ;
                          ui:child [
                              rdf:type html:Div ;
                              ui:child [
                                  rdf:type ui:forEach ;
                                  ui:child [
                                      rdf:type html:Tr ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "docPropertiesTD"^^xsd:string ;
                                          ui:child [
                                              rdf:type iess:ObjectWidgetRow ;
                                              arg:object [
                                                  sp:varName "library"^^xsd:string ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:resultSet [
                                      sp:varName "libFiles"^^xsd:string ;
                                    ] ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Thead ;
                          ui:child [
                              rdf:type html:Tr ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Library"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:H3 ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Create and Download XML Library Schemas"^^xsd:string ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Library Tab"^^xsd:string ;
  rdfs:subClassOf iess:Tabs ;
.
iess:LiteralViewer
  rdf:type swa:ObjectViewerClass ;
  swa:objectWidgetWeight [
      rdf:type swa:WeightedExpression ;
      swa:expression [
          rdf:type sp:isLiteral ;
          sp:arg1 [
              sp:varName "object"^^xsd:string ;
            ] ;
        ] ;
      swa:weight 10 ;
    ] ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Div ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text [
                  sp:varName "object"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "A node viewer for literal values, displaying the literal's text."^^xsd:string ;
  rdfs:label "IES Literal viewer"^^xsd:string ;
  rdfs:subClassOf swa:LiteralViewer ;
.
iess:MagicProperties
  rdf:type spin:MagicProperty ;
  rdfs:label "Magic properties"^^xsd:string ;
  rdfs:subClassOf spin:MagicProperties ;
.
iess:Mast
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:username [
          rdf:type iess:currentUser ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "ies-header"^^xsd:string ;
          ui:child [
              rdf:type html:Div ;
              html:id "ies-logo"^^xsd:string ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:id "ies-mast-gutter"^^xsd:string ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:id "ies-user"^^xsd:string ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "font-size: 9px;"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type uix:getTBVersion ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "user: "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 1 ;
                      ui:text [
                          sp:varName "username"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type html:A ;
                          html:href "../logout.html"^^xsd:string ;
                          html:id "logout"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "( logout )"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 2 ;
                      ui:condition [
                          rdf:type smf:isTBL ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "The header area of the IESS application(s). Displays logo, name of vocabulary, a global auto-complete field and an index."^^xsd:string ;
  rdfs:label "Browser header"^^xsd:string ;
  rdfs:subClassOf iess:Headers ;
.
iess:MissingPropertyValueHelper
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:ontologyGraph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicate ;
      spl:valueType rdf:Property ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:loadable ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:H3 ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Guidance"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  html:class "ies_body"^^xsd:string ;
                  ui:child [
                      rdf:type html:B ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              rdf:type smf:qname ;
                              sp:arg1 [
                                  rdf:type sp:iri ;
                                  sp:arg1 [
                                      sp:varName "predicate"^^xsd:string ;
                                    ] ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Missing value for property "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text """.
    """^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  html:class "ies_body"^^xsd:string ;
                  ui:child [
                      rdf:type html:I ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "This can be done either in the ontology graph itself or in the XML Schema Pragma graph "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text "."^^xsd:string ;
                    ] ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  html:class "ies_body"^^xsd:string ;
                  ui:child [
                      rdf:type html:I ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "ontologyGraph"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "This should be defined on the ontology "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text "."^^xsd:string ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:loadId "ies-dialog-div"^^xsd:string ;
        ] ;
    ] ;
  rdfs:label "Missing property value helper"^^xsd:string ;
  rdfs:subClassOf iess:Helpers ;
.
iess:Node
  rdf:type ui:NodeClass ;
  rdfs:label "Node"^^xsd:string ;
  rdfs:subClassOf ui:Node ;
.
iess:Object
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicate ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type iess:LabeledObjects ;
          arg:single "true"^^xsd:boolean ;
          ui:args "*"^^xsd:string ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "Inserts a widget for a single value of a given predicate at the given subject. This element should only be used if the property doesn't have a max cardinality of 1 anyway, to overload the default behavior."^^xsd:string ;
  rdfs:label "IES Object"^^xsd:string ;
  rdfs:subClassOf swa:AbstractObject ;
.
iess:ObjectPropertyValueInSpecificGraphWithHelper
  rdf:type swa:ObjectWidgetRowClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:ontologyGraph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicate ;
      spl:valueType rdf:Property ;
    ] ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      let:datatype [
          rdf:type sp:if ;
          sp:arg1 [
              rdf:type sp:isLiteral ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
            ] ;
          sp:arg2 [
              rdf:type sp:datatype ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
            ] ;
          sp:arg3 [
              sp:varName "no"^^xsd:string ;
            ] ;
        ] ;
      let:uid [
          rdf:type ui:uniqueId ;
        ] ;
      ui:child [
          rdf:type ui:setContext ;
          ui:child [
              rdf:type ui:group ;
              let:object [
                  rdf:type sp:Select ;
                  sp:resultVariables (
                      [
                        sp:varName "object"^^xsd:string ;
                      ]
                    ) ;
                  sp:where (
                      [
                        rdf:type sp:Optional ;
                        sp:elements (
                            [
                              sp:object [
                                  sp:varName "value1"^^xsd:string ;
                                ] ;
                              sp:predicate [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                              sp:subject [
                                  sp:varName "ontologyGraph"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                      ]
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type sp:if ;
                            sp:arg1 [
                                rdf:type sp:bound ;
                                sp:arg1 [
                                    sp:varName "value1"^^xsd:string ;
                                  ] ;
                              ] ;
                            sp:arg2 [
                                sp:varName "value1"^^xsd:string ;
                              ] ;
                            sp:arg3 "MISSING" ;
                          ] ;
                        sp:variable [
                            sp:varName "object"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  ui:child [
                      rdf:type ui:else ;
                      ui:child [
                          rdf:type iess:ObjectWidgetRow ;
                          arg:uid [
                              sp:varName "uid"^^xsd:string ;
                            ] ;
                          ui:args "*"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:if ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "ies_missing_content"^^xsd:string ;
                          ui:child [
                              rdf:type html:A ;
                              html:href "javascript:"^^xsd:string ;
                              html:onclick [
                                  rdf:type ui:concat ;
                                  sp:arg1 "ies.openHelperDialog('Missing Value Helper',{ graph : '"^^xsd:string ;
                                  sp:arg2 [
                                      rdf:type ui:encodeNode ;
                                      sp:arg1 [
                                          sp:varName "graph"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  sp:arg3 "', ontologyGraph: '"^^xsd:string ;
                                  sp:arg4 [
                                      rdf:type ui:encodeNode ;
                                      sp:arg1 [
                                          sp:varName "ontologyGraph"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  sp:arg5 "', predicate: '"^^xsd:string ;
                                  sp:arg6 [
                                      rdf:type ui:encodeNode ;
                                      sp:arg1 [
                                          sp:varName "predicate"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  sp:arg7 "'});"^^xsd:string ;
                                ] ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Missing Value"^^xsd:string ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type html:Div ;
                              html:class "red-info-icon"^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:condition [
                          rdf:type sp:eq ;
                          sp:arg1 [
                              sp:varName "object"^^xsd:string ;
                            ] ;
                          sp:arg2 "MISSING" ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:queryGraph [
              rdf:type ui:graphWithImports ;
              sp:arg1 [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment """<ui:if ui:condition=\"{= ?object = &quot;MISSING&quot; }\">
                    <div class=\"ies_missing_content\" let:helpText=\"{= iess:constructJHelpTextForMissingValue(?graph, ?ontologyGraph, ?predicate) }\">
                        <div class=\"red-info-icon\"/>
                        <a href=\"javascript:\" onclick=\"ies.openHelperDialog('Missing Value Helper','{= ?helpText }');\">Missing Value</a>
                    </div>
                </ui:if>"""^^xsd:string ;
  rdfs:label "Object property value in specific graph with helper"^^xsd:string ;
  rdfs:subClassOf iess:Viewers ;
.
iess:ObjectViewer
  rdf:type swa:ObjectViewerClass ;
  ui:private "true"^^xsd:boolean ;
  ui:prototype [
      rdf:type html:Div ;
      html:class "ies-object-widget"^^xsd:string ;
      let:class [
          rdf:type swa:bestObjectViewerClass ;
          arg:object [
              sp:varName "object"^^xsd:string ;
            ] ;
          arg:predicate [
              sp:varName "predicate"^^xsd:string ;
            ] ;
          arg:subject [
              sp:varName "subject"^^xsd:string ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "[Error: no ObjectViewer found for "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text ", "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 3 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "predicate"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 4 ;
                  ui:text ", "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 5 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 6 ;
                  ui:text "]"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:dynamicView ;
              arg:object [
                  sp:varName "object"^^xsd:string ;
                ] ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "subject"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
              ui:class [
                  sp:varName "class"^^xsd:string ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "class"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A read-only widget displaying a single object."^^xsd:string ;
  rdfs:label "IES Object viewer"^^xsd:string ;
  rdfs:subClassOf swa:ObjectWidget ;
.
iess:ObjectViewerRow
  rdf:type swa:ObjectWidgetRowClass ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:group ;
      let:datatype [
          rdf:type sp:if ;
          sp:arg1 [
              rdf:type sp:isLiteral ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
            ] ;
          sp:arg2 [
              rdf:type sp:datatype ;
              sp:arg1 [
                  sp:varName "object"^^xsd:string ;
                ] ;
            ] ;
          sp:arg3 [
              sp:varName "no"^^xsd:string ;
            ] ;
        ] ;
      let:uid [
          rdf:type ui:uniqueId ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:about [
              rdf:type sp:if ;
              sp:arg1 [
                  rdf:type sp:isIRI ;
                  sp:arg1 [
                      sp:varName "subject"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  sp:varName "subject"^^xsd:string ;
                ] ;
              sp:arg3 [
                  sp:varName "noBNodes"^^xsd:string ;
                ] ;
            ] ;
          html:class "ies_widget_value_slot"^^xsd:string ;
          html:content [
              rdf:type sp:if ;
              sp:arg1 [
                  rdf:type sp:isLiteral ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  sp:varName "object"^^xsd:string ;
                ] ;
              sp:arg3 [
                  sp:varName "no"^^xsd:string ;
                ] ;
            ] ;
          html:datatype [
              sp:varName "datatype"^^xsd:string ;
            ] ;
          html:href [
              rdf:type sp:if ;
              sp:arg1 [
                  rdf:type sp:isIRI ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  sp:varName "object"^^xsd:string ;
                ] ;
              sp:arg3 [
                  sp:varName "no"^^xsd:string ;
                ] ;
            ] ;
          html:id [
              sp:varName "uid"^^xsd:string ;
            ] ;
          html:property [
              rdf:type sp:if ;
              sp:arg1 [
                  rdf:type sp:isLiteral ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type ui:encodeNode ;
                  sp:arg1 [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg3 [
                  sp:varName "no"^^xsd:string ;
                ] ;
            ] ;
          html:rel [
              rdf:type sp:if ;
              sp:arg1 [
                  rdf:type sp:isIRI ;
                  sp:arg1 [
                      sp:varName "object"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type ui:encodeNode ;
                  sp:arg1 [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg3 [
                  sp:varName "no"^^xsd:string ;
                ] ;
            ] ;
          ui:addNamespace [
              rdf:type sp:if ;
              sp:arg1 [
                  rdf:type swa:hasPrefix ;
                  arg:resource [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              sp:arg3 [
                  sp:varName "none"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type iess:ObjectViewer ;
              arg:uid [
                  sp:varName "uid"^^xsd:string ;
                ] ;
              ui:args "*"^^xsd:string ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "A row in an ObjectViewer."^^xsd:string ;
  rdfs:label "IES Object viewer row"^^xsd:string ;
  rdfs:subClassOf iess:ObjectWidgetRow ;
.
iess:ObjectWidgetRow
  rdf:type swa:ObjectWidgetRowClass ;
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:object ;
      rdfs:comment "The object node."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:dynamicView ;
      arg:object [
          sp:varName "object"^^xsd:string ;
        ] ;
      arg:predicate [
          sp:varName "predicate"^^xsd:string ;
        ] ;
      arg:subject [
          sp:varName "subject"^^xsd:string ;
        ] ;
      ui:class iess:ObjectViewerRow ;
    ] ;
  rdfs:comment "Superclass for the widget row types."^^xsd:string ;
  rdfs:label "IES Object widget row"^^xsd:string ;
  rdfs:subClassOf swa:ObjectElements ;
.
iess:Objects
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:function [
          rdf:type swa:modeProperty ;
          arg:predicate swa:isSingleFunction ;
        ] ;
      ui:child [
          rdf:type iess:LabeledObjects ;
          arg:single [
              rdf:type sp:if ;
              sp:arg1 [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "function"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 [
                  rdf:type spif:invoke ;
                  sp:arg1 [
                      sp:varName "function"^^xsd:string ;
                    ] ;
                  sp:arg2 [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  sp:arg3 [
                      sp:varName "subject"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg3 [
                  rdf:type swa:modeProperty ;
                  arg:predicate swa:isSingleConstant ;
                ] ;
            ] ;
          ui:args "*"^^xsd:string ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment "A two-columned structure with a label on the left and zero or more objects on the right."^^xsd:string ;
  rdfs:label "IES Objects"^^xsd:string ;
  rdfs:subClassOf swa:AbstractObject ;
.
iess:ObjectsBody
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:single ;
      spl:valueType xsd:boolean ;
      rdfs:comment "True to allow at most one value."^^xsd:string ;
    ] ;
  ui:private "false"^^xsd:boolean ;
  ui:prototype [
      rdf:type ui:dynamicView ;
      arg:predicate [
          sp:varName "predicate"^^xsd:string ;
        ] ;
      arg:single [
          sp:varName "single"^^xsd:string ;
        ] ;
      arg:subject [
          sp:varName "subject"^^xsd:string ;
        ] ;
      ui:class [
          rdf:type sp:coalesce ;
          sp:arg1 [
              rdf:type swa:modeProperty ;
              arg:predicate swa:objectsBodyClass ;
            ] ;
          sp:arg2 iess:SingleRowObjectsBody ;
        ] ;
    ] ;
  rdfs:comment "The body of an Object(s) widget, typically containing one row for each value. This can be \"overloaded\" via a mode property."^^xsd:string ;
  rdfs:label "IES Objects body"^^xsd:string ;
  rdfs:subClassOf swa:ObjectElements ;
.
iess:ObjectsGroup
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:optional "true"^^xsd:boolean ;
      spl:predicate arg:filterFunction ;
      spl:valueType spin:Function ;
      rdfs:comment "An optional filter function that takes a predicate and a subject as arguments and returns true for all predicates that should be displayed."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicates ;
      spl:valueType sp:Select ;
      rdfs:comment "A result set (e.g., SPARQL SELECT query) that delivers the predicates in this group."^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:subject ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The resource to display."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      letrs:rs [
          rdf:type sp:Select ;
          sp:resultVariables (
              [
                sp:varName "predicate"^^xsd:string ;
              ]
            ) ;
          sp:where (
              [
                sp:object [
                    sp:varName "predicates"^^xsd:string ;
                  ] ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object 0 ;
                sp:predicate rdf:first ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object () ;
                sp:predicate rdf:rest ;
                sp:subject [
                    sp:varName "?1"^^xsd:string ;
                  ] ;
              ]
              [
                sp:object [
                    sp:varName "predicate"^^xsd:string ;
                  ] ;
                sp:predicate spr:colCells ;
                sp:subject [
                    sp:varName "?0"^^xsd:string ;
                  ] ;
              ]
              [
                rdf:type sp:Filter ;
                sp:expression [
                    rdf:type sp:or ;
                    sp:arg1 [
                        rdf:type sp:not ;
                        sp:arg1 [
                            rdf:type sp:bound ;
                            sp:arg1 [
                                sp:varName "filterFunction"^^xsd:string ;
                              ] ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        rdf:type spif:invoke ;
                        sp:arg1 [
                            sp:varName "filterFunction"^^xsd:string ;
                          ] ;
                        sp:arg2 [
                            sp:varName "predicate"^^xsd:string ;
                          ] ;
                        sp:arg3 [
                            sp:varName "subject"^^xsd:string ;
                          ] ;
                      ] ;
                  ] ;
              ]
            ) ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:class "ies-objects-group"^^xsd:string ;
              ui:child [
                  rdf:type html:Table ;
                  html:class "docPropertiesTable"^^xsd:string ;
                  let:pid [
                      rdf:type ui:uniqueId ;
                    ] ;
                  ui:child [
                      rdf:type html:Tbody ;
                      ui:child [
                          rdf:type ui:forEach ;
                          ui:child [
                              rdf:type iess:Objects ;
                              arg:predicate [
                                  sp:varName "predicate"^^xsd:string ;
                                ] ;
                              arg:subject [
                                  sp:varName "subject"^^xsd:string ;
                                ] ;
                              arg:tabular "true"^^xsd:boolean ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                          ui:resultSet [
                              sp:varName "rs"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Thead ;
                      ui:child [
                          rdf:type html:Tr ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "docPropertiesTH"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Property"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "docPropertiesTH"^^xsd:string ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Value"^^xsd:string ;
                                ] ;
                              ui:childIndex 2 ;
                            ] ;
                          ui:child [
                              rdf:type html:Th ;
                              html:class "docPropertiesTH"^^xsd:string ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-subtitle"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text [
                              sp:varName "label"^^xsd:string ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:bound ;
                      sp:arg1 [
                          sp:varName "label"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:gt ;
              sp:arg1 [
                  rdf:type spr:rowCount ;
                  sp:arg1 [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                ] ;
              sp:arg2 0 ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "A group of iess:Objects elements where the predicates are computed by taking a result set (e.g. of all relevant properties) and applying a filter on top of it, e.g. to only show the annotation properties among those that are relevant."^^xsd:string ;
  rdfs:label "Objects group"^^xsd:string ;
  rdfs:subClassOf swa:ObjectGroupElements ;
.
iess:OntologyBrowserPage
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:ontology ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type swa:FullScreenBorderLayout ;
          arg:northSize 60 ;
          arg:southSize 100 ;
          arg:westSize 300 ;
          ui:child [
              rdf:type html:Div ;
              html:class "ui-layout-north"^^xsd:string ;
              ui:child [
                  rdf:type iess:BrowserHeader ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:class "ui-layout-south ies-border"^^xsd:string ;
              ui:childIndex 4 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:class "ui-layout-west ies-border"^^xsd:string ;
              ui:child [
                  rdf:type swa:Header ;
                  arg:label "Class Hierarchy"^^xsd:string ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:class "ui-layout-content"^^xsd:string ;
                  ui:child [
                      rdf:type swa:Tree ;
                      arg:cache "true"^^xsd:boolean ;
                      arg:dataProvider iess:ClassTreeDataProvider ;
                      arg:draggable "false"^^xsd:boolean ;
                      arg:id "mainTree"^^xsd:string ;
                      arg:onLoaded "ies.onTreeLoaded()"^^xsd:string ;
                      arg:onSelect "ies.setSelectedResourceFromTree(resource)"^^xsd:string ;
                      arg:root owl:Thing ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:Script ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "ies.setSelectedResource('"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 1 ;
                      ui:text [
                          sp:varName "selectedResource"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text "');"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 3 ;
              ui:condition [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "selectedResource"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:loadable ;
              html:class "ui-layout-center ies-border"^^xsd:string ;
              ui:cache [
                  rdf:type sp:not ;
                  sp:arg1 [
                      sp:varName "editable"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:else ;
                  ui:child [
                      rdf:type swa:Header ;
                      arg:label "No Concept Selected"^^xsd:string ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type swa:ViewForm ;
                      arg:editable "false"^^xsd:boolean ;
                      arg:resource [
                          sp:varName "resource"^^xsd:string ;
                        ] ;
                      arg:showFooter "false"^^xsd:boolean ;
                      arg:showResourceActions "false"^^xsd:boolean ;
                      arg:showURI "true"^^xsd:boolean ;
                      arg:viewModeName [
                          sp:varName "viewModeName"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:bound ;
                      sp:arg1 [
                          sp:varName "resource"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 2 ;
              ui:loadId "mainForm"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:queryGraph [
          rdf:type ui:graphWithImports ;
          sp:arg1 [
              sp:varName "ontology"^^xsd:string ;
            ] ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue iess:createOntologyViewerLink ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment """Test with:

http://localhost:8083/tbl/swp?_viewClass=iess:OntologyBrowserPage&ontology=%3Chttp://ies.topbraidlive.org/1.0/swa/iesconfig%3E"""^^xsd:string ;
  rdfs:label "Ontology Browser Page"^^xsd:string ;
  rdfs:subClassOf iess:Pages ;
.
iess:OntologyMetadata
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:ontology ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "The config instance."^^xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type ui:group ;
          default:labelWidth "350px"^^xsd:string ;
          default:subject [
              sp:varName "ontology"^^xsd:string ;
            ] ;
          default:tabular "true"^^xsd:boolean ;
          ui:child [
              rdf:type swa:ObjectsEnum ;
              arg:label "Ontology Metadata"^^xsd:string ;
              ui:child [
                  rdf:type iess:Object ;
                  arg:predicate vaem:dateCreated ;
                  ui:childIndex 3 ;
                ] ;
              ui:child [
                  rdf:type iess:Object ;
                  arg:predicate vaem:description ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type iess:Object ;
                  arg:predicate vaem:hasGraphRole ;
                  ui:childIndex 5 ;
                ] ;
              ui:child [
                  rdf:type iess:Object ;
                  arg:predicate vaem:lastUpdated ;
                  ui:childIndex 4 ;
                ] ;
              ui:child [
                  rdf:type iess:Object ;
                  arg:predicate vaem:name ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type iess:Object ;
                  arg:predicate vaem:releaseDate ;
                  ui:childIndex 6 ;
                ] ;
              ui:child [
                  rdf:type iess:Object ;
                  arg:predicate vaem:usesNonImportedResource ;
                  ui:childIndex 7 ;
                ] ;
              ui:child [
                  rdf:type iess:Object ;
                  arg:predicate vaem:withAttributionTo ;
                  ui:childIndex 8 ;
                ] ;
              ui:child [
                  rdf:type iess:Object ;
                  arg:predicate rdfs:label ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type iess:Object ;
                  arg:predicate owl:imports ;
                  ui:childIndex 9 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:queryGraph [
          rdf:type ui:graphWithImports ;
          sp:arg1 [
              sp:varName "ontology"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Ontology Metadata"^^xsd:string ;
  rdfs:subClassOf iess:Viewers ;
.
iess:OntologySourcesTab
  rdf:type ui:NodeClass ;
