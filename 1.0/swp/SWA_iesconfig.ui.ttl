                                  sp:object [
                                      sp:varName "gDesc"^^xsd:string ;
                                    ] ;
                                  sp:predicate vaem:description ;
                                  sp:subject [
                                      sp:varName "graph"^^xsd:string ;
                                    ] ;
                                ]
                              ) ;
                          ]
                          [
                            rdf:type sp:Bind ;
                            sp:expression [
                                rdf:type xsd:string ;
                                sp:arg1 [
                                    sp:varName "graph"^^xsd:string ;
                                  ] ;
                              ] ;
                            sp:variable [
                                sp:varName "gURI"^^xsd:string ;
                              ] ;
                          ]
                        ) ;
                      sp:graphNameNode [
                          sp:varName "graph"^^xsd:string ;
                        ] ;
                    ]
                  )
                ) ;
            ] ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type html:Div ;
                  ui:child [
                      rdf:type iess:BuildOntologiesInProjectTable ;
                      arg:project [
                          sp:varName "project"^^xsd:string ;
                        ] ;
                      ui:childIndex 2 ;
