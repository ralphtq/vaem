                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Table ;
                      html:class "docPropertiesTable"^^xsd:string ;
                      html:id "TBL_Ontology-Schemas"^^xsd:string ;
                      ui:child [
                          rdf:type html:Tbody ;
                          ui:child [
                              rdf:type ui:forEach ;
                              ui:child [
                                  rdf:type html:Div ;
                                  let:id [
                                      rdf:type iess:uniqueId ;
                                      arg:prefix "" ;
                                    ] ;
                                  ui:child [
                                      rdf:type html:Tr ;
                                      html:title [
                                          sp:varName "gDesc"^^xsd:string ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property ies_width_for_view_button"^^xsd:string ;
                                          ui:child [
                                              rdf:type ui:if ;
                                              ui:child [
                                                  rdf:type html:Button ;
                                                  html:onclick [
                                                      rdf:type ui:concat ;
                                                      sp:arg1 "ies.viewOntology('"^^xsd:string ;
                                                      sp:arg2 [
                                                          sp:varName "gAnnotationsGraph"^^xsd:string ;
                                                        ] ;
                                                      sp:arg3 "');"^^xsd:string ;
                                                    ] ;
                                                  ui:child [
                                                      rdf:type ui:TextNode ;
                                                      ui:childIndex 0 ;
                                                      ui:text "View"^^xsd:string ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:childIndex 0 ;
                                              ui:condition [
                                                  rdf:type sp:bound ;
                                                  sp:arg1 [
                                                      sp:varName "gAnnotationsGraph"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 2 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          html:id [
                                              rdf:type fn:concat ;
                                              sp:arg1 "TD-ONT_" ;
                                              sp:arg2 [
                                                  sp:varName "id"^^xsd:string ;
                                                ] ;
                                            ] ;
                                          ui:child [
                                              rdf:type ui:setContext ;
                                              ui:child [
                                                  rdf:type iess:ObjectWidgetRow ;
                                                  arg:object [
                                                      sp:varName "graph"^^xsd:string ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:childIndex 0 ;
                                              ui:queryGraph [
                                                  rdf:type ui:graphWithImports ;
                                                  sp:arg1 [
                                                      sp:varName "graph"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              ui:varName "createLinkFunction"^^xsd:string ;
                                              ui:varValue iess:createOntologyViewerLink ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          ui:child [
                                              rdf:type iess:ObjectWidgetRow ;
                                              arg:object [
                                                  sp:varName "gLastUpdated"^^xsd:string ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 4 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          ui:child [
                                              rdf:type iess:ObjectWidgetRow ;
                                              arg:object [
                                                  sp:varName "gRevision"^^xsd:string ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 3 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          ui:child [
                                              rdf:type iess:ObjectWidgetRow ;
                                              arg:object [
                                                  sp:varName "gURI"^^xsd:string ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 1 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          ui:child [
                                              rdf:type html:Div ;
                                              html:class "ies_widget_value_slot"^^xsd:string ;
                                              ui:child [
                                                  rdf:type html:Input ;
                                                  html:name [
                                                      rdf:type ui:concat ;
                                                      sp:arg1 [
                                                          rdf:type fn:concat ;
                                                          sp:arg1 "CB_" ;
                                                          sp:arg2 [
                                                              sp:varName "id"^^xsd:string ;
                                                            ] ;
                                                        ] ;
                                                      sp:arg2 " "^^xsd:string ;
                                                    ] ;
                                                  html:type "checkbox"^^xsd:string ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 5 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:resultSet [
                                  sp:varName "projectGraphs"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Thead ;
                          ui:child [
                              rdf:type html:Tr ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "Annotations that control the XSD generation"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "XSP Directives Graph"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 2 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "URI of the ontology graph"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Ontology Base URI"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Last Updated"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 4 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Revision"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 3 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Schema"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Selected"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 5 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:id "ies-all-ontology-graphs"^^xsd:string ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "padding:20px;"^^xsd:string ;
                  ui:child [
                      rdf:type html:Button ;
                      html:id "ies-all-graphs-button"^^xsd:string ;
                      html:onclick [
                          rdf:type ui:concat ;
                          sp:arg1 "ies.showAllGraphsInProject('"^^xsd:string ;
                          sp:arg2 [
                              sp:varName "project"^^xsd:string ;
                            ] ;
                          sp:arg3 "')"^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Show All Graphs"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      rdf:type spr:rowCount ;
                      sp:arg1 [
                          sp:varName "projectGraphs"^^xsd:string ;
                        ] ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Build Ontology Selections Table"^^xsd:string ;
  rdfs:subClassOf iess:Builders ;
.
iess:BuildProjectXSDs
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:project [
          rdf:type sp:Select ;
          sp:resultVariables (
              [
                sp:varName "project"^^xsd:string ;
              ]
            ) ;
          sp:where (
              [
                rdf:type sp:Bind ;
                sp:expression [
                    rdf:type iess:makeUserSessionResource ;
                    arg:prefix "OPRJ" ;
                    arg:resource "" ;
                  ] ;
                sp:variable [
                    sp:varName "projectURI"^^xsd:string ;
                  ] ;
              ]
              [
                rdf:type sp:Bind ;
                sp:expression [
                    rdf:type iess:getSessionGraph ;
                  ] ;
                sp:variable [
                    sp:varName "graph"^^xsd:string ;
                  ] ;
              ]
              (
                [
                  rdf:type sp:NamedGraph ;
                  sp:elements (
                      [
                        sp:object [
                            sp:varName "project"^^xsd:string ;
                          ] ;
                        sp:predicate vaem:name ;
                        sp:subject [
                            sp:varName "projectURI"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:graphNameNode [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                ]
              )
            ) ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:group ;
              letrs:files [
                  rdf:type sp:Select ;
                  sp:orderBy (
                      [
                        sp:varName "file"^^xsd:string ;
                      ]
                    ) ;
                  sp:resultVariables (
                      [
                        sp:varName "file"^^xsd:string ;
                      ]
                      [
                        sp:varName "field"^^xsd:string ;
                      ]
                    ) ;
                  sp:where (
                      [
                        sp:object [
                            sp:varName "project"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                        sp:predicate iess:getProjectXSDFiles ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "file"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      ui:child [
                          rdf:type html:Div ;
                          html:class "ies-subtitle"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Last XSD Files"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:P ;
                          html:class "ies_body"^^xsd:string ;
                          ui:child [
                              rdf:type html:B ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "Last Project:"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text "  "^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 2 ;
                              ui:text [
                                  sp:varName "project"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:child [
                          rdf:type html:P ;
                          html:class "ies_body"^^xsd:string ;
                          ui:child [
                              rdf:type html:B ;
                              ui:child [
                                  rdf:type ui:TextNode ;
                                  ui:childIndex 0 ;
                                  ui:text "User:"^^xsd:string ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 1 ;
                              ui:text " "^^xsd:string ;
                            ] ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 2 ;
                              ui:text [
                                  rdf:type iess:currentUser ;
                                ] ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Table ;
                          html:class "docPropertiesTable"^^xsd:string ;
                          ui:child [
                              rdf:type html:Tbody ;
                              ui:child [
                                  rdf:type html:Div ;
                                  ui:child [
                                      rdf:type ui:forEach ;
                                      ui:child [
                                          rdf:type html:Tr ;
                                          ui:child [
                                              rdf:type html:Td ;
                                              html:class "docPropertiesTD"^^xsd:string ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text [
                                                      sp:varName "file"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                      ui:resultSet [
                                          sp:varName "files"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 1 ;
                            ] ;
                          ui:child [
                              rdf:type html:Thead ;
                              ui:child [
                                  rdf:type html:Tr ;
                                  ui:child [
                                      rdf:type html:Th ;
                                      html:class "docPropertiesTH"^^xsd:string ;
                                      ui:child [
                                          rdf:type ui:TextNode ;
                                          ui:childIndex 0 ;
                                          ui:text "File Name"^^xsd:string ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 3 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "files"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "project"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Build Project XSDs"^^xsd:string ;
  rdfs:subClassOf iess:Builders ;
.
iess:BuildUserAdminDiv
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:user [
          rdf:type iess:currentUser ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "ies-subtitle"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "Administrator Actions"^^xsd:string ;
            ] ;
          ui:childIndex 2 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "ies-subtitle"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "User: "^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 1 ;
              ui:text [
                  sp:varName "user"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 2 ;
              ui:text " Session Actions"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "ies_control_panel"^^xsd:string ;
          ui:child [
              rdf:type html:Br ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:style "padding:10px;"^^xsd:string ;
              ui:child [
                  rdf:type html:Button ;
                  html:onclick "alert('To be implemented in future release');"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Execute Administrator Actions"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:child [
              rdf:type html:Input ;
              html:name "ies-user-admin-delete-xsds-cb"^^xsd:string ;
              html:type "checkbox"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Delete XSD Files"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:Input ;
              html:name "ies-user-admin-delete-zips-cb"^^xsd:string ;
              html:type "checkbox"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Delete ZIP Files"^^xsd:string ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:childIndex 3 ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          html:class "ies_control_panel"^^xsd:string ;
          ui:child [
              rdf:type html:Div ;
              html:style "padding:10px;"^^xsd:string ;
              ui:child [
                  rdf:type html:Button ;
                  html:onclick "alert('To be implemented soon');"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Execute User: "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 1 ;
                      ui:text [
                          sp:varName "user"^^xsd:string ;
                        ] ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 2 ;
                      ui:text " Actions"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:Input ;
              html:name "ies-user-admin-delete-jobs-cb"^^xsd:string ;
              html:type "checkbox"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "Delete User: "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text [
                      sp:varName "user"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text " Jobs"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Build User Admin Div"^^xsd:string ;
  rdfs:subClassOf iess:Builders ;
.
iess:BuildXSDGenerationConfigurationTab
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:config [
          rdf:type iess:getOntologyProjectConfiguration ;
          arg:graph [
              rdf:type iess:getSessionGraph ;
            ] ;
        ] ;
      ui:child [
          rdf:type html:Div ;
          ui:child [
              rdf:type ui:else ;
              ui:child [
                  rdf:type html:Div ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text """
No ontology project has been selected. To select one go to the 'projects tab'"""^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type html:Div ;
                  html:class "ies-subtitle"^^xsd:string ;
                  ui:child [
                      rdf:type html:A ;
                      html:onclick "ies.openHelpDialog('configuring-xsd-generator-div')"^^xsd:string ;
                      ui:child [
                          rdf:type html:Img ;
                          html:src [
                              rdf:type ui:concat ;
                              sp:arg1 [
                                  rdf:type ui:lib ;
                                ] ;
                              sp:arg2 "/ies/images/help_icon.png"^^xsd:string ;
                            ] ;
                          html:width "15px"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text """XSD Generation Configuration Settings
"""^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "border: 1px solid black"^^xsd:string ;
                  ui:child [
                      rdf:type ui:setContext ;
                      ui:child [
                          rdf:type iess:SaveSessionGraph ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type swa:SwitchableForm ;
                          arg:editable "true"^^xsd:boolean ;
                          arg:matchIds "form"^^xsd:string ;
                          arg:resource [
                              sp:varName "config"^^xsd:string ;
                            ] ;
                          arg:showURI "false"^^xsd:boolean ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                      ui:queryGraph [
                          rdf:type ui:graphWithImports ;
                          sp:arg1 [
                              rdf:type iess:getSessionGraph ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:bound ;
                  sp:arg1 [
                      sp:varName "config"^^xsd:string ;
                    ] ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment """Useful trace:

<iess:alert arg:message=\"Config is {= xsd:string(?config) }\"/>"""^^xsd:string ;
  rdfs:label "Build XSD Generation configuration tab"^^xsd:string ;
  rdfs:subClassOf iess:Builders ;
.
iess:BuildXSDGenerationOntologyValidationTab
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:config [
          rdf:type iess:getOntologyProjectConfiguration ;
          arg:graph [
              rdf:type iess:getSessionGraph ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:Div ;
              ui:child [
                  rdf:type html:P ;
                  html:class "ies_message"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "No ontology project selected. To select one go to the 'projects tab'"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text "p>"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:class "ies-subtitle"^^xsd:string ;
              ui:child [
                  rdf:type html:A ;
                  html:onclick "ies.openHelpDialog('validating-ontology-graphs-div')"^^xsd:string ;
                  ui:child [
                      rdf:type html:Img ;
                      html:src [
                          rdf:type ui:concat ;
                          sp:arg1 [
                              rdf:type ui:lib ;
                            ] ;
                          sp:arg2 "/ies/images/help_icon.png"^^xsd:string ;
                        ] ;
                      html:width "15px"^^xsd:string ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text """XSD Generation Directives
"""^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type html:P ;
              html:class "ies_body"^^xsd:string ;
              ui:child [
                  rdf:type html:I ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "missing value"^^xsd:string ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "If a "^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 2 ;
                  ui:text " is stated, click in the text to see which property needs to be specified for which ontology and in which graph."^^xsd:string ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type html:P ;
              html:class "ies_body"^^xsd:string ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text "The table that follows shows the directives that control the generation of XSD files."^^xsd:string ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              ui:child [
                  rdf:type html:Div ;
                  ui:child [
                      rdf:type iess:MissingPropertyValueHelper ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      rdf:type html:Div ;
                      html:style "padding:20px;"^^xsd:string ;
                      ui:child [
                          rdf:type html:A ;
                          html:onclick "ies.openHelpDialog('executing-owl-to-xsd-transformations-div')"^^xsd:string ;
                          ui:child [
                              rdf:type html:Img ;
                              html:src [
                                  rdf:type ui:concat ;
                                  sp:arg1 [
                                      rdf:type ui:lib ;
                                    ] ;
                                  sp:arg2 "/ies/images/help_icon.png"^^xsd:string ;
                                ] ;
                              html:width "15px"^^xsd:string ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Button ;
                          html:onclick "ies.generateXSDs();"^^xsd:string ;
                          ui:child [
                              rdf:type ui:TextNode ;
                              ui:childIndex 0 ;
                              ui:text "Generate XSDs"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:child [
                          rdf:type html:Div ;
                          html:id "ies-busy-with-xsd-generation"^^xsd:string ;
                          ui:childIndex 2 ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Table ;
                      html:class "docPropertiesTable"^^xsd:string ;
                      ui:child [
                          rdf:type html:Tbody ;
                          ui:child [
                              rdf:type ui:forEach ;
                              ui:child [
                                  rdf:type ui:setContext ;
                                  ui:child [
                                      rdf:type html:Tr ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          html:id [
                                              rdf:type fn:concat ;
                                              sp:arg1 "TD-ONT_" ;
                                              sp:arg2 [
                                                  sp:varName "id"^^xsd:string ;
                                                ] ;
                                            ] ;
                                          ui:child [
                                              rdf:type iess:ObjectViewer ;
                                              arg:object [
                                                  sp:varName "ontGraph"^^xsd:string ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          html:id [
                                              rdf:type fn:concat ;
                                              sp:arg1 "TD-XSP_" ;
                                              sp:arg2 [
                                                  sp:varName "id"^^xsd:string ;
                                                ] ;
                                            ] ;
                                          ui:child [
                                              rdf:type iess:ObjectViewer ;
                                              arg:object [
                                                  sp:varName "xspGraph"^^xsd:string ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 1 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          ui:child [
                                              rdf:type iess:ObjectPropertyValueInSpecificGraphWithHelper ;
                                              arg:graph [
                                                  sp:varName "xspGraph"^^xsd:string ;
                                                ] ;
                                              arg:ontologyGraph [
                                                  sp:varName "ontGraph"^^xsd:string ;
                                                ] ;
                                              arg:predicate vaem:namespace ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 6 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          ui:child [
                                              rdf:type iess:ObjectPropertyValueInSpecificGraphWithHelper ;
                                              arg:graph [
                                                  sp:varName "xspGraph"^^xsd:string ;
                                                ] ;
                                              arg:ontologyGraph [
                                                  sp:varName "ontGraph"^^xsd:string ;
                                                ] ;
                                              arg:predicate vaem:namespacePrefix ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 5 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          ui:child [
                                              rdf:type iess:ObjectPropertyValueInSpecificGraphWithHelper ;
                                              arg:graph [
                                                  sp:varName "xspGraph"^^xsd:string ;
                                                ] ;
                                              arg:ontologyGraph [
                                                  sp:varName "ontGraph"^^xsd:string ;
                                                ] ;
                                              arg:predicate <http://xspl.us/schema/xsp#targetNamespace> ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 7 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          ui:child [
                                              rdf:type iess:ObjectPropertyValueInSpecificGraphWithHelper ;
                                              arg:graph [
                                                  sp:varName "xspGraph"^^xsd:string ;
                                                ] ;
                                              arg:ontologyGraph [
                                                  sp:varName "ontGraph"^^xsd:string ;
                                                ] ;
                                              arg:predicate <http://xspl.us/schema/xsp#xsdFileName> ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 4 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          ui:child [
                                              rdf:type iess:ObjectPropertyValueInSpecificGraphWithHelper ;
                                              arg:graph [
                                                  sp:varName "xspGraph"^^xsd:string ;
                                                ] ;
                                              arg:ontologyGraph [
                                                  sp:varName "xspGraph"^^xsd:string ;
                                                ] ;
                                              arg:predicate vaem:revision ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 2 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Td ;
                                          html:class "td.ies_ont_property"^^xsd:string ;
                                          ui:child [
                                              rdf:type ui:TextNode ;
                                              ui:childIndex 0 ;
                                              ui:text [
                                                  rdf:type iess:getOntologyGraphProperty ;
                                                  arg:graph [
                                                      sp:varName "xspGraph"^^xsd:string ;
                                                    ] ;
                                                  arg:ontologyGraph [
                                                      sp:varName "xspGraph"^^xsd:string ;
                                                    ] ;
                                                  arg:property vaem:releaseDate ;
                                                ] ;
                                            ] ;
                                          ui:childIndex 3 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:queryGraph [
                                      rdf:type ui:graphWithImports ;
                                      sp:arg1 [
                                          sp:varName "xspGraph"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  ui:varName "createLinkFunction"^^xsd:string ;
                                  ui:varValue iess:createOntologyViewerLink ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:resultSet [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Thead ;
                          ui:child [
                              rdf:type html:Tr ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "Name of the XSD file"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Filename"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 4 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "Ontology graph"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Ontology Graph"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "Prefix for the XSD file's namespace"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Namespace Prefix"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 5 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "Release date of the metadata directives graph"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "XSP Release Date"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 3 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "Revision level of the metadata directives graph"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "XSP Revision"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 2 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "XSD Target namespace"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Target Namespace"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 7 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "XSD namespace string"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Namespace"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 6 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "XSP Directives Graph"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Directives Graph"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 3 ;
              ui:template iess:RetrieveGraphsForSelectedOntologies ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "config"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment """Useful trace:

<iess:alert arg:message=\"Config is {= xsd:string(?config) }\"/>"""^^xsd:string ;
  rdfs:label "Build XSD Generation Ontology Validation Tab"^^xsd:string ;
  rdfs:subClassOf iess:Builders ;
.
iess:BuildXSDGenerationSelectedOntologiesDiv
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      let:config [
          rdf:type iess:getOntologyProjectConfiguration ;
          arg:graph [
              rdf:type iess:getSessionGraph ;
            ] ;
        ] ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:Div ;
              ui:child [
                  rdf:type html:P ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "No ontology project selected. Select one on the 'projects tab'"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 1 ;
                  ui:text "p>"^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type html:Div ;
              html:class "ies-subtitle"^^xsd:string ;
              ui:child [
                  rdf:type html:A ;
                  html:href "#validating-ontology-graphs"^^xsd:string ;
                  ui:child [
                      rdf:type html:Img ;
                      html:src [
                          rdf:type ui:concat ;
                          sp:arg1 [
                              rdf:type ui:lib ;
                            ] ;
                          sp:arg2 "/ies/images/help_icon.png"^^xsd:string ;
                        ] ;
                      html:width "10px"^^xsd:string ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text """Validation of Selected Ontologies
    """^^xsd:string ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              ui:child [
                  rdf:type html:Div ;
                  ui:child [
                      rdf:type html:Table ;
                      html:class "docPropertiesTable"^^xsd:string ;
                      ui:child [
                          rdf:type html:Tbody ;
                          ui:child [
                              rdf:type ui:forEach ;
                              ui:child [
                                  rdf:type ui:setContext ;
                                  ui:child [
                                      rdf:type ui:group ;
                                      let:targetNamespace [
                                          rdf:type iess:getOntologyProperty ;
                                          arg:graph [
                                              sp:varName "ontGraph"^^xsd:string ;
                                            ] ;
                                          arg:property <http://xspl.us/schema/xsp#targetNamespace> ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Tr ;
                                          ui:child [
                                              rdf:type html:Td ;
                                              html:class "td.ies_ont_property"^^xsd:string ;
                                              html:id [
                                                  rdf:type fn:concat ;
                                                  sp:arg1 "TD-ONT_" ;
                                                  sp:arg2 [
                                                      sp:varName "id"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type iess:ObjectWidgetRow ;
                                                  arg:object [
                                                      sp:varName "ontGraph"^^xsd:string ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:child [
                                              rdf:type html:Td ;
                                              html:class "td.ies_ont_property"^^xsd:string ;
                                              html:id [
                                                  rdf:type fn:concat ;
                                                  sp:arg1 "TD-ONT_" ;
                                                  sp:arg2 [
                                                      sp:varName "id"^^xsd:string ;
                                                    ] ;
                                                ] ;
                                              ui:child [
                                                  rdf:type iess:ObjectWidgetRow ;
                                                  arg:object [
                                                      sp:varName "xspGraph"^^xsd:string ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:childIndex 1 ;
                                            ] ;
                                          ui:child [
                                              rdf:type html:Td ;
                                              html:class "td.ies_ont_property"^^xsd:string ;
                                              ui:child [
                                                  rdf:type iess:ObjectWidgetRow ;
                                                  arg:object [
                                                      sp:varName "ontGraphU"^^xsd:string ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:childIndex 2 ;
                                            ] ;
                                          ui:child [
                                              rdf:type html:Td ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text [
                                                      rdf:type iess:getOntologyGraphProperty ;
                                                      arg:graph [
                                                          sp:varName "xspGraph"^^xsd:string ;
                                                        ] ;
                                                      arg:ontologyGraph [
                                                          sp:varName "ontGraph"^^xsd:string ;
                                                        ] ;
                                                      arg:property vaem:namespace ;
                                                    ] ;
                                                ] ;
                                              ui:childIndex 3 ;
                                            ] ;
                                          ui:child [
                                              rdf:type html:Td ;
                                              ui:child [
                                                  rdf:type ui:TextNode ;
                                                  ui:childIndex 0 ;
                                                  ui:text [
                                                      rdf:type iess:getOntologyGraphProperty ;
                                                      arg:graph [
                                                          sp:varName "xspGraph"^^xsd:string ;
                                                        ] ;
                                                      arg:ontologyGraph [
                                                          sp:varName "ontGraph"^^xsd:string ;
                                                        ] ;
                                                      arg:property vaem:namespacePrefix ;
                                                    ] ;
                                                ] ;
                                              ui:childIndex 4 ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                  ui:queryGraph [
                                      rdf:type ui:graphWithImports ;
                                      sp:arg1 [
                                          sp:varName "xspGraph"^^xsd:string ;
                                        ] ;
                                    ] ;
                                  ui:varName "createLinkFunction"^^xsd:string ;
                                  ui:varValue iess:createOntologyViewerLink ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:resultSet [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Thead ;
                          ui:child [
                              rdf:type html:Tr ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "Ontology Graph"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Ontology Graph"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "URI of the ontology graph"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Base URI"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 2 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "XSD Target namespace"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Target Namespace"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 4 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "XSD namespace string"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Namespace"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 3 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  html:title "XSP Directives Graph"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "XSP Directives Graph"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
              ui:template iess:RetrieveGraphsForSelectedOntologies ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "config"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Build XSD Generation Selected Ontologies div"^^xsd:string ;
  rdfs:subClassOf iess:Builders ;
.
iess:Builders
  rdf:type ui:NodeClass ;
  ui:responseType ui:HTML ;
  rdfs:label "Builders"^^xsd:string ;
  rdfs:subClassOf iess:Handlers ;
.
iess:ClassInstances
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type ui:group ;
          let:count [
              rdf:type sp:Select ;
              sp:resultVariables (
                  [
                    sp:expression [
                        rdf:type sp:Count ;
                        sp:expression [
                            sp:varName "instance"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:varName "instanceCount"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "class"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:type ;
                    sp:subject [
                        sp:varName "instance"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type ui:if ;
              ui:child [
                  rdf:type iess:SubjectsBody ;
                  arg:object [
                      sp:varName "class"^^xsd:string ;
                    ] ;
                  arg:predicate rdf:type ;
                  arg:tabular "true"^^xsd:string ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:class "ies-subtitle"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "Instances"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
              ui:condition [
                  rdf:type sp:gt ;
                  sp:arg1 [
                      sp:varName "count"^^xsd:string ;
                    ] ;
                  sp:arg2 0 ;
                ] ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue iess:createLinkForMainForm ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Class Instances"^^xsd:string ;
  rdfs:subClassOf iess:Viewers ;
.
iess:ClassTreeDataProvider
  rdf:type swa:TreeDataProvider ;
  arg:treeChildrenTemplate swa:ClassTreeChildren ;
  arg:treePathTemplate swa:ClassTreePath ;
  arg:treeRootsTemplate swa:ClassTreeRoots ;
  rdfs:comment "A data provider for a class tree starting at rdfs:Resource."^^xsd:string ;
  rdfs:label "Class tree data provider"^^xsd:string ;
.
iess:ConfigXSDsGenerationTab
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Div ;
          html:id "xsd_generation_configuration"^^xsd:string ;
          ui:child [
              rdf:type html:Div ;
              html:style "border: 1px solid black"^^xsd:string ;
              let:config [
                  rdf:type iess:makeUserSessionResource ;
                  arg:prefix "CONFIG" ;
                  arg:resource "" ;
                ] ;
              ui:child [
                  rdf:type ui:setContext ;
                  ui:child [
                      rdf:type iess:SaveSessionGraph ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type swa:SwitchableForm ;
                      arg:editable "true"^^xsd:boolean ;
                      arg:matchIds "form"^^xsd:string ;
                      arg:resource [
                          sp:varName "config"^^xsd:string ;
                        ] ;
                      arg:showURI "false"^^xsd:boolean ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:queryGraph [
                      rdf:type ui:graphWithImports ;
                      sp:arg1 [
                          rdf:type iess:getSessionGraph ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Config XSDs Generation Tab"^^xsd:string ;
  rdfs:subClassOf iess:Tabs ;
.
iess:ConfirmSelectedOntologies
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:ontologyList ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:if ;
      ui:child [
          rdf:type html:Div ;
          html:class "ies-subtitle"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "Selected Ontologies"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:child [
          rdf:type ui:group ;
          let:sessionGraph [
              rdf:type iess:getSessionGraph ;
            ] ;
          letrs:indices [
              rdf:type sp:Select ;
              sp:resultVariables (
                  [
                    sp:varName "index"^^xsd:string ;
                  ]
                ) ;
              sp:where (
                  [
                    sp:object [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                    sp:predicate spif:split ;
                    sp:subject [
                        sp:varName "index"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "ontologyList"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object "," ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                ) ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              let:project [
                  rdf:type iess:getOntologyProjectName ;
                  arg:graph [
                      sp:varName "sessionGraph"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type iess:SaveSessionGraph ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:Div ;
                  html:style "padding:20px;"^^xsd:string ;
                  ui:child [
                      rdf:type html:A ;
                      html:onclick "ies.openHelpDialog('validating-ontology-graphs-div')"^^xsd:string ;
                      ui:child [
                          rdf:type html:Img ;
                          html:src [
                              rdf:type ui:concat ;
                              sp:arg1 [
                                  rdf:type ui:lib ;
                                ] ;
                              sp:arg2 "/ies/images/help_icon.png"^^xsd:string ;
                            ] ;
                          html:width "15px"^^xsd:string ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 2 ;
                    ] ;
                  ui:child [
                      rdf:type html:Button ;
                      html:onclick "ies.clearSelection('');"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Cancel"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type html:Button ;
                      html:onclick "ies.continueToOntologyValidation();"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Continue to Ontology Validation Checks"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 2 ;
                ] ;
              ui:child [
                  rdf:type ui:call ;
                  iess:relativeLocation [
                      sp:varName "project"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type html:Table ;
                      html:class "docPropertiesTable"^^xsd:string ;
                      ui:child [
                          rdf:type html:Tbody ;
                          ui:child [
                              rdf:type ui:forEach ;
                              ui:child [
                                  rdf:type html:Div ;
                                  let:gLabel [
                                      rdf:type spr:cell ;
                                      sp:arg1 [
                                          sp:varName "rs"^^xsd:string ;
                                        ] ;
                                      sp:arg2 [
                                          sp:varName "index"^^xsd:string ;
                                        ] ;
                                      sp:arg3 1 ;
                                    ] ;
                                  let:gURI [
                                      rdf:type spr:cell ;
                                      sp:arg1 [
                                          sp:varName "rs"^^xsd:string ;
                                        ] ;
                                      sp:arg2 [
                                          sp:varName "index"^^xsd:string ;
                                        ] ;
                                      sp:arg3 2 ;
                                    ] ;
                                  let:graph [
                                      rdf:type spr:cell ;
                                      sp:arg1 [
                                          sp:varName "rs"^^xsd:string ;
                                        ] ;
                                      sp:arg2 [
                                          sp:varName "index"^^xsd:string ;
                                        ] ;
                                      sp:arg3 0 ;
                                    ] ;
                                  ui:child [
                                      rdf:type ui:group ;
                                      let:xspGraph [
                                          rdf:type iess:getOntologyXSPGraph ;
                                          sp:arg1 [
                                              sp:varName "project"^^xsd:string ;
                                            ] ;
                                          sp:arg2 [
                                              sp:varName "graph"^^xsd:string ;
                                            ] ;
                                        ] ;
                                      ui:child [
                                          rdf:type iess:SetSelectedOntology ;
                                          arg:ontology [
                                              sp:varName "xspGraph"^^xsd:string ;
                                            ] ;
                                          ui:childIndex 0 ;
                                        ] ;
                                      ui:child [
                                          rdf:type html:Tr ;
                                          html:title [
                                              sp:varName "gDesc"^^xsd:string ;
                                            ] ;
                                          ui:child [
                                              rdf:type html:Td ;
                                              html:class "docPropertiesTD"^^xsd:string ;
                                              ui:child [
                                                  rdf:type iess:ObjectWidgetRow ;
                                                  arg:object [
                                                      sp:varName "gURI"^^xsd:string ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                ] ;
                                              ui:childIndex 1 ;
                                            ] ;
                                          ui:child [
                                              rdf:type html:Td ;
                                              html:class "docPropertiesTD"^^xsd:string ;
                                              ui:child [
                                                  rdf:type ui:setContext ;
                                                  ui:child [
                                                      rdf:type iess:ObjectWidgetRow ;
                                                      arg:object [
                                                          sp:varName "graph"^^xsd:string ;
                                                        ] ;
                                                      ui:childIndex 0 ;
                                                    ] ;
                                                  ui:childIndex 0 ;
                                                  ui:queryGraph [
                                                      rdf:type ui:graphWithImports ;
                                                      sp:arg1 [
                                                          sp:varName "graph"^^xsd:string ;
                                                        ] ;
                                                    ] ;
                                                  ui:varName "createLinkFunction"^^xsd:string ;
                                                  ui:varValue iess:createOntologyViewerLink ;
                                                ] ;
                                              ui:childIndex 0 ;
                                            ] ;
                                          ui:childIndex 1 ;
                                        ] ;
                                      ui:childIndex 0 ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                              ui:resultSet [
                                  sp:varName "indices"^^xsd:string ;
                                ] ;
                            ] ;
                          ui:childIndex 1 ;
                        ] ;
                      ui:child [
                          rdf:type html:Thead ;
                          ui:child [
                              rdf:type html:Tr ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Base URI"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 1 ;
                                ] ;
                              ui:child [
                                  rdf:type html:Th ;
                                  html:class "docPropertiesTH"^^xsd:string ;
                                  ui:child [
                                      rdf:type ui:TextNode ;
                                      ui:childIndex 0 ;
                                      ui:text "Schema"^^xsd:string ;
                                    ] ;
                                  ui:childIndex 0 ;
                                ] ;
                              ui:childIndex 0 ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:template iess:FindGraphs ;
                  vaem:hasGraphRole vaem:SchemaGraph ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:condition [
          rdf:type sp:bound ;
          sp:arg1 [
              sp:varName "ontologyList"^^xsd:string ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:comment "The ui:protoype makes use of 'Semantic Table'. See http://spinrdf.org/spr.html for documentation."^^xsd:string ;
  rdfs:label "Confirm Selected Ontologies"^^xsd:string ;
  rdfs:subClassOf iess:Confirmers ;
.
iess:Confirmers
  rdf:type ui:NodeClass ;
  ui:responseType ui:HTML ;
  rdfs:label "Confirmers"^^xsd:string ;
  rdfs:subClassOf iess:Handlers ;
.
iess:ContextHelp
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:loadable ;
          ui:childIndex 0 ;
          ui:loadId "ies-help-div"^^xsd:string ;
        ] ;
    ] ;
  rdfs:label "Context Help"^^xsd:string ;
  rdfs:subClassOf iess:Helpers ;
.
iess:CreateLinkFunctions
  rdf:type spin:Function ;
  rdfs:subClassOf swa:CreateLinkFunctions ;
.
iess:CreateXSD-GenerationJob
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:sourceOntology ;
      spl:valueType owl:Ontology ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:transaction ;
          ui:child [
              rdf:type ui:update ;
              ui:childIndex 0 ;
              ui:updateQuery [
                  rdf:type sp:Modify ;
                  sp:insertPattern (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              sp:object iess:XSD-GenerationJob ;
                              sp:predicate rdf:type ;
                              sp:subject [
                                  sp:varName "job"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "sourceOntology"^^xsd:string ;
                                ] ;
                              sp:predicate iess:sourceBaseURI ;
                              sp:subject [
                                  sp:varName "job"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "timeNow"^^xsd:string ;
                                ] ;
                              sp:predicate vaem:dateCreated ;
                              sp:subject [
                                  sp:varName "job"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:where (
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type iess:uniqueId ;
                            arg:prefix "JOB_" ;
                          ] ;
                        sp:variable [
                            sp:varName "job"^^xsd:string ;
                          ] ;
                      ]
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type afn:now ;
                          ] ;
                        sp:variable [
                            sp:varName "timeNow"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:logMessage [
              rdf:type ui:concat ;
              sp:arg1 "Create XSD Generation Job for "^^xsd:string ;
              sp:arg2 [
                  sp:varName "ontologySouce"^^xsd:string ;
                ] ;
              sp:arg3 " in Graph "^^xsd:string ;
              sp:arg4 [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:label "Create XSD Generation job"^^xsd:string ;
  rdfs:subClassOf iess:JobHandlers ;
.
iess:DefaultObjectsBody
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type ui:else ;
          ui:child [
              rdf:type html:Div ;
              html:class "swa-object-row"^^xsd:string ;
              ui:child [
                  rdf:type iess:ObjectWidgetRow ;
                  arg:predicate [
                      sp:varName "predicate"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 1 ;
        ] ;
      ui:child [
          rdf:type ui:if ;
          ui:child [
              rdf:type ui:call ;
              arg:predicate [
                  sp:varName "predicate"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "subject"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type ui:forEach ;
                  ui:child [
                      rdf:type iess:ObjectWidgetRow ;
                      arg:object [
                          sp:varName "object"^^xsd:string ;
                        ] ;
                      arg:predicate [
                          sp:varName "predicate"^^xsd:string ;
                        ] ;
                      arg:subject [
                          sp:varName "subject"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 1 ;
                  ui:resultSet [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "swa-object-row"^^xsd:string ;
                      ui:child [
                          rdf:type swa:ObjectWidgetRow ;
                          arg:predicate [
                              sp:varName "predicate"^^xsd:string ;
                            ] ;
                          arg:subject [
                              sp:varName "subject"^^xsd:string ;
                            ] ;
                          ui:childIndex 0 ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:and ;
                      sp:arg1 [
                          rdf:type sp:eq ;
                          sp:arg1 [
                              rdf:type spr:rowCount ;
                              sp:arg1 [
                                  sp:varName "rs"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:arg2 0 ;
                        ] ;
                      sp:arg2 [
                          rdf:type sp:not ;
                          sp:arg1 [
                              rdf:type swa:isViewMode ;
                            ] ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
              ui:template swa:SortedObjects ;
            ] ;
          ui:childIndex 0 ;
          ui:condition [
              rdf:type sp:bound ;
              sp:arg1 [
                  sp:varName "subject"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:comment "The default implementation of swa:ObjectsBody, containing one row for each value."^^xsd:string ;
  rdfs:label "Default objects body"^^xsd:string ;
  rdfs:subClassOf iess:ObjectsBody ;
.
iess:DeleteJobsForCurrentUserSession
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:project ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:graph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type ui:transaction ;
          ui:child [
              rdf:type ui:update ;
              ui:childIndex 0 ;
              ui:updateQuery [
                  rdf:type sp:Modify ;
                  sp:deletePattern (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              sp:object [
                                  sp:varName "jobU"^^xsd:string ;
                                ] ;
                              sp:predicate iess:hasJob ;
                              sp:subject [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "o"^^xsd:string ;
                                ] ;
                              sp:predicate [
                                  sp:varName "p"^^xsd:string ;
                                ] ;
                              sp:subject [
                                  sp:varName "jobU"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:where (
                      [
                        rdf:type sp:Bind ;
                        sp:expression [
                            rdf:type iess:getUserSession ;
                          ] ;
                        sp:variable [
                            sp:varName "session"^^xsd:string ;
                          ] ;
                      ]
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              sp:object [
                                  sp:varName "jobU"^^xsd:string ;
                                ] ;
                              sp:predicate iess:hasJob ;
                              sp:subject [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "o"^^xsd:string ;
                                ] ;
                              sp:predicate [
                                  sp:varName "p"^^xsd:string ;
                                ] ;
                              sp:subject [
                                  sp:varName "jobU"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:message [
              rdf:type ui:concat ;
              sp:arg1 "Clear Job for User Session in Graph "^^xsd:string ;
              sp:arg2 [
                  sp:varName "graph"^^xsd:string ;
                ] ;
              sp:arg3 " and Project "^^xsd:string ;
              sp:arg4 [
                  sp:varName "project"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Delete Jobs for current user session"^^xsd:string ;
  rdfs:subClassOf iess:UpdateHandlers ;
.
iess:DeleteSession
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:project ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      let:graph [
          rdf:type iess:getSessionGraph ;
        ] ;
      ui:child [
          rdf:type ui:transaction ;
          ui:child [
              rdf:type ui:update ;
              ui:childIndex 0 ;
              ui:updateQuery [
                  rdf:type sp:Modify ;
                  sp:deletePattern (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              sp:object [
                                  sp:varName "o1"^^xsd:string ;
                                ] ;
                              sp:predicate [
                                  sp:varName "p1"^^xsd:string ;
                                ] ;
                              sp:subject [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "o2"^^xsd:string ;
                                ] ;
                              sp:predicate [
                                  sp:varName "p2"^^xsd:string ;
                                ] ;
                              sp:subject [
                                  sp:varName "projectURI"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:where (
                      [
                        rdf:type sp:NamedGraph ;
                        sp:elements (
                            [
                              rdf:type sp:Bind ;
                              sp:expression [
                                  rdf:type iess:getUserSession ;
                                ] ;
                              sp:variable [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                            [
                              rdf:type sp:Bind ;
                              sp:expression [
                                  rdf:type iess:makeUserSessionResource ;
                                  arg:prefix "OPRJ" ;
                                  arg:resource "" ;
                                ] ;
                              sp:variable [
                                  sp:varName "projectURI"^^xsd:string ;
                                ] ;
                            ]
                            [
                              rdf:type sp:Bind ;
                              sp:expression [
                                  rdf:type iess:makeUserSessionResource ;
                                  arg:prefix "CONFIG" ;
                                  arg:resource "" ;
                                ] ;
                              sp:variable [
                                  sp:varName "config"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "o1"^^xsd:string ;
                                ] ;
                              sp:predicate [
                                  sp:varName "p1"^^xsd:string ;
                                ] ;
                              sp:subject [
                                  sp:varName "session"^^xsd:string ;
                                ] ;
                            ]
                            [
                              sp:object [
                                  sp:varName "o2"^^xsd:string ;
                                ] ;
                              sp:predicate [
                                  sp:varName "p2"^^xsd:string ;
                                ] ;
                              sp:subject [
                                  sp:varName "projectURI"^^xsd:string ;
                                ] ;
                            ]
                          ) ;
                        sp:graphNameNode [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
            ] ;
          ui:childIndex 0 ;
          ui:logMessage [
              rdf:type ui:concat ;
              sp:arg1 "Delete Session from Graph "^^xsd:string ;
              sp:arg2 [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ] ;
        ] ;
    ] ;
  rdfs:label "Delete Session"^^xsd:string ;
  rdfs:subClassOf iess:UpdateHandlers ;
.
iess:DetailedClassView
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:class ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type html:Div ;
          html:class "tuiView"^^xsd:string ;
          ui:child [
              rdf:type iess:ClassInstances ;
              arg:class [
                  sp:varName "class"^^xsd:string ;
                ] ;
              ui:childIndex 5 ;
            ] ;
          ui:child [
              rdf:type html:Div ;
              html:class "ies_resource_summary"^^xsd:string ;
              ui:child [
                  rdf:type html:P ;
                  html:class "ies_qname"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "QName = "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 1 ;
                      ui:text [
                          rdf:type ui:encodeNode ;
                          sp:arg1 [
                              sp:varName "class"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type iess:maybeDescription ;
                          arg:resource [
                              sp:varName "class"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:H2 ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "class"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:child [
              rdf:type ui:call ;
              arg:resource [
                  sp:varName "class"^^xsd:string ;
                ] ;
              arg:subject [
                  sp:varName "class"^^xsd:string ;
                ] ;
              ui:child [
                  rdf:type iess:ObjectsGroup ;
                  arg:filterFunction swa:isAnnotationProperty ;
                  arg:label "Annotations"^^xsd:string ;
                  arg:predicates [
                      sp:varName "rs"^^xsd:string ;
                    ] ;
                  arg:subject [
                      sp:varName "class"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:childIndex 4 ;
              ui:template [
                  rdf:type swa:modeProperty ;
                  arg:predicate swa:formObjectPredicateSelectionTemplate ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:group ;
              letrs:myPropertySet [
                  rdf:type sp:Select ;
                  sp:distinct "true"^^xsd:boolean ;
                  sp:orderBy (
                      [
                        rdf:type ui:label ;
                        sp:arg1 [
                            sp:varName "property"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:resultVariables (
                      [
                        sp:varName "property"^^xsd:string ;
                      ]
                      [
                        sp:varName "parent"^^xsd:string ;
                      ]
                    ) ;
                  sp:where (
                      [
                        sp:object [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                        sp:predicate iess:relevantPropertiesAtClassWithParent ;
                        sp:subject [
                            sp:varName "property"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "class"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "parent"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type iess:PropertiesTable ;
                      arg:class [
                          sp:varName "class"^^xsd:string ;
                        ] ;
                      arg:propertySet [
                          sp:varName "myPropertySet"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-subtitle"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Relevant Properties for "^^xsd:string ;
                        ] ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 1 ;
                          ui:text [
                              rdf:type ui:label ;
                              sp:arg1 [
                                  sp:varName "class"^^xsd:string ;
                                ] ;
                            ] ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "myPropertySet"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 2 ;
            ] ;
          ui:child [
              rdf:type ui:group ;
              letrs:superclasses [
                  rdf:type sp:Select ;
                  sp:distinct "true"^^xsd:boolean ;
                  sp:orderBy (
                      [
                        sp:varName "depth"^^xsd:string ;
                      ]
                      [
                        rdf:type ui:label ;
                        sp:arg1 [
                            sp:varName "super"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                  sp:resultVariables (
                      [
                        sp:varName "super"^^xsd:string ;
                      ]
                      [
                        sp:varName "depth"^^xsd:string ;
                      ]
                    ) ;
                  sp:where (
                      [
                        sp:object [
                            sp:varName "super"^^xsd:string ;
                          ] ;
                        sp:predicate iess:mySuperClass ;
                        sp:subject [
                            sp:varName "class"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "class"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "super"^^xsd:string ;
                          ] ;
                        sp:predicate rdf:first ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object () ;
                        sp:predicate rdf:rest ;
                        sp:subject [
                            sp:varName "?1"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "depth"^^xsd:string ;
                          ] ;
                        sp:predicate iess:inheritanceDepth ;
                        sp:subject [
                            sp:varName "?0"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ] ;
              ui:child [
                  rdf:type ui:if ;
                  ui:child [
                      rdf:type iess:InheritanceTable ;
                      arg:resourceSet [
                          sp:varName "superclasses"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:child [
                      rdf:type html:Canvas ;
                      html:height "2"^^xsd:string ;
                      html:id "InheritanceGraphCanvas"^^xsd:string ;
                      html:style "border:1px solid #40abd4; background-color: #40abd4;"^^xsd:string ;
                      html:width "750"^^xsd:string ;
                      ui:childIndex 3 ;
                    ] ;
                  ui:child [
                      rdf:type html:Div ;
                      html:class "ies-subtitle"^^xsd:string ;
                      ui:child [
                          rdf:type ui:TextNode ;
                          ui:childIndex 0 ;
                          ui:text "Inheritance Table"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type ui:CommentNode ;
                      ui:childIndex 2 ;
                      rdfs:comment "div class=\"ies-subtitle\">Inheritance Graph</div"^^xsd:string ;
                    ] ;
                  ui:childIndex 0 ;
                  ui:condition [
                      rdf:type sp:gt ;
                      sp:arg1 [
                          rdf:type spr:rowCount ;
                          sp:arg1 [
                              sp:varName "superclasses"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 0 ;
                    ] ;
                ] ;
              ui:childIndex 3 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:queryGraph [
          rdf:type ui:graphWithImports ;
          sp:arg1 [
              rdf:type iess:maybeConvertToURI ;
              sp:arg1 [
                  sp:varName "context"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue iess:createLinkForMainForm ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Detailed Class View"^^xsd:string ;
  rdfs:subClassOf iess:Viewers ;
.
iess:DetailedInstanceView
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:resource ;
      spl:valueType rdfs:Resource ;
    ] ;
  ui:prototype [
      rdf:type ui:setContext ;
      ui:child [
          rdf:type html:Div ;
          html:class "tuiView"^^xsd:string ;
          ui:child [
              rdf:type html:Div ;
              html:class "ies_resource_summary"^^xsd:string ;
              ui:child [
                  rdf:type html:P ;
                  html:class "ies_qname"^^xsd:string ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text "QName = "^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 1 ;
                      ui:text [
                          rdf:type ui:encodeNode ;
                          sp:arg1 [
                              sp:varName "resource"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 1 ;
                ] ;
              ui:child [
                  rdf:type html:P ;
                  ui:child [
                      rdf:type ui:TextNode ;
                      ui:childIndex 0 ;
                      ui:text [
                          rdf:type iess:maybeDescription ;
                          arg:resource [
                              sp:varName "resource"^^xsd:string ;
                            ] ;
                        ] ;
                    ] ;
                  ui:childIndex 0 ;
                ] ;
              ui:child [
                  rdf:type ui:call ;
                  arg:object [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type swa:SubjectsGroup ;
                      arg:label "Incoming References"^^xsd:string ;
                      arg:object [
                          sp:varName "resource"^^xsd:string ;
                        ] ;
                      arg:predicates [
                          sp:varName "rs"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:childIndex 3 ;
                  ui:template [
                      rdf:type swa:modeProperty ;
                      arg:predicate swa:formSubjectPredicateSelectionTemplate ;
                    ] ;
                ] ;
              ui:child [
                  rdf:type ui:call ;
                  arg:subject [
                      sp:varName "resource"^^xsd:string ;
                    ] ;
                  ui:child [
                      rdf:type iess:ObjectsGroup ;
                      arg:filterFunction swa:isAnnotationProperty ;
                      arg:label "Annotations"^^xsd:string ;
                      arg:predicates [
                          sp:varName "rs"^^xsd:string ;
                        ] ;
                      arg:subject [
                          sp:varName "resource"^^xsd:string ;
                        ] ;
                      ui:childIndex 0 ;
                    ] ;
                  ui:child [
                      rdf:type iess:ObjectsGroup ;
                      arg:filterFunction swa:isNonAnnotationProperty ;
                      arg:label "Properties"^^xsd:string ;
                      arg:predicates [
                          sp:varName "rs"^^xsd:string ;
                        ] ;
                      arg:subject [
                          sp:varName "resource"^^xsd:string ;
                        ] ;
                      ui:childIndex 1 ;
                    ] ;
                  ui:childIndex 2 ;
                  ui:template [
                      rdf:type swa:modeProperty ;
                      arg:predicate swa:formObjectPredicateSelectionTemplate ;
                    ] ;
                ] ;
              ui:childIndex 1 ;
            ] ;
          ui:child [
              rdf:type html:H2 ;
              ui:child [
                  rdf:type ui:TextNode ;
                  ui:childIndex 0 ;
                  ui:text [
                      rdf:type ui:label ;
                      sp:arg1 [
                          sp:varName "resource"^^xsd:string ;
                        ] ;
                    ] ;
                ] ;
              ui:childIndex 0 ;
            ] ;
          ui:childIndex 0 ;
        ] ;
      ui:queryGraph [
          rdf:type ui:graphWithImports ;
          sp:arg1 [
              rdf:type iess:maybeConvertToURI ;
              sp:arg1 [
                  sp:varName "context"^^xsd:string ;
                ] ;
            ] ;
        ] ;
      ui:varName "createLinkFunction"^^xsd:string ;
      ui:varValue iess:createLinkForMainForm ;
    ] ;
  ui:responseType ui:HTML ;
  rdfs:label "Detailed Instance View"^^xsd:string ;
  rdfs:subClassOf iess:Viewers ;
.
iess:DevTestsTab
  rdf:type ui:NodeClass ;
  ui:prototype [
      rdf:type ui:group ;
