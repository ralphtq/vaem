iess:absoluteFileNameForXSD-SchemasZIP
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "absoluteFileName"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:if ;
                sp:arg1 [
                    rdf:type smf:isTBL ;
                  ] ;
                sp:arg2 [
                    rdf:type iess:getSessionConfigurationPropertyValue ;
                    arg:property iess:serverURL ;
                  ] ;
                sp:arg3 "http://localhost:8083" ;
              ] ;
            sp:variable [
                sp:varName "serverURL"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 [
                    sp:varName "serverURL"^^xsd:string ;
                  ] ;
                sp:arg2 "{= ui:lib()}/ies/zips/" ;
                sp:arg3 [
                    rdf:type iess:getOntologyProjectName ;
                    arg:graph [
                        rdf:type iess:getSessionGraph ;
                      ] ;
                  ] ;
                sp:arg4 ".ZIP" ;
              ] ;
            sp:variable [
                sp:varName "absoluteFileName"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:label "absolute file name for XSD Schemas ZIP"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:alert
  rdf:type ui:NodeClass ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:message ;
      spl:valueType xsd:string ;
    ] ;
  ui:prototype [
      rdf:type ui:group ;
      ui:child [
          rdf:type html:Script ;
          html:type "text/javascript"^^xsd:string ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 0 ;
              ui:text "alert(\""^^xsd:string ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 1 ;
              ui:text [
                  sp:varName "message"^^xsd:string ;
                ] ;
            ] ;
          ui:child [
              rdf:type ui:TextNode ;
              ui:childIndex 2 ;
              ui:text "\");"^^xsd:string ;
            ] ;
          ui:childIndex 0 ;
        ] ;
    ] ;
  rdfs:comment """Example uses:

1)     Check that a table has content: <iess:alert arg:message=\"{= spr:rowCount(?rs) }\"/>"""^^xsd:string ;
  rdfs:label "alert"^^xsd:string ;
  rdfs:subClassOf iess:SubElements ;
.
iess:constructJHelpTextForMissingValue
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "text"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 "<p class=&quot;ies_body&quot;>Missing value for property " ;
                sp:arg2 [
                    rdf:type smf:qname ;
                    sp:arg1 [
                        sp:varName "predicate"^^xsd:string ;
                      ] ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "t1"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 " on ontology " ;
                sp:arg2 [
                    rdf:type smf:qname ;
                    sp:arg1 [
                        sp:varName "ontologyGraph"^^xsd:string ;
                      ] ;
                  ] ;
                sp:arg3 "</p>" ;
              ] ;
            sp:variable [
                sp:varName "t2"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 "<p class=&quot;ies_body&quot;>Add the property value to the graph " ;
                sp:arg2 [
                    rdf:type smf:qname ;
                    sp:arg1 [
                        sp:varName "graph"^^xsd:string ;
                      ] ;
                  ] ;
                sp:arg3 "</p>" ;
              ] ;
            sp:variable [
                sp:varName "t3"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 [
                    sp:varName "t1"^^xsd:string ;
                  ] ;
                sp:arg2 [
                    sp:varName "t2"^^xsd:string ;
                  ] ;
                sp:arg3 [
                    sp:varName "t3"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "text"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:ontologyGraph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:predicate ;
      spl:valueType rdf:Property ;
    ] ;
  rdfs:label "construct help text for missing value"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:constructJobTrace
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "text"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:getSessionGraph ;
              ] ;
            sp:variable [
                sp:varName "sessionGraph"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:getUserSession ;
              ] ;
            sp:variable [
                sp:varName "userSession"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type afn:localname ;
                sp:arg1 [
                    sp:varName "userSession"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "sessionName"^^xsd:string ;
              ] ;
          ]
          (
            [
              rdf:type sp:NamedGraph ;
              sp:elements (
                  [
                    sp:object [
                        sp:varName "project"^^xsd:string ;
                      ] ;
                    sp:predicate iess:requires ;
                    sp:subject [
                        sp:varName "userSession"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        rdf:type afn:localname ;
                        sp:arg1 [
                            sp:varName "project"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:variable [
                        sp:varName "projectName"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Optional ;
                    sp:elements (
                        [
                          sp:object [
                              sp:varName "job"^^xsd:string ;
                            ] ;
                          sp:predicate iess:hasJob ;
                          sp:subject [
                              sp:varName "userSession"^^xsd:string ;
                            ] ;
                        ]
                        [
                          rdf:type sp:Bind ;
                          sp:expression [
                              rdf:type afn:localname ;
                              sp:arg1 [
                                  sp:varName "job"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:variable [
                              sp:varName "jobName"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                  ]
                ) ;
              sp:graphNameNode [
                  sp:varName "sessionGraph"^^xsd:string ;
                ] ;
            ]
          )
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 "Session= " ;
                sp:arg2 [
                    sp:varName "sessionName"^^xsd:string ;
                  ] ;
                sp:arg3 " , project = " ;
                sp:arg4 [
                    sp:varName "projectName"^^xsd:string ;
                  ] ;
                sp:arg5 ", job =" ;
                sp:arg6 [
                    sp:varName "jobName"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "text"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:label "construct job trace"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:constructZipFileNameForXSD-Schemas
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "absoluteFileName"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:getAbsoluteFilePathForConfigurationPropertyValue ;
                sp:arg1 iess:xsdFilesPath ;
              ] ;
            sp:variable [
                sp:varName "absoluteFilePath"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 "/" ;
                sp:arg2 [
                    sp:varName "absoluteFilePath"^^xsd:string ;
                  ] ;
                sp:arg3 [
                    rdf:type iess:getOntologyProjectName ;
                    arg:graph [
                        rdf:type iess:getSessionGraph ;
                      ] ;
                  ] ;
                sp:arg4 ".ZIP" ;
              ] ;
            sp:variable [
                sp:varName "absoluteFileName"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:label "construct zip file name for XSD-Schemas"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:createLink
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "link"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type ui:currentQueryGraph ;
              ] ;
            sp:variable [
                sp:varName "baseURI"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 "ies.navigateToInTab('" ;
                sp:arg2 [
                    rdf:type xsd:string ;
                    sp:arg1 [
                        sp:varName "resource"^^xsd:string ;
                      ] ;
                  ] ;
                sp:arg3 "', '" ;
                sp:arg4 [
                    rdf:type xsd:string ;
                    sp:arg1 [
                        sp:varName "baseURI"^^xsd:string ;
                      ] ;
                  ] ;
                sp:arg5 "', 'ies-window')" ;
              ] ;
            sp:variable [
                sp:varName "link"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:comment "The IES CreateLinkFunction - it simply navigates to the resource with a call of the SWP servlet."^^xsd:string ;
  rdfs:label "create link (IES)"^^xsd:string ;
  rdfs:subClassOf iess:CreateLinkFunctions ;
.
iess:createLinkForMainForm
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "link"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 "ies.showResourceInMainForm('" ;
                sp:arg2 [
                    sp:varName "resource"^^xsd:string ;
                  ] ;
                sp:arg3 "')" ;
              ] ;
            sp:variable [
                sp:varName "link"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:comment "Create a link to view resource in the main form."^^xsd:string ;
  rdfs:label "create link (IES)"^^xsd:string ;
  rdfs:subClassOf iess:CreateLinkFunctions ;
.
iess:createOntologyViewerLink
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "link"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 "ies.viewOntology('" ;
                sp:arg2 [
                    rdf:type xsd:string ;
                    sp:arg1 [
                        sp:varName "resource"^^xsd:string ;
                      ] ;
                  ] ;
                sp:arg3 "', 'ies-window')" ;
              ] ;
            sp:variable [
                sp:varName "link"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:comment "The IES CreateLinkFunction - it simply navigates to the resource with a call of the SWP servlet."^^xsd:string ;
  rdfs:label "create ontology viewer link"^^xsd:string ;
  rdfs:subClassOf iess:CreateLinkFunctions ;
.
iess:currentUser
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "user"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:currentUserName ;
              ] ;
            sp:variable [
                sp:varName "n1"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:if ;
                sp:arg1 [
                    rdf:type sp:or ;
                    sp:arg1 [
                        rdf:type sp:not ;
                        sp:arg1 [
                            rdf:type sp:bound ;
                            sp:arg1 [
                                sp:varName "n1"^^xsd:string ;
                              ] ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        rdf:type sp:eq ;
                        sp:arg1 [
                            sp:varName "n1"^^xsd:string ;
                          ] ;
                        sp:arg2 "" ;
                      ] ;
                  ] ;
                sp:arg2 "tbcme" ;
                sp:arg3 [
                    sp:varName "n1"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "user"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:label "current user"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:findAnnotationsGraph
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "graph"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object [
                sp:varName "?0"^^xsd:string ;
              ] ;
            sp:predicate tops:files ;
            sp:subject [
                sp:varName "file"^^xsd:string ;
              ] ;
          ]
          [
            sp:object spin:_arg1 ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object "true"^^xsd:boolean ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?2"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object "true"^^xsd:boolean ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:baseURI ;
                sp:arg1 [
                    sp:varName "file"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type xsd:string ;
                sp:arg1 [
                    sp:varName "graph"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "uri"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:and ;
                sp:arg1 [
                    rdf:type sp:and ;
                    sp:arg1 [
                        rdf:type sp:bound ;
                        sp:arg1 [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ] ;
                    sp:arg2 [
                        rdf:type sp:not ;
                        sp:arg1 [
                            rdf:type fn:starts-with ;
                            sp:arg1 [
                                sp:varName "uri"^^xsd:string ;
                              ] ;
                            sp:arg2 "file:" ;
                          ] ;
                      ] ;
                  ] ;
                sp:arg2 [
                    rdf:type sp:not ;
                    sp:arg1 [
                        rdf:type fn:ends-with ;
                        sp:arg1 [
                            sp:varName "uri"^^xsd:string ;
                          ] ;
                        sp:arg2 ".tch" ;
                      ] ;
                  ] ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type iess:isXSPforOntology ;
                arg:graph [
                    sp:varName "graph"^^xsd:string ;
                  ] ;
                arg:ontology spin:_arg2 ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "project path"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdfs:Resource ;
    ] ;
  rdfs:label "find annotations graph"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:findGraphUsingXSP
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            sp:varName "graph"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "graph"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object <http://xspl.us/1.1/schema/xsp> ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object spin:_arg1 ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "graph"^^xsd:string ;
              ] ;
            sp:predicate iess:findGraphWithImport ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "project path"^^xsd:string ;
    ] ;
  rdfs:label "find graph using XSP"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:findGraphWithImport
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            sp:varName "graph"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "graph"^^xsd:string ;
          ]
        ) ;
      sp:where (
          (
            [
              sp:object [
                  sp:varName "?0"^^xsd:string ;
                ] ;
              sp:predicate tops:files ;
              sp:subject [
                  sp:varName "file"^^xsd:string ;
                ] ;
            ]
            [
              sp:object spin:_arg2 ;
              sp:predicate rdf:first ;
              sp:subject [
                  sp:varName "?0"^^xsd:string ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "?1"^^xsd:string ;
                ] ;
              sp:predicate rdf:rest ;
              sp:subject [
                  sp:varName "?0"^^xsd:string ;
                ] ;
            ]
            [
              sp:object "true"^^xsd:boolean ;
              sp:predicate rdf:first ;
              sp:subject [
                  sp:varName "?1"^^xsd:string ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "?2"^^xsd:string ;
                ] ;
              sp:predicate rdf:rest ;
              sp:subject [
                  sp:varName "?1"^^xsd:string ;
                ] ;
            ]
            [
              sp:object "true"^^xsd:boolean ;
              sp:predicate rdf:first ;
              sp:subject [
                  sp:varName "?2"^^xsd:string ;
                ] ;
            ]
            [
              sp:object () ;
              sp:predicate rdf:rest ;
              sp:subject [
                  sp:varName "?2"^^xsd:string ;
                ] ;
            ]
            [
              rdf:type sp:Bind ;
              sp:expression [
                  rdf:type smf:baseURI ;
                  sp:arg1 [
                      sp:varName "file"^^xsd:string ;
                    ] ;
                ] ;
              sp:variable [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ]
            [
              rdf:type sp:Bind ;
              sp:expression [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                ] ;
              sp:variable [
                  sp:varName "uri"^^xsd:string ;
                ] ;
            ]
            [
              rdf:type sp:Filter ;
              sp:expression [
                  rdf:type sp:and ;
                  sp:arg1 [
                      rdf:type sp:and ;
                      sp:arg1 [
                          rdf:type sp:bound ;
                          sp:arg1 [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          rdf:type sp:not ;
                          sp:arg1 [
                              rdf:type fn:starts-with ;
                              sp:arg1 [
                                  sp:varName "uri"^^xsd:string ;
                                ] ;
                              sp:arg2 "file:" ;
                            ] ;
                        ] ;
                    ] ;
                  sp:arg2 [
                      rdf:type sp:not ;
                      sp:arg1 [
                          rdf:type fn:ends-with ;
                          sp:arg1 [
                              sp:varName "uri"^^xsd:string ;
                            ] ;
                          sp:arg2 ".tch" ;
                        ] ;
                    ] ;
                ] ;
            ]
          )
          (
            [
              rdf:type sp:NamedGraph ;
              sp:elements (
                  [
                    rdf:type sp:Exists ;
                    sp:elements (
                        [
                          sp:object spin:_arg1 ;
                          sp:predicate owl:imports ;
                          sp:subject [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                  ]
                ) ;
              sp:graphNameNode [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ]
          )
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType xsd:string ;
      rdfs:comment "project path"^^xsd:string ;
    ] ;
  rdfs:label "find graph with import"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:findGraphsInProject
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            sp:varName "graph"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "file"^^xsd:string ;
          ]
          [
            sp:varName "graph"^^xsd:string ;
          ]
        ) ;
      sp:where (
          (
            [
              rdf:type sp:Bind ;
              sp:expression [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      rdf:type fn:concat ;
                      sp:arg1 "/" ;
                      sp:arg2 spin:_arg1 ;
                    ] ;
                ] ;
              sp:variable [
                  sp:varName "workspacePath"^^xsd:string ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "?0"^^xsd:string ;
                ] ;
              sp:predicate tops:files ;
              sp:subject [
                  sp:varName "file"^^xsd:string ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "workspacePath"^^xsd:string ;
                ] ;
              sp:predicate rdf:first ;
              sp:subject [
                  sp:varName "?0"^^xsd:string ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "?1"^^xsd:string ;
                ] ;
              sp:predicate rdf:rest ;
              sp:subject [
                  sp:varName "?0"^^xsd:string ;
                ] ;
            ]
            [
              sp:object "true"^^xsd:boolean ;
              sp:predicate rdf:first ;
              sp:subject [
                  sp:varName "?1"^^xsd:string ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "?2"^^xsd:string ;
                ] ;
              sp:predicate rdf:rest ;
              sp:subject [
                  sp:varName "?1"^^xsd:string ;
                ] ;
            ]
            [
              sp:object "true"^^xsd:boolean ;
              sp:predicate rdf:first ;
              sp:subject [
                  sp:varName "?2"^^xsd:string ;
                ] ;
            ]
            [
              sp:object () ;
              sp:predicate rdf:rest ;
              sp:subject [
                  sp:varName "?2"^^xsd:string ;
                ] ;
            ]
            [
              rdf:type sp:Bind ;
              sp:expression [
                  rdf:type smf:baseURI ;
                  sp:arg1 [
                      sp:varName "file"^^xsd:string ;
                    ] ;
                ] ;
              sp:variable [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ]
            [
              rdf:type sp:Bind ;
              sp:expression [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                ] ;
              sp:variable [
                  sp:varName "uri"^^xsd:string ;
                ] ;
            ]
            [
              rdf:type sp:Filter ;
              sp:expression [
                  rdf:type sp:and ;
                  sp:arg1 [
                      rdf:type sp:and ;
                      sp:arg1 [
                          rdf:type sp:bound ;
                          sp:arg1 [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          rdf:type sp:not ;
                          sp:arg1 [
                              rdf:type fn:starts-with ;
                              sp:arg1 [
                                  sp:varName "uri"^^xsd:string ;
                                ] ;
                              sp:arg2 "file:" ;
                            ] ;
                        ] ;
                    ] ;
                  sp:arg2 [
                      rdf:type sp:not ;
                      sp:arg1 [
                          rdf:type fn:ends-with ;
                          sp:arg1 [
                              sp:varName "uri"^^xsd:string ;
                            ] ;
                          sp:arg2 ".tch" ;
                        ] ;
                    ] ;
                ] ;
            ]
          )
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "project path"^^xsd:string ;
    ] ;
  rdfs:label "find graphs in a project"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:findGraphsWithRole
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            sp:varName "graph"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "ontGraph"^^xsd:string ;
          ]
        ) ;
      sp:where (
          (
            [
              rdf:type sp:Bind ;
              sp:expression [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      rdf:type fn:concat ;
                      sp:arg1 "/" ;
                      sp:arg2 spin:_arg1 ;
                    ] ;
                ] ;
              sp:variable [
                  sp:varName "workspacePath"^^xsd:string ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "?0"^^xsd:string ;
                ] ;
              sp:predicate tops:files ;
              sp:subject [
                  sp:varName "file"^^xsd:string ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "workspacePath"^^xsd:string ;
                ] ;
              sp:predicate rdf:first ;
              sp:subject [
                  sp:varName "?0"^^xsd:string ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "?1"^^xsd:string ;
                ] ;
              sp:predicate rdf:rest ;
              sp:subject [
                  sp:varName "?0"^^xsd:string ;
                ] ;
            ]
            [
              sp:object "true"^^xsd:boolean ;
              sp:predicate rdf:first ;
              sp:subject [
                  sp:varName "?1"^^xsd:string ;
                ] ;
            ]
            [
              sp:object [
                  sp:varName "?2"^^xsd:string ;
                ] ;
              sp:predicate rdf:rest ;
              sp:subject [
                  sp:varName "?1"^^xsd:string ;
                ] ;
            ]
            [
              sp:object "true"^^xsd:boolean ;
              sp:predicate rdf:first ;
              sp:subject [
                  sp:varName "?2"^^xsd:string ;
                ] ;
            ]
            [
              sp:object () ;
              sp:predicate rdf:rest ;
              sp:subject [
                  sp:varName "?2"^^xsd:string ;
                ] ;
            ]
            [
              rdf:type sp:Bind ;
              sp:expression [
                  rdf:type smf:baseURI ;
                  sp:arg1 [
                      sp:varName "file"^^xsd:string ;
                    ] ;
                ] ;
              sp:variable [
                  sp:varName "graph"^^xsd:string ;
                ] ;
            ]
            [
              rdf:type sp:Bind ;
              sp:expression [
                  rdf:type xsd:string ;
                  sp:arg1 [
                      sp:varName "graph"^^xsd:string ;
                    ] ;
                ] ;
              sp:variable [
                  sp:varName "uri"^^xsd:string ;
                ] ;
            ]
            [
              rdf:type sp:Filter ;
              sp:expression [
                  rdf:type sp:and ;
                  sp:arg1 [
                      rdf:type sp:and ;
                      sp:arg1 [
                          rdf:type sp:bound ;
                          sp:arg1 [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          rdf:type sp:not ;
                          sp:arg1 [
                              rdf:type fn:starts-with ;
                              sp:arg1 [
                                  sp:varName "uri"^^xsd:string ;
                                ] ;
                              sp:arg2 "file:" ;
                            ] ;
                        ] ;
                    ] ;
                  sp:arg2 [
                      rdf:type sp:not ;
                      sp:arg1 [
                          rdf:type fn:ends-with ;
                          sp:arg1 [
                              sp:varName "uri"^^xsd:string ;
                            ] ;
                          sp:arg2 ".tch" ;
                        ] ;
                    ] ;
                ] ;
            ]
          )
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    rdf:type sp:NamedGraph ;
                    sp:elements (
                        [
                          sp:object spin:_arg2 ;
                          sp:predicate vaem:hasGraphRole ;
                          sp:subject [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ]
                        [
                          rdf:type sp:Bind ;
                          sp:expression [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                          sp:variable [
                              sp:varName "ontGraph"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                    sp:graphNameNode [
                        sp:varName "graph"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    rdf:type sp:NamedGraph ;
                    sp:elements (
                        [
                          sp:object vaem:AnnotationsGraph ;
                          sp:predicate vaem:hasGraphRole ;
                          sp:subject [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ]
                        [
                          sp:object [
                              sp:varName "ontGraph"^^xsd:string ;
                            ] ;
                          sp:predicate <http://xspl.us/schema/xsp#annotatesGraph> ;
                          sp:subject [
                              sp:varName "graph"^^xsd:string ;
                            ] ;
                        ]
                        [
                          sp:object spin:_arg2 ;
                          sp:predicate vaem:hasGraphRole ;
                          sp:subject [
                              sp:varName "ontGraph"^^xsd:string ;
                            ] ;
                        ]
                      ) ;
                    sp:graphNameNode [
                        sp:varName "graph"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "project path"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "graph role"^^xsd:string ;
    ] ;
  rdfs:label "find graphs with role"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:getAbsoluteFilePath
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "ap"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:getWorkspaceFilePath ;
                sp:arg1 "../" ;
                sp:arg2 spin:_arg1 ;
                sp:arg3 spin:_arg2 ;
              ] ;
            sp:variable [
                sp:varName "rp"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:workspacePath ;
              ] ;
            sp:variable [
                sp:varName "wsp"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type fn:concat ;
                sp:arg1 [
                    sp:varName "wsp"^^xsd:string ;
                  ] ;
                sp:arg2 [
                    sp:varName "rp"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "ap"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "project name"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType xsd:string ;
      rdfs:comment "relative path to folder in project"^^xsd:string ;
    ] ;
  rdfs:label "get absolute file path"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getAbsoluteFilePathForConfigurationPropertyValue
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "absolutePath"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:getSessionConfigurationPropertyValue ;
                arg:property spin:_arg1 ;
              ] ;
            sp:variable [
                sp:varName "projectRelativePath"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:getOntologyProjectName ;
                arg:graph [
                    rdf:type iess:getSessionGraph ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "project"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:getWorkspaceFilePath ;
                sp:arg1 "../" ;
                sp:arg2 [
                    sp:varName "project"^^xsd:string ;
                  ] ;
                sp:arg3 [
                    sp:varName "projectRelativePath"^^xsd:string ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "workspaceRelativePath"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type smf:workspacePath ;
              ] ;
            sp:variable [
                sp:varName "workspacePath"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type xsd:string ;
                sp:arg1 [
                    rdf:type fn:concat ;
                    sp:arg1 [
                        sp:varName "workspacePath"^^xsd:string ;
                      ] ;
                    sp:arg2 [
                        sp:varName "workspaceRelativePath"^^xsd:string ;
                      ] ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "absolutePath"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdf:Property ;
      rdfs:comment "configuration property"^^xsd:string ;
    ] ;
  rdfs:label "get absolute file path for configuraion property value"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getOntologyFromSessionXSP-Graph
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "ontGraph"^^xsd:string ;
          ]
          [
            sp:varName "xspGraph"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:getSessionGraph ;
              ] ;
            sp:variable [
                sp:varName "sessionGraph"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:getUserSession ;
              ] ;
            sp:variable [
                sp:varName "session"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "ontProject"^^xsd:string ;
                    ] ;
                  sp:predicate iess:requires ;
                  sp:subject [
                      sp:varName "session"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "xspGraph"^^xsd:string ;
                    ] ;
                  sp:predicate iess:hasSelectedXSPGraph ;
                  sp:subject [
                      sp:varName "ontProject"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "sessionGraph"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  sp:object [
                      sp:varName "ontGraph"^^xsd:string ;
                    ] ;
                  sp:predicate <http://xspl.us/schema/xsp#annotatesGraph> ;
                  sp:subject [
                      sp:varName "xspGraph"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "xspGraph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:label "get ontology from session XSP graph"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:getOntologyGraphProperty
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "value"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  rdf:type sp:Optional ;
                  sp:elements (
                      [
                        sp:object [
                            sp:varName "value1"^^xsd:string ;
                          ] ;
                        sp:predicate [
                            sp:varName "property"^^xsd:string ;
                          ] ;
                        sp:subject [
                            sp:varName "ontologyGraph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ]
                [
                  rdf:type sp:Bind ;
                  sp:expression [
                      rdf:type sp:if ;
                      sp:arg1 [
                          rdf:type sp:bound ;
                          sp:arg1 [
                              sp:varName "value1"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          sp:varName "value1"^^xsd:string ;
                        ] ;
                      sp:arg3 "MISSING" ;
                    ] ;
                  sp:variable [
                      sp:varName "value"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:ontologyGraph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdf:Property ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:comment "Returns value for a property, arg:property, on the ontology graph arg:ontologyGraph. The property may be defined either on the annotation graph, passed as arg:graph, or the graph that is annotated."^^xsd:string ;
  rdfs:label "get ontology graph property"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getOntologyProject
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "ontologyProject"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  rdf:type sp:Bind ;
                  sp:expression [
                      rdf:type iess:getUserSession ;
                    ] ;
                  sp:variable [
                      sp:varName "userSession"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object iess:Session ;
                  sp:predicate rdf:type ;
                  sp:subject [
                      sp:varName "userSession"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "ontologyProject"^^xsd:string ;
                    ] ;
                  sp:predicate iess:requires ;
                  sp:subject [
                      sp:varName "userSession"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object iess:OntologyProject ;
                  sp:predicate rdf:type ;
                  sp:subject [
                      sp:varName "ontologyProject"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:comment "returns the URI for the current user's ontology project"^^xsd:string ;
  rdfs:label "get ontology project"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getOntologyProjectConfiguration
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "config"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  rdf:type sp:Bind ;
                  sp:expression [
                      rdf:type iess:getUserSession ;
                    ] ;
                  sp:variable [
                      sp:varName "session"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "ontProject"^^xsd:string ;
                    ] ;
                  sp:predicate iess:requires ;
                  sp:subject [
                      sp:varName "session"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "config"^^xsd:string ;
                    ] ;
                  sp:predicate iess:hasConfiguration ;
                  sp:subject [
                      sp:varName "ontProject"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:comment "The configuration settings for XSD generation are held on an ontology project instance."^^xsd:string ;
  rdfs:label "get ontology project configuration"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getOntologyProjectName
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "name"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  rdf:type sp:Bind ;
                  sp:expression [
                      rdf:type iess:getUserSession ;
                    ] ;
                  sp:variable [
                      sp:varName "session"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "ontProject"^^xsd:string ;
                    ] ;
                  sp:predicate iess:requires ;
                  sp:subject [
                      sp:varName "session"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "name"^^xsd:string ;
                    ] ;
                  sp:predicate vaem:name ;
                  sp:subject [
                      sp:varName "ontProject"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:comment "The project name of an ontology project instance."^^xsd:string ;
  rdfs:label "get ontology project name"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getOntologyProperty
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "value"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  rdf:type sp:Optional ;
                  sp:elements (
                      [
                        sp:object [
                            sp:varName "value1"^^xsd:string ;
                          ] ;
                        sp:predicate [
                            sp:varName "property"^^xsd:string ;
                          ] ;
                        sp:subject [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ]
                [
                  rdf:type sp:Optional ;
                  sp:elements (
                      [
                        sp:object [
                            sp:varName "schemaGraph"^^xsd:string ;
                          ] ;
                        sp:predicate <http://xspl.us/schema/xsp#annotatesGraph> ;
                        sp:subject [
                            sp:varName "graph"^^xsd:string ;
                          ] ;
                      ]
                      [
                        sp:object [
                            sp:varName "value2"^^xsd:string ;
                          ] ;
                        sp:predicate [
                            sp:varName "property"^^xsd:string ;
                          ] ;
                        sp:subject [
                            sp:varName "schemaGraph"^^xsd:string ;
                          ] ;
                      ]
                    ) ;
                ]
                [
                  rdf:type sp:Bind ;
                  sp:expression [
                      rdf:type sp:if ;
                      sp:arg1 [
                          rdf:type sp:bound ;
                          sp:arg1 [
                              sp:varName "value1"^^xsd:string ;
                            ] ;
                        ] ;
                      sp:arg2 [
                          sp:varName "value1"^^xsd:string ;
                        ] ;
                      sp:arg3 [
                          rdf:type sp:if ;
                          sp:arg1 [
                              rdf:type sp:bound ;
                              sp:arg1 [
                                  sp:varName "schemaGraph"^^xsd:string ;
                                ] ;
                            ] ;
                          sp:arg2 [
                              rdf:type sp:if ;
                              sp:arg1 [
                                  rdf:type sp:bound ;
                                  sp:arg1 [
                                      sp:varName "value2"^^xsd:string ;
                                    ] ;
                                ] ;
                              sp:arg2 [
                                  sp:varName "value2"^^xsd:string ;
                                ] ;
                              sp:arg3 "MISSING" ;
                            ] ;
                          sp:arg3 "MISSING" ;
                        ] ;
                    ] ;
                  sp:variable [
                      sp:varName "value"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:graph ;
      spl:valueType rdfs:Resource ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdf:Property ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:comment "Returns value for a metadata property on an ontology. The property may live either on an annotation graph or on the graph that the annotation graph annotates."^^xsd:string ;
  rdfs:label "get ontology property"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getOntologyXSPGraph
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "gAnnotationsGraphURI"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object spin:_arg1 ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object spin:_arg2 ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "gAnnotationsGraphURI"^^xsd:string ;
              ] ;
            sp:predicate iess:findAnnotationsGraph ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "project name"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "ontology URI"^^xsd:string ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:comment "Find the XSP graph for a given ontology"^^xsd:string ;
  rdfs:label "get ontology project configuration"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getParentClass
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "d"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Union ;
            sp:elements (
                (
                  [
                    sp:object [
                        sp:varName "x"^^xsd:string ;
                      ] ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject spin:_arg1 ;
                  ]
                  [
                    sp:object owl:Class ;
                    sp:predicate rdf:type ;
                    sp:subject [
                        sp:varName "x"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Filter ;
                    sp:expression [
                        rdf:type sp:ne ;
                        sp:arg1 [
                            sp:varName "x"^^xsd:string ;
                          ] ;
                        sp:arg2 spin:_arg2 ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "x"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object spin:_arg2 ;
                    sp:predicate rdf:first ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object () ;
                    sp:predicate rdf:rest ;
                    sp:subject [
                        sp:varName "?1"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "inc"^^xsd:string ;
                      ] ;
                    sp:predicate iess:getParentClass ;
                    sp:subject [
                        sp:varName "?0"^^xsd:string ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        rdf:type sp:add ;
                        sp:arg1 [
                            sp:varName "inc"^^xsd:string ;
                          ] ;
                        sp:arg2 1 ;
                      ] ;
                    sp:variable [
                        sp:varName "d"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    sp:object spin:_arg2 ;
                    sp:predicate rdfs:subClassOf ;
                    sp:subject spin:_arg1 ;
                  ]
                  [
                    sp:object owl:Class ;
                    sp:predicate rdf:type ;
                    sp:subject spin:_arg2 ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression 1 ;
                    sp:variable [
                        sp:varName "d"^^xsd:string ;
                      ] ;
                  ]
                )
                (
                  [
                    rdf:type sp:Filter ;
                    sp:expression [
                        rdf:type sp:eq ;
                        sp:arg1 spin:_arg1 ;
                        sp:arg2 spin:_arg2 ;
                      ] ;
                  ]
                  [
                    rdf:type sp:Bind ;
                    sp:expression 0 ;
                    sp:variable [
                        sp:varName "d"^^xsd:string ;
                      ] ;
                  ]
                )
              ) ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "Current subclass"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "Current superclass"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg3 ;
      spl:valueType xsd:integer ;
    ] ;
  rdfs:label "get parent class"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:getParentsWithinDepth
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "depth"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            sp:object spin:_arg1 ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object spin:_arg2 ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "depth"^^xsd:string ;
              ] ;
            sp:predicate iess:getParentClass ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type sp:le ;
                sp:arg1 [
                    sp:varName "depth"^^xsd:string ;
                  ] ;
                sp:arg2 spin:_arg3 ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "Current subclass"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg2 ;
      spl:valueType rdfs:Resource ;
      rdfs:comment "Current superclass"^^xsd:string ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg3 ;
      spl:valueType xsd:integer ;
    ] ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:getProjectConfigurationPropertyValue
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "value"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:getSessionGraph ;
              ] ;
            sp:variable [
                sp:varName "sessionGraph"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:makeUserSessionResource ;
                arg:prefix "CONFIG" ;
                arg:resource "" ;
              ] ;
            sp:variable [
                sp:varName "config"^^xsd:string ;
              ] ;
          ]
          (
            [
              rdf:type sp:NamedGraph ;
              sp:elements (
                  [
                    sp:object [
                        sp:varName "value"^^xsd:string ;
                      ] ;
                    sp:predicate [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                    sp:subject [
                        sp:varName "config"^^xsd:string ;
                      ] ;
                  ]
                ) ;
              sp:graphNameNode [
                  sp:varName "sessionGraph"^^xsd:string ;
                ] ;
            ]
          )
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdf:Property ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:comment "Retrieves a property from the current session's configuration instance."^^xsd:string ;
  rdfs:label "get project configuration property value"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getProjectXSDFiles
  rdf:type spin:MagicProperty ;
  spin:body [
      rdf:type sp:Select ;
      sp:orderBy (
          [
            sp:varName "file"^^xsd:string ;
          ]
        ) ;
      sp:resultVariables (
          [
            sp:varName "file"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type xsd:string ;
                sp:arg1 [
                    rdf:type fn:concat ;
                    sp:arg1 "/" ;
                    sp:arg2 spin:_arg1 ;
                  ] ;
              ] ;
            sp:variable [
                sp:varName "workspacePath"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?0"^^xsd:string ;
              ] ;
            sp:predicate tops:files ;
            sp:subject [
                sp:varName "file"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "workspacePath"^^xsd:string ;
              ] ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?1"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?0"^^xsd:string ;
              ] ;
          ]
          [
            sp:object "true"^^xsd:boolean ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object [
                sp:varName "?2"^^xsd:string ;
              ] ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?1"^^xsd:string ;
              ] ;
          ]
          [
            sp:object "true"^^xsd:boolean ;
            sp:predicate rdf:first ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            sp:object () ;
            sp:predicate rdf:rest ;
            sp:subject [
                sp:varName "?2"^^xsd:string ;
              ] ;
          ]
          [
            rdf:type sp:Filter ;
            sp:expression [
                rdf:type fn:ends-with ;
                sp:arg1 [
                    sp:varName "file"^^xsd:string ;
                  ] ;
                sp:arg2 ".xsd" ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate sp:arg1 ;
      spl:valueType xsd:string ;
      rdfs:comment "project path"^^xsd:string ;
    ] ;
  rdfs:label "get project XSD files"^^xsd:string ;
  rdfs:subClassOf iess:MagicProperties ;
.
iess:getServerURL
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "serverURL"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:if ;
                sp:arg1 [
                    rdf:type smf:isTBL ;
                  ] ;
                sp:arg2 [
                    rdf:type fn:concat ;
                    sp:arg1 [
                        rdf:type iess:getSessionConfigurationPropertyValue ;
                        arg:property iess:serverURL ;
                      ] ;
                    sp:arg2 "/ies" ;
                  ] ;
                sp:arg3 "http://localhost:8083" ;
              ] ;
            sp:variable [
                sp:varName "serverURL"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  rdfs:label "get server URL"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getSessionConfigurationPropertyValue
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "value"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type iess:getSessionGraph ;
              ] ;
            sp:variable [
                sp:varName "sessionGraph"^^xsd:string ;
              ] ;
          ]
          (
            [
              rdf:type sp:NamedGraph ;
              sp:elements (
                  [
                    rdf:type sp:Bind ;
                    sp:expression [
                        rdf:type iess:getUserSession ;
                      ] ;
                    sp:variable [
                        sp:varName "session"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "ontologyProject"^^xsd:string ;
                      ] ;
                    sp:predicate iess:requires ;
                    sp:subject [
                        sp:varName "session"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "config"^^xsd:string ;
                      ] ;
                    sp:predicate iess:hasConfiguration ;
                    sp:subject [
                        sp:varName "ontologyProject"^^xsd:string ;
                      ] ;
                  ]
                  [
                    sp:object [
                        sp:varName "value"^^xsd:string ;
                      ] ;
                    sp:predicate [
                        sp:varName "property"^^xsd:string ;
                      ] ;
                    sp:subject [
                        sp:varName "config"^^xsd:string ;
                      ] ;
                  ]
                ) ;
              sp:graphNameNode [
                  sp:varName "sessionGraph"^^xsd:string ;
                ] ;
            ]
          )
        ) ;
    ] ;
  spin:constraint [
      rdf:type spl:Argument ;
      spl:predicate arg:property ;
      spl:valueType rdf:Property ;
    ] ;
  spin:returnType xsd:string ;
  rdfs:comment "Retrieves a property from the current session's configuration instance."^^xsd:string ;
  rdfs:label "get session configuration property value"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getSessionGraph
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "graph"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:Bind ;
            sp:expression [
                rdf:type sp:iri ;
                sp:arg1 "http://ies.topbraidlive.org/dynamic/sessions" ;
              ] ;
            sp:variable [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:returnType rdfs:Resource ;
  rdfs:label "get session graph"^^xsd:string ;
  rdfs:subClassOf iess:Functions ;
.
iess:getUserConfigurationProperty
  rdf:type spin:Function ;
  spin:body [
      rdf:type sp:Select ;
      sp:resultVariables (
          [
            sp:varName "value"^^xsd:string ;
          ]
        ) ;
      sp:where (
          [
            rdf:type sp:NamedGraph ;
            sp:elements (
                [
                  rdf:type sp:Bind ;
                  sp:expression [
                      rdf:type iess:getUserSession ;
                    ] ;
                  sp:variable [
                      sp:varName "session"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "ontProject"^^xsd:string ;
                    ] ;
                  sp:predicate iess:requires ;
                  sp:subject [
                      sp:varName "session"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "config"^^xsd:string ;
                    ] ;
                  sp:predicate iess:hasConfiguration ;
                  sp:subject [
                      sp:varName "ontProject"^^xsd:string ;
                    ] ;
                ]
                [
                  sp:object [
                      sp:varName "value"^^xsd:string ;
                    ] ;
                  sp:predicate [
                      sp:varName "property"^^xsd:string ;
                    ] ;
                  sp:subject [
                      sp:varName "config"^^xsd:string ;
                    ] ;
                ]
              ) ;
            sp:graphNameNode [
                sp:varName "graph"^^xsd:string ;
              ] ;
          ]
        ) ;
    ] ;
  spin:constraint [
